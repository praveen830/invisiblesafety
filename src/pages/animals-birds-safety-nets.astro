---
import BaseLayout from '../layouts/BaseLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { pricing } from '../data/pricing';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { Bird, ShieldCheck, Check, AlertTriangle, MessageCircle, Phone, ArrowRight, Activity, Eye, Dog, Heart, Sparkles } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Animals & Birds Safety Nets",
  "Translucent 0.7mm nylon and UV-stabilized virgin polymer anti-pigeon and pet protection netting for balconies, windows, and duct shafts starting at ₹28/sq.ft.",
  pricing.safetyNet.pigeonProtection
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://Invisible Safety.com/" },
  { name: "Animals & Birds Safety Nets", url: "https://Invisible Safety.com/animals-birds-safety-nets/" }
]);
