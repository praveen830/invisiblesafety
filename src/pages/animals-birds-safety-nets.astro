---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { pricing } from '../data/pricing';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2 } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Animals & Birds Safety Nets",
  "Translucent 0.7mm nylon and UV-stabilized virgin polymer anti-pigeon and pet protection netting for balconies, windows, and duct shafts with custom site quote",
  pricing.safetyNet.pigeonProtection
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Animals & Birds Safety Nets", url: "https://invisiblesafety.in/animals-birds-safety-nets/" }
]);

const specs = [
  { label: "Optical Transparency", value: "98% Visual Skyline Transmission", icon: ShieldCheck },
  { label: "Humane Standards", value: "100% Non-Entangling Blunt Mesh", icon: Award },
  { label: "Spike Metallurgy", value: "SS304 Spikes on Polycarbonate", icon: Wrench },
  { label: "Clean Living Guarantee", value: "3-Year Replacement Guarantee", icon: CheckCircle2 }
];

const subcategories = [
  {
    title: "Translucent Anti-Pigeon Netting",
    subtitle: "Near-invisible monofilament grid denying roosting access to pigeons without daylight blockage.",
    href: "/pigeon-nets/",
    image: "/images/pigeon-net.webp",
    spec: "Virgin UV-Stabilized Co-Polymer",
    badge: "Discreet Living"
  },
  {
    title: "SS304 Polycarbonate Bird Spikes",
    subtitle: "Humane curved blunt spikes preventing bird perching on narrow parapets, AC units, and ledges.",
    href: "/bird-spikes/",
    image: "/images/balcony-safety.webp",
    spec: "Weather-Resistant Virgin Polycarbonate",
    badge: "Ledge Protection"
  },
  {
    title: "Anti-Monkey Balcony Enclosures",
    subtitle: "High-tensile braided wire netting designed to withstand aggressive monkey pulling and tampering.",
    href: "/monkey-safety-nets/",
    image: "/images/safety-net-balcony.webp",
    spec: "Reinforced Multi-Cord Tension",
    badge: "Wildlife Defense"
  },
  {
    title: "Fine-Mesh Insect & Mosquito Nets",
    subtitle: "Pleated and roller insect screens providing 100% insect protection with cross-ventilation.",
    href: "/mosquito-safety-nets/",
    image: "/images/terrace-top-net.jpg",
    spec: "Fiberglass Anti-Tear Mesh",
    badge: "Clean Airflow"
  }
];

const gallery = [
  {
    src: "/images/pigeon-net.webp",
    alt: "Translucent Pigeon Net on Balcony",
    title: "Translucent Skyline Protection",
    caption: "Unobtrusive bird exclusion preserving pristine aesthetic elevation.",
    badge: "Penthouse Living"
  },
  {
    src: "/images/balcony-safety.webp",
    alt: "Stainless Steel Bird Spikes along Parapet",
    title: "SS304 Anti-Perching Ledge Spikes",
    caption: "Precision silicon-bonded spikes installed on high-rise AC ledges.",
    badge: "Facade Care"
  },
  {
    src: "/images/safety-net-balcony.webp",
    alt: "Reinforced Anti-Monkey Enclosure",
    title: "High-Tensile Balcony Barrier",
    caption: "Heavy-gauge netting protecting hillside residences against wildlife intrusion.",
    badge: "Perimeter Shield"
  },
  {
    src: "/images/terrace-top-net.jpg",
    alt: "Terrace Bird Exclusion Netting",
    title: "Rooftop Air Duct & Terrace Net",
    caption: "Wide-span horizontal netting keeping roof shafts free of bird nesting.",
    badge: "Clean Architecture"
  }
];
---

<SubPageLayout
  title="Animals & Birds Safety Nets | Anti-Pigeon & Pet Protection | Invisible Safety"
  description="Certified Animals & Birds Safety Nets with custom site quote 0.7mm translucent bird exclusion mesh and high-tensile pet balcony netting."
  canonicalUrl="/animals-birds-safety-nets/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="HUMANE AVIAN & WILDLIFE DEFENSE"
  heroTitle="ANIMALS &amp; BIRDS SAFETY NETS"
  heroSubtitle="Comprehensive humane bird exclusion netting, stainless steel spikes, and reinforced wildlife enclosures safeguarding balconies and air ducts without obstructing views."
  heroImage="/images/pigeon-net.webp"
  heroImageAlt="Animals and Birds Safety Nets Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Defense Overview Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">DOMESTIC &amp; FACADE SANCTUARY</span>
        <h2 class="editorial-title">Pristine Living Without Pests</h2>
        <p class="editorial-subtitle">
          Eliminate bird droppings, nest mite infestations, and aggressive wildlife visits forever.
        </p>
      </div>

      <div class="anim-grid">
        <div class="anim-card">
          <h3 class="anim-card-title">100% Humane Exclusion</h3>
          <p class="anim-card-desc">
            Physical barrier denial stops birds from nesting on AC ledges without trapping, poisoning, or injuring birds.
          </p>
        </div>

        <div class="anim-card">
          <h3 class="anim-card-title">Microbial Health Defense</h3>
          <p class="anim-card-desc">
            Stops dried pigeon droppings from circulating fungal spores into bedrooms via air conditioner intake fans.
          </p>
        </div>

        <div class="anim-card">
          <h3 class="anim-card-title">SS304 Anti-Perching Spikes</h3>
          <p class="anim-card-desc">
            Blunt surgical-grade steel pins deny roosting on narrow copings, pipes, and signs with zero rust staining on paintwork.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Estimator Section -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Animal &amp; Bird Net Quote</h2>
        <p class="editorial-subtitle">
          Configure balcony dimensions for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .anim-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .anim-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .anim-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .anim-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .anim-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
