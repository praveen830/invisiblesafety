---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2 } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Swimming Pool Safety Nets",
  "High-tension child and pet anti-drowning swimming pool safety nets with flush marine brass anchors with custom site quote",
  24
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Specialty Solutions", url: "https://invisiblesafety.in/sports-nets/" },
  { name: "Swimming Pool Nets", url: "https://invisiblesafety.in/swimming-pool-nets/" }
]);

const specs = [
  { label: "Core Tensile Webbing", value: "Multi-Strand UV-Stabilized Polyethylene", icon: ShieldCheck },
  { label: "Load Support Rating", value: "Holds 150+ kg Child / Adult Weight", icon: Award },
  { label: "Flush Anchors", value: "Brass / SS316 Flush Deck Anchors", icon: Wrench },
  { label: "Direct Warranty", value: "5-Year Chlorine & UV Resistant", icon: CheckCircle2 }
];

const subcategories = [
  {
    title: "Apartment Balcony Safety Nets",
    subtitle: "Full-perimeter protective enclosure stopping accidental falls without making balconies feel caged.",
    href: "/balcony-safety/",
    image: "/images/safety-net-balcony.webp",
    spec: "Virgin High-Density Polymer",
    badge: "Residential Core"
  },
  {
    title: "Child Safety Invisible Grills",
    subtitle: "50mm calibrated Japanese SS316 cables providing unyielding 400+ kgf fall safety.",
    href: "/child-safety-invisible-grills/",
    image: "/images/child-safety.webp",
    spec: "400+ kgf Breaking Load",
    badge: "Flagship Grills"
  },
  {
    title: "Terrace Top Fall Perimeter",
    subtitle: "Boundary safety netting installed over open roof parapets to secure terrace gatherings.",
    href: "/terrace-safety-nets/",
    image: "/images/terrace-top-net.jpg",
    spec: "High-Tensile Perimeter Tie Cords",
    badge: "Rooftop Guard"
  },
  {
    title: "Rooftop Cricket Practice Nets",
    subtitle: "Enclosed practice cages allowing hard leather ball batting practice without perimeter danger.",
    href: "/sports-practice-nets/",
    image: "/images/sports-nets.webp",
    spec: "Heavy-Gauge Multi-Strand Mesh",
    badge: "Sports Suite"
  }
];

const gallery = [
  {
    src: "/images/swimming-pool-net.jpg",
    alt: "Swimming Pool Safety Cover",
    title: "Villas Pool Safety Barrier",
    caption: "Precision edge-anchored tension net safeguarding toddlers and pets from accidental water immersion.",
    badge: "Villa Safety"
  },
  {
    src: "/images/hero-balcony.webp",
    alt: "Balcony Invisible Grills",
    title: "Panoramic Skyline Aperture",
    caption: "High-contrast SS316 marine cables preserving panoramic cityscape views.",
    badge: "Skyline Vista"
  },
  {
    src: "/images/child-safety.webp",
    alt: "Child-Safe Calibrated Balcony",
    title: "Toddler Anti-Fall System",
    caption: "Zero footholds preventing climbing leverage with unyielding 400+ kg load strength.",
    badge: "Child & Pet Safety"
  },
  {
    src: "/images/sports-nets.webp",
    alt: "Sports Netting Rooftop Turf",
    title: "Rooftop Practice Enclosure",
    caption: "High-velocity ball containment enclosure for residential clubhouses.",
    badge: "Specialty Sports"
  }
];
---

<SubPageLayout
  title="Swimming Pool Safety Nets | Child & Pet Anti-Drowning Barrier | Invisible Safety"
  description="High-tension swimming pool safety nets with flush brass anchors. Prevents toddler and pet accidental falls with 5-year chlorine-resistant warranty."
  canonicalUrl="/swimming-pool-nets/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="PEDIATRIC WATER SAFETY"
  heroTitle="SWIMMING POOL SAFETY NETS"
  heroSubtitle="Tensioned surface barriers anchored across residential and clubhouse swimming pools with flush deck fittings, preventing accidental infant and pet drowning."
  heroImage="/images/swimming-pool-net.jpg"
  heroImageAlt="Swimming Pool Safety Nets Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Pool Safety Dynamics Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">DROWNING PREVENTION INTEGRITY</span>
        <h2 class="editorial-title">Tensioned Water Perimeter</h2>
        <p class="editorial-subtitle">
          Designed so that a child falling onto the net remains elevated completely above water level.
        </p>
      </div>

      <div class="pool-grid">
        <div class="pool-card">
          <h3 class="pool-card-title">Central Pulley Tensioning</h3>
          <p class="pool-card-desc">
            Equipped with a central tensioning cord ratchet system that pulls the mesh drum-tight across the water surface, preventing any sagging below the waterline.
          </p>
        </div>

        <div class="pool-card">
          <h3 class="pool-card-title">Flush Brass Deck Anchors</h3>
          <p class="pool-card-desc">
            Anchor keyholes install completely flush with stone or marble pool coping, ensuring barefoot swimmers never stub toes or trip when the net is removed.
          </p>
        </div>

        <div class="pool-card">
          <h3 class="pool-card-title">Chlorine &amp; Chemical Immunity</h3>
          <p class="pool-card-desc">
            Treated with marine chemical inhibitors resistant to swimming pool chlorine, ozone sanitation systems, and direct tropical solar degradation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Estimator Section -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Pool Netting Quote</h2>
        <p class="editorial-subtitle">
          Configure pool dimensions for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .pool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .pool-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .pool-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .pool-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .pool-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
