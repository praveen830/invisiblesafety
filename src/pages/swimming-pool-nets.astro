---
import BaseLayout from '../layouts/BaseLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Sparkles, MessageCircle, Phone, ArrowRight, LifeBuoy, Waves } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Swimming Pool Safety Nets",
  "High-tension child and pet drowning prevention swimming pool safety nets with custom site quote with central tension pulley system.",
  32
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Specialty Solutions", url: "https://invisiblesafety.in/sports-nets/" },
  { name: "Swimming Pool Nets", url: "https://invisiblesafety.in/swimming-pool-nets/" }
]);
---

<BaseLayout
  title="Swimming Pool Safety Nets | Child & Pet Drowning Prevention | Invisible Safety"
  description="Certified swimming pool safety nets designed to prevent toddler and pet drowning accidents. Supports 150+ kg across pool surface. with custom site quote with stainless deck anchors."
  canonicalUrl="/swimming-pool-nets/"
  schema={[serviceSchema, breadcrumbs]}
>
  <section class="section-spacing" style="background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%); border-bottom: 1px solid #E2E8F0; padding-top: 2rem;">
    <div class="container">
      <nav style="font-size: 0.76rem; font-weight: 700; color: #64748B; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 2rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <a href="/" style="color: #64748B; text-decoration: none;">HOME</a>
        <span>/</span>
        <a href="/sports-nets/" style="color: #64748B; text-decoration: none;">SPECIALTY SOLUTIONS</a>
        <span>/</span>
        <span style="color: #C2410C;">SWIMMING POOL NETS</span>
      </nav>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 3.5rem; align-items: start;">
        <div style="position: sticky; top: 100px;">
          <div style="position: relative; border-radius: 24px; overflow: hidden; background: #0F172A; box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.18); aspect-ratio: 3/4;">
            <img
              src="/images/swimming-pool-net.jpg"
              alt="Swimming Pool Safety Net Enclosure"
              style="width: 100%; height: 100%; object-fit: cover;"
              loading="eager"
            />
            <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15, 23, 42, 0.1) 0%, rgba(15, 23, 42, 0.75) 100%); pointer-events: none;"></div>
            
            <div style="position: absolute; top: 16px; left: 16px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); border: 1px solid #BAE6FD; padding: 0.35rem 0.85rem; border-radius: 20px; font-size: 0.75rem; font-weight: 800; color: #0284C7; display: flex; align-items: center; gap: 0.4rem;">
              <Waves size={13} /> DROWNING PREVENTION SYSTEM
            </div>

            <div style="position: absolute; bottom: 20px; left: 20px; right: 20px; color: #FFFFFF; pointer-events: none;">
              <div style="font-size: 0.75rem; font-weight: 800; color: #38BDF8; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.25rem;">
                WATER PERIMETER
              </div>
              <div style="font-size: 1.4rem; font-weight: 900; line-height: 1.2;">
                Child & Pet Water Perimeter
              </div>
              <div style="font-size: 0.85rem; color: #CBD5E1; margin-top: 0.35rem;">
                Supports 150+ kg Child Weight Above Water • Easy Roller Tensioning
              </div>
            </div>
          </div>
        </div>

        <div>
          <div style="display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.35rem 0.85rem; background: #F0F9FF; border: 1px solid #BAE6FD; border-radius: 20px; font-size: 0.78rem; font-weight: 800; color: #0284C7; margin-bottom: 1rem;">
            <ShieldCheck size={14} /> TODDLER & PET DROWNING PREVENTION
          </div>

          <h1 style="font-size: clamp(2.4rem, 4.2vw, 3.4rem); font-weight: 900; color: #0F172A; line-height: 1.15; margin-bottom: 0.75rem; letter-spacing: -0.03em;">
            SWIMMING POOL NETS
          </h1>
          <p style="font-size: 1.2rem; font-weight: 600; color: #0284C7; margin-bottom: 1.5rem; line-height: 1.4;">
            Child-safe and pet-safe pool mesh covers supporting up to 150 kg across the water surface to eliminate drowning risks.
          </p>

          <div style="display: flex; gap: 2rem; align-items: baseline; margin-bottom: 2rem; padding: 1.25rem 1.5rem; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 14px;">
            <div>
              <span style="font-size: 0.72rem; color: #64748B; display: block; font-weight: 700; text-transform: uppercase;">Direct Quotation:</span>
              <span style="font-size: 1.45rem; font-weight: 800; color: #0284C7;">Custom Site Quote</span>
            </div>
            <div style="width: 1px; height: 38px; background: #E2E8F0;"></div>
            <div>
              <span style="font-size: 0.72rem; color: #64748B; display: block; font-weight: 700; text-transform: uppercase;">Warranty:</span>
              <span style="font-size: 1.25rem; font-weight: 800; color: #16A34A;">3-Year Chlorine & UV Proof</span>
            </div>
          </div>

          <p style="font-size: 1.05rem; color: #475569; line-height: 1.7; margin-bottom: 2rem;">
            Unfenced private villa swimming pools, clubhouse pools, and resort plunge pools are among the leading causes of accidental drowning in young children and pets. Invisible Safety Pool Safety Nets form a tightly stretched horizontal mesh barrier anchored flush to the deck with brass or SS316 anchors. If a toddler steps or falls onto the net, they remain elevated safely above the water line without submerging.
          </p>

          <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 16px; overflow: hidden; margin-bottom: 2.5rem; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);">
            <div style="padding: 1rem 1.5rem; background: #F8FAFC; border-bottom: 1px solid #E2E8F0; font-size: 0.82rem; font-weight: 800; color: #0F172A; letter-spacing: 0.08em; text-transform: uppercase;">
              TECHNICAL SPECIFICATION TABLE
            </div>
            <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem;">
              <tbody>
                <tr style="border-bottom: 1px solid #F1F5F9;">
                  <td style="padding: 0.9rem 1.5rem; font-weight: 700; color: #334155; width: 40%; background: #FAFAFA;">Mesh Material</td>
                  <td style="padding: 0.9rem 1.5rem; color: #0F172A; font-weight: 600;">Virgin High-Density Polyethylene with Chlorine Inhibitors</td>
                </tr>
                <tr style="border-bottom: 1px solid #F1F5F9;">
                  <td style="padding: 0.9rem 1.5rem; font-weight: 700; color: #334155; background: #FAFAFA;">Weight Bearing Capacity</td>
                  <td style="padding: 0.9rem 1.5rem; color: #0F172A; font-weight: 600;">Supports 150+ kg across pool center (Keeps child dry)</td>
                </tr>
                <tr style="border-bottom: 1px solid #F1F5F9;">
                  <td style="padding: 0.9rem 1.5rem; font-weight: 700; color: #334155; background: #FAFAFA;">Deck Anchors</td>
                  <td style="padding: 0.9rem 1.5rem; color: #0F172A; font-weight: 600;">Flush-Mounted Marine Brass or SS316 Deck Anchors</td>
                </tr>
                <tr style="border-bottom: 1px solid #F1F5F9;">
                  <td style="padding: 0.9rem 1.5rem; font-weight: 700; color: #334155; background: #FAFAFA;">Tension System</td>
                  <td style="padding: 0.9rem 1.5rem; color: #0F172A; font-weight: 600;">Central Ratchet Pulley (Simple 3-minute removal & installation)</td>
                </tr>
                <tr>
                  <td style="padding: 0.9rem 1.5rem; font-weight: 700; color: #334155; background: #FAFAFA;">Chlorine Resistance</td>
                  <td style="padding: 0.9rem 1.5rem; color: #16A34A; font-weight: 800;">100% Chemical & Salt Water Resistant (Non-degrading)</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="#estimator" class="btn btn-primary" style="padding: 0.95rem 1.85rem;">
              <span>Calculate Pool Net Cost</span>
              <ArrowRight size={17} />
            </a>
            <a
              href={`https://wa.me/${business.whatsapp}?text=Hi%20Invisible Safety%2C%20I%20need%20a%20quote%20for%20Swimming%20Pool%20Safety%20Nets.`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp"
              style="padding: 0.95rem 1.85rem;"
            >
              <MessageCircle size={17} />
              <span>Book Free Pool Survey</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-spacing" style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0;" id="estimator">
    <div class="container">
      <div class="section-header" style="max-width: 780px; margin: 0 auto 3rem auto; text-align: center;">
        <span class="badge-arch">ONLINE ESTIMATION</span>
        <h2>Calculate Pool Net Price</h2>
        <p>Enter your pool length and width for instant custom estimation.</p>
      </div>
      <CostEstimator client:load />
    </div>
  </section>

  <TrustSection />
  <FAQSection category="safety-nets" title="Swimming Pool Safety Nets FAQ" />
</BaseLayout>
