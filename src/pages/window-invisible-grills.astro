---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2, Wind, Eye } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Windows Invisible Grills",
  "Frameless architectural SS316 invisible grills for sliding windows and French doors with 10-year warranty with custom site quote",
  190
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Invisible Grills", url: "https://invisiblesafety.in/invisible-grills/" },
  { name: "Windows Invisible Grills", url: "https://invisiblesafety.in/window-invisible-grills/" }
]);

const specs = [
  { label: "Cable Metallurgy", value: "Virgin Japanese SS316 Marine Grade", icon: ShieldCheck },
  { label: "Ventilation Index", value: "100% Unrestricted Natural Airflow", icon: Wind },
  { label: "Visual Clarity", value: "98.5% Optical Light Transmission", icon: Eye },
  { label: "Direct Warranty", value: "10-Year Direct Written Guarantee", icon: Wrench }
];

const subcategories = [
  {
    title: "Balcony Invisible Grills",
    subtitle: "Full-height high-tensile SS316 marine cables safeguarding high-rise living balconies.",
    href: "/balcony-invisible-grills/",
    image: "/images/hero-balcony.webp",
    spec: "Japanese SS316 (2.0mm / 2.5mm)",
    badge: "Flagship Balcony"
  },
  {
    title: "Duplex Staircase Tension Grills",
    subtitle: "Floor-to-ceiling vertical cable dividers safeguarding duplex voids and floating stairs.",
    href: "/staircase-invisible-grills/",
    image: "/images/staircase-invisible-grills.webp",
    spec: "Floor-to-Ceiling SS316 Cables",
    badge: "Interior Luxury"
  },
  {
    title: "Child-Safe Calibrated Spacing",
    subtitle: "50mm anti-head entrapment spacing engineered to protect toddlers and pets without climbable steps.",
    href: "/child-safety-invisible-grills/",
    image: "/images/child-safety.webp",
    spec: "50mm Anti-Entrapment Core",
    badge: "Toddler Proof"
  },
  {
    title: "French Sliding Door Barriers",
    subtitle: "Sleek low-profile track installations allowing French doors to remain wide open for evening breezes.",
    href: "/window-invisible-grills/",
    image: "/images/window-invisible-grills.webp",
    spec: "Direct Wall Anchor Tracks",
    badge: "Fenestration Guard"
  }
];

const gallery = [
  {
    src: "/images/window-invisible-grills.webp",
    alt: "French Sliding Window Invisible Grills",
    title: "French Fenestration Suite",
    caption: "Full-height sliding window array allowing maximum cross-ventilation without compromising child safety.",
    badge: "Low-Sill Specialized"
  },
  {
    src: "/images/hero-balcony.webp",
    alt: "Balcony Invisible Grills",
    title: "Panoramic Skyline Aperture",
    caption: "High-contrast SS316 marine cables preserving panoramic cityscape views.",
    badge: "Skyline Vista"
  },
  {
    src: "/images/staircase-invisible-grills.webp",
    alt: "Duplex Staircase Cables",
    title: "Duplex Void Tension Array",
    caption: "Floor-to-ceiling vertical cable array guarding modern architectural stairs.",
    badge: "Interior Architecture"
  },
  {
    src: "/images/child-safety.webp",
    alt: "Child-Safe Window Cables",
    title: "Toddler Anti-Fall System",
    caption: "Calibrated 50mm pitch strictly preventing toddlers from leaning through open window sills.",
    badge: "Child & Pet Safety"
  }
];
---

<SubPageLayout
  title="Windows Invisible Grills | Frameless Sliding Window Safety | Invisible Safety"
  description="High-tensile SS316 marine-grade invisible grills for windows, French doors, and low sills with custom site quote Maximum airflow with zero visual obstruction."
  canonicalUrl="/window-invisible-grills/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="FRAMELESS FENESTRATION ARCHITECTURE"
  heroTitle="WINDOWS INVISIBLE GRILLS"
  heroSubtitle="Sleek architectural barriers for large sliding glass windows, French doors, and low-sill bedroom openings, allowing complete cross-ventilation with 400+ kgf child safety."
  heroImage="/images/window-invisible-grills.webp"
  heroImageAlt="Windows Invisible Grills Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Window Dynamics Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">UNOBSTRUCTED LIVING</span>
        <h2 class="editorial-title">Ventilation Without Vulnerability</h2>
        <p class="editorial-subtitle">
          Enjoy unhindered morning air and skyline panoramas without bulky iron bars darkening your room.
        </p>
      </div>

      <div class="window-features-grid">
        <div class="window-feature-card">
          <h3 class="window-card-title">Low-Sill Window Protection</h3>
          <p class="window-card-desc">
            Modern high-rise apartments feature floor-level window sills that pose grave hazards for exploring children. Our invisible grills secure the opening with zero aesthetic degradation.
          </p>
        </div>

        <div class="window-feature-card">
          <h3 class="window-card-title">Emergency Egress Alignment</h3>
          <p class="window-card-desc">
            Unlike welded iron bars that trap occupants during fire emergencies, invisible grills can be severed with certified emergency rescue cable cutters in seconds by firefighters.
          </p>
        </div>

        <div class="window-feature-card">
          <h3 class="window-card-title">Zero Rust &amp; Weatherproof</h3>
          <p class="window-card-desc">
            AISI 316 marine alloy contains molybdenum to neutralize monsoon humidity and coastal salt-spray corrosion, ensuring pristine cable tension for over 10 years.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Smart Cost Estimator -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Window Grill Cost</h2>
        <p class="editorial-subtitle">
          Configure window dimensions for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection category="invisible-grills" title="Window Invisible Grills Questions &amp; Answers" />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .window-features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .window-feature-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .window-feature-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .window-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .window-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
