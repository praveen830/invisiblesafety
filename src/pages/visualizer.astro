---
import BaseLayout from '../layouts/BaseLayout.astro';
import VisualizerIsland from '../components/react/VisualizerIsland';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { getBreadcrumbSchema } from '../utils/seo';
import { Sparkles, Camera, Eye, ShieldCheck, ArrowRight } from 'lucide-react';

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Visualizer", url: "https://invisiblesafety.in/visualizer/" }
]);
---

<BaseLayout
  title="See It On Your Home | Balcony Safety Visualizer | Invisible Safety"
  description="Visualize invisible grills and safety nets directly on your balcony or window. Upload a photo or select standard high-rise presets to see your unobstructed skyline view."
  canonicalUrl="/visualizer/"
  schema={[breadcrumbs]}
>
  <!-- Light Architectural Hero Section -->
  <section class="section-spacing" style="background: linear-gradient(180deg, #F0F9FF 0%, #F8FAFC 100%); border-bottom: 1px solid #E2E8F0;">
    <div class="container" style="text-align: center; max-width: 860px; margin-bottom: 2.5rem;">
      <div style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.9rem; background: #E0F2FE; border: 1px solid #BAE6FD; border-radius: 20px; font-size: 0.8rem; font-weight: 700; color: #0369A1; margin-bottom: 1.25rem;">
        <Sparkles size={14} />
        <span>PRACTICAL HOME VISUALIZER • AI ARCHITECTURAL FIT</span>
      </div>
      <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.4rem); font-weight: 800; color: #0F172A; line-height: 1.2; margin-bottom: 1.25rem;">
        Visualize Invisible Grills <br />
        <span style="color: #2563EB;">on Your Balcony</span>
      </h1>
      <p style="font-size: 1.15rem; color: #475569; line-height: 1.65; max-width: 720px; margin: 0 auto;">
        Upload your photo. Explore elegant safety solutions. See your balcony before and after installation.
      </p>
    </div>

    <!-- Wide Panoramic Studio Workspace -->
    <div class="container" style="max-width: 1400px; padding: 0 clamp(0.75rem, 2vw, 1.5rem);">
      <VisualizerIsland client:load />
    </div>
  </section>

  <!-- How It Works & Tips -->
  <section class="section-spacing bg-warm" style="border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">PHOTO GUIDELINES</span>
        <h2>How To Take The Best Balcony Photo</h2>
        <p>Follow these quick tips for the most realistic visualization of your space.</p>
      </div>

      <div class="grid-3">
        <div class="card">
          <div style="font-size: 1.5rem; font-weight: 800; color: #2563EB; margin-bottom: 0.5rem;">01</div>
          <h3 style="font-size: 1.15rem; font-weight: 700; color: #0F172A; margin-bottom: 0.4rem;">Capture Full Opening</h3>
          <p style="font-size: 0.92rem; color: #475569; line-height: 1.6;">
            Step back into your living room so the ceiling slab, side walls, and bottom railing are all visible in the frame.
          </p>
        </div>

        <div class="card">
          <div style="font-size: 1.5rem; font-weight: 800; color: #2563EB; margin-bottom: 0.5rem;">02</div>
          <h3 style="font-size: 1.15rem; font-weight: 700; color: #0F172A; margin-bottom: 0.4rem;">Good Daytime Lighting</h3>
          <p style="font-size: 0.92rem; color: #475569; line-height: 1.6;">
            Take the photograph during daylight hours without direct camera glare so the background skyline stands out sharply.
          </p>
        </div>

        <div class="card">
          <div style="font-size: 1.5rem; font-weight: 800; color: #2563EB; margin-bottom: 0.5rem;">03</div>
          <h3 style="font-size: 1.15rem; font-weight: 700; color: #0F172A; margin-bottom: 0.4rem;">Free Doorstep Check</h3>
          <p style="font-size: 0.92rem; color: #475569; line-height: 1.6;">
            Visual previews are for design reference. Our engineer will visit your home with actual physical cable samples for confirmation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection category="invisible-grill" title="Visualizer & Installation Questions" />
</BaseLayout>
