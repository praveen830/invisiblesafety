---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2 } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Industrial Safety Nets & Debris Containment",
  "High-load industrial warehouse, racking, and factory safety netting certified to industrial standards with custom site quote",
  24
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Construction & Industrial", url: "https://invisiblesafety.in/construction-safety-nets/" },
  { name: "Industrial Safety Nets", url: "https://invisiblesafety.in/industrial-safety-nets/" }
]);

const specs = [
  { label: "Industrial Polymer", value: "High-Tenacity Multi-Ply Braided Nylon", icon: ShieldCheck },
  { label: "Debris Arrest Rating", value: "Heavy Industrial Pallet & Box Fall Catch", icon: Award },
  { label: "Structural Compliance", value: "Factory Inspectorate & IS 3521", icon: Wrench },
  { label: "Site Guarantee", value: "Commercial Industrial Safety Certification", icon: CheckCircle2 }
];

const subcategories = [
  {
    title: "Construction Site Fall Nets",
    subtitle: "Dual-layer personnel fall arrest mesh with fine debris catch lining for multi-story towers.",
    href: "/construction-safety-nets/",
    image: "/images/construction-safety-net.jpg",
    spec: "High-Impact Shock-Absorbing Core",
    badge: "Life Safety"
  },
  {
    title: "Building Duct Shaft Enclosures",
    subtitle: "Continuous vertical netting closing deep building plumbing ducts to prevent accidental tool drops.",
    href: "/duct-safety-nets/",
    image: "/images/duct-net.webp",
    spec: "Corrosion-Proof Heavy Perimeter Rope",
    badge: "Shaft Safety"
  },
  {
    title: "Car Parking Perimeter Nets",
    subtitle: "Basement and podium parking barriers preventing cricket ball strikes and vehicular damage.",
    href: "/car-parking-safety-nets/",
    image: "/images/car-parking-net.jpg",
    spec: "Weather-Resistant Multi-Strand Mesh",
    badge: "Basement Shield"
  },
  {
    title: "Terrace Top Fall Perimeter",
    subtitle: "Boundary safety netting installed over open roof parapets to secure terrace gatherings.",
    href: "/terrace-safety-nets/",
    image: "/images/terrace-top-net.jpg",
    spec: "High-Tensile Perimeter Tie Cords",
    badge: "Rooftop Guard"
  }
];

const gallery = [
  {
    src: "/images/industrial-safety-net.jpg",
    alt: "Industrial Warehouse Safety Netting",
    title: "Logistics Hub Storage Net",
    caption: "Ceiling-to-floor containment preventing high-bay pallet falls in logistics facilities.",
    badge: "Warehouse Safety"
  },
  {
    src: "/images/construction-safety-net.jpg",
    alt: "Construction Scaffolding Netting",
    title: "Commercial Tower Catch Net",
    caption: "Engineered fall arrest network safeguarding active high-rise construction.",
    badge: "Commercial Site"
  },
  {
    src: "/images/duct-net.webp",
    alt: "Vertical Duct Enclosure",
    title: "Internal Duct Void Enclosure",
    caption: "Continuous floor-to-floor vertical barrier protecting service shafts.",
    badge: "Shaft Protection"
  },
  {
    src: "/images/car-parking-net.jpg",
    alt: "Podium Parking Protection",
    title: "Podium Car Parking Barrier",
    caption: "Aesthetic perimeter mesh shielding luxury cars from stray ball impacts.",
    badge: "Podium Shield"
  }
];
---

<SubPageLayout
  title="Industrial Safety Nets | Warehouse Racking & Factory Fall Protection | Invisible Safety"
  description="Heavy-duty industrial fall protection and warehouse pallet rack safety netting with custom site quote Factory compliance certified."
  canonicalUrl="/industrial-safety-nets/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="INDUSTRIAL WORKPLACE DEFENSE"
  heroTitle="INDUSTRIAL &amp; FACTORY SAFETY NETS"
  heroSubtitle="Engineered high-load safety netting arrays designed for factories, warehouse high-bay racking, mezzanine perimeters, and conveyor overhead lines."
  heroImage="/images/industrial-safety-net.jpg"
  heroImageAlt="Industrial Safety Nets Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Industrial Features Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">OCCUPATIONAL HAZARD ELIMINATION</span>
        <h2 class="editorial-title">Certified Workplace Protection</h2>
        <p class="editorial-subtitle">
          Engineered to satisfy industrial safety audits, warehouse audits, and factory inspectorate norms.
        </p>
      </div>

      <div class="ind-grid">
        <div class="ind-card">
          <h3 class="ind-card-title">High-Bay Rack Backing</h3>
          <p class="ind-card-desc">
            Mounted along the rear of pallet racks to prevent loaded boxes or heavy cartons from being pushed off into adjacent pedestrian picking aisles.
          </p>
        </div>

        <div class="ind-card">
          <h3 class="ind-card-title">Overhead Conveyor Catch</h3>
          <p class="ind-card-desc">
            Suspended beneath overhead parcel and manufacturing conveyors to safely catch jammed items before they strike workers walking below.
          </p>
        </div>

        <div class="ind-card">
          <h3 class="ind-card-title">Fire-Retardant Treatment</h3>
          <p class="ind-card-desc">
            Optional flame-resistant treatments compliant with factory fire safety codes, ensuring netting will not propagate flames in manufacturing hubs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Estimator Section -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Industrial Netting Quote</h2>
        <p class="editorial-subtitle">
          Configure warehouse or factory area for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .ind-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .ind-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .ind-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .ind-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .ind-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
