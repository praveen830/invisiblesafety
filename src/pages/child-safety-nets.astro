---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2, Shield, Heart } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Child & Toddler Balcony Safety Nets",
  "Reinforced UV-stabilized polymer netting designed to prevent toddler falls and toy drops on high-rise balconies with custom site quote",
  18
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Safety Nets", url: "https://invisiblesafety.in/safety-nets/" },
  { name: "Child Safety Nets", url: "https://invisiblesafety.in/child-safety-nets/" }
]);

const specs = [
  { label: "Polymer Quality", value: "Virgin UV-Stabilized Co-Polymer", icon: ShieldCheck },
  { label: "Impact Capacity", value: "150+ kgf Breaking Strength per Mesh", icon: Award },
  { label: "Knot Engineering", value: "Heat-Set Non-Abrasive Knots", icon: Heart },
  { label: "Replacement Warranty", value: "3 to 5-Year Certified Guarantee", icon: Wrench }
];

const subcategories = [
  {
    title: "Apartment Balcony Safety Nets",
    subtitle: "Full-perimeter protective enclosure stopping accidental falls without making balconies feel caged.",
    href: "/balcony-safety/",
    image: "/images/safety-net-balcony.webp",
    spec: "Virgin High-Density Polymer",
    badge: "Residential Core"
  },
  {
    title: "Child Safety Invisible Grills",
    subtitle: "50mm calibrated Japanese SS316 cables providing unyielding 400+ kgf fall safety.",
    href: "/child-safety-invisible-grills/",
    image: "/images/child-safety.webp",
    spec: "400+ kgf Breaking Load",
    badge: "Flagship Grills"
  },
  {
    title: "Internal Stairwell Void Protection",
    subtitle: "Vertical safety netting closing large staircase eye gaps in villas and duplexes.",
    href: "/staircase-safety-nets/",
    image: "/images/staircase-invisible-grills.webp",
    spec: "Floor-to-Floor Continuous Webbing",
    badge: "Interior Void"
  },
  {
    title: "Terrace Top Fall Perimeter",
    subtitle: "Boundary safety netting installed over open parapets to secure terrace gatherings.",
    href: "/terrace-safety-nets/",
    image: "/images/terrace-top-net.jpg",
    spec: "High-Tensile Perimeter Tie Cords",
    badge: "Rooftop Guard"
  }
];

const gallery = [
  {
    src: "/images/child-safety.webp",
    alt: "Toddler and Pet Safe Balcony Netting",
    title: "Toddler & Pet Anti-Drop Barrier",
    caption: "Tight-grid netting stopping pets and toy drops with high impact resilience on luxury high-rise balconies.",
    badge: "Family Peace of Mind"
  },
  {
    src: "/images/safety-net-balcony.webp",
    alt: "Apartment Balcony Fall Shield",
    title: "Apartment Balcony Fall Shield",
    caption: "UV-treated high-density netting installed on a 15th-floor luxury balcony.",
    badge: "Residential Core"
  },
  {
    src: "/images/balcony-safety.webp",
    alt: "Clean Balcony Safety Mesh",
    title: "Architectural Parapet Extension",
    caption: "Precision anchor installation providing total peace of mind for families.",
    badge: "100% Society Approved"
  },
  {
    src: "/images/terrace-top-net.jpg",
    alt: "Terrace Party Deck Protection",
    title: "Terrace Party Deck Protection",
    caption: "Secured terrace boundary allowing safe evening gatherings and events.",
    badge: "Terrace Guard"
  }
];
---

<SubPageLayout
  title="Child Safety Nets | Toddler Balcony Protection | Invisible Safety"
  description="High-density polymer balcony safety nets for toddlers and pets with custom site quote 150+ kg load tested, anti-abrasive knots with 5-year replacement guarantee."
  canonicalUrl="/child-safety-nets/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="RESIDENTIAL CHILD PROTECTION"
  heroTitle="CHILD &amp; PET SAFETY NETS"
  heroSubtitle="UV-stabilized high-density virgin polymer netting safeguarding living balconies, banisters, and windows, preventing infant falls and pet slips with 150+ kgf impact load resistance."
  heroImage="/images/child-safety.webp"
  heroImageAlt="Child Safety Nets Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Child Safety Features Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">DOMESTIC SAFETY ARCHITECTURE</span>
        <h2 class="editorial-title">Built For Curious Hands &amp; Paws</h2>
        <p class="editorial-subtitle">
          Engineered to prevent falls, head entrapment, and dropped objects without restricting outdoor sunlight.
        </p>
      </div>

      <div class="child-nets-grid">
        <div class="child-net-card">
          <h3 class="net-card-title">Impact-Absorbing Stretch Dynamics</h3>
          <p class="net-card-desc">
            Unlike rigid barriers that can cause bruising upon accidental running impact, high-density polymer meshes gently decelerate children, providing a soft cushioned perimeter.
          </p>
        </div>

        <div class="child-net-card">
          <h3 class="net-card-title">Smooth Heat-Fused Knots</h3>
          <p class="net-card-desc">
            Constructed with machine-extruded round filaments and heat-locked knots that will never fray, release fiber splinters, or abrade tender infant skin.
          </p>
        </div>

        <div class="child-net-card">
          <h3 class="net-card-title">Zero Toy Dropping Protection</h3>
          <p class="net-card-desc">
            Calibrated mesh density stops balls, toy cars, and feeding bottles from slipping between railing gaps and plummeting down onto pedestrian walkways below.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Smart Cost Estimator -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Child Net Cost</h2>
        <p class="editorial-subtitle">
          Configure balcony dimensions for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection category="safety-nets" title="Child Safety Nets Questions &amp; Answers" />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .child-nets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .child-net-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .child-net-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .net-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .net-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
