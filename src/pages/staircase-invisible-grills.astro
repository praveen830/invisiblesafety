---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2, Ruler, Layers } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Staircase Invisible Grills",
  "Floor-to-ceiling vertical tension safety cables for duplex staircases and luxury floating stairs with 10-year warranty with custom site quote",
  190
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Invisible Grills", url: "https://invisiblesafety.in/invisible-grills/" },
  { name: "Staircase Invisible Grills", url: "https://invisiblesafety.in/staircase-invisible-grills/" }
]);

const specs = [
  { label: "Cable Metallurgy", value: "Virgin Japanese SS316 Marine Grade", icon: ShieldCheck },
  { label: "Tensile Breaking Load", value: "400+ kgf Load Strength", icon: Award },
  { label: "Spatial Aesthetic", value: "Floor-to-Ceiling Continuous Array", icon: Layers },
  { label: "Direct Warranty", value: "10-Year Direct Written Guarantee", icon: Wrench }
];

const subcategories = [
  {
    title: "Balcony Invisible Grills",
    subtitle: "Floor-to-ceiling high-tensile SS316 marine cables safeguarding high-rise living balconies.",
    href: "/balcony-invisible-grills/",
    image: "/images/hero-balcony.webp",
    spec: "Japanese SS316 (2.0mm / 2.5mm)",
    badge: "Flagship Balcony"
  },
  {
    title: "French Window Invisible Grills",
    subtitle: "Frameless high-tensile safety barriers for low-sill windows and sliding fenestrations.",
    href: "/window-invisible-grills/",
    image: "/images/window-invisible-grills.webp",
    spec: "Direct Wall Anchor Tracks",
    badge: "Fenestration Guard"
  },
  {
    title: "Child-Safe Calibrated Spacing",
    subtitle: "50mm anti-head entrapment spacing engineered to protect toddlers and pets without climbable steps.",
    href: "/child-safety-invisible-grills/",
    image: "/images/child-safety.webp",
    spec: "50mm Anti-Entrapment Core",
    badge: "Toddler Proof"
  },
  {
    title: "Duplex Void Enclosures",
    subtitle: "Full-height vertical safety arrays enclosing double-height living room mezzanine voids.",
    href: "/staircase-invisible-grills/",
    image: "/images/staircase-invisible-grills.webp",
    spec: "Architectural Ceiling Anchors",
    badge: "Mezzanine Guard"
  }
];

const gallery = [
  {
    src: "/images/staircase-invisible-grills.webp",
    alt: "Duplex Staircase Invisible Grills Installation",
    title: "Duplex Architectural Staircase",
    caption: "Floor-to-ceiling tensioned SS316 cables securing floating wooden stairs in a luxury penthouse.",
    badge: "Interior Luxury"
  },
  {
    src: "/images/hero-balcony.webp",
    alt: "Balcony Invisible Grills",
    title: "Panoramic Skyline Aperture",
    caption: "High-contrast SS316 marine cables preserving panoramic cityscape views.",
    badge: "Skyline Vista"
  },
  {
    src: "/images/window-invisible-grills.webp",
    alt: "French Window Invisible Grills",
    title: "French Fenestration Suite",
    caption: "Full ventilation and child anti-fall safety with zero visual blockage.",
    badge: "Window Protection"
  },
  {
    src: "/images/child-safety.webp",
    alt: "Child-Safe Calibrated Balcony",
    title: "Toddler Anti-Fall System",
    caption: "Zero footholds preventing climbing leverage with unyielding 400+ kg load strength.",
    badge: "Child & Pet Safety"
  }
];
---

<SubPageLayout
  title="Staircase Invisible Grills | Duplex Void Fall Protection | Invisible Safety"
  description="Floor-to-ceiling SS316 vertical cable tension safety grills for duplex staircases and floating steps with custom site quote Architectural elegance with 10-year warranty."
  canonicalUrl="/staircase-invisible-grills/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="THE SPIRAL ASCENT"
  heroTitle="STAIRCASE INVISIBLE GRILLS"
  heroSubtitle="Floor-to-ceiling tensioned cables safeguarding open stairwells, void drops, and luxury floating stairs while accentuating modern duplex verticality."
  heroImage="/images/staircase-invisible-grills.webp"
  heroImageAlt="Staircase Invisible Grills Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Architectural Void Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INTERIOR ARCHITECTURE</span>
        <h2 class="editorial-title">Dramatic Verticality &amp; Fall Protection</h2>
        <p class="editorial-subtitle">
          Secure floating steps and duplex voids without heavy glass partitions that collect smudges or obstruct natural light.
        </p>
      </div>

      <div class="staircase-grid">
        <div class="staircase-card">
          <h3 class="staircase-card-title">Floating Staircase Integrity</h3>
          <p class="staircase-card-desc">
            Cantilevered and open-tread stairs look visually striking but pose severe fall hazards for children. Vertical invisible cables provide transparent edge protection from step to ceiling.
          </p>
        </div>

        <div class="staircase-card">
          <h3 class="staircase-card-title">Airy Spatial Continuation</h3>
          <p class="staircase-card-desc">
            Unlike solid glass panels that restrict air circulation and require frequent cleaning, tensioned cables maintain breezy open-plan airflow across multi-level duplex living rooms.
          </p>
        </div>

        <div class="staircase-card">
          <h3 class="staircase-card-title">Structural Ceiling Anchors</h3>
          <p class="staircase-card-desc">
            Heavy-duty counter-sunk anchors embedded into concrete slabs with concealed aesthetic caps ensure pristine architectural alignment without visible brackets.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Smart Cost Estimator -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Staircase Grill Cost</h2>
        <p class="editorial-subtitle">
          Configure stairwell dimensions for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection category="invisible-grills" title="Staircase Invisible Grills Questions &amp; Answers" />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .staircase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .staircase-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .staircase-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .staircase-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .staircase-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
