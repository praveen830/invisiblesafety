  <script>
    function initDynamicSubcategoryCards() {
      const cards = document.querySelectorAll<HTMLElement>('.interactive-system-card');

      cards.forEach(card => {
        const defaultHref = card.getAttribute('data-default-href') || card.getAttribute('data-href') || '/';
        const defaultImg = card.getAttribute('data-default-img') || '';
        const defaultTag = card.getAttribute('data-default-tag') || '';
        const defaultCta = card.getAttribute('data-default-cta') || 'Explore System & Sub-Categories';

        const imgEl = card.querySelector<HTMLImageElement>('.card-showcase-img');
        const badgeEl = card.querySelector<HTMLElement>('.card-badge-chip');
        const titleEl = card.querySelector<HTMLElement>('.card-showcase-title');
        const actionBtn = card.querySelector<HTMLAnchorElement>('.card-action-btn');
        const btnText = card.querySelector<HTMLElement>('.card-action-btn .btn-text');
        const chips = card.querySelectorAll<HTMLAnchorElement>('.subcat-link-chip');

        chips.forEach(chip => {
          // Mouseover / Hover: Live Preview and target routing swap
          chip.addEventListener('mouseenter', () => {
            chips.forEach(c => c.classList.remove('active-subcat-chip'));
            chip.classList.add('active-subcat-chip');

            const subImg = chip.getAttribute('data-sub-img');
            const subTitle = chip.getAttribute('data-sub-title');
            const subTag = chip.getAttribute('data-sub-tag');
            const subHref = chip.getAttribute('data-sub-href');

            if (imgEl && subImg && imgEl.src !== subImg) {
              imgEl.style.opacity = '0.6';
              setTimeout(() => {
                imgEl.src = subImg;
                imgEl.style.opacity = '1';
              }, 120);
            }

            if (badgeEl && subTag) {
              badgeEl.textContent = subTag;
            }

            if (titleEl && subTitle) {
              titleEl.textContent = subTitle;
            }

            if (btnText && subTitle) {
              btnText.textContent = `Open ${subTitle} Page`;
            }

            if (subHref) {
              card.setAttribute('data-href', subHref);
              if (actionBtn) {
                actionBtn.href = subHref;
              }
            }
          });

          // Click on chip: direct instant navigation
          chip.addEventListener('click', (e) => {
            e.stopPropagation();
            const subHref = chip.getAttribute('data-sub-href') || chip.getAttribute('href');
            if (subHref) {
              window.location.href = subHref;
            }
          });
        });

        // When mouse leaves the subcategory chips area, smoothly restore defaults
        const chipsBox = card.querySelector('.subcategories-interactive-box');
        if (chipsBox) {
          chipsBox.addEventListener('mouseleave', () => {
            chips.forEach(c => c.classList.remove('active-subcat-chip'));

            if (imgEl && defaultImg && !imgEl.src.endsWith(defaultImg)) {
              imgEl.style.opacity = '0.7';
              setTimeout(() => {
                imgEl.src = defaultImg;
                imgEl.style.opacity = '1';
              }, 150);
            }

            if (badgeEl && defaultTag) {
              badgeEl.textContent = defaultTag;
            }

            if (titleEl && defaultTag) {
              titleEl.textContent = defaultTag;
            }

            if (btnText && defaultCta) {
              btnText.textContent = defaultCta;
            }

            card.setAttribute('data-href', defaultHref);
            if (actionBtn) {
              actionBtn.href = defaultHref;
            }
          });
        }

        // Clicking anywhere on the card navigates to currently active data-href
        card.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (target.closest('a') || target.closest('button')) {
            return;
          }
          const activeHref = card.getAttribute('data-href') || defaultHref;
          if (activeHref) {
            window.location.href = activeHref;
          }
        });
      });
    }

    document.addEventListener('DOMContentLoaded', initDynamicSubcategoryCards);
    document.addEventListener('astro:page-load', initDynamicSubcategoryCards);
  </script>
