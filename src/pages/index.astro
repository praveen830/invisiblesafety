---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SolutionsAccordion from '../components/SolutionsAccordion.astro';
import FAQSection from '../components/FAQSection.astro';
import VisualizerIsland from '../components/react/VisualizerIsland';
import BeforeAfterSlider from '../components/react/BeforeAfterSlider';
import CostEstimator from '../components/react/CostEstimator';
import { business } from '../data/business';
import { getLocalBusinessSchema, getFAQSchema } from '../utils/seo';
import {
  ShieldCheck,
  Wrench,
  Ruler,
  Award,
  ArrowRight,
  Phone,
  Sparkles
} from 'lucide-react';

const localBusinessSchema = getLocalBusinessSchema();
const faqSchema = getFAQSchema([
  {
    question: "What are invisible grills made of?",
    answer: "Our invisible grills are constructed from virgin SS316 marine-grade stainless steel cables with a transparent protective nylon coating, mounted into powder-coated structural aluminium tracks."
  },
  {
    question: "Are invisible grills permitted by apartment society RWAs?",
    answer: "Yes, apartment societies and gated communities widely approve invisible grills because they maintain building elevation uniformity and do not look like protruding iron cages."
  },
  {
    question: "How long does site measurement and installation take?",
    answer: "Site measurement typically takes 30-45 minutes. Once dimensions are confirmed, standard balcony installation is completed in 3 to 5 hours by our trained technicians."
  }
]);

const craftsmanshipPillars = [
  {
    icon: ShieldCheck,
    title: "SS316 Marine Grade",
    desc: "Genuine AISI 316 austenitic stainless steel with molybdenum to resist corrosion in coastal and monsoon conditions."
  },
  {
    icon: Award,
    title: "400+ kgf Tensile Strength",
    desc: "High-breaking load capacity engineered to prevent accidental falls while preserving 98% visual clarity."
  },
  {
    icon: Ruler,
    title: "Laser Precision Survey",
    desc: "Complimentary doorstep site measurement with physical wire samples and structural surface alignment."
  },
  {
    icon: Wrench,
    title: "10-Year Direct Guarantee",
    desc: "Written warranty documentation covering cable tension, track finish, and structural anchor integrity."
  }
];
---

<BaseLayout
  title="Invisible Safety | Ultra-Luxury Invisible Grills & Safety Solutions"
  description="Editorial-grade architectural invisible grills and certified safety net systems for luxury residences, high-rise penthouses, and modern apartments."
  canonicalUrl="/"
  schema={[localBusinessSchema, faqSchema]}
>
  <!-- 1. Full-Bleed Editorial Hero (100dvh) -->
  <Hero />

  <!-- 2. Viewport-Driven Full-Bleed Collections Feed (100dvh Per Space) -->
  <SolutionsAccordion />

  <!-- 3. Interactive Visualizer: Open vs Protected Balcony -->
  <section class="editorial-visualizer-section">
    <div class="editorial-section-container">
      <div class="editorial-section-header">
        <span class="editorial-eyebrow">THE ARCHITECTURAL DIFFERENCE</span>
        <h2 class="editorial-title">Before &amp; After Installation</h2>
        <p class="editorial-subtitle">
          Experience how invisible tensile cables secure open balconies without obstructing skyline panoramas.
        </p>
      </div>

      <div class="visualizer-wrapper">
        <BeforeAfterSlider client:visible />
      </div>
    </div>
  </section>

  <!-- 4. Interactive Space Visualizer -->
  <section class="editorial-planner-section" id="visualize">
    <div class="editorial-section-container">
      <div class="editorial-section-header">
        <span class="editorial-eyebrow">INTERACTIVE PLANNING</span>
        <h2 class="editorial-title">Visualize Your Space</h2>
        <p class="editorial-subtitle">
          Preview cable pitch and aesthetic integration across various residential layouts.
        </p>
      </div>

      <div class="visualizer-island-wrapper">
        <VisualizerIsland client:visible />
      </div>
    </div>
  </section>

  <!-- 5. Interactive Cost & Area Estimator -->
  <section class="editorial-calculator-section" id="estimate">
    <div class="editorial-section-container">
      <div class="editorial-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Your Balcony Quote</h2>
        <p class="editorial-subtitle">
          Select your product type, approximate dimensions, and city for an instant custom measurement quote.
        </p>
      </div>

      <div class="cost-estimator-wrapper">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <!-- 6. Minimalist Craftsmanship & Engineering Standards -->
  <section class="editorial-standards-section">
    <div class="editorial-section-container">
      <div class="editorial-section-header">
        <span class="editorial-eyebrow">UNCOMPROMISING METALLURGY</span>
        <h2 class="editorial-title">Craftsmanship &amp; Engineering</h2>
        <p class="editorial-subtitle">
          Engineered for architectural harmony, safety integrity, and lifetime durability.
        </p>
      </div>

      <div class="editorial-pillars-grid">
        {craftsmanshipPillars.map((pillar) => (
          <div class="editorial-pillar-card">
            <div class="pillar-icon-box">
              <pillar.icon size={20} strokeWidth={1.75} />
            </div>
            <h3 class="pillar-title">{pillar.title}</h3>
            <p class="pillar-desc">{pillar.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Essential Residential FAQ -->
  <FAQSection />

  <!-- 7. Minimalist Concierge Survey Invitation -->
  <section class="editorial-concierge-strip">
    <div class="editorial-section-container">
      <div class="concierge-editorial-box">
        <span class="concierge-eyebrow">COMPLIMENTARY CONSULTATION</span>
        <h2 class="concierge-title">Schedule Doorstep Laser Measurement</h2>
        <p class="concierge-desc">
          Our structural engineer will visit your residence with physical SS316 wire samples, inspect anchoring surfaces, and provide a clear quotation.
        </p>
        <div class="concierge-actions">
          <a href="/contact/#quote" class="btn-editorial-solid">
            <span>REQUEST SITE SURVEY</span>
          </a>
          <a href={`tel:${business.phoneRaw}`} class="btn-editorial-outline">
            <Phone size={14} />
            <span>Call: {business.phone}</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* =========================================================================
     EDITORIAL SECTIONS STYLING
     ========================================================================= */
  .editorial-visualizer-section,
  .editorial-planner-section,
  .editorial-calculator-section,
  .editorial-standards-section,
  .editorial-concierge-strip {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 7vw, 6rem) 0;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .editorial-section-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 3.5vw, 2.5rem);
    box-sizing: border-box;
  }

  .editorial-section-header {
    text-align: center;
    max-width: 740px;
    margin: 0 auto clamp(2rem, 4vw, 3.5rem) auto;
  }

  .editorial-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--color-gold, #C5A880);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.75rem;
  }

  .editorial-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: clamp(1.75rem, 3.5vw, 2.8rem);
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #FFFFFF;
    text-transform: uppercase;
    margin: 0 0 0.85rem 0;
    line-height: 1.2;
  }

  .editorial-subtitle {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-style: italic;
    font-size: clamp(0.95rem, 1.25vw, 1.15rem);
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .visualizer-wrapper,
  .visualizer-island-wrapper {
    max-width: 1080px;
    margin: 0 auto;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .cost-estimator-wrapper {
    max-width: 920px;
    margin: 0 auto;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
  }

  /* Pillars Grid */
  .editorial-pillars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 1024px) {
    .editorial-pillars-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 580px) {
    .editorial-pillars-grid {
      grid-template-columns: 1fr;
    }
  }

  .editorial-pillar-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: all 0.3s ease;
  }

  .editorial-pillar-card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .pillar-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-gold, #C5A880);
    margin-bottom: 1.25rem;
  }

  .pillar-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.5rem 0;
  }

  .pillar-desc {
    font-size: 0.85rem;
    color: #94A3B8;
    line-height: 1.55;
    margin: 0;
  }

  /* Concierge Box */
  .concierge-editorial-box {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 4vw, 3rem);
  }

  .concierge-eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--color-gold, #C5A880);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.85rem;
  }

  .concierge-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #FFFFFF;
    text-transform: uppercase;
    margin: 0 0 1rem 0;
    line-height: 1.25;
  }

  .concierge-desc {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-style: italic;
    font-size: clamp(0.95rem, 1.2vw, 1.15rem);
    color: #CBD5E1;
    line-height: 1.6;
    margin: 0 auto 2rem auto;
    max-width: 620px;
  }

  .concierge-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 580px) {
    .concierge-actions {
      flex-direction: column;
      width: 100%;
    }

    .concierge-actions a {
      width: 100%;
    }
  }
</style>
