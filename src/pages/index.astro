  .services-mobile-btn-wrap {
    display: none;
    margin-top: 1.5rem;
    text-align: center;
  }

  @media (max-width: 767px) {
    .services-mobile-btn-wrap {
      display: block;
    }
  }

  .services-mobile-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 12px 16px;
    border-radius: 12px;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    color: #0F233D;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 1px 3px rgba(15, 35, 61, 0.05);
  }

  /* Section 2B: Why Us Trust Strip */
  .why-us-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 1024px) {
    .why-us-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  @media (max-width: 640px) {
    .why-us-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
    .why-pillar-last {
      grid-column: span 2;
    }
  }

  .why-pillar-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.3s ease;
  }

  .why-pillar-card:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .why-pillar-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .why-pillar-title {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.35rem 0;
    line-height: 1.3;
  }

  .why-pillar-subtitle {
    font-size: 0.78rem;
    color: #CBD5E1;
    margin: 0;
    line-height: 1.45;
  }

  /* =========================================================================
     SECTION 3: INTERACTIVE 3D BALCONY VISUALIZER & COST ESTIMATOR
     ========================================================================= */
  .section-interactive {
    background-color: #F0F5FA;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid #E2E8F0;
  }

  .interactive-split-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .interactive-tool-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 20px;
    padding: clamp(1.25rem, 3vw, 2rem);
    box-shadow: 0 4px 20px -2px rgba(26, 54, 93, 0.06), 0 2px 6px -1px rgba(26, 54, 93, 0.04);
  }

  .tool-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .tool-step-badge {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #C6A66B;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.25rem;
  }

  .tool-card-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: #1A365D;
    line-height: 1.25;
    margin: 0;
  }

  .tool-live-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #EBF4FA;
