---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import VisualizerIsland from '../components/react/VisualizerIsland';
import CostEstimator from '../components/react/CostEstimator';
import { business } from '../data/business';
import { getLocalBusinessSchema, getFAQSchema } from '../utils/seo';
import {
  Ruler,
  CheckCircle2,
  ArrowRight,
  Phone,
  MessageCircle,
  Check,
  Layers,
  Cpu,
  MapPin,
  Calendar,
  Sparkles
} from 'lucide-react';

const localBusinessSchema = getLocalBusinessSchema();
const faqSchema = getFAQSchema([
  {
    question: "What are invisible grills made of?",
    answer: "Our invisible grills are constructed from virgin Japanese SS316 marine-grade stainless steel cables with 2.5% Molybdenum and a transparent protective DuPont nylon coating, mounted into 6063-T6 powder-coated structural aluminium tracks."
  },
  {
    question: "Are invisible grills permitted by apartment society RWAs?",
    answer: "Yes! High-rise gated communities and RWAs (including Aparna, My Home, Prestige, and Sobha) widely approve invisible grills because they maintain building elevation uniformity, do not alter exterior facades, and preserve architectural harmony."
  },
  {
    question: "How long does site measurement and installation take?",
    answer: "Doorstep laser site measurement takes 30-45 minutes. Once confirmed, standard balcony installation is completed in 3 to 5 hours by our certified in-house technicians."
  },
  {
    question: "Can cables be severed during a fire emergency?",
    answer: "Yes. While invisible grills cannot be cut by children or pets, they can be severed in seconds using standard wire cutters in an emergency evacuation, complying fully with fire safety standards."
  }
]);

const metroCities = [
  {
    name: "Hyderabad & Secunderabad",
    hubType: "Central Operations Hub",
    href: "/locations/hyderabad/",
    tag: "Same-Day Survey",
    localities: ["Financial District", "Gachibowli", "HITEC City", "Kokapet", "Kondapur", "Tellapur"],
    desc: "Elevation-compliant SS316 invisible grills and child safety nets for western IT corridor high-rise towers."
  },
  {
    name: "Visakhapatnam (Vizag)",
    hubType: "Coastal Corridor Hub",
    href: "/locations/visakhapatnam/",
    tag: "Marine Grade SS316",
    localities: ["Beach Road", "MVP Colony", "Madhurawada", "Rushikonda", "Seethammadhara", "Siripuram"],
    desc: "Molybdenum-enriched AISI 316 invisible grills engineered to withstand coastal salt spray and high humidity."
  },
  {
    name: "Vijayawada",
    hubType: "Andhra Urban Hub",
    href: "/locations/vijayawada/",
    tag: "High-Airflow Safety",
    localities: ["Benz Circle", "Patamata", "Labbipet", "Kanuru", "Poranki", "Moghalrajpuram"],
    desc: "Child fall-protection and humane anti-pigeon netting engineered for maximum summer cross-ventilation."
  },
  {
    name: "Bengaluru",
    hubType: "Karnataka Metro Hub",
    href: "/locations/",
    tag: "Tech Corridor Fleet",
    localities: ["Whitefield", "Electronic City", "Sarjapur Road", "Bellandur", "Hebbal", "HSR Layout"],
    desc: "Certified invisible grills and anti-bird barriers for high-rise towers across Prestige, Sobha, and Godrej societies."
  },
  {
    name: "Chennai",
    hubType: "Tamil Nadu Coastal Hub",
    href: "/locations/",
    tag: "Anti-Corrosion Tech",
    localities: ["OMR Expressway", "ECR", "Anna Nagar", "Adyar", "Velachery", "Porur"],
    desc: "Corrosion-proof SS316 invisible grills and pigeon netting built for high tropical heat and maritime monsoon corridors."
  },
  {
    name: "Kochi",
    hubType: "Kerala Coastal Hub",
    href: "/locations/",
    tag: "Monsoon Resilient",
    localities: ["Marine Drive", "Kakkanad InfoPark", "Edappally", "Panampilly Nagar", "Aluva"],
    desc: "Monsoon-tested balcony safety netting and tensile cable architecture for waterfront luxury apartments."
  }
];
---

<BaseLayout
  title="Invisible Safety | Architectural SS316 Invisible Grills & Safety Nets"
  description="South India's premier specialist in architectural SS316 marine-grade invisible grills, certified Garware safety nets, and smart ceiling cloth drying hangers."
  canonicalUrl="/"
  schema={[localBusinessSchema, faqSchema]}
>
  <!-- =========================================================================
       SECTION 1: HERO & INSTANT TRUST BAR
       ========================================================================= -->
  <Hero />

  <!-- =========================================================================
       SECTION 2: CORE 3-PILLAR SERVICE SHOWCASE
       ========================================================================= -->
  <section class="section-showcase" id="services">
    <div class="arch-container">
      <div class="section-title-box">
        <span class="arch-eyebrow">CORE ARCHITECTURAL PILLARS</span>
        <h2 class="arch-heading">Three Certified Safety Verticals</h2>
        <p class="arch-lead">
          Precision-engineered safety solutions designed specifically for South Indian residential towers, high-rise penthouses, and gated luxury communities.
        </p>
      </div>

      <div class="pillars-showcase-grid">
        <!-- Pillar 1: SS316 Marine-Grade Invisible Grills -->
        <div class="pillar-card">
          <div class="pillar-media-frame">
            <img
              src="/images/category-invisible-grills.jpg"
              alt="SS316 Marine-Grade Balcony Invisible Grills"
              class="pillar-image"
              loading="lazy"
              width="600"
              height="400"
            />
            <span class="pillar-badge badge-gold">PILLAR 1: FLAGSHIP SAFETY</span>
          </div>

          <div class="pillar-body">
            <h3 class="pillar-title">SS316 Marine-Grade Invisible Grills</h3>
            <p class="pillar-desc">
              Parallel vertical high-tensile SS316 marine cables anchored into structural aluminium tracks, delivering 98% daylight clarity with uncompromising fall protection.
            </p>

            <div class="pillar-specs-box">
              <div class="spec-bullet">
                <CheckCircle2 size={16} className="bullet-icon text-gold" />
                <span>Virgin Japanese AISI 316 Steel with 2.5% Molybdenum</span>
              </div>
              <div class="spec-bullet">
                <CheckCircle2 size={16} className="bullet-icon text-gold" />
                <span>400+ kgf tensile breaking strength per cable</span>
              </div>
              <div class="spec-bullet">
                <CheckCircle2 size={16} className="bullet-icon text-gold" />
                <span>6063-T6 powder-coated structural aluminium track</span>
              </div>
              <div class="spec-bullet">
                <CheckCircle2 size={16} className="bullet-icon text-gold" />
                <span>15-Year Direct Written Guarantee</span>
              </div>
            </div>

            <div class="pillar-sublinks">
              <span class="sublinks-label">Available Applications:</span>
              <div class="sublinks-cluster">
                <a href="/invisible-grills/">Balcony Grills</a>
                <span class="dot">·</span>
                <a href="/window-invisible-grills/">Window Grills</a>
                <span class="dot">·</span>
                <a href="/staircase-invisible-grills/">Staircase Grills</a>
                <span class="dot">·</span>
                <a href="/child-safety-invisible-grills/">50mm Spacing</a>
              </div>
            </div>

            <div class="pillar-action-row">
              <a href="/invisible-grills/" class="btn-pillar-primary">
                <span>Explore Invisible Grills</span>
                <ArrowRight size={14} />
              </a>
              <a
                href={`https://wa.me/${business.whatsapp}?text=Hello%20Invisible%20Safety%2C%20I%20am%20interested%20in%20a%20quote%20for%20SS316%20Invisible%20Grills.`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-pillar-whatsapp"
                aria-label="WhatsApp Quote for Invisible Grills"
              >
                <MessageCircle size={16} />
                <span>Quote</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Pillar 2: Balcony & Anti-Pigeon Safety Nets -->
        <div class="pillar-card">
          <div class="pillar-media-frame">
            <picture>
              <source srcset="/images/safety-net-balcony.webp" type="image/webp" />
              <img
                src="/images/safety-net-balcony.jpg"
                alt="High-Rise Balcony Safety Nets and Anti-Pigeon Solutions"
                class="pillar-image"
                loading="lazy"
                width="600"
                height="400"
              />
            </picture>
            <span class="pillar-badge badge-blue">PILLAR 2: CERTIFIED HDPE</span>
          </div>

          <div class="pillar-body">
            <h3 class="pillar-title">Balcony &amp; Anti-Pigeon Safety Nets</h3>
            <p class="pillar-desc">
              100% Virgin Garware high-density polyethylene netting and stainless steel spikes delivering complete child safety and humane pigeon exclusion without trapping birds.
            </p>

            <div class="pillar-specs-box">
              <div class="spec-bullet">
                <CheckCircle2 size={16} className="bullet-icon text-blue" />
                <span>100% Virgin Garware HDPE polymer with UV stabilization</span>
              </div>
              <div class="spec-bullet">
                <CheckCircle2 size={16} className="bullet-icon text-blue" />
                <span>Translucent monofilament preserves daylight &amp; breezes</span>
              </div>
              <div class="spec-bullet">
                <CheckCircle2 size={16} className="bullet-icon text-blue" />
                <span>Zero bird droppings, respiratory allergens, or pigeon roosts</span>
              </div>
              <div class="spec-bullet">
                <CheckCircle2 size={16} className="bullet-icon text-blue" />
                <span>5-Year Weatherproof Durability Guarantee</span>
              </div>
            </div>

            <div class="pillar-sublinks">
              <span class="sublinks-label">Available Applications:</span>
              <div class="sublinks-cluster">
                <a href="/safety-nets/">Balcony Nets</a>
                <span class="dot">·</span>
                <a href="/pigeon-nets/">Pigeon Deterrence</a>
                <span class="dot">·</span>
                <a href="/bird-spikes/">SS304 Spikes</a>
                <span class="dot">·</span>
                <a href="/child-safety-nets/">Child Fall Nets</a>
              </div>
            </div>

            <div class="pillar-action-row">
              <a href="/safety-nets/" class="btn-pillar-primary">
                <span>Explore Safety Nets</span>
                <ArrowRight size={14} />
              </a>
              <a
                href={`https://wa.me/${business.whatsapp}?text=Hello%20Invisible%20Safety%2C%20I%20am%20interested%20in%20a%20quote%20for%20Safety%20Nets.`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-pillar-whatsapp"
                aria-label="WhatsApp Quote for Safety Nets"
              >
                <MessageCircle size={16} />
                <span>Quote</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Pillar 3: Smart Ceiling Cloth Drying Hangers -->
        <div class="pillar-card">
          <div class="pillar-media-frame">
            <img
              src="/images/cloth-drying-hanger.jpg"
              alt="Smart Ceiling Mounted Cloth Drying Hangers"
              class="pillar-image"
              loading="lazy"
              width="600"
              height="400"
            />
            <span class="pillar-badge badge-peach">PILLAR 3: SPACE RECLAMATION</span>
          </div>

          <div class="pillar-body">
            <h3 class="pillar-title">Smart Ceiling Cloth Drying Hangers</h3>
            <p class="pillar-desc">
              Individual pull-down stainless steel ceiling drying pipes engineered with smooth dual nylon pulleys that reclaim 100% usable balcony and utility floor space.
            </p>

            <div class="pillar-specs-box">
              <div class="spec-bullet">
                <CheckCircle2 size={16} className="bullet-icon text-peach" />
                <span>100% Rust-proof heavy-gauge stainless steel tubes</span>
              </div>
              <div class="spec-bullet">
                <CheckCircle2 size={16} className="bullet-icon text-peach" />
                <span>Dual nylon pulley mechanism with high-tensile cords</span>
              </div>
              <div class="spec-bullet">
                <CheckCircle2 size={16} className="bullet-icon text-peach" />
                <span>5 kg wet weight capacity per individual pipe (up to 30 kg)</span>
              </div>
              <div class="spec-bullet">
                <CheckCircle2 size={16} className="bullet-icon text-peach" />
                <span>3-Year Mechanical Smooth-Glide Guarantee</span>
              </div>
            </div>

            <div class="pillar-sublinks">
              <span class="sublinks-label">Available Applications:</span>
              <div class="sublinks-cluster">
                <a href="/cloth-drying-hangers/">Ceiling Pull-Down Racks</a>
                <span class="dot">·</span>
                <a href="/cloth-drying-hangers/#utility">Balcony Utility Spaces</a>
              </div>
            </div>

            <div class="pillar-action-row">
              <a href="/cloth-drying-hangers/" class="btn-pillar-primary">
                <span>Explore Cloth Hangers</span>
                <ArrowRight size={14} />
              </a>
              <a
                href={`https://wa.me/${business.whatsapp}?text=Hello%20Invisible%20Safety%2C%20I%20am%20interested%20in%20Ceiling%20Cloth%20Drying%20Hangers.`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-pillar-whatsapp"
                aria-label="WhatsApp Quote for Cloth Drying Hangers"
              >
                <MessageCircle size={16} />
                <span>Quote</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 3: INTERACTIVE 3D BALCONY VISUALIZER & LIVE COST ESTIMATOR
       ========================================================================= -->
  <section class="section-interactive" id="interactive-planner">
    <div class="arch-container">
      <div class="section-title-box">
        <span class="arch-eyebrow">UNIFIED BALCONY LAB</span>
        <h2 class="arch-heading">Interactive 3D Visualizer &amp; Dynamic Cost Estimator</h2>
        <p class="arch-lead">
          Preview cable pitch and aesthetic integration across realistic high-rise layouts, then calibrate your exact balcony dimensions for an instant sq.ft. quotation.
        </p>
      </div>

      <div class="interactive-split-grid">
        <!-- Left: 3D Balcony Visualizer Island -->
        <div class="interactive-tool-card" id="visualize">
          <div class="tool-card-header">
            <div>
              <span class="tool-step-badge">STEP 1: PREVIEW AESTHETIC</span>
              <h3 class="tool-card-title">Interactive 3D Balcony Visualizer</h3>
            </div>
            <div class="tool-live-pill">
              <Sparkles size={14} />
              <span>Interactive Space View</span>
            </div>
          </div>
          <p class="tool-card-caption">
            Simulate 50mm child-safe vs. 75mm panoramic cable pitch across daylight, twilight, and architectural balcony layouts.
          </p>
          <div class="tool-island-wrapper">
            <VisualizerIsland client:visible />
          </div>
        </div>

        <!-- Right: Dynamic Cost & Sq.Ft. Estimator -->
        <div class="interactive-tool-card" id="estimate">
          <div class="tool-card-header">
            <div>
              <span class="tool-step-badge">STEP 2: INSTANT CALIBRATION</span>
              <h3 class="tool-card-title">Dynamic Sq.Ft. Cost Estimator</h3>
            </div>
            <div class="tool-live-pill">
              <Ruler size={14} />
              <span>Live Quote Engine</span>
            </div>
          </div>
          <p class="tool-card-caption">
            Select product type, approximate balcony dimensions, and city for an instant custom quote sent directly to WhatsApp.
          </p>
          <div class="tool-island-wrapper">
            <CostEstimator client:visible />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 4: ENGINEERING & SAFETY SPECIFICATIONS
       ========================================================================= -->
  <section class="section-engineering" id="engineering-specs">
    <div class="arch-container">
      <div class="section-title-box">
        <span class="arch-eyebrow">METALLURGICAL RIGOUR &amp; POLYMER SCIENCE</span>
        <h2 class="arch-heading">Engineering &amp; Safety Specifications</h2>
        <p class="arch-lead">
          Compare the metallurgical and material engineering behind our SS316 molybdenum marine steel invisible grills vs. UV-stabilized virgin Garware HDPE safety nets.
        </p>
      </div>

      <!-- Two Deep Specification Breakdown Cards -->
      <div class="engineering-cards-grid">
        <!-- Card 1: SS316 Marine Invisible Grills -->
        <div class="eng-card">
          <div class="eng-card-header">
            <div class="eng-icon-box bg-gold-light">
              <Cpu size={24} className="text-gold-dark" />
            </div>
            <div>
              <span class="eng-badge">METALLURGY 01</span>
              <h3 class="eng-title">SS316 Marine-Grade Steel</h3>
            </div>
          </div>

          <div class="eng-specs-list">
            <div class="eng-spec-item">
              <span class="eng-spec-label">Core Alloy Composition:</span>
              <span class="eng-spec-val">Virgin AISI 316 (16-18% Cr, 10-14% Ni, 2-3% Molybdenum)</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Tensile Breaking Strength:</span>
              <span class="eng-spec-val">400+ kgf breaking load per individual cable strand</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Cable Core Architecture:</span>
              <span class="eng-spec-val">7×7 multi-strand core (49 micro-wires wound in counter-tension)</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Protective Sheathing:</span>
              <span class="eng-spec-val">DuPont Pure Nylon-12 transparent casing (UV &amp; scratch immune)</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Track Mounting Profile:</span>
              <span class="eng-spec-val">6063-T6 architectural powder-coated aluminium structural profile</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Corrosion Resistance:</span>
              <span class="eng-spec-val">100% rust-proof against coastal sea breeze &amp; hard water washes</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Direct Warranty Coverage:</span>
              <span class="eng-spec-val">15-Year Direct Written Guarantee against rust &amp; structural sag</span>
            </div>
          </div>
        </div>

        <!-- Card 2: UV-Stabilized Garware HDPE Safety Nets -->
        <div class="eng-card">
          <div class="eng-card-header">
            <div class="eng-icon-box bg-sky-light">
              <Layers size={24} className="text-sky-dark" />
            </div>
            <div>
              <span class="eng-badge">POLYMER 02</span>
              <h3 class="eng-title">Garware UV-Stabilized HDPE</h3>
            </div>
          </div>

          <div class="eng-specs-list">
            <div class="eng-spec-item">
              <span class="eng-spec-label">Polymer Grade:</span>
              <span class="eng-spec-val">100% Virgin High-Density Polyethylene (Garware Technical Fibres)</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Tensile Energy Absorption:</span>
              <span class="eng-spec-val">High elastic shock-absorption (cushions accidental toddler falls)</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Filament Construction:</span>
              <span class="eng-spec-val">0.7mm to 1.2mm multi-strand braided monofilament &amp; co-polymer</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">UV Stabilization Tech:</span>
              <span class="eng-spec-val">Carbon black &amp; hindered amine UV light stabilizers (anti-brittleness)</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Pigeon Exclusion Factor:</span>
              <span class="eng-spec-val">100% humane barrier without bird entanglement or feather entrapment</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Wind Resistance &amp; Drag:</span>
              <span class="eng-spec-val">99% aerodynamic wind passage (zero whistling or fluttering)</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Direct Warranty Coverage:</span>
              <span class="eng-spec-val">5-Year Weatherproof Guarantee against rotting &amp; UV degradation</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Direct Engineering Comparison Matrix Table -->
      <div class="matrix-table-wrap">
        <table class="engineering-matrix-table">
          <thead>
            <tr>
              <th class="matrix-th-feature">Engineering Specification</th>
              <th class="matrix-th-grill">SS316 Invisible Grills</th>
              <th class="matrix-th-net">Garware HDPE Safety Nets</th>
              <th class="matrix-th-old">Traditional MS Box Grills</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="feature-name">Tensile Breaking Strength</td>
              <td class="grill-val"><strong>400+ kgf</strong> per cable</td>
              <td class="net-val"><strong>180+ kgf</strong> impact absorption</td>
              <td class="old-val">Rigid welded joints (brittle welds)</td>
            </tr>
            <tr>
              <td class="feature-name">Daylight &amp; View Preservation</td>
              <td class="grill-val"><strong>98% Transparent</strong> (Skyline vista)</td>
              <td class="net-val"><strong>85–90%</strong> Translucent mesh</td>
              <td class="old-val">Blocks 40–60% natural light</td>
            </tr>
            <tr>
              <td class="feature-name">Coastal Salt &amp; Rust Resistance</td>
              <td class="grill-val"><strong>100% Rust-Proof</strong> (Molybdenum AISI 316)</td>
              <td class="net-val"><strong>Inert to salt</strong> (Zero rot or corrosion)</td>
              <td class="old-val">Severe rusting in 18–24 months</td>
            </tr>
            <tr>
              <td class="feature-name">Society Elevation Compliance</td>
              <td class="grill-val"><strong>100% Approved</strong> across all RWAs</td>
              <td class="net-val"><strong>Approved</strong> for balconies &amp; shafts</td>
              <td class="old-val">Frequently banned by RWA bylaws</td>
            </tr>
            <tr>
              <td class="feature-name">Emergency Fire Evacuation</td>
              <td class="grill-val"><strong>Cut in 10s</strong> with wire cutters</td>
              <td class="net-val"><strong>Cut in 5s</strong> with emergency shears</td>
              <td class="old-val">Traps residents (requires oxy-torch)</td>
            </tr>
            <tr>
              <td class="feature-name">Recommended Balcony Application</td>
              <td class="grill-val">Living room balconies &amp; French windows</td>
              <td class="net-val">Utility balconies, ducts &amp; AC ledges</td>
              <td class="old-val">Ground floor security grills only</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 5: SERVICE CITIES & LOCAL COVERAGE HUB
       ========================================================================= -->
  <section class="section-locations" id="service-locations">
    <div class="arch-container">
      <div class="section-title-box">
        <span class="arch-eyebrow">SOUTH INDIA METRO HUBS</span>
        <h2 class="arch-heading">Service Cities &amp; Local Coverage Hub</h2>
        <p class="arch-lead">
          Our certified in-house technician fleets deliver same-day doorstep laser measurements, physical cable demonstrations, and prompt installation across 6 major metropolitan regions.
        </p>
      </div>

      <div class="metro-cities-grid">
        {metroCities.map((city) => (
          <div class="city-card">
            <div class="city-card-header">
              <span class="city-hub-badge">{city.hubType}</span>
              <span class="city-feature-tag">{city.tag}</span>
            </div>

            <h3 class="city-card-title">{city.name}</h3>
            <p class="city-card-desc">{city.desc}</p>

            <div class="city-localities-wrap">
              <span class="localities-heading">Prime Service Zones:</span>
              <div class="localities-tags">
                {city.localities.map((loc) => (
                  <span class="locality-pill">{loc}</span>
                ))}
              </div>
            </div>

            <div class="city-action-row">
              <a href={city.href} class="city-details-link">
                <span>View Service Details</span>
                <ArrowRight size={13} />
              </a>
              <a
                href={`tel:${business.phoneRaw}`}
                class="city-call-btn"
                aria-label={`Call local technician in ${city.name}`}
              >
                <Phone size={13} />
                <span>Call Local Hub</span>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Additional Regional Service Footer Hub Note -->
      <div class="regional-coverage-banner">
        <div class="coverage-banner-content">
          <MapPin size={22} className="coverage-icon" />
          <div>
