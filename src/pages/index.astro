     ========================================================================= */
  @media (max-width: 1024px) {
    .interactive-split-grid {
      grid-template-columns: 1fr;
    }

    .engineering-cards-grid {
      grid-template-columns: 1fr;
    }

    .metro-cities-grid {
      grid-template-columns: 1fr 1fr;
    }

    .booking-channels-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .metro-cities-grid {
