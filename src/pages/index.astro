---

<BaseLayout
  title="Invisible Safety | Architectural SS316 Invisible Grills & Safety Nets"
  description="South India's premier specialist in architectural SS316 marine-grade invisible grills, certified Garware safety nets, and smart ceiling cloth drying hangers."
  canonicalUrl="/"
  schema={[localBusinessSchema, faqSchema]}
>
  <!-- =========================================================================
       SECTION 1: HERO & INSTANT TRUST BAR
       ========================================================================= -->
  <Hero />

  <!-- =========================================================================
       SECTION 2: CERTIFIED 7-SERVICE PHOTO-FIRST SHOWCASE
       ========================================================================= -->
  <section class="section-showcase" id="services">
    <div class="arch-container">
      <!-- Section Header -->
      <div class="services-header-row">
        <div class="services-header-text">
          <span class="arch-eyebrow">CORE ARCHITECTURAL PORTFOLIO</span>
          <h2 class="arch-heading">Our Safety Services</h2>
          <p class="arch-lead services-header-desc">
            Engineered fall protection and bird exclusion systems designed specifically for South Indian residential towers, high-rise penthouses, and gated communities.
          </p>
        </div>
        <div class="services-header-action">
          <a href="/solutions/" class="btn-explore-all">
            <span>Explore All Services</span>
            <ArrowRight size={14} className="text-[#C6A66B]" />
          </a>
        </div>
      </div>

      <!-- Full-Size Editorial Service Showcase: Desktop 1-col full-width, Mobile 2-col -->
      <div class="services-cards-grid">
        {coreServices.map((service) => (
          <a
            href={service.href}
            class="service-card"
            aria-label={`View ${service.title} details`}
          >
            <!-- Top Bar: Clean architectural header bar with title & category -->
            <div class="service-card-bar">
              <div class="service-card-bar-left">
                <div class="service-card-icon-box">
                  <service.icon size={18} />
                </div>
                <div class="service-card-title-group">
                  <span class="service-card-category">{service.category}</span>
                  <h3 class="service-card-title">{service.title}</h3>
                </div>
              </div>
              <div class="service-card-bar-right">
                <span class="service-card-tag-pill">{service.tag}</span>
                <span class="service-card-cta-label">Explore Details</span>
                <div class="service-card-arrow-box">
                  <ArrowRight size={15} />
                </div>
              </div>
            </div>

            <!-- Full-Size Media: Crisp 16:9 desktop, 4:5 mobile -->
            <div class="service-card-media">
              <picture>
                <source
                  media="(max-width: 767px)"
                  srcset={service.mobileImage}
                  type="image/webp"
                  width={service.mobileWidth}
                  height={service.mobileHeight}
                />
                <source
                  media="(min-width: 768px)"
                  srcset={service.image}
                  type="image/webp"
                  width={service.width}
                  height={service.height}
                />
                <img
                  src={service.image}
                  alt={service.alt}
                  class="service-card-img"
                  loading="lazy"
                  decoding="async"
                  width={service.width}
                  height={service.height}
                />
              </picture>
              <span class="service-card-tag-mobile">{service.tag}</span>
            </div>
          </a>
        ))}
      </div>

      <!-- Mobile Button: Explore All Services -->
      <div class="services-mobile-btn-wrap">
        <a href="/solutions/" class="services-mobile-btn">
          <span>Explore All 7 Services</span>
          <ArrowRight size={14} className="text-[#2D89EF]" />
        </a>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 2B: HIGH-CONTRAST NAVY TRUST STRIP (Why Choose Invisiblesafety.in?)
       ========================================================================= -->
  <section class="section-why-us bg-[#0F233D] text-white py-12 md:py-16" id="why-us">
    <div class="arch-container">
      <div class="text-center max-w-3xl mx-auto mb-8 md:mb-12">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-[#C6A66B] mb-2">
          WHY CHOOSE INVISIBLESAFETY.IN
        </span>
        <h2 class="font-brand text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight leading-tight">
          South India's Certified High-Rise Safety Leader
        </h2>
        <p class="text-slate-300 text-sm md:text-base mt-2 leading-relaxed">
          Over 15,000+ luxury apartments and penthouses protected with zero view obstruction and 100% elevation compliance.
        </p>
      </div>

      <!-- 5 Crisp Trust Pillars: 2-col compact on mobile (5th spans full width), 5-col on desktop -->
      <div class="why-us-grid">
        {whyChoosePillars.map((pillar, idx) => (
          <div class={`why-pillar-card ${idx === 4 ? 'why-pillar-last' : ''}`}>
            <div class="why-pillar-icon-box">
              <pillar.icon size={22} className={pillar.color === 'gold' ? 'text-[#C6A66B]' : 'text-[#2D89EF]'} />
            </div>
            <h3 class="why-pillar-title">
              {pillar.title}
            </h3>
            <p class="why-pillar-subtitle">
              {pillar.subtitle}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 3: INTERACTIVE 3D BALCONY VISUALIZER & LIVE COST ESTIMATOR
       ========================================================================= -->
  <section class="section-interactive bg-[#F0F5FA] py-12 md:py-16 border-b border-slate-200" id="interactive-planner">
    <div class="arch-container">
      <div class="text-center max-w-3xl mx-auto mb-8 md:mb-12">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-[#C6A66B] mb-2">
          UNIFIED BALCONY LAB
        </span>
        <h2 class="font-brand text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#0F233D] tracking-tight leading-tight">
          Interactive 3D Visualizer &amp; Dynamic Cost Estimator
        </h2>
        <p class="text-slate-600 text-sm md:text-base mt-2 leading-relaxed">
          Preview cable pitch and aesthetic integration across realistic high-rise layouts, then calibrate your exact balcony dimensions for an instant sq.ft. quotation.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-start">
        <!-- Left: 3D Balcony Visualizer Island -->
        <div class="rounded-3xl bg-white shadow-card border border-slate-100 p-5 md:p-8 flex flex-col justify-between" id="visualize">
          <div class="flex items-start justify-between gap-3 mb-3">
            <div>
              <span class="inline-block text-[11px] font-bold text-[#C6A66B] uppercase tracking-wider mb-1">
                STEP 1: PREVIEW AESTHETIC
              </span>
              <h3 class="text-lg md:text-xl font-bold text-[#0F233D]">
                Interactive 3D Balcony Visualizer
              </h3>
            </div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#F0F5FA] border border-[#2D89EF]/20 text-xs font-bold text-[#2D89EF] shrink-0">
              <Sparkles size={13} />
              <span>Interactive Space View</span>
            </div>
          </div>
          <p class="text-xs md:text-sm text-slate-500 mb-4 leading-relaxed">
            Simulate 50mm child-safe vs. 75mm panoramic cable pitch across daylight, twilight, and architectural balcony layouts.
          </p>
          <div class="w-full">
            <VisualizerIsland client:visible />
          </div>
        </div>

        <!-- Right: Dynamic Cost & Sq.Ft. Estimator -->
        <div class="rounded-3xl bg-white shadow-card border border-slate-100 p-5 md:p-8 flex flex-col justify-between" id="estimate">
          <div class="flex items-start justify-between gap-3 mb-3">
            <div>
              <span class="inline-block text-[11px] font-bold text-[#2D89EF] uppercase tracking-wider mb-1">
                STEP 2: INSTANT CALIBRATION
              </span>
              <h3 class="text-lg md:text-xl font-bold text-[#0F233D]">
                Dynamic Sq.Ft. Cost Estimator
              </h3>
            </div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FDF6EE] border border-[#C6A66B]/30 text-xs font-bold text-[#C6A66B] shrink-0">
              <Ruler size={13} />
              <span>Live Quote Engine</span>
            </div>
          </div>
          <p class="text-xs md:text-sm text-slate-500 mb-4 leading-relaxed">
            Select product type, approximate balcony dimensions, and city for an instant custom quote sent directly to WhatsApp.
          </p>
          <div class="w-full">
            <CostEstimator client:visible />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 4: ENGINEERING & SAFETY SPECIFICATIONS
       ========================================================================= -->
  <section class="section-engineering" id="engineering-specs">
    <div class="arch-container">
      <div class="section-title-box">
        <span class="arch-eyebrow">METALLURGICAL RIGOUR &amp; POLYMER SCIENCE</span>
        <h2 class="arch-heading">Engineering &amp; Safety Specifications</h2>
        <p class="arch-lead">
          Compare the metallurgical and material engineering behind our SS316 molybdenum marine steel invisible grills vs. UV-stabilized virgin Garware HDPE safety nets.
        </p>
      </div>

      <!-- Two Deep Specification Breakdown Cards -->
      <div class="engineering-cards-grid">
        <!-- Card 1: SS316 Marine Invisible Grills -->
        <div class="eng-card">
          <div class="eng-card-header">
            <div class="eng-icon-box bg-gold-light">
              <Cpu size={24} className="text-gold-dark" />
            </div>
            <div>
              <span class="eng-badge">METALLURGY 01</span>
              <h3 class="eng-title">SS316 Marine-Grade Steel</h3>
            </div>
          </div>

          <div class="eng-specs-list">
            <div class="eng-spec-item">
              <span class="eng-spec-label">Core Alloy Composition:</span>
              <span class="eng-spec-val">Virgin AISI 316 (16-18% Cr, 10-14% Ni, 2-3% Molybdenum)</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Tensile Breaking Strength:</span>
              <span class="eng-spec-val">400+ kgf breaking load per individual cable strand</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Cable Core Architecture:</span>
              <span class="eng-spec-val">7×7 multi-strand core (49 micro-wires wound in counter-tension)</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Protective Sheathing:</span>
              <span class="eng-spec-val">DuPont Pure Nylon-12 transparent casing (UV &amp; scratch immune)</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Track Mounting Profile:</span>
              <span class="eng-spec-val">6063-T6 architectural powder-coated aluminium structural profile</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Corrosion Resistance:</span>
              <span class="eng-spec-val">100% rust-proof against coastal sea breeze &amp; hard water washes</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Direct Warranty Coverage:</span>
              <span class="eng-spec-val">15-Year Direct Written Guarantee against rust &amp; structural sag</span>
            </div>
          </div>
        </div>

        <!-- Card 2: UV-Stabilized Garware HDPE Safety Nets -->
        <div class="eng-card">
          <div class="eng-card-header">
            <div class="eng-icon-box bg-sky-light">
              <Layers size={24} className="text-sky-dark" />
            </div>
            <div>
              <span class="eng-badge">POLYMER 02</span>
              <h3 class="eng-title">Garware UV-Stabilized HDPE</h3>
            </div>
          </div>

          <div class="eng-specs-list">
            <div class="eng-spec-item">
              <span class="eng-spec-label">Polymer Grade:</span>
              <span class="eng-spec-val">100% Virgin High-Density Polyethylene (Garware Technical Fibres)</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Tensile Energy Absorption:</span>
              <span class="eng-spec-val">High elastic shock-absorption (cushions accidental toddler falls)</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Filament Construction:</span>
              <span class="eng-spec-val">0.7mm to 1.2mm multi-strand braided monofilament &amp; co-polymer</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">UV Stabilization Tech:</span>
              <span class="eng-spec-val">Carbon black &amp; hindered amine UV light stabilizers (anti-brittleness)</span>
            </div>
            <div class="eng-spec-item">
              <span class="eng-spec-label">Pigeon Exclusion Factor:</span>
