  }

  /* =========================================================================
     SECTION 4: ENGINEERING & SAFETY SPECIFICATIONS
     ========================================================================= */
  .section-engineering {
    background-color: #F4F9FD;
    padding: clamp(4rem, 7vw, 6rem) 0;
    border-bottom: 1px solid #E2E8F0;
  }

  .engineering-cards-grid {
