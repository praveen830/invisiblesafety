---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import CostEstimator from '../components/react/CostEstimator';
import VisualizerIsland from '../components/react/VisualizerIsland';
import SolutionsAccordion from '../components/SolutionsAccordion.astro';
import { business } from '../data/business';
import { projects } from '../data/projects';
import { getLocalBusinessSchema, getFAQSchema } from '../utils/seo';
import {
  ShieldCheck,
  Sparkles,
  Phone,
  ArrowRight,
  CheckCircle,
  Eye,
  Activity,
  Layers,
  Award,
  FileText,
  Check,
  MapPin,
  Building2,
  Wrench,
  Search,
  Baby,
  Dog,
  Bird,
  Target,
  Shield,
  HardHat,
  ChevronRight,
  MessageCircle,
  Star,
  Clock,
  ExternalLink
} from 'lucide-react';

const localBusinessSchema = getLocalBusinessSchema();
const faqSchema = getFAQSchema([
  {
    question: "What are invisible grills and how are they engineered?",
    answer: "Invisible grills are high-tensile AISI 316 marine-grade stainless steel cables tested to withstand over 400 kgf tensile force, securing balconies, windows, and staircases while preserving 98% of natural skyline views."
  },
  {
    question: "Do apartment societies in Telangana and Andhra Pradesh approve invisible grills?",
    answer: "Yes, gated societies and RWAs approve InvisProtect systems because the cables are nearly invisible from street level, preserving building facade elevations without exterior iron cage protrusion."
  }
]);

// 05 Architectural Safety Systems (The 5 Main Parts)
const mainSystems = [
  {
    id: "system-invisible-grills",
    title: "SS316 Invisible Grills",
    eyebrow: "FLAGSHIP ARCHITECTURAL APERTURE · 70% PRIMARY FOCUS",
    tagline: "High-tensile Japanese AISI 316 marine-grade stainless steel cables tested to 400+ kgf tensile capacity. Engineered for modern high-rises to preserve 98% unobstructed panoramic skyline views with fire-escape safety.",
    image: "/images/hero-balcony.webp",
    badge: "Primary Specialty (70%)",
    badgeColor: "#0284C7",
    startingRate: "₹190 / sq.ft",
    warranty: "10-Year Direct Manufacturer Warranty",
    route: "/invisible-grills/",
    subCategories: [
      "Balcony Invisible Grills",
      "Staircase Invisible Grills",
      "Windows Invisible Grills",
      "Child Safety Invisible Grills"
    ],
    ctaText: "Explore Invisible Grills & 4 Sub-Categories"
  },
  {
    id: "system-core-safety-nets",
    title: "Core Safety Nets",
    eyebrow: "SYSTEM 02 · RESIDENTIAL FALL PROTECTION",
    tagline: "Certified high-density virgin Garware polymer netting engineered for whole-balcony anti-fall security, open multi-story stairwell voids, and tall building perimeter elevations.",
    image: "/images/safety-net-balcony.webp",
    badge: "Apartment Standard",
    badgeColor: "#15803D",
    startingRate: "₹25 / sq.ft",
    warranty: "3-Year Certified Anti-Sag Warranty",
    route: "/safety-nets/",
    subCategories: [
      "Balcony Safety Nets",
      "Children Safety Nets",
      "Staircase Safety Nets",
      "Building Safety Nets"
    ],
    ctaText: "Explore Core Safety Nets & 4 Sub-Categories"
  },
  {
    id: "system-animal-bird",
    title: "Animal & Bird Protection",
    eyebrow: "SYSTEM 03 · 100% HUMANE HYGIENE & PET SHIELD",
    tagline: "0.7mm translucent monofilament netting completely barring pigeons, mites, and acidic guano without blocking daylight, alongside reinforced anti-fall meshes for curious cats and dogs.",
    image: "/images/pigeon-net.webp",
    badge: "Humane & Invisible",
    badgeColor: "#16A34A",
    startingRate: "₹28 / sq.ft",
    warranty: "2 to 3-Year UV Protection",
    route: "/animals-birds-safety-nets/",
    subCategories: [
      "Anti-Pigeon Nets",
      "Bird Exclusion Nets",
      "Balcony Bird Nets",
      "Pet Protection Nets"
    ],
    ctaText: "Explore Animal & Bird Protection & 4 Sub-Categories"
  },
  {
    id: "system-construction-industrial",
    title: "Construction & Industrial Nets",
    eyebrow: "SYSTEM 04 · HEAVY DEBRIS & WORK SITE RIGGING",
    tagline: "Industrial-grade heavy-ply containment netting for high-rise scaffolding, multi-story utility air shafts, warehouse storage racks, open sky terrace decks, and vehicle parking lots.",
    image: "/images/construction-safety-net.jpg",
    badge: "Heavy-Duty Site Grade",
    badgeColor: "#D97706",
    startingRate: "₹22 / sq.ft",
    warranty: "3 to 5-Year Industrial Grade",
    route: "/duct-safety-nets/",
    subCategories: [
      "Construction Safety",
      "Industrial Safety Nets",
      "Terrace Top Nets",
      "Car Parking Safety Nets"
    ],
    ctaText: "Explore Construction & Industrial & 4 Sub-Categories"
  },
  {
    id: "system-specialty-solutions",
    title: "Specialty Solutions",
    eyebrow: "SYSTEM 05 · RECREATIONAL & DOMESTIC UTILITIES",
    tagline: "High-velocity ball containment enclosures for rooftop cricket turfs, heavy-ply coconut palm canopy nets, child-safe swimming pool covers, and ceiling-mounted balcony cloth drying pulley systems.",
    image: "/images/sports-nets.webp",
    badge: "Recreational & Utility",
    badgeColor: "#0284C7",
    startingRate: "₹18 / sq.ft",
    warranty: "3 to 5-Year High Impact",
    route: "/sports-nets/",
    subCategories: [
      "Sports Practice Nets",
      "Coconut Safety Nets",
      "Swimming Pool Nets",
      "Balcony Cloth Drying Hangers"
    ],
    ctaText: "Explore Specialty Solutions & 4 Sub-Categories"
  }
];
---

<BaseLayout
  title="InvisProtect | Architectural Safety Without Compromising the View"
  description="India's leading architectural safety company. Premium SS316 marine invisible grills (400+ kg load) and certified safety nets in Hyderabad, Vizag, and Vijayawada. 10-year direct warranty."
  canonicalUrl="/"
  schema={[localBusinessSchema, faqSchema]}
>
  <!-- 01. HEADER: Rendered via BaseLayout & Header.astro -->

  <!-- 02. HERO: Full-Width Architectural Background -->
  <Hero />

  <!-- 03. BRAND INTRODUCTION: Philosophy & Purpose -->
  <section class="section-spacing" style="background: #FFFFFF; border-bottom: 1px solid #E2E8F0;">
    <div class="container">
      <div style="max-width: 920px; margin: 0 auto; text-align: center;">
        <div style="font-size: 0.76rem; font-weight: 800; color: #C2410C; letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 0.75rem;">
          CORE BUSINESS POSITIONING
        </div>
        <h2 style="font-size: clamp(2rem, 3.8vw, 2.9rem); font-weight: 900; color: #0F172A; letter-spacing: -0.025em; line-height: 1.18; margin-bottom: 1.25rem;">
          Architectural Safety Without Compromising the View.
        </h2>
        <p style="font-size: 1.12rem; color: #475569; line-height: 1.7; margin-bottom: 2.5rem;">
          InvisProtect engineers sophisticated fall-prevention and perimeter safety systems for modern residential high-rises, commercial developments, and selected institutions across Telangana and Andhra Pradesh. We design protection around your space—blending certified metallurgical strength with total visual transparency.
        </p>

        <!-- Brand Philosophy Pillars (Architectural Design with Elevated UI Style) -->
        <div class="pillars-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1.15rem; text-align: center;">
          <!-- Pillar 1 -->
          <div class="pillar-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; border-top: 3px solid #0284C7; padding: 1.5rem 1rem; border-radius: 14px; box-shadow: 0 4px 15px rgba(2, 132, 199, 0.05); position: relative;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: #F0F9FF; border: 1px solid #BAE6FD; display: flex; align-items: center; justify-content: center; margin: 0 auto 0.85rem auto; color: #0284C7;">
              <ShieldCheck size={22} />
            </div>
            <div style="display: inline-block; font-size: 0.68rem; font-weight: 800; color: #0284C7; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.15rem 0.55rem; background: #F0F9FF; border-radius: 20px; margin-bottom: 0.35rem;">
              PILLAR 01
            </div>
            <div style="font-size: 1.05rem; font-weight: 900; color: #0F172A; letter-spacing: -0.01em;">SAFETY</div>
            <div style="font-size: 0.8rem; color: #64748B; margin-top: 0.35rem; font-weight: 500;">400+ kgf load tested</div>
          </div>

          <!-- Pillar 2 -->
          <div class="pillar-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; border-top: 3px solid #0284C7; padding: 1.5rem 1rem; border-radius: 14px; box-shadow: 0 4px 15px rgba(2, 132, 199, 0.05); position: relative;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: #F0F9FF; border: 1px solid #BAE6FD; display: flex; align-items: center; justify-content: center; margin: 0 auto 0.85rem auto; color: #0284C7;">
              <Eye size={22} />
            </div>
            <div style="display: inline-block; font-size: 0.68rem; font-weight: 800; color: #0284C7; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.15rem 0.55rem; background: #F0F9FF; border-radius: 20px; margin-bottom: 0.35rem;">
              PILLAR 02
            </div>
            <div style="font-size: 1.05rem; font-weight: 900; color: #0F172A; letter-spacing: -0.01em;">ARCHITECTURE</div>
            <div style="font-size: 0.8rem; color: #64748B; margin-top: 0.35rem; font-weight: 500;">Preserves facade elegance</div>
          </div>

          <!-- Pillar 3 -->
          <div class="pillar-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; border-top: 3px solid #0284C7; padding: 1.5rem 1rem; border-radius: 14px; box-shadow: 0 4px 15px rgba(2, 132, 199, 0.05); position: relative;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: #F0F9FF; border: 1px solid #BAE6FD; display: flex; align-items: center; justify-content: center; margin: 0 auto 0.85rem auto; color: #0284C7;">
              <Award size={22} />
            </div>
            <div style="display: inline-block; font-size: 0.68rem; font-weight: 800; color: #0284C7; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.15rem 0.55rem; background: #F0F9FF; border-radius: 20px; margin-bottom: 0.35rem;">
              PILLAR 03
            </div>
            <div style="font-size: 1.05rem; font-weight: 900; color: #0F172A; letter-spacing: -0.01em;">QUALITY</div>
            <div style="font-size: 0.8rem; color: #64748B; margin-top: 0.35rem; font-weight: 500;">Virgin Japanese SS316</div>
          </div>

          <!-- Pillar 4 -->
          <div class="pillar-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; border-top: 3px solid #0284C7; padding: 1.5rem 1rem; border-radius: 14px; box-shadow: 0 4px 15px rgba(2, 132, 199, 0.05); position: relative;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: #F0F9FF; border: 1px solid #BAE6FD; display: flex; align-items: center; justify-content: center; margin: 0 auto 0.85rem auto; color: #0284C7;">
              <Activity size={22} />
            </div>
            <div style="display: inline-block; font-size: 0.68rem; font-weight: 800; color: #0284C7; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.15rem 0.55rem; background: #F0F9FF; border-radius: 20px; margin-bottom: 0.35rem;">
              PILLAR 04
            </div>
            <div style="font-size: 1.05rem; font-weight: 900; color: #0F172A; letter-spacing: -0.01em;">FUNCTION</div>
            <div style="font-size: 0.8rem; color: #64748B; margin-top: 0.35rem; font-weight: 500;">Fire-evacuation safe</div>
          </div>

          <!-- Pillar 5 -->
          <div class="pillar-card" style="background: #FFFFFF; border: 1px solid #E2E8F0; border-top: 3px solid #0284C7; padding: 1.5rem 1rem; border-radius: 14px; box-shadow: 0 4px 15px rgba(2, 132, 199, 0.05); position: relative;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: #F0F9FF; border: 1px solid #BAE6FD; display: flex; align-items: center; justify-content: center; margin: 0 auto 0.85rem auto; color: #0284C7;">
              <Clock size={22} />
            </div>
            <div style="display: inline-block; font-size: 0.68rem; font-weight: 800; color: #0284C7; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.15rem 0.55rem; background: #F0F9FF; border-radius: 20px; margin-bottom: 0.35rem;">
              PILLAR 05
            </div>
            <div style="font-size: 1.05rem; font-weight: 900; color: #0F172A; letter-spacing: -0.01em;">SERVICE</div>
            <div style="font-size: 0.8rem; color: #64748B; margin-top: 0.35rem; font-weight: 500;">10-Year direct support</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 04. OUR 5 ARCHITECTURAL SAFETY SYSTEMS (The Main Parts Dashboard) -->
  <section class="section-spacing" style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0;" id="architectural-systems">
    <div class="container">
      <div class="section-header" style="max-width: 820px; margin: 0 auto 3rem auto; text-align: center;">
        <span class="badge-arch">PRIMARY SYSTEMS CATALOG</span>
        <h2 style="font-size: clamp(2rem, 3.8vw, 2.75rem); font-weight: 900; color: #0F172A; letter-spacing: -0.025em; margin-bottom: 0.75rem;">
          Our 5 Architectural Safety Systems
        </h2>
        <p style="font-size: 1.08rem; color: #475569; line-height: 1.65; margin: 0;">
          Select any core safety system below to navigate directly to its dedicated showcase and explore all specialized sub-categories, technical specifications, and instant quotes.
        </p>
      </div>

      <!-- SYSTEM 01: Flagship SS316 Invisible Grills (70% Emphasis) -->
      <div
        class="arch-card interactive-system-card"
        id="system-card-1"
        data-href="/invisible-grills/"
        data-default-img="/images/hero-balcony.webp"
        data-default-tag="Virgin Japanese SS316 Core Wire"
        data-default-href="/invisible-grills/"
        data-default-cta="Explore Invisible Grills & 4 Sub-Categories"
        style="background: #FFFFFF; border: 2px solid #0284C7; border-radius: 20px; overflow: hidden; margin-bottom: 2.5rem; box-shadow: 0 16px 40px rgba(2, 132, 199, 0.09); position: relative; cursor: pointer;"
      >
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); align-items: stretch;">
          <!-- Left: Information & Sub-Categories -->
          <div style="padding: 2.75rem 2.25rem; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.85rem;">
                <span style="font-size: 0.72rem; font-weight: 800; color: #0284C7; letter-spacing: 0.12em; text-transform: uppercase;">
                  SYSTEM 01 · PRIMARY FLAGSHIP SPECIALTY (70%)
                </span>
                <span style="background: #F0F9FF; border: 1px solid #BAE6FD; color: #0284C7; font-size: 0.72rem; font-weight: 800; padding: 0.2rem 0.6rem; border-radius: 20px;">
                  10-Year Direct Warranty
                </span>
              </div>

              <h3 style="font-size: clamp(1.85rem, 3vw, 2.4rem); font-weight: 900; color: #0F172A; letter-spacing: -0.02em; margin-bottom: 0.85rem; line-height: 1.2;">
                <a href="/invisible-grills/" class="card-title-link" style="text-decoration: none; color: inherit; transition: color 0.25s ease;">
                  SS316 Invisible Grills
                </a>
              </h3>

              <p style="font-size: 1rem; color: #475569; line-height: 1.65; margin-bottom: 1.5rem;">
                Precision-tensioned Japanese AISI 316 marine-grade stainless steel cables enclosed in transparent DuPont UV-stabilized nylon. Withstands 400+ kgf tensile force while preserving 98% unobstructed panoramic views.
              </p>

              <!-- Included Sub-Categories Section with Mouseover Interactive Preview & Direct Routing -->
              <div class="subcategories-interactive-box" style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 14px; padding: 1.15rem 1.25rem; margin-bottom: 1.75rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.65rem;">
                  <span style="font-size: 0.72rem; font-weight: 800; color: #64748B; letter-spacing: 0.08em; text-transform: uppercase;">
                    EXPLORE 4 SUB-CATEGORIES (MOUSE OVER TO PREVIEW):
                  </span>
                  <span class="hover-helper-hint" style="font-size: 0.7rem; color: #0284C7; font-weight: 600;">Hover & Click to Open</span>
                </div>
                <div class="subcat-chips-row" style="display: flex; flex-wrap: wrap; gap: 0.55rem;">
                  <a
                    href="/balcony-invisible-grills/"
                    class="subcat-link-chip"
                    data-sub-img="/images/hero-balcony.webp"
                    data-sub-title="Balcony Invisible Grills"
                    data-sub-tag="400+ kgf Load-Tested Balcony Rigging"
                    data-sub-href="/balcony-invisible-grills/"
                  >
                    <span>Balcony Invisible Grills</span>
                    <ArrowRight size={12} className="chip-arr" />
                  </a>
                  <a
                    href="/staircase-invisible-grills/"
                    class="subcat-link-chip"
                    data-sub-img="/images/staircase-invisible-grills.webp"
                    data-sub-title="Staircase Invisible Grills"
                    data-sub-tag="Duplex Vertical Tension Wire Shield"
                    data-sub-href="/staircase-invisible-grills/"
                  >
                    <span>Staircase Invisible Grills</span>
                    <ArrowRight size={12} className="chip-arr" />
                  </a>
                  <a
                    href="/window-invisible-grills/"
                    class="subcat-link-chip"
                    data-sub-img="/images/window-invisible-grills.webp"
                    data-sub-title="Windows Invisible Grills"
                    data-sub-tag="Zero Iron Cage Clutter • Clear Window Sight"
                    data-sub-href="/window-invisible-grills/"
                  >
                    <span>Windows Invisible Grills</span>
                    <ArrowRight size={12} className="chip-arr" />
                  </a>
                  <a
                    href="/child-safety-invisible-grills/"
                    class="subcat-link-chip"
                    data-sub-img="/images/child-safety.webp"
                    data-sub-title="Child Safety Invisible Grills"
                    data-sub-tag="50mm Anti-Entrapment Spacing with Zero-Climb"
                    data-sub-href="/child-safety-invisible-grills/"
                  >
                    <span>Child Safety Invisible Grills</span>
                    <ArrowRight size={12} className="chip-arr" />
                  </a>
                </div>
              </div>
            </div>

            <div>
              <div style="display: flex; align-items: baseline; gap: 1rem; margin-bottom: 1.25rem;">
                <div>
                  <span style="font-size: 0.75rem; color: #64748B; display: block; text-transform: uppercase; font-weight: 600;">Starting Rate:</span>
                  <span style="font-size: 1.6rem; font-weight: 900; color: #0284C7;">₹190 <span style="font-size: 0.88rem; color: #64748B; font-weight: 500;">/ sq.ft</span></span>
                </div>
                <div style="font-size: 0.82rem; color: #16A34A; font-weight: 700;">
                  ✓ Tested 400+ kg Breaking Load
                </div>
              </div>

              <div style="display: flex; gap: 0.85rem; flex-wrap: wrap;">
                <a href="/invisible-grills/" class="btn btn-primary card-action-btn" style="padding: 0.85rem 1.6rem;">
                  <span class="btn-text">Explore Invisible Grills & 4 Sub-Categories</span>
                  <ArrowRight size={16} />
                </a>
                <a href="/invisible-grill-cost/" class="btn btn-outline" style="padding: 0.85rem 1.4rem;">
                  <span>Instant Cost Estimator</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Right: Visual Masterpiece Showcase (Dynamic on Mouse Over) -->
          <a
            href="/invisible-grills/"
            class="system-card-image-link"
            style="position: relative; min-height: 340px; background: #0F172A; overflow: hidden; display: block; text-decoration: none;"
            aria-label="View Invisible Grills Showcase"
          >
            <img
              src="/images/hero-balcony.webp"
              alt="SS316 Marine Invisible Grills"
              style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.65s cubic-bezier(0.2, 0, 0, 1), opacity 0.35s ease;"
              class="hover-zoom-img card-showcase-img"
              loading="lazy"
            />
            <div style="position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(15, 23, 42, 0.85) 100%); pointer-events: none;"></div>
            <div style="position: absolute; bottom: 1.5rem; left: 1.5rem; right: 1.5rem; color: #FFFFFF; pointer-events: none;">
              <div style="font-size: 0.75rem; font-weight: 800; color: #38BDF8; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.25rem;">
                AEROSPACE ARCHITECTURAL RIGGING
              </div>
              <div class="card-showcase-title" style="font-size: 1.25rem; font-weight: 800; transition: color 0.3s ease;">
                Virgin Japanese SS316 Core Wire
              </div>
              <div class="card-showcase-desc" style="font-size: 0.82rem; color: #CBD5E1; margin-top: 0.25rem;">
                2.0mm & 2.5mm Tensile Strands • DuPont UV Protective Membrane
              </div>
            </div>
          </a>
        </div>
      </div>

      <!-- 2X2 GRID: SYSTEMS 02, 03, 04, 05 -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
        
        <!-- SYSTEM 02: Core Safety Nets -->
        <div
          class="arch-card interactive-system-card"
          id="system-card-2"
          data-href="/safety-nets/"
          data-default-img="/images/safety-net-balcony.webp"
          data-default-tag="Apartment Standard Fall Protection"
          data-default-href="/safety-nets/"
          data-default-cta="Explore Core Safety Nets & Sub-Categories"
          style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 18px; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 8px 24px rgba(0,0,0,0.04); cursor: pointer;"
        >
          <a href="/safety-nets/" class="system-card-image-link" style="position: relative; height: 210px; overflow: hidden; background: #F1F5F9; display: block;">
            <img
              src="/images/safety-net-balcony.webp"
              alt="Core Safety Nets"
              style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.65s cubic-bezier(0.2, 0, 0, 1), opacity 0.35s ease;"
              class="hover-zoom-img card-showcase-img"
              loading="lazy"
            />
            <div class="card-badge-chip" style="position: absolute; top: 12px; left: 12px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(6px); border: 1px solid #E2E8F0; padding: 0.25rem 0.65rem; border-radius: 6px; font-size: 0.72rem; font-weight: 700; color: #15803D; transition: all 0.3s ease;">
              Apartment Standard
            </div>
            <div style="position: absolute; bottom: 12px; right: 12px; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(6px); color: #FFFFFF; padding: 0.25rem 0.65rem; border-radius: 6px; font-size: 0.78rem; font-weight: 800;">
              From ₹25 / sq.ft
            </div>
          </a>

          <div style="padding: 1.75rem 1.5rem; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="font-size: 0.7rem; font-weight: 800; color: #15803D; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.35rem;">
                SYSTEM 02 · RESIDENTIAL FALL PROTECTION
              </div>
              <h3 style="font-size: 1.45rem; font-weight: 800; color: #0F172A; margin-bottom: 0.65rem;">
                <a href="/safety-nets/" class="card-title-link" style="text-decoration: none; color: inherit; transition: color 0.25s ease;">
                  Core Safety Nets
