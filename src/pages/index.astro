    background: #F0F5FA;
    color: #2D89EF;
    border: 1px solid rgba(45, 137, 239, 0.2);
  }

  .service-card-cta-label {
    display: none;
    font-size: 13px;
    font-weight: 600;
    color: #2D89EF;
    transition: color 0.2s ease;
  }

  @media (min-width: 1024px) {
    .service-card-cta-label {
      display: inline-block;
    }
  }

  @media (max-width: 767px) {
    .service-card-tag-pill {
      display: none;
    }
    .service-card-cta-label {
      display: none;
    }
  }

  .service-card:hover .service-card-cta-label {
    color: #0F233D;
  }

  .service-card-arrow-box {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #F8FAFC;
    color: #94A3B8;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  @media (max-width: 767px) {
    .service-card-arrow-box {
      width: 28px;
      height: 28px;
    }
  }

  .service-card:hover .service-card-arrow-box {
    background: #0F233D;
    color: #FFFFFF;
    transform: translateX(3px);
  }

  /* Media Container: 16:9 Full Desktop, 4:5 Mobile */
  .service-card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: #F1F5F9;
  }

  @media (max-width: 767px) {
    .service-card-media {
      aspect-ratio: 4 / 5;
    }
  }

  .service-card-media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .service-card-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-card:hover .service-card-img {
    transform: scale(1.025);
  }

  /* Mobile overlay tag */
  .service-card-tag-mobile {
    display: none;
  }

  @media (max-width: 767px) {
    .service-card-tag-mobile {
      display: block;
      position: absolute;
      top: 10px;
      left: 10px;
      background: rgba(15, 35, 61, 0.88);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      color: #FFFFFF;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: 6px;
      pointer-events: none;
      z-index: 2;
    }
