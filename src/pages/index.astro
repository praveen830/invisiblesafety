---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FAQSection from '../components/FAQSection.astro';
import CostEstimator from '../components/react/CostEstimator';
import VisualizerIsland from '../components/react/VisualizerIsland';
import BeforeAfterSlider from '../components/react/BeforeAfterSlider';
import { business } from '../data/business';
import { projects } from '../data/projects';
import { getLocalBusinessSchema, getFAQSchema } from '../utils/seo';
import {
  Shield,
  ShieldCheck,
  CheckCircle2,
  ArrowRight,
  MapPin,
  Phone,
  MessageCircle,
  Clock,
  Wrench,
  Ruler,
  FileText,
  Award,
  Layers,
  Sparkles,
  Building2,
  Home
} from 'lucide-react';

const localBusinessSchema = getLocalBusinessSchema();
const faqSchema = getFAQSchema([
  {
    question: "What are invisible grills made of?",
    answer: "Our invisible grills are constructed from virgin SS316 marine-grade stainless steel cables with a transparent protective nylon coating, mounted into powder-coated structural aluminium tracks."
  },
  {
    question: "Are invisible grills permitted by apartment society RWAs?",
    answer: "Yes, apartment societies and gated communities widely approve invisible grills because they maintain building elevation uniformity and do not look like protruding iron cages."
  },
  {
    question: "How long does site measurement and installation take?",
    answer: "Site measurement typically takes 30-45 minutes. Once dimensions are confirmed, standard balcony installation is completed in 3 to 5 hours by our trained technicians."
  }
]);

// 1. Primary Customer Journey Categories (What are you looking to protect?)
const protectionCategories = [
  {
    title: "Balconies",
    desc: "Discreet anti-fall protection preserving panoramic skyline views and natural cross-ventilation.",
    image: "/images/balcony-safety.webp",
    link: "/balcony-invisible-grills/",
    badge: "Most Popular"
  },
  {
    title: "Windows",
    desc: "Modern window protection for French doors and sliding glass windows without heavy iron bars.",
    image: "/images/window-invisible-grills.webp",
    link: "/window-invisible-grills/",
    badge: "Residential"
  },
  {
    title: "Staircases",
    desc: "Floor-to-ceiling vertical tension systems securing open internal stairwells in duplex homes.",
    image: "/images/staircase-invisible-grills.webp",
    link: "/staircase-invisible-grills/",
    badge: "Duplex & Villas"
  },
  {
    title: "Children Safety",
    desc: "Calibrated 50mm spacing preventing toddler climb, head entrapment, or toy drops.",
    image: "/images/child-safety.webp",
    link: "/child-safety-invisible-grills/",
    badge: "High-Priority"
  },
  {
    title: "Pigeon & Bird Protection",
    desc: "Translucent anti-pigeon netting and stainless steel spikes keeping balconies clean and hygienic.",
    image: "/images/pigeon-net.webp",
    link: "/pigeon-nets/",
    badge: "Bird Control"
  },
  {
    title: "Construction & Industrial",
    desc: "Industrial-grade perimeter containment, duct shaft safety nets, and debris protection.",
    image: "/images/construction-safety-net.jpg",
    link: "/construction-safety-nets/",
    badge: "Commercial"
  }
];

// 2. Invisible Grills Product Subcategories
const invisibleGrillProducts = [
  {
    title: "Balcony Invisible Grills",
    desc: "Engineered for high-rise apartment balconies. Marine-grade SS316 cables anchored into structural concrete.",
    material: "SS316 Marine Grade (2.5mm / 2.0mm)",
    spacing: "50mm Child-Safe or 75mm Open View",
    image: "/images/hero-balcony.webp",
    link: "/balcony-invisible-grills/"
  },
  {
    title: "Window Invisible Grills",
    desc: "Clean architectural window protection for master bedrooms, French windows, and sliding glass facades.",
    material: "Virgin SS316 with DuPont nylon sheath",
    spacing: "50mm vertical / horizontal tension",
    image: "/images/window-invisible-grills.webp",
    link: "/window-invisible-grills/"
  },
  {
    title: "Staircase Invisible Grills",
    desc: "Floor-to-ceiling vertical wire systems for multi-level villas, duplex stairs, and open internal voids.",
    material: "High-tensile SS316 stainless steel",
    spacing: "Calibrated 50mm uniform pitch",
    image: "/images/staircase-invisible-grills.webp",
    link: "/staircase-invisible-grills/"
  },
  {
    title: "Child Safety Invisible Grills",
    desc: "Engineered with anti-spread horizontal stiffeners and child-proof 50mm spacing for total peace of mind.",
    material: "SS316 core + anti-climb alignment",
    spacing: "50mm non-entrapment pitch",
    image: "/images/child-safety.webp",
    link: "/child-safety-invisible-grills/"
  }
];

// 3. Core Safety Nets Subcategories
const safetyNetProducts = [
  {
    title: "Balcony Safety Nets",
    desc: "High-density virgin polymer netting providing dependable, cost-effective anti-fall protection.",
    spec: "UV-treated virgin nylon / HDPE",
    image: "/images/safety-net-balcony.webp",
    link: "/balcony-safety/"
  },
  {
    title: "Children Safety Nets",
    desc: "Tight-mesh perimeter safety netting designed specifically to safeguard toddlers and pets on balconies.",
    spec: "Reinforced border cord & anchor hooks",
    image: "/images/child-safety.webp",
    link: "/child-safety-nets/"
  },
  {
    title: "Anti-Pigeon Nets",
    desc: "Discreet 0.7mm translucent netting barring pigeons and birds from nesting without blocking light.",
    spec: "Non-toxic, humane bird deterrent",
    image: "/images/pigeon-net.webp",
    link: "/pigeon-nets/"
  },
  {
    title: "Building & Duct Nets",
    desc: "Heavy-ply containment netting for central building ducts, open utility shafts, and terrace tops.",
    spec: "Industrial weather-resistant grade",
    image: "/images/building-safety-net.jpg",
    link: "/duct-safety-nets/"
  }
];
---

<BaseLayout
  title="Invisible Safety | Invisible Grills & Safety Solutions for Modern Homes"
  description="Professional invisible grills and safety net systems for apartment balconies, windows, and staircases. SS316 marine-grade cables, expert installation in Vizag, Hyderabad, Vijayawada & Amaravati."
  canonicalUrl="/"
  schema={[localBusinessSchema, faqSchema]}
>
  <!-- 2. Hero Section -->
  <Hero />

  <!-- 3. Primary Customer Journey: What are you looking to protect? -->
  <section class="section-spacing bg-white" id="protect-journey">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">APPLICATIONS</span>
        <h2>What are you looking to protect?</h2>
        <p>Select your space to explore tailored safety grill and net solutions designed for Indian residential architecture.</p>
      </div>

      <div class="grid-3">
        {protectionCategories.map((cat) => (
          <a href={cat.link} class="photo-card">
            <div class="photo-card-img-wrapper">
              <img src={cat.image} alt={`${cat.title} safety installation`} loading="lazy" />
            </div>
            <div class="photo-card-body">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.35rem;">
                <h3 class="photo-card-title">{cat.title}</h3>
                <span class="badge badge-neutral">{cat.badge}</span>
              </div>
              <p class="photo-card-desc">{cat.desc}</p>
              <div class="photo-card-link">
                <span>VIEW SOLUTION</span>
                <ArrowRight size={14} />
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Featured Product: Invisible Grills -->
  <section class="section-spacing bg-warm" id="featured-products">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">FLAGSHIP SOLUTION</span>
        <h2>Invisible Grills</h2>
        <p>Minimal visual obstruction. Practical protection for modern balconies, windows, and open architectural spaces.</p>
      </div>

      <div class="grid-2">
        {invisibleGrillProducts.map((prod) => (
          <a
            href={prod.link}
            class="card interactive-product-card"
            aria-label={`View details for ${prod.title}`}
          >
            <div class="card-img-wrap" style="position: relative; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: #E2E8F0;">
              <img src={prod.image} alt={prod.title} style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
            </div>
            <div style="padding: 1.75rem; display: flex; flex-direction: column; flex-grow: 1;">
              <h3 style="font-size: 1.3rem; margin-bottom: 0.5rem; color: #0F172A;">{prod.title}</h3>
              <p style="font-size: 0.95rem; color: #475569; margin-bottom: 1.25rem; line-height: 1.6;">
                {prod.desc}
              </p>

              <div style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; padding: 0.85rem 1rem; margin-bottom: 1.5rem; font-size: 0.85rem;">
                <div style="margin-bottom: 0.35rem;">
                  <strong style="color: #334155;">Material:</strong> <span style="color: #64748B;">{prod.material}</span>
                </div>
                <div>
                  <strong style="color: #334155;">Spacing Options:</strong> <span style="color: #64748B;">{prod.spacing}</span>
                </div>
              </div>

              <div style="margin-top: auto; display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #F1F5F9; padding-top: 1rem;">
                <div>
                  <span style="font-size: 0.78rem; color: #64748B; display: block;">Indicative Price</span>
                  <span style="font-size: 1rem; font-weight: 700; color: #0F172A;">with custom site quote / sq. ft</span>
                </div>
                <div class="btn btn-secondary btn-sm card-action-btn">
                  <span>VIEW DETAILS</span>
                  <ArrowRight size={14} />
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div style="text-align: center; margin-top: 2.5rem;">
        <a href="/invisible-grills/" class="btn btn-primary">
          <span>Explore All Invisible Grill Options</span>
          <ArrowRight size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- 5. Safety Nets Section -->
  <section class="section-spacing bg-white">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">DEPENDABLE PROTECTION</span>
        <h2>Safety Nets</h2>
        <p>Reliable anti-fall and bird protection mesh for residential towers, apartment balconies, and open building voids.</p>
      </div>

      <div class="grid-4">
        {safetyNetProducts.map((net) => (
          <a
            href={net.link}
            class="card interactive-product-card"
            aria-label={`View details for ${net.title}`}
          >
            <div class="card-img-wrap" style="position: relative; width: 100%; aspect-ratio: 16 / 10; overflow: hidden; background: #E2E8F0;">
              <img src={net.image} alt={net.title} style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
            </div>
            <div style="padding: 1.25rem 1.5rem 1.5rem 1.5rem; display: flex; flex-direction: column; flex-grow: 1;">
              <h3 style="font-size: 1.15rem; margin-bottom: 0.4rem; color: #0F172A;">{net.title}</h3>
              <p style="font-size: 0.88rem; color: #475569; margin-bottom: 1rem; flex-grow: 1; line-height: 1.5;">
                {net.desc}
              </p>
              <div style="font-size: 0.78rem; font-weight: 600; color: #64748B; background: #F1F5F9; padding: 0.35rem 0.6rem; border-radius: 4px; margin-bottom: 1rem;">
                {net.spec}
              </div>
              <div class="card-text-link" style="font-size: 0.88rem; font-weight: 600; color: #2563EB; display: inline-flex; align-items: center; gap: 0.35rem;">
                <span>VIEW DETAILS</span>
                <ArrowRight size={14} />
              </div>
            </div>
          </a>
        ))}
      </div>

      <div style="text-align: center; margin-top: 2.5rem;">
        <a href="/safety-nets/" class="btn btn-secondary">
          <span>View All Safety Net Solutions</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 6. Why Invisible Safety (Trust Section) -->
  <section class="section-spacing bg-warm">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">STANDARDS & CREDIBILITY</span>
        <h2>Why Customers Choose Invisible Safety</h2>
        <p>Transparent materials, trained full-time technicians, and clear documentation for your peace of mind.</p>
      </div>

      <div class="grid-3">
        <div class="card">
          <div style="width: 42px; height: 42px; border-radius: 8px; background: #EFF6FF; color: #2563EB; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
            <ShieldCheck size={22} />
          </div>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: #0F172A;">Material Transparency</h3>
          <p style="font-size: 0.92rem; color: #475569; margin: 0; line-height: 1.5;">
            We specify genuine SS316 marine-grade stainless steel cables with molybdenum composition to prevent rusting, even in humid coastal areas.
          </p>
        </div>

        <div class="card">
          <div style="width: 42px; height: 42px; border-radius: 8px; background: #EFF6FF; color: #2563EB; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
            <Wrench size={22} />
          </div>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: #0F172A;">Professional Installation</h3>
          <p style="font-size: 0.92rem; color: #475569; margin: 0; line-height: 1.5;">
            Installed by trained technicians using certified safety harnesses and heavy-duty structural aluminium tracks anchored into reinforced concrete.
          </p>
        </div>

        <div class="card">
          <div style="width: 42px; height: 42px; border-radius: 8px; background: #EFF6FF; color: #2563EB; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
            <Ruler size={22} />
          </div>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: #0F172A;">On-Site Measurement</h3>
          <p style="font-size: 0.92rem; color: #475569; margin: 0; line-height: 1.5;">
            Our engineer visits your apartment with physical wire samples and precision measuring tools to inspect structural surfaces before quoting.
          </p>
        </div>

        <div class="card">
          <div style="width: 42px; height: 42px; border-radius: 8px; background: #EFF6FF; color: #2563EB; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
            <FileText size={22} />
          </div>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: #0F172A;">Clear Quotations</h3>
          <p style="font-size: 0.92rem; color: #475569; margin: 0; line-height: 1.5;">
            No hidden fees. Every quote clearly specifies the exact billable square footage, track specifications, wire gauge, and installation scope.
          </p>
        </div>

        <div class="card">
          <div style="width: 42px; height: 42px; border-radius: 8px; background: #EFF6FF; color: #2563EB; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
            <Award size={22} />
          </div>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: #0F172A;">Warranty Documentation</h3>
          <p style="font-size: 0.92rem; color: #475569; margin: 0; line-height: 1.5;">
            Receive written warranty certificates covering material integrity, track durability, and cable tension for your records.
          </p>
        </div>

        <div class="card">
          <div style="width: 42px; height: 42px; border-radius: 8px; background: #EFF6FF; color: #2563EB; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
            <MapPin size={22} />
          </div>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: #0F172A;">Local Service Availability</h3>
          <p style="font-size: 0.92rem; color: #475569; margin: 0; line-height: 1.5;">
            Dedicated local installation and service teams stationed in Hyderabad, Visakhapatnam, and Vijayawada for prompt post-install support.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. How It Works -->
  <section class="section-spacing bg-white" id="how-it-works">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">SIMPLE 4-STEP PROCESS</span>
        <h2>How It Works</h2>
        <p>A straightforward and transparent workflow from your initial inquiry to final safety sign-off.</p>
      </div>

      <div class="grid-4">
        <!-- Step 1 -->
        <div style="display: flex; flex-direction: column;">
          <div class="step-number">01</div>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: #0F172A;">Tell us what you need</h3>
          <p style="font-size: 0.92rem; color: #475569; line-height: 1.5;">
            Contact us via phone, WhatsApp, or website form. Share your apartment location and approximate balcony or window dimensions.
          </p>
        </div>

        <!-- Step 2 -->
        <div style="display: flex; flex-direction: column;">
          <div class="step-number">02</div>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: #0F172A;">Schedule measurement</h3>
          <p style="font-size: 0.92rem; color: #475569; line-height: 1.5;">
            Our technician visits your home at a convenient time to measure the space and show physical material and wire samples.
          </p>
        </div>

        <!-- Step 3 -->
        <div style="display: flex; flex-direction: column;">
          <div class="step-number">03</div>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: #0F172A;">Choose your solution</h3>
          <p style="font-size: 0.92rem; color: #475569; line-height: 1.5;">
            Select between 2.0mm or 2.5mm cable gauges, 50mm or 75mm spacing, and receive a formal, transparent price quotation.
          </p>
        </div>

        <!-- Step 4 -->
        <div style="display: flex; flex-direction: column;">
          <div class="step-number">04</div>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem; color: #0F172A;">Professional installation</h3>
          <p style="font-size: 0.92rem; color: #475569; line-height: 1.5;">
            Our trained technicians install track frames, tension the cables uniformly, and clean up the work area before final handover.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Real Installations Section -->
  <section class="section-spacing bg-warm" id="installations">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">PORTFOLIO</span>
        <h2>Real Installations</h2>
        <p>Photographs from completed residential invisible grill and safety net installations in gated communities.</p>
      </div>

      <div class="grid-2">
        {projects.slice(0, 4).map((proj) => (
          <div class="card" style="display: flex; flex-direction: column; overflow: hidden; padding: 0;">
            <div style="position: relative; width: 100%; aspect-ratio: 16 / 10; overflow: hidden; background: #E2E8F0;">
              <img src={proj.imageAfter} alt={`${proj.apartmentName} - ${proj.title}`} style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
              <div style="position: absolute; bottom: 12px; left: 12px; background: rgba(15, 23, 42, 0.85); color: #FFFFFF; font-size: 0.75rem; font-weight: 600; padding: 4px 10px; border-radius: 4px;">
                {proj.apartmentName}, {proj.city}
              </div>
            </div>
            <div style="padding: 1.5rem;">
              <h3 style="font-size: 1.2rem; margin-bottom: 0.35rem; color: #0F172A;">{proj.title}</h3>
              <p style="font-size: 0.85rem; color: #64748B; margin-bottom: 0.75rem;">
                {proj.configuration} • {proj.floor}
              </p>
              <p style="font-size: 0.9rem; color: #475569; font-style: italic; line-height: 1.5; margin: 0;">
                "{proj.clientQuote}"
              </p>
            </div>
          </div>
        ))}
      </div>

      <div style="text-align: center; margin-top: 2.5rem;">
        <a href="/projects/" class="btn btn-secondary">
          <span>View More Project Photos</span>
          <ArrowRight size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- 9. Before / After Comparison -->
  <section class="section-spacing bg-white">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">VISUAL COMPARISON</span>
        <h2>Before & After Installation</h2>
        <p>Compare an open or traditionally barred balcony against a professionally installed invisible grill system.</p>
      </div>

      <BeforeAfterSlider client:visible />
    </div>
  </section>

  <!-- 10. Visualize Your Space -->
  <section class="section-spacing bg-warm" id="visualize">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">INTERACTIVE PLANNING</span>
        <h2>Visualize Your Space</h2>
        <p>See how different safety solutions and cable spacing look across various residential apartment openings.</p>
      </div>

      <VisualizerIsland client:visible />
    </div>
  </section>

  <!-- 11. Free Site Quote & Measurement Tool -->
  <section class="section-spacing bg-white" id="calculator">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">CUSTOM QUOTATION</span>
        <h2>Plan Your Free Site Measurement</h2>
        <p>Select your product type and dimensions to request a 100% free on-site laser measurement and custom quote.</p>
      </div>

      <CostEstimator client:load />
    </div>
  </section>

  <!-- 12. Service Areas -->
  <section class="section-spacing bg-warm">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">COVERAGE</span>
        <h2>Service Areas</h2>
        <p>We provide full site measurement, installation, and after-sales support across major urban regions.</p>
      </div>

      <div class="grid-3">
        {business.cities.map((city) => (
          <div class="card">
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
              <MapPin size={20} className="text-blue" />
              <h3 style="font-size: 1.25rem; color: #0F172A; margin: 0;">{city.name}</h3>
            </div>
            <p style="font-size: 0.88rem; color: #475569; margin-bottom: 1rem; line-height: 1.5;">
              {city.tagline}
            </p>
            <div style="font-size: 0.78rem; font-weight: 700; color: #64748B; margin-bottom: 0.4rem;">
              POPULAR LOCALITIES:
            </div>
            <div style="font-size: 0.82rem; color: #475569; line-height: 1.6; margin-bottom: 1.25rem;">
              {city.popularAreas.slice(0, 6).join(", ")} and nearby areas.
            </div>
            <a href={`/locations/${city.slug}/`} style="font-size: 0.88rem; font-weight: 600; color: #2563EB; display: inline-flex; align-items: center; gap: 0.35rem;">
              <span>View {city.name} Details</span>
              <ArrowRight size={14} />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 13. FAQs -->
  <FAQSection />

  <!-- 14. Final Call To Action -->
  <section class="section-spacing-sm bg-white" style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 16px; padding: 3rem 2rem; text-align: center; max-width: 860px; margin: 0 auto;">
        <h2 style="font-size: clamp(1.6rem, 3vw, 2.25rem); color: #0F172A; margin-bottom: 0.75rem;">
          Need a Site Measurement for Your Home?
        </h2>
        <p style="font-size: 1.05rem; color: #475569; max-width: 600px; margin: 0 auto 2rem auto; line-height: 1.6;">
          Our technical engineer will visit your apartment with physical SS316 wire and track samples, measure your space accurately, and provide a clear quotation.
        </p>

        <div style="display: flex; align-items: center; justify-content: center; gap: 1rem; flex-wrap: wrap;">
          <a href="/contact/#quote" class="btn btn-primary btn-lg">
            <span>GET A FREE QUOTE</span>
            <ArrowRight size={18} />
          </a>

          <a href={`tel:${business.phoneRaw}`} class="btn btn-secondary btn-lg">
            <Phone size={18} />
            <span>Call: {business.phone}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    function setupProductCardKeyboard() {
      document.querySelectorAll<HTMLAnchorElement>('a.interactive-product-card').forEach((card) => {
        card.addEventListener('keydown', (e) => {
          if (e.key === ' ' || e.code === 'Space') {
            e.preventDefault();
            card.click();
          }
        });
      });
    }

    document.addEventListener('DOMContentLoaded', setupProductCardKeyboard);
    document.addEventListener('astro:page-load', setupProductCardKeyboard);
  </script>
</BaseLayout>
