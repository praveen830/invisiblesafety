          <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2.5rem;">
            <a href="#estimator" class="btn btn-primary">
              <span>Calculate Duct Shaft Coverage</span>
              <ArrowRight size={17} />
            </a>
            <a
              href={`https://wa.me/${business.whatsapp}?text=Hi%20InvisProtect%2C%20I%20am%20from%20an%20RWA%20society%20committee%20and%20need%20a%20quote%20for%20building%20duct%20safety%20nets.`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp"
            >
              <MessageCircle size={17} />
              <span>RWA Bulk Enquiry</span>
            </a>
          </div>

          <div style="display: inline-flex; align-items: center; gap: 1.5rem; background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 14px; padding: 0.85rem 1.5rem; box-shadow: var(--shadow-sm);">
            <div>
              <span style="font-size: 0.72rem; color: #64748B; display: block; font-weight: 600; text-transform: uppercase;">Society Rate:</span>
              <span style="font-size: 1.35rem; font-weight: 800; color: #D97706;">₹22 / sq.ft</span>
            </div>
            <div style="width: 1px; height: 32px; background: #E2E8F0;"></div>
            <div>
              <span style="font-size: 0.72rem; color: #64748B; display: block; font-weight: 600; text-transform: uppercase;">Volume Discount:</span>
              <span style="font-size: 1.35rem; font-weight: 800; color: #16A34A;">Up to 15% Off</span>
            </div>
          </div>
        </div>

        <!-- Hero Image Showcase -->
        <div style="position: relative; border-radius: 20px; overflow: hidden; background: #FFFFFF; border: 1px solid #E2E8F0; padding: 0.85rem; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);">
          <div style="position: relative; border-radius: 14px; overflow: hidden; aspect-ratio: 16/9;">
            <img
              src="/images/duct-net.webp"
