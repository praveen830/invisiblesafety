---
import BaseLayout from '../layouts/BaseLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { pricing } from '../data/pricing';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { Building2, ShieldCheck, Check, ArrowRight, MessageCircle, Phone, Users, Activity } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Utility Duct & Plumbing Shaft Safety Nets",
  "Heavy-duty HDPE netting systems for multi-storey residential building shafts, atriums, and commercial ventilation ducts starting at ₹22/sq.ft.",
  pricing.safetyNet.ductShaftIndustrial
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisprotect.com/" },
  { name: "Duct Safety Nets", url: "https://invisprotect.com/duct-safety-nets/" }
]);
---

<BaseLayout
  title="Duct Safety Nets for Apartments & RWAs | InvisProtect India"
  description="Industrial-grade HDPE safety nets for plumbing shafts, ventilation ducts, and building atriums starting at ₹22/sq.ft. Prevents technician falls and debris accumulation. RWA bulk pricing available."
  canonicalUrl="/duct-safety-nets/"
  schema={[serviceSchema, breadcrumbs]}
>
  <!-- Hero Section -->
  <section class="section-spacing" style="background: linear-gradient(180deg, #FFFBEB 0%, #F8FAFC 100%); border-bottom: 1px solid #E2E8F0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3.5rem; align-items: center;">
        <div>
          <div style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.85rem; background: #FEF3C7; border: 1px solid #FDE68A; border-radius: 20px; font-size: 0.8rem; font-weight: 700; color: #B45309; margin-bottom: 1.25rem;">
            <Building2 size={14} /> RWA & COMMERCIAL INFRASTRUCTURE
          </div>
