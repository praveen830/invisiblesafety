---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2 } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Building Duct Shaft Safety Nets",
  "Heavy-duty continuous vertical and horizontal duct shaft safety nets for residential and commercial towers with custom site quote",
  20
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Construction & Industrial", url: "https://invisiblesafety.in/construction-safety-nets/" },
  { name: "Duct Safety Nets", url: "https://invisiblesafety.in/duct-safety-nets/" }
]);

const specs = [
  { label: "Shaft Tensile Rope", value: "Heavy-Gauge UV-Stabilized Nylon", icon: ShieldCheck },
  { label: "Debris Containment", value: "100% Tool & Object Drop Stop", icon: Award },
  { label: "Anchor Metallurgy", value: "SS304 Structural Expansion Bolts", icon: Wrench },
  { label: "Site Compliance", value: "Commercial High-Rise Certified", icon: CheckCircle2 }
];

const subcategories = [
  {
    title: "Construction Site Fall Nets",
    subtitle: "Dual-layer personnel fall arrest mesh with fine debris catch lining for multi-story towers.",
    href: "/construction-safety-nets/",
    image: "/images/construction-safety-net.jpg",
    spec: "High-Impact Shock-Absorbing Core",
    badge: "Life Safety"
  },
  {
    title: "Industrial Debris Containment",
    subtitle: "Heavy-duty warehouse perimeter screens containing pallet fragments and high-bay storage fall-off.",
    href: "/industrial-safety-nets/",
    image: "/images/industrial-safety-net.jpg",
    spec: "UV-Treated Industrial Polyethylene",
    badge: "Factory Grade"
  },
  {
    title: "Car Parking Perimeter Nets",
    subtitle: "Basement and podium parking barriers preventing ball strikes and vehicular glass damage.",
    href: "/car-parking-safety-nets/",
    image: "/images/car-parking-net.jpg",
    spec: "Weather-Resistant Multi-Strand Mesh",
    badge: "Basement Shield"
  },
  {
    title: "Terrace Top Fall Perimeter",
    subtitle: "Boundary safety netting installed over open roof parapets to secure terrace gatherings.",
    href: "/terrace-safety-nets/",
    image: "/images/terrace-top-net.jpg",
    spec: "High-Tensile Perimeter Tie Cords",
    badge: "Rooftop Guard"
  }
];

const gallery = [
  {
    src: "/images/duct-net.webp",
    alt: "Vertical Duct Shaft Enclosure",
    title: "Internal Duct Void Enclosure",
    caption: "Continuous floor-to-floor vertical barrier protecting service shafts from accidental tool falls and pigeon infestation.",
    badge: "Shaft Protection"
  },
  {
    src: "/images/construction-safety-net.jpg",
    alt: "Commercial Construction Netting",
    title: "Tower Facade Catch Net",
    caption: "Engineered fall arrest network safeguarding active high-rise construction.",
    badge: "Commercial Site"
  },
  {
    src: "/images/industrial-safety-net.jpg",
    alt: "Industrial Debris Catch Net",
    title: "Logistics Hub Storage Net",
    caption: "Ceiling-to-floor containment preventing high-bay pallet falls.",
    badge: "Warehouse Safety"
  },
  {
    src: "/images/car-parking-net.jpg",
    alt: "Podium Parking Protection",
    title: "Podium Car Parking Barrier",
    caption: "Aesthetic perimeter mesh shielding luxury cars from stray ball impacts.",
    badge: "Podium Shield"
  }
];
---

<SubPageLayout
  title="Building Duct Shaft Safety Nets | Plumbing Shaft Enclosures | Invisible Safety"
  description="Heavy-duty vertical building duct shaft safety nets. Stops accidental tool drops, debris fall, and pigeon roosting in plumbing shafts."
  canonicalUrl="/duct-safety-nets/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="STRUCTURAL ARCHITECTURE"
  heroTitle="BUILDING DUCT SHAFT SAFETY NETS"
  heroSubtitle="Continuous vertical and horizontal high-tensile safety netting sealing building plumbing shafts, ventilation ducts, and internal service voids against hazardous falls."
  heroImage="/images/duct-net.webp"
  heroImageAlt="Building Duct Safety Nets Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Shaft Safety Dynamics -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">SHAFT VOID PROTECTION</span>
        <h2 class="editorial-title">Total Void Containment</h2>
        <p class="editorial-subtitle">
          Building plumbing ducts run up to 40 stories deep, posing critical hazards during maintenance.
        </p>
      </div>

      <div class="duct-grid">
        <div class="duct-card">
          <h3 class="duct-card-title">Maintenance Fall Prevention</h3>
          <p class="duct-card-desc">
            Provides a safety arrest mesh across every service opening so plumbers and electricians working in duct voids are fully shielded against high-altitude drops.
          </p>
        </div>

        <div class="duct-card">
          <h3 class="duct-card-title">Anti-Pigeon Roosting Block</h3>
          <p class="duct-card-desc">
            Deep shafts are favorite nesting spots for pigeons. Sealing the perimeter permanently halts foul odors, dead bird blockages, and HVAC contamination.
          </p>
        </div>

        <div class="duct-card">
          <h3 class="duct-card-title">Heavy Boundary Ropes</h3>
          <p class="duct-card-desc">
            Each section is bordered with 8mm to 12mm high-tenacity perimeter ropes anchored into RCC beams using stainless steel hook fasteners.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Cost Estimator -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Duct Netting Quote</h2>
        <p class="editorial-subtitle">
          Configure duct dimensions for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .duct-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .duct-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .duct-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .duct-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .duct-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
