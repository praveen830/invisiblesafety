---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import BeforeAfterSlider from '../components/react/BeforeAfterSlider';
import ComparisonTable from '../components/ComparisonTable.astro';
import EngineeringSection from '../components/EngineeringSection.astro';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2, Ruler, Check, ArrowRight, Eye, Activity } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Balcony Invisible Grills",
  "Architectural SS316 marine-grade invisible safety grills for high-rise balconies. 400+ kg load tested, transparent panoramic views with 10-year direct warranty.",
  190
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Invisible Grills", url: "https://invisiblesafety.in/invisible-grills/" },
  { name: "Balcony Invisible Grills", url: "https://invisiblesafety.in/balcony-invisible-grills/" }
]);

const specs = [
  { label: "Cable Metallurgy", value: "Virgin Japanese SS316 Marine Grade", icon: ShieldCheck },
  { label: "Tensile Strength", value: "400+ kgf Breaking Load per Cable", icon: Award },
  { label: "Spacing Calibration", value: "50mm Child-Safe or 75mm Panoramic", icon: Ruler },
  { label: "Direct Warranty", value: "10-Year Direct Written Guarantee", icon: Wrench }
];

const subcategories = [
  {
    title: "French Window Invisible Grills",
    subtitle: "Frameless high-tensile safety barriers for low-sill windows and full-height sliding glass doors.",
    href: "/window-invisible-grills/",
    image: "/images/window-invisible-grills.webp",
    spec: "Direct Wall Anchor Structural Tracks",
    badge: "Maximum Airflow"
  },
  {
    title: "Duplex Staircase Tension Grills",
    subtitle: "Floor-to-ceiling vertical cable dividers safeguarding duplex voids and floating stairs.",
    href: "/staircase-invisible-grills/",
    image: "/images/staircase-invisible-grills.webp",
    spec: "Floor-to-Ceiling SS316 Cables",
    badge: "Interior Luxury"
  },
  {
    title: "Child-Safe Calibrated Spacing",
    subtitle: "50mm anti-head entrapment spacing engineered to protect toddlers and pets without climbable steps.",
    href: "/child-safety-invisible-grills/",
    image: "/images/child-safety.webp",
    spec: "50mm Anti-Entrapment Core",
    badge: "Toddler Proof"
  },
  {
    title: "Apartment Balcony Fall Shield",
    subtitle: "Comprehensive high-rise perimeter protection approved by apartment society RWAs.",
    href: "/balcony-safety/",
    image: "/images/balcony-safety.webp",
    spec: "Zero Facade Alteration",
    badge: "100% Society Approved"
  }
];

const gallery = [
  {
    src: "/images/hero-balcony.webp",
    alt: "Balcony Invisible Grills High-Rise Installation",
    title: "Panoramic Penthouse Balcony",
    caption: "Virgin Japanese SS316 marine cables offering uncompromised 180° skyline vistas with 400+ kg fall protection.",
    badge: "Flagship Balcony"
  },
  {
    src: "/images/invisible-grills-page.webp",
    alt: "Curved Corner Balcony Invisible Grills",
    title: "Curved Corner Balcony Deck",
    caption: "Seamless corner corner-post rigging aligning with structural architectural glass.",
    badge: "Precision Anchored"
  },
  {
    src: "/images/window-invisible-grills.webp",
    alt: "Fenestration Tension Grills",
    title: "French Window Fenestration",
    caption: "High-tensile cables enabling open windows without risking toddler falls.",
    badge: "Ventilation Guard"
  },
  {
    src: "/images/child-safety.webp",
    alt: "50mm Child-Safe Cable Array",
    title: "Toddler Anti-Fall System",
    caption: "Calibrated 50mm spacing eliminating all climbable rungs and entrapment gaps.",
    badge: "Child & Pet Safety"
  }
];
---

<SubPageLayout
  title="Balcony Invisible Grills | High-Rise SS316 Fall Safety | Invisible Safety"
  description="Engineered SS316 marine-grade invisible grills for high-rise balconies with custom site quote 400+ kgf load tested, RWA compliant with 10-year zero-rust warranty."
  canonicalUrl="/balcony-invisible-grills/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="FLAGSHIP ARCHITECTURAL SAFETY"
  heroTitle="BALCONY INVISIBLE GRILLS"
  heroSubtitle="Virgin Japanese SS316 marine-grade tensile cables tensioned into structural aluminium tracks, safeguarding high-rise balconies with 400+ kgf breaking load while preserving 180° uninterrupted panoramic skyline vistas."
  heroImage="/images/hero-balcony.webp"
  heroImageAlt="Balcony Invisible Grills Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Architectural Difference Before/After Slider -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">THE ARCHITECTURAL DIFFERENCE</span>
        <h2 class="editorial-title">Panoramic Balcony Transformation</h2>
        <p class="editorial-subtitle">
          Slide to compare traditional cage bars vs Invisible Safety SS316 architectural grills.
        </p>
      </div>

      <div class="visualizer-wrapper">
        <BeforeAfterSlider client:visible />
      </div>
    </div>
  </section>

  <!-- Engineering Section -->
  <EngineeringSection />

  <!-- Comparison Matrix -->
  <ComparisonTable />

  <!-- Interactive Cost Estimator -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Balcony Grill Cost</h2>
        <p class="editorial-subtitle">
          Select dimensions and options for real-time quotation and doorstep laser survey scheduling.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection category="invisible-grills" title="Balcony Invisible Grills Questions &amp; Answers" />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .visualizer-wrapper {
    max-width: 1080px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
