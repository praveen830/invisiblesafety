---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { pricing } from '../data/pricing';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2, Check, ArrowRight, Activity, Eye, Shield } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Pigeon Safety Nets & Bird Exclusion",
  "Translucent 0.7mm nylon and UV-treated HDPE anti-pigeon netting for balconies, AC ledges, and duct shafts with custom site quote",
  pricing.safetyNet.pigeonProtection
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Animal & Bird Protection", url: "https://invisiblesafety.in/pigeon-nets/" },
  { name: "Pigeon Safety Nets", url: "https://invisiblesafety.in/pigeon-nets/" }
]);

const specs = [
  { label: "Mesh Diameter", value: "0.7mm Translucent UV Monofilament", icon: ShieldCheck },
  { label: "Optical Transparency", value: "98% Visual Skyline Transmission", icon: Award },
  { label: "Spike Metallurgy", value: "SS304 Spikes on Polycarbonate Base", icon: Wrench },
  { label: "Living Guarantee", value: "3-Year Clean Balcony Warranty", icon: CheckCircle2 }
];

const subcategories = [
  {
    title: "Translucent Anti-Pigeon Netting",
    subtitle: "Near-invisible monofilament grid denying roosting access to pigeons without obstructing daylight.",
    href: "/pigeon-nets/",
    image: "/images/pigeon-net.webp",
    spec: "Virgin UV-Stabilized Co-Polymer",
    badge: "Discreet Living"
  },
  {
    title: "SS304 Polycarbonate Bird Spikes",
    subtitle: "Humane curved blunt spikes preventing bird perching on narrow parapets, AC units, and ledges.",
    href: "/bird-spikes/",
    image: "/images/balcony-safety.webp",
    spec: "Weather-Resistant Virgin Polycarbonate",
    badge: "Ledge Protection"
  },
  {
    title: "Anti-Monkey Balcony Enclosures",
    subtitle: "High-tensile braided wire netting designed to withstand aggressive monkey pulling and tampering.",
    href: "/monkey-safety-nets/",
    image: "/images/safety-net-balcony.webp",
    spec: "Reinforced Multi-Cord Tension",
    badge: "Wildlife Defense"
  },
  {
    title: "Fine-Mesh Insect & Mosquito Nets",
    subtitle: "Pleated and roller insect screens providing 100% insect protection while ensuring cross-ventilation.",
    href: "/mosquito-safety-nets/",
    image: "/images/terrace-top-net.jpg",
    spec: "Fiberglass Anti-Tear Mesh",
    badge: "Clean Airflow"
  }
];

const gallery = [
  {
    src: "/images/pigeon-net.webp",
    alt: "Translucent Pigeon Net on Balcony",
    title: "Translucent Skyline Protection",
    caption: "Unobtrusive bird exclusion preserving pristine aesthetic elevation.",
    badge: "Penthouse Living"
  },
  {
    src: "/images/balcony-safety.webp",
    alt: "Stainless Steel Bird Spikes along Parapet",
    title: "SS304 Anti-Perching Ledge Spikes",
    caption: "Precision silicon-bonded spikes installed on high-rise AC ledges.",
    badge: "Facade Care"
  },
  {
    src: "/images/safety-net-balcony.webp",
    alt: "Reinforced Anti-Monkey Enclosure",
    title: "High-Tensile Balcony Barrier",
    caption: "Heavy-gauge netting protecting hillside residences against wildlife intrusion.",
    badge: "Perimeter Shield"
  },
  {
    src: "/images/terrace-top-net.jpg",
    alt: "Terrace Bird Exclusion Netting",
    title: "Rooftop Air Duct & Terrace Net",
    caption: "Wide-span horizontal netting keeping roof shafts free of bird nesting.",
    badge: "Clean Architecture"
  }
];
---

<SubPageLayout
  title="Pigeon Safety Nets & Bird Exclusion | The Winged Sanctuary | Invisible Safety"
  description="Translucent, virtually invisible anti-pigeon netting and SS304 spikes. 100% humane, stops bird droppings and respiratory allergens."
  canonicalUrl="/pigeon-nets/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="ANIMAL & BIRD EXCLUSION"
  heroTitle="THE WINGED SANCTUARY"
  heroSubtitle="Zero-visibility humane bird barrier systems and surgical-grade stainless spikes safeguarding residential balconies without blocking skyline views."
  heroImage="/images/pigeon-net.webp"
  heroImageAlt="Translucent Pigeon Net Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Hygiene & Health Standards Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">HYGIENE &amp; HEALTH SHIELD</span>
        <h2 class="editorial-title">Humane Avian Exclusion</h2>
        <p class="editorial-subtitle">
          Eliminate droppings, bacterial fungal spores, and nest clutter while upholding ethical wildlife standards.
        </p>
      </div>

      <div class="pigeon-benefits-grid">
        <div class="pigeon-benefit-card">
          <h3 class="benefit-title">Zero Optical Intrusion</h3>
          <p class="benefit-desc">
            Engineered with 0.7mm translucent co-polymer filaments that disappear against the open sky from a distance of just 1.5 meters.
          </p>
        </div>

        <div class="pigeon-benefit-card">
          <h3 class="benefit-title">Respiratory Protection</h3>
          <p class="benefit-desc">
            Pigeon droppings carry Histoplasmosis and Cryptococcosis spores. Enclosing your balcony permanently halts airborne microbial intrusion into your living space.
          </p>
        </div>

        <div class="pigeon-benefit-card">
          <h3 class="benefit-title">100% Humane &amp; Harmless</h3>
          <p class="benefit-desc">
            Smooth, non-tangling knots and blunt-tip surgical spikes deter landings without causing physical injury to pigeons or songbirds.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Smart Cost Estimator -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Pigeon Net Cost</h2>
        <p class="editorial-subtitle">
          Configure balcony or duct shaft dimensions for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .pigeon-benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .pigeon-benefit-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .pigeon-benefit-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .benefit-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .benefit-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
