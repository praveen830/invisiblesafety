const { solution } = Astro.props;

const serviceSchema = getServiceSchema(
  solution.heroTitle,
  solution.description,
  solution.slug === "invisible-grills" ? "SS316 Marine Grade" : "Certified Architectural Safety System"
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Solutions", url: "https://invisiblesafety.in/solutions/" },
  { name: solution.heroTitle, url: `https://invisiblesafety.in/solutions/${solution.slug}/` }
]);
---

<SubPageLayout
  title={solution.title}
  description={solution.description}
  canonicalUrl={`/solutions/${solution.slug}/`}
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow={solution.heroEyebrow}
  heroTitle={solution.heroTitle}
  heroSubtitle={solution.heroSubtitle}
  heroImage={solution.heroImage}
  heroImageAlt={solution.heroImageAlt}
  specs={solution.specs}
  subcategories={solution.subcategories}
  gallery={solution.gallery}
>
  <!-- Interactive Cost Estimator & Visualizer Integration -->
  <section class="editorial-interactive-slot">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Your Space Measurement</h2>
        <p class="editorial-subtitle">
          Configure balcony or window dimensions for an instant certified engineering quotation.
        </p>
      </div>

      <div class="calculator-slot-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <!-- Essential Residential FAQ Section -->
  <FAQSection />
</SubPageLayout>

<style>
  .editorial-interactive-slot {
    background-color: #0D0D0D;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .calculator-slot-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
