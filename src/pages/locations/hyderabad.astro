---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CostEstimator from '../../components/react/CostEstimator';
import TrustSection from '../../components/TrustSection.astro';
import { locations } from '../../data/locations';
import { business } from '../../data/business';
import { getBreadcrumbSchema, getFAQSchema } from '../../utils/seo';
import { MapPin, ShieldCheck, Check, Phone, MessageCircle, ArrowRight, Building } from 'lucide-react';

const loc = locations.hyderabad;
const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Locations", url: "https://invisiblesafety.in/locations/" },
  { name: "Hyderabad", url: "https://invisiblesafety.in/locations/hyderabad/" }
]);
const faqSchema = getFAQSchema(loc.faqs);
---

<BaseLayout
  title="Invisible Grills in Hyderabad | Balcony Safety & Pigeon Nets | Invisible Safety"
  description="Premier invisible safety grills for high-rise balconies in Gachibowli, Kondapur, Hitec City, Kokapet & Financial District. SS316 marine-grade, 400+ kg load, same-day laser measurement."
  canonicalUrl="/locations/hyderabad/"
  schema={[breadcrumbs, faqSchema]}
>
  <!-- Light Architectural Hero Section -->
  <section class="section-spacing" style="background: linear-gradient(180deg, #F0F9FF 0%, #F8FAFC 100%); border-bottom: 1px solid #E2E8F0;">
    <div class="container" style="text-align: center; max-width: 880px;">
      <div style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.9rem; border-radius: 20px; background: #E0F2FE; border: 1px solid #BAE6FD; color: #0369A1; font-size: 0.8rem; font-weight: 700; margin-bottom: 1.25rem;">
        <MapPin size={14} /> HYDERABAD & CYBERABAD HIGH-RISE EXPERTS
      </div>
      <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.4rem); font-weight: 800; color: #0F172A; line-height: 1.2; margin-bottom: 1.25rem;">
        Invisible Safety Grills <br />
        <span style="color: #2563EB;">in Hyderabad</span>
      </h1>
      <p style="font-size: 1.12rem; color: #475569; line-height: 1.65; max-width: 740px; margin: 0 auto 2rem auto;">
        {loc.localDescription}
      </p>

      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="#estimator" class="btn btn-primary">
          <span>Calculate Price for Hyderabad Balcony</span>
          <ArrowRight size={16} />
        </a>
        <a
          href={`https://wa.me/${business.whatsapp}?text=Hi%20Invisible Safety%2C%20I%20live%20in%20Hyderabad%20and%20need%20a%20site%20visit%20for%20my%20balcony.`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
        >
          <MessageCircle size={17} />
          <span>Book Free Hyderabad Site Visit</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Localized Engineering Specifics -->
  <section class="section-spacing bg-warm" style="border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">HYDERABAD HIGH-RISE STANDARDS</span>
        <h2>{loc.localSpecifics.title}</h2>
        <p>Calibrated for towers exceeding 20 to 50 floors across Kokapet and the IT corridor.</p>
      </div>

      <div class="grid-2" style="max-width: 900px; margin: 0 auto 3rem auto; gap: 1.25rem;">
        {loc.localSpecifics.points.map(pt => (
          <div class="card" style="display: flex; align-items: flex-start; gap: 0.75rem; background: #FFFFFF; padding: 1.25rem;">
            <span style="flex-shrink: 0; margin-top: 2px;"><Check size={20} color="#16A34A" /></span>
            <span style="font-size: 0.95rem; color: #334155; line-height: 1.5;">{pt}</span>
          </div>
        ))}
      </div>

      <!-- Key Localities Grid -->
      <div class="card" style="max-width: 900px; margin: 0 auto; background: #FFFFFF; border: 1px solid #E2E8F0; padding: 2rem;">
        <h3 style="font-size: 1.25rem; font-weight: 700; color: #0F172A; margin-bottom: 1.25rem;">
          Popular Hyderabad High-Rise Communities Served:
        </h3>
        <div class="grid-3" style="gap: 1rem;">
          {loc.keyAreas.map(area => (
            <div style="background: #F8FAFC; padding: 1rem; border-radius: 8px; border: 1px solid #E2E8F0;">
              <div style="font-weight: 700; color: #2563EB; font-size: 0.92rem; margin-bottom: 0.25rem;">{area.name}</div>
              <div style="font-size: 0.82rem; color: #64748B;">{area.description}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Recent Hyderabad Case Studies -->
  <section class="section-spacing bg-white" style="border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">VERIFIED LOCAL PROJECTS</span>
        <h2>Installed In Prominent Hyderabad Towers</h2>
        <p>Read what homeowners in your neighboring communities say about our installation team.</p>
      </div>

      <div class="grid-3">
        {loc.recentInstallations.map(inst => (
          <div class="card" style="background: #FFFFFF; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="font-size: 0.8rem; font-weight: 700; color: #2563EB; margin-bottom: 0.35rem;">
                {inst.locality.toUpperCase()}
              </div>
              <h4 style="font-size: 1.2rem; font-weight: 700; color: #0F172A; margin-bottom: 0.35rem;">
                {inst.community}
              </h4>
              <div style="font-size: 0.84rem; color: #16A34A; font-weight: 700; margin-bottom: 0.85rem;">
                {inst.product} • {inst.sqft} sq.ft
              </div>
              <p style="font-size: 0.9rem; color: #475569; line-height: 1.6; font-style: italic;">
                "{inst.quote}"
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Live Cost Estimator -->
  <section class="section-spacing bg-warm" style="border-bottom: 1px solid var(--color-border);" id="estimator">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">DOORSTEP MEASUREMENT</span>
        <h2>Calculate Your Hyderabad Balcony Quote</h2>
        <p>Free laser measurement across Gachibowli, Kondapur, Madhapur, and Kokapet within 24 hours.</p>
      </div>
      <CostEstimator client:load />
    </div>
  </section>

  <!-- Local Hyderabad FAQs -->
  <section class="section-spacing bg-white" style="border-bottom: 1px solid var(--color-border);">
    <div class="container" style="max-width: 860px;">
      <div class="section-header">
        <span class="eyebrow">LOCAL FAQS</span>
        <h2>Hyderabad Community Questions</h2>
      </div>

      <div style="display: flex; flex-direction: column; gap: 1rem;">
        {loc.faqs.map(faq => (
          <div class="card" style="padding: 1.35rem 1.5rem; background: #FFFFFF;">
            <h4 style="font-size: 1.08rem; font-weight: 700; color: #0F172A; margin-bottom: 0.5rem;">{faq.question}</h4>
            <p style="font-size: 0.92rem; color: #475569; margin: 0; line-height: 1.6;">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <TrustSection />
</BaseLayout>
