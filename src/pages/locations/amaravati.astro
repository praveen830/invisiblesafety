---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CostEstimator from '../../components/react/CostEstimator';
import TrustSection from '../../components/TrustSection.astro';
import { locations } from '../../data/locations';
import { business } from '../../data/business';
import { getBreadcrumbSchema, getFAQSchema } from '../../utils/seo';
import { MapPin, ShieldCheck, Check, Phone, MessageCircle, ArrowRight } from 'lucide-react';

const loc = locations.amaravati;
const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Locations", url: "https://invisiblesafety.in/locations/" },
  { name: "Amaravati", url: "https://invisiblesafety.in/locations/amaravati/" }
]);
const faqSchema = getFAQSchema(loc.faqs);
---

<BaseLayout
  title="Invisible Grills & Safety Nets in Amaravati Capital Region | Invisible Safety"
  description="Architectural invisible safety grills and balcony nets for apartments and villas in Tadepalli, Mangalagiri, Undavalli & Thullur. 10-year warranty, SS316 marine cables."
  canonicalUrl="/locations/amaravati/"
  schema={[breadcrumbs, faqSchema]}
>
  <!-- Light Architectural Hero Section -->
  <section class="section-spacing" style="background: linear-gradient(180deg, #F0F9FF 0%, #F8FAFC 100%); border-bottom: 1px solid #E2E8F0;">
    <div class="container" style="text-align: center; max-width: 880px;">
      <div style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.9rem; border-radius: 20px; background: #E0F2FE; border: 1px solid #BAE6FD; color: #0369A1; font-size: 0.8rem; font-weight: 700; margin-bottom: 1.25rem;">
        <MapPin size={14} /> ANDHRA PRADESH CAPITAL REGION HUB
      </div>
      <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.4rem); font-weight: 800; color: #0F172A; line-height: 1.2; margin-bottom: 1.25rem;">
        Invisible Safety Grills <br />
        <span style="color: #2563EB;">in Amaravati</span>
      </h1>
      <p style="font-size: 1.12rem; color: #475569; line-height: 1.65; max-width: 740px; margin: 0 auto 2rem auto;">
        {loc.localDescription}
      </p>

      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="#estimator" class="btn btn-primary">
          <span>Schedule Survey in Amaravati</span>
          <ArrowRight size={16} />
        </a>
        <a
          href={`https://wa.me/${business.whatsapp}?text=Hi%20Invisible%20Safety%2C%20I%20live%20in%20Amaravati%20and%20need%20a%20site%20measurement%20for%20my%20balcony.`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
        >
          <MessageCircle size={17} />
          <span>WhatsApp Amaravati Team</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Localized Engineering Specifics -->
  <section class="section-spacing bg-warm" style="border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">CAPITAL CORRIDOR ENGINEERING</span>
        <h2>{loc.localSpecifics.title}</h2>
        <p>Built to withstand open-plain wind dynamics across high-elevation capital riverfront towers.</p>
      </div>

      <div class="grid-2">
        {loc.localSpecifics.points.map((pt) => (
          <div class="card" style="display: flex; gap: 1rem; align-items: flex-start;">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: #EFF6FF; display: flex; align-items: center; justify-content: center; color: #2563EB; flex-shrink: 0; margin-top: 2px;">
              <ShieldCheck size={18} />
            </div>
            <div>
              <p style="font-size: 0.95rem; color: #334155; line-height: 1.6; margin: 0; font-weight: 500;">
                {pt}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Key Localities Grid -->
  <section class="section-spacing bg-white" style="border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">NEIGHBORHOOD COVERAGE</span>
        <h2>Amaravati Key Localities Served</h2>
        <p>Our dedicated mobile team arrives at your doorstep with actual physical cable and track samples.</p>
      </div>

      <div class="grid-3">
        {loc.keyAreas.map((area) => (
          <div class="card" style="background: #F8FAFC;">
            <h3 style="font-size: 1.15rem; font-weight: 700; color: #0F172A; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
              <MapPin size={16} className="text-blue" />
              <span>{area.name}</span>
            </h3>
            <p style="font-size: 0.88rem; color: #64748B; line-height: 1.5; margin: 0;">
              {area.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Recent Projects in Amaravati -->
  <section class="section-spacing bg-warm" style="border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">VERIFIED REVIEWS</span>
        <h2>Recent Installations in Amaravati</h2>
        <p>Real feedback from homeowners and apartment residents in the capital region.</p>
      </div>

      <div class="grid-2">
        {loc.recentInstallations.map((inst) => (
          <div class="card" style="background: #FFFFFF;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
              <span style="font-weight: 700; color: #0F172A; font-size: 1.05rem;">{inst.community}</span>
              <span class="badge badge-primary">{inst.locality}</span>
            </div>
            <p style="font-size: 0.92rem; color: #475569; font-style: italic; line-height: 1.6; margin-bottom: 1rem;">
              "{inst.quote}"
            </p>
            <div style="font-size: 0.8rem; color: #64748B; border-top: 1px solid #F1F5F9; padding-top: 0.75rem; display: flex; justify-content: space-between;">
              <span>{inst.product} ({inst.sqft} sq. ft)</span>
              <span>⭐ {inst.rating}/5.0</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Free Site Measurement & Estimator -->
  <section class="section-spacing bg-white" id="estimator">
    <div class="container" style="max-width: 900px;">
      <div class="section-header">
        <span class="eyebrow">CUSTOM QUOTATION</span>
        <h2>Schedule Free Amaravati Site Measurement</h2>
        <p>Get accurate measurements and zero-commitment quote from our local Amaravati team.</p>
      </div>
      <CostEstimator client:visible />
    </div>
  </section>

  <TrustSection />
</BaseLayout>
