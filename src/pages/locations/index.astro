---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocationLinks from '../../components/LocationLinks.astro';
import TrustSection from '../../components/TrustSection.astro';
import { getBreadcrumbSchema } from '../../utils/seo';

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://Invisible Safety.com/" },
  { name: "Locations", url: "https://Invisible Safety.com/locations/" }
]);
---

<BaseLayout
  title="Service Locations | Invisible Grills & Safety Nets | Invisible Safety"
  description="Invisible Safety delivers certified doorstep laser measurement and installation across Hyderabad, Visakhapatnam, and Vijayawada. In-house certified technicians."
  canonicalUrl="/locations/"
  schema={[breadcrumbs]}
>
  <section class="section-spacing" style="background: radial-gradient(circle at 50% 0%, rgba(2, 132, 199, 0.2) 0%, rgba(9, 13, 22, 1) 75%); border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
    <div class="container" style="text-align: center; max-width: 860px;">
      <span class="badge-emerald" style="margin-bottom: 1.25rem;">
        Regional Operations
      </span>
      <h1 style="font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 800; color: #FFFFFF; line-height: 1.15; margin-bottom: 1.25rem;">
        Where We Protect Homes <br />
        <span style="color: #38BDF8;">Across South India</span>
      </h1>
      <p style="font-size: 1.15rem; color: #94A3B8; line-height: 1.6; max-width: 700px; margin: 0 auto;">
        From high-rise towers along Hyderabad's Financial District to sea-facing residences along Vizag's Beach Road, our dedicated local installation crews deliver precision craftsmanship.
      </p>
    </div>
  </section>

  <LocationLinks />
  <TrustSection />
</BaseLayout>
