---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2 } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Car Parking Safety Nets",
  "High-impact basement, podium, and open car parking safety netting preventing ball hits, bird droppings, and overhead debris with custom site quote",
  18
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Construction & Industrial", url: "https://invisiblesafety.in/construction-safety-nets/" },
  { name: "Car Parking Safety Nets", url: "https://invisiblesafety.in/car-parking-safety-nets/" }
]);

const specs = [
  { label: "Mesh Polymer", value: "High-Density Braided UV-Resistant HDPE", icon: ShieldCheck },
  { label: "Impact Defense", value: "Withstands Direct Cricket & Football Hits", icon: Award },
  { label: "Corrosion Grade", value: "SS304 Tensioned Perimeter Cables", icon: Wrench },
  { label: "Direct Warranty", value: "3 to 5-Year Weatherproof Guarantee", icon: CheckCircle2 }
];

const subcategories = [
  {
    title: "Building Duct Shaft Enclosures",
    subtitle: "Continuous vertical netting closing deep building plumbing ducts to prevent tool drops.",
    href: "/duct-safety-nets/",
    image: "/images/duct-net.webp",
    spec: "Shaft Void Protection",
    badge: "Hygiene Guard"
  },
  {
    title: "Industrial Debris Containment",
    subtitle: "Heavy-duty warehouse perimeter screens containing pallet fragments and high-bay storage fall-off.",
    href: "/industrial-safety-nets/",
    image: "/images/industrial-safety-net.jpg",
    spec: "UV-Treated Industrial Polyethylene",
    badge: "Factory Grade"
  },
  {
    title: "Coconut Palm Anti-Drop Netting",
    subtitle: "Suspended impact-absorption nets preventing heavy coconut fall damage to cars and residents.",
    href: "/coconut-safety-nets/",
    image: "/images/coconut-safety-net.jpg",
    spec: "Heavy Impact-Cushioning Webbing",
    badge: "Property Protection"
  },
  {
    title: "Construction Site Fall Nets",
    subtitle: "Dual-layer personnel fall arrest mesh with fine debris catch lining for active multi-story sites.",
    href: "/construction-safety-nets/",
    image: "/images/construction-safety-net.jpg",
    spec: "High-Impact Shock-Absorbing Core",
    badge: "Life Safety"
  }
];

const gallery = [
  {
    src: "/images/car-parking-net.jpg",
    alt: "Podium Car Parking Safety Nets",
    title: "Podium Car Parking Barrier",
    caption: "Aesthetic perimeter mesh shielding luxury cars from stray ball impacts and overhead falling objects.",
    badge: "Podium Shield"
  },
  {
    src: "/images/coconut-safety-net.jpg",
    alt: "Coconut Drop Catch Netting",
    title: "High-Impact Canopy Catch",
    caption: "Heavy-duty perimeter webbing preventing vehicular glass damage in driveways.",
    badge: "Property Protection"
  },
  {
    src: "/images/industrial-safety-net.jpg",
    alt: "Industrial Warehouse Safety Netting",
    title: "Logistics Hub Storage Net",
    caption: "Ceiling-to-floor containment preventing high-bay pallet falls.",
    badge: "Warehouse Safety"
  },
  {
    src: "/images/duct-net.webp",
    alt: "Vertical Duct Enclosure",
    title: "Internal Duct Void Enclosure",
    caption: "Continuous floor-to-floor vertical barrier protecting service shafts.",
    badge: "Shaft Protection"
  }
];
---

<SubPageLayout
  title="Car Parking Safety Nets | Podium & Basement Vehicle Protection | Invisible Safety"
  description="High-density car parking safety nets for podiums, basements, and open lots with custom site quote Prevents ball damage, bird droppings, and debris."
  canonicalUrl="/car-parking-safety-nets/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="VEHICULAR & PODIUM PROTECTION"
  heroTitle="CAR PARKING SAFETY NETS"
  heroSubtitle="High-tensile perimeter safety netting arrays shielding residential podiums, driveways, and basement parking bays from stray cricket balls, falling debris, and roosting birds."
  heroImage="/images/car-parking-net.jpg"
  heroImageAlt="Car Parking Safety Nets Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Parking Defense Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">AUTOMOTIVE ASSET DEFENSE</span>
        <h2 class="editorial-title">Zero Dent &amp; Glass Breakage Protection</h2>
        <p class="editorial-subtitle">
          Podium parking adjacent to children play areas poses constant risk to vehicle glass and paint.
        </p>
      </div>

      <div class="park-grid">
        <div class="park-card">
          <h3 class="park-card-title">Ball Deflection Buffer</h3>
          <p class="park-card-desc">
            Positioned between sports play areas and open parking bays to absorb and deflect cricket balls, footballs, and basketballs with zero bounce damage.
          </p>
        </div>

        <div class="park-card">
          <h3 class="park-card-title">Pigeon Dropping Barrier</h3>
          <p class="park-card-desc">
            Acidic pigeon droppings permanently corrode luxury automotive clear-coats. Overhead netting seals basement ceiling pipes against bird roosting.
          </p>
        </div>

        <div class="park-card">
          <h3 class="park-card-title">Clear Headroom Clearance</h3>
          <p class="park-card-desc">
            Tensioned overhead with stainless steel guide cables that maintain complete clearance for high-roof SUVs and emergency fire response vehicles.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Estimator Section -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Parking Net Quote</h2>
        <p class="editorial-subtitle">
          Configure parking bay dimensions for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .park-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .park-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .park-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .park-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .park-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
