---
import BaseLayout from '../layouts/BaseLayout.astro';
import SolutionsAccordion from '../components/SolutionsAccordion.astro';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { getBreadcrumbSchema } from '../utils/seo';
import { ArrowRight, Sparkles, Phone } from 'lucide-react';
import { business } from '../data/business';

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Solutions", url: "https://invisiblesafety.in/solutions/" }
]);
---

<BaseLayout
  title="Safety Solutions Interactive Explorer | Invisible Safety"
  description="Explore Invisible Safety's 5 architectural safety systems: Stainless Steel invisible grills, apartment balcony safety nets, construction debris netting, pigeon exclusion, and specialty solutions."
  canonicalUrl="/solutions/"
  schema={[breadcrumbs]}
>
  <!-- Full-Width Interactive Solutions Showcase -->
  <section class="solutions-showcase-section">
    <div class="solutions-header-wrapper">
      <span class="editorial-eyebrow">ARCHITECTURAL SAFETY CATALOG</span>
      <h1 class="solutions-main-title">
        The Five Core Divisions
      </h1>
      <p class="solutions-subtitle">
        Explore our five architectural safety systems below. Select any collection to discover detailed metallurgy, material information, and dedicated format specifications.
      </p>
    </div>

    <!-- Interactive 100dvh Snap Stack Showcase -->
    <div class="solutions-content-wrapper">
      <SolutionsAccordion isStandalone={true} />
    </div>
  </section>

  <!-- Quick Concierge Consultation Strip -->
  <section class="editorial-concierge-strip">
    <div class="subpage-container">
      <div class="concierge-editorial-box">
        <span class="concierge-eyebrow">BALCONY MEASUREMENT & SIZING</span>
        <h2 class="concierge-title">Need a Multi-Balcony Consultation?</h2>
        <p class="concierge-desc">
          Our professional architectural surveyor will inspect your structure, measure cable lengths with high-precision accurates, present authentic Stainless Steel wire samples, and deliver a zero-obligation quotation across Hyderabad, Vizag, and Vijayawada.
        </p>
        <div class="concierge-actions">
          <a href="/contact/#quote" class="btn btn-primary">
            <span>REQUEST SITE SURVEY</span>
            <ArrowRight size={14} />
          </a>
          <a href={`tel:${business.phoneRaw}`} class="btn btn-secondary">
            <Phone size={14} />
            <span>DIRECT CALL: {business.phone}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <TrustSection />
</BaseLayout>

<style>
  .solutions-showcase-section {
    background-color: #F8FAFD;
    color: #1A365D;
    position: relative;
    padding-top: clamp(3rem, 5vw, 4.5rem);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-bottom: 1px solid #E2E8F0;
  }

  .solutions-header-wrapper {
    max-width: 820px;
    margin: 0 auto clamp(2rem, 4vw, 3rem) auto;
    width: 100%;
    text-align: center;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  .editorial-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #0284C7;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.75rem;
  }

  .solutions-main-title {
    font-family: var(--font-heading, 'Cinzel', serif);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #0F233D;
    text-transform: uppercase;
    margin: 0 0 1rem 0;
    line-height: 1.2;
  }

  .solutions-subtitle {
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    color: #475569;
    line-height: 1.6;
    margin: 0;
  }

  .solutions-content-wrapper {
    width: 100%;
  }

  .editorial-concierge-strip {
    background-color: #FDF6EE;
    color: #1A365D;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid #E2E8F0;
  }

  .subpage-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 3.5vw, 2.5rem);
    box-sizing: border-box;
  }

  .concierge-editorial-box {
    max-width: 840px;
    margin: 0 auto;
    text-align: center;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 20px;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 4vw, 3rem);
    box-shadow: 0 4px 20px rgba(15, 35, 61, 0.05);
  }

  .concierge-eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #0284C7;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.85rem;
  }

  .concierge-title {
    font-family: var(--font-heading, 'Cinzel', serif);
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #0F233D;
    text-transform: uppercase;
    margin: 0 0 1rem 0;
    line-height: 1.25;
  }

  .concierge-desc {
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    color: #475569;
    line-height: 1.6;
    margin: 0 auto 2rem auto;
    max-width: 640px;
  }

  .concierge-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 580px) {
    .concierge-actions {
      flex-direction: column;
      width: 100%;
    }

    .concierge-actions a {
      width: 100%;
    }
  }
</style>
