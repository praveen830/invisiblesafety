---
import BaseLayout from '../layouts/BaseLayout.astro';
import SolutionsAccordion from '../components/SolutionsAccordion.astro';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { getBreadcrumbSchema } from '../utils/seo';
import { ArrowRight, Sparkles } from 'lucide-react';

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.com/" },
  { name: "Solutions", url: "https://invisiblesafety.com/solutions/" }
]);
---

<BaseLayout
  title="Safety Solutions Interactive Explorer | Invisible Safety"
  description="Explore Invisible Safety's 5 architectural safety systems: SS316 invisible grills, apartment balcony safety nets, construction debris netting, pigeon exclusion, and specialty solutions."
  canonicalUrl="/solutions/"
  schema={[breadcrumbs]}
>
  <!-- Full-Width Interactive Solutions Showcase -->
  <section class="solutions-showcase-section">
    <div class="solutions-header-wrapper">
      <div class="catalog-eyebrow-pill">
        <Sparkles size={14} color="#38BDF8" />
        <span>ARCHITECTURAL SAFETY CATALOG</span>
      </div>
      <h1 class="solutions-main-title">
        Explore Solutions By Category
      </h1>
      <p class="solutions-subtitle">
        Explore our 5 architectural safety systems below. Select any category to view specifications, pricing, and dedicated solutions.
      </p>
    </div>

    <!-- Interactive Showcase (Desktop Horizontal Accordion & Mobile Touch Cards) -->
    <div class="solutions-content-wrapper">
      <SolutionsAccordion isStandalone={true} />
    </div>
  </section>

  <!-- Quick Assistance / Consultation Strip -->
  <section class="consultation-strip">
    <div class="container consultation-inner">
      <div class="consultation-text">
        <h3 class="consultation-title">
          Need a Custom Multi-Balcony Consultation?
        </h3>
        <p class="consultation-desc">
          Our structural engineers provide free on-site laser measurement across Hyderabad, Vizag & Vijayawada.
        </p>
      </div>
      <div class="consultation-actions">
        <a href="/invisible-grill-cost/" class="btn btn-primary">
          <span>Instant Cost Estimator</span>
          <ArrowRight size={14} />
        </a>
        <a href="/contact/" class="btn btn-secondary">
          <span>Schedule Site Visit</span>
        </a>
      </div>
    </div>
  </section>

  <TrustSection />
</BaseLayout>

<style>
  .solutions-showcase-section {
    background: linear-gradient(180deg, #F0F9FF 0%, #F8FAFC 100%);
    border-bottom: 1px solid #E2E8F0;
    position: relative;
    padding: 3rem 1.5rem 4rem 1.5rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .solutions-header-wrapper {
    max-width: 800px;
    margin: 0 auto 2.2rem auto;
    width: 100%;
    text-align: center;
    box-sizing: border-box;
  }

  .catalog-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #E0F2FE;
    border: 1px solid #BAE6FD;
    padding: 0.35rem 0.9rem;
    border-radius: 30px;
    margin-bottom: 1rem;
  }

  .catalog-eyebrow-pill span {
    font-size: 0.76rem;
    font-weight: 800;
    color: #0369A1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .solutions-main-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: clamp(2rem, 3.8vw, 3.2rem);
    font-weight: 900;
    color: #0F172A;
    letter-spacing: -0.025em;
    line-height: 1.18;
    margin-bottom: 0.75rem;
  }

  .solutions-subtitle {
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    color: #475569;
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .solutions-content-wrapper {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  /* Consultation Strip */
  .consultation-strip {
    background: #FFFFFF;
    border-top: 1px solid #E2E8F0;
    border-bottom: 1px solid #E2E8F0;
    padding: 2.5rem 1.5rem;
  }

  .consultation-inner {
    max-width: 960px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .consultation-text {
    text-align: left;
    max-width: 540px;
  }

  .consultation-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #0F172A;
    margin-bottom: 0.35rem;
  }

  .consultation-desc {
    font-size: 0.9rem;
    color: #475569;
    margin: 0;
    line-height: 1.5;
  }

  .consultation-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 899px) {
    .solutions-showcase-section {
      padding: 2rem 1rem 3.5rem 1rem;
    }

    .solutions-header-wrapper {
      margin-bottom: 1.5rem;
    }

    .consultation-inner {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }

    .consultation-text {
      text-align: center;
    }

    .consultation-actions {
      justify-content: center;
      width: 100%;
    }

    .consultation-actions .btn {
      flex: 1;
      min-width: 160px;
      justify-content: center;
    }
  }
</style>
