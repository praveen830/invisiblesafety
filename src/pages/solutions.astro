---
import BaseLayout from '../layouts/BaseLayout.astro';
import SolutionsAccordion from '../components/SolutionsAccordion.astro';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { getBreadcrumbSchema } from '../utils/seo';
import { ArrowRight, Sparkles, Phone } from 'lucide-react';
import { business } from '../data/business';

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Solutions", url: "https://invisiblesafety.in/solutions/" }
]);
---

<BaseLayout
  title="Safety Solutions Interactive Explorer | Invisible Safety"
  description="Explore Invisible Safety's 5 architectural safety systems: SS316 invisible grills, apartment balcony safety nets, construction debris netting, pigeon exclusion, and specialty solutions."
  canonicalUrl="/solutions/"
  schema={[breadcrumbs]}
>
  <!-- Full-Width Interactive Solutions Showcase -->
  <section class="solutions-showcase-section">
    <div class="solutions-header-wrapper">
      <span class="editorial-eyebrow">ARCHITECTURAL SAFETY CATALOG</span>
      <h1 class="solutions-main-title">
        The Five Core Divisions
      </h1>
      <p class="solutions-subtitle">
        Explore our five architectural safety systems below. Select any collection to discover detailed metallurgy, load certifications, and dedicated format specifications.
      </p>
    </div>

    <!-- Interactive 100dvh Snap Stack Showcase -->
    <div class="solutions-content-wrapper">
      <SolutionsAccordion isStandalone={true} />
    </div>
  </section>

  <!-- Quick Concierge Consultation Strip -->
  <section class="editorial-concierge-strip">
    <div class="subpage-container">
      <div class="concierge-editorial-box">
        <span class="concierge-eyebrow">DOORSTEP LASER CALIBRATION</span>
        <h2 class="concierge-title">Need a Multi-Balcony Consultation?</h2>
        <p class="concierge-desc">
          Our certified architectural surveyor will inspect your structure, measure cable lengths with high-precision lasers, present authentic SS316 wire samples, and deliver a zero-obligation quotation across Hyderabad, Vizag, and Vijayawada.
        </p>
        <div class="concierge-actions">
          <a href="/contact/#quote" class="btn-editorial-pill">
            <span>REQUEST SITE SURVEY</span>
            <ArrowRight size={14} />
          </a>
          <a href={`tel:${business.phoneRaw}`} class="btn-editorial-pill-secondary">
            <Phone size={14} />
            <span>DIRECT CALL: {business.phone}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <TrustSection />
</BaseLayout>

<style>
  .solutions-showcase-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    position: relative;
    padding-top: clamp(3rem, 5vw, 4.5rem);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .solutions-header-wrapper {
    max-width: 820px;
    margin: 0 auto clamp(2rem, 4vw, 3rem) auto;
    width: 100%;
    text-align: center;
    padding: 0 1.5rem;
    box-sizing: border-box;
  }

  .editorial-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--color-gold, #C5A880);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.75rem;
  }

  .solutions-main-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #FFFFFF;
    text-transform: uppercase;
    margin: 0 0 1rem 0;
    line-height: 1.2;
  }

  .solutions-subtitle {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-style: italic;
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .solutions-content-wrapper {
    width: 100%;
  }

  .editorial-concierge-strip {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .subpage-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 3.5vw, 2.5rem);
    box-sizing: border-box;
  }

  .concierge-editorial-box {
    max-width: 840px;
    margin: 0 auto;
    text-align: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 4vw, 3rem);
  }

  .concierge-eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--color-gold, #C5A880);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.85rem;
  }

  .concierge-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: clamp(1.5rem, 3vw, 2.35rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #FFFFFF;
    text-transform: uppercase;
    margin: 0 0 1rem 0;
    line-height: 1.25;
  }

  .concierge-desc {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-style: italic;
    font-size: clamp(0.95rem, 1.2vw, 1.15rem);
    color: #CBD5E1;
    line-height: 1.6;
    margin: 0 auto 2rem auto;
    max-width: 640px;
  }

  .concierge-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-editorial-pill-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.75rem 2rem;
    border-radius: 0;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    font-weight: 500;
    transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    border: 1px solid rgba(255, 255, 255, 0.4);
    background-color: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #FFFFFF;
    text-decoration: none;
    cursor: pointer;
  }

  .btn-editorial-pill-secondary:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.9);
    color: #FFFFFF;
    transform: translateY(-2px);
  }

  @media (max-width: 580px) {
    .concierge-actions {
      flex-direction: column;
      width: 100%;
    }

    .concierge-actions a {
      width: 100%;
    }
  }
</style>
