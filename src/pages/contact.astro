---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getBreadcrumbSchema, getLocalBusinessSchema } from '../utils/seo';
import { Phone, MessageCircle, Mail, MapPin, Clock, ArrowRight, ShieldCheck, Check, Sparkles } from 'lucide-react';

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Contact", url: "https://invisiblesafety.in/contact/" }
]);
const localSchema = getLocalBusinessSchema();

const solutionsList = [
  { id: "balcony-grills", category: "INVISIBLE GRILLS", title: "Balcony Invisible Grills" },
  { id: "window-grills", category: "INVISIBLE GRILLS", title: "Window Invisible Grills" },
  { id: "staircase-grills", category: "INVISIBLE GRILLS", title: "Staircase Invisible Grills" },
  { id: "child-grills", category: "INVISIBLE GRILLS", title: "Child Safety Invisible Grills" },
  { id: "balcony-nets", category: "CORE SAFETY NETS", title: "Balcony Safety Nets" },
  { id: "children-nets", category: "CORE SAFETY NETS", title: "Children Safety Nets" },
  { id: "bird-protection", category: "BIRD PROTECTION", title: "Anti-Pigeon Nets & Spikes" },
  { id: "construction-nets", category: "CONSTRUCTION & INDUSTRIAL", title: "Construction & Duct Nets" }
];
---

<BaseLayout
  title="Schedule Free Site Survey & Contact | Invisible Safety"
  description="Book your free doorstep laser measurement and site survey for invisible grills and safety nets. Transparent pricing, SS316 certified marine-grade cables in Hyderabad, Vizag & Vijayawada."
  canonicalUrl="/contact/"
  schema={[localSchema, breadcrumbs]}
>
  <div class="site-contact-page">
    <!-- Clean Header / Hero matching Website Style -->
    <section class="contact-hero-section">
      <div class="container hero-inner">
        <span class="eyebrow">SITE MEASUREMENT & CONSULTATION</span>
        <h1 class="hero-main-heading">Schedule Your Free Doorstep Laser Measurement</h1>
        <p class="hero-description">
          Our structural engineers visit your apartment with physical SS316 wire and track samples, measure your space accurately with digital laser tools, and provide an exact quotation.
        </p>
      </div>
    </section>

    <!-- Main Multi-Step Survey Form -->
    <section class="contact-form-section" id="quote">
      <div class="container">
        <div class="form-master-card">
          <!-- STEP 01: Safety Solutions Required -->
          <div class="step-header-row">
            <div class="step-tag-wrapper">
              <span class="step-badge">STEP 01</span>
              <span class="step-subtitle-label">SAFETY SOLUTIONS REQUIRED</span>
            </div>
            <span class="badge badge-blue selected-counter-pill" id="selected-counter">0 selected</span>
          </div>

          <h2 class="step-title">Select Safety Solutions Needed</h2>
          <p class="step-desc">Choose the openings or safety systems you would like us to inspect and measure.</p>

          <div class="solutions-grid" id="solutions-grid">
            {solutionsList.map((sol) => (
              <button
                type="button"
                class="solution-tile"
                data-id={sol.id}
                data-name={sol.title}
                role="checkbox"
                aria-checked="false"
              >
                <div class="tile-content">
                  <span class="tile-category">{sol.category}</span>
                  <span class="tile-title">{sol.title}</span>
                </div>
                <div class="tile-checkbox">
                  <Check size={14} className="check-svg" />
                </div>
              </button>
            ))}
          </div>

          <!-- STEP 02: Location & Contact Details -->
          <div class="step-header-row step-two-divider">
            <div class="step-tag-wrapper">
              <span class="step-badge">STEP 02</span>
              <span class="step-subtitle-label">LOCATION & CONTACT DETAILS</span>
            </div>
          </div>

          <h2 class="step-title">Your Site Details & Contact Information</h2>
          <p class="step-desc">Provide your contact and apartment location so our local technician can coordinate the site visit.</p>

          <form id="contact-booking-form" class="site-booking-form">
            <div class="form-fields-grid">
              <!-- Pincode -->
              <div class="input-group">
                <label for="client-pincode" class="field-label">
                  Pincode <span class="required">*</span>
                </label>
                <input
                  type="text"
                  id="client-pincode"
                  class="field-input"
                  placeholder="e.g. 500081"
                  maxlength="6"
                  required
                />
              </div>

              <!-- Locality & City -->
              <div class="input-group">
                <label for="client-locality" class="field-label">
                  Locality & City <span class="required">*</span>
                </label>
                <input
                  type="text"
                  id="client-locality"
                  class="field-input"
                  placeholder="e.g. Madhapur / Hitec City, Hyderabad"
                  required
                />
              </div>

              <!-- Mobile Number -->
              <div class="input-group">
                <label for="client-phone" class="field-label">
                  Mobile Number <span class="required">*</span>
                </label>
                <input
                  type="tel"
                  id="client-phone"
                  class="field-input"
                  placeholder="+91 83097 55398"
                  required
                />
              </div>

              <!-- Client Name -->
              <div class="input-group">
                <label for="client-name" class="field-label">
                  Full Name <span class="required">*</span>
                </label>
                <input
                  type="text"
                  id="client-name"
                  class="field-input"
                  placeholder="e.g. Ramesh Kumar"
                  required
                />
              </div>

              <!-- Architectural Notes (Full Width) -->
              <div class="input-group full-width">
                <label for="client-notes" class="field-label">
                  Balcony / Window Details & Requirements <span class="optional">(Optional)</span>
                </label>
                <textarea
                  id="client-notes"
                  class="field-input field-textarea"
                  rows="3"
                  placeholder="e.g. 14th-floor main balcony with curved railing, master bedroom french windows, child safety spacing."
                ></textarea>
              </div>
            </div>

            <!-- Bottom Action & Trust Row -->
            <div class="form-action-footer">
              <div class="trust-commitments">
                <div class="trust-commit-item">
                  <ShieldCheck size={16} className="text-blue" />
                  <span>Complimentary on-site measurement</span>
                </div>
                <span class="commit-dot">•</span>
                <div class="trust-commit-item">
                  <span>Zero sales pressure</span>
                </div>
                <span class="commit-dot">•</span>
                <div class="trust-commit-item">
                  <span>Direct engineering quotation</span>
                </div>
              </div>

              <button type="submit" class="btn btn-primary btn-lg submit-quote-btn" id="submit-btn">
                <MessageCircle size={18} />
                <span>SEND QUOTE REQUEST ON WHATSAPP</span>
                <ArrowRight size={16} />
              </button>
            </div>
          </form>
        </div>

        <!-- 3-Column Business Direct Contact Hub matching Website Design -->
        <div class="contact-support-grid">
          <!-- WhatsApp Chat -->
          <div class="card support-card">
            <div class="support-card-top">
              <div class="icon-box-whatsapp">
                <MessageCircle size={22} />
              </div>
              <div>
                <h3 class="support-title">WhatsApp Instant Chat</h3>
                <span class="status-badge-green">Average reply &lt; 5 minutes</span>
              </div>
            </div>
            <p class="support-desc">
              Fastest way to send balcony photos, ask questions, or request same-day doorstep measurement.
            </p>
            <a
              href={`https://wa.me/${business.whatsapp}?text=Hello%20Invisible%20Safety%2C%20I%20would%20like%20to%20schedule%20a%20site%20measurement%20for%20my%20balcony.`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp support-btn"
            >
              <MessageCircle size={16} />
              <span>Chat on WhatsApp</span>
            </a>
          </div>

          <!-- Direct Phone -->
          <div class="card support-card">
            <div class="support-card-top">
              <div class="icon-box-blue">
                <Phone size={22} />
              </div>
              <div>
                <h3 class="support-title">Direct Phone Line</h3>
                <span class="status-badge-muted">8:00 AM – 8:30 PM Daily</span>
              </div>
            </div>
            <p class="support-desc">
              Speak directly with a certified installation engineer for technical consultation and scheduling.
            </p>
            <a
              href={`tel:${business.phoneRaw}`}
              class="btn btn-secondary support-btn"
            >
              <Phone size={16} />
              <span>Call: {business.phone}</span>
            </a>
          </div>

          <!-- Operations Hub & Cities -->
          <div class="card support-card">
            <div class="support-card-top">
              <div class="icon-box-navy">
                <MapPin size={22} />
              </div>
              <div>
                <h3 class="support-title">Central Operations Hub</h3>
                <span class="status-badge-muted">Telangana & Andhra Pradesh</span>
              </div>
            </div>
            <p class="support-desc">
              {business.address.street}, {business.address.locality}, {business.address.city}, {business.address.state} {business.address.pincode}
            </p>
            <div class="cities-pill-row">
              <span class="badge badge-neutral">Hyderabad</span>
              <span class="badge badge-neutral">Visakhapatnam</span>
              <span class="badge badge-neutral">Vijayawada</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust & FAQ Sections -->
    <TrustSection />
    <FAQSection />
  </div>
</BaseLayout>

<style>
  /* =========================================================================
     WEBSITE UNIFIED THEME: Clean White / Soft Slate & Professional Blue
     ========================================================================= */
  .site-contact-page {
    background-color: var(--color-bg, #FFFFFF);
    color: var(--color-body, #475569);
  }

  /* Hero Section */
  .contact-hero-section {
    background-color: var(--color-bg-warm, #F8FAFC);
    border-bottom: 1px solid var(--color-border, #E2E8F0);
    padding: 3.5rem 1.5rem 3rem 1.5rem;
    text-align: center;
  }

  .hero-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .hero-main-heading {
    font-family: var(--font-heading, 'Manrope', sans-serif);
    font-size: clamp(2.1rem, 4.2vw, 3.25rem);
    font-weight: 800;
    line-height: 1.18;
    color: var(--color-primary, #0F172A);
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .hero-description {
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    color: var(--color-muted, #64748B);
    line-height: 1.65;
    max-width: 720px;
    margin: 0 auto;
  }

  /* Main Form Container */
  .contact-form-section {
    padding: 3.5rem 1.5rem 5rem 1.5rem;
    background-color: var(--color-bg, #FFFFFF);
  }

  .form-master-card {
    max-width: 1020px;
    margin: 0 auto 3.5rem auto;
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: var(--radius-lg, 14px);
    box-shadow: var(--shadow-sm, 0 1px 3px rgba(0, 0, 0, 0.05));
    padding: 2.75rem 2.5rem;
    box-sizing: border-box;
  }

  /* Step Header Rows */
  .step-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .step-tag-wrapper {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .step-badge {
    background-color: var(--color-accent-light, #EFF6FF);
    color: var(--color-accent, #2563EB);
    border: 1px solid #BFDBFE;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm, 6px);
    letter-spacing: 0.06em;
  }

  .step-subtitle-label {
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent, #2563EB);
  }

  .selected-counter-pill {
    font-size: 0.78rem;
    font-weight: 700;
  }

  .step-two-divider {
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border, #E2E8F0);
  }

  .step-title {
    font-family: var(--font-heading, 'Manrope', sans-serif);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--color-primary, #0F172A);
    margin: 0.25rem 0 0.4rem 0;
    letter-spacing: -0.01em;
  }

  .step-desc {
    font-size: 0.95rem;
    color: var(--color-muted, #64748B);
    margin-bottom: 1.5rem;
  }

  /* Solutions 2-Column Grid */
  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .solution-tile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: var(--radius-md, 10px);
    padding: 1.15rem 1.25rem;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
    outline: none;
    user-select: none;
    width: 100%;
    box-sizing: border-box;
  }

  .solution-tile:hover {
    border-color: #CBD5E1;
    background-color: var(--color-bg-warm, #F8FAFC);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .solution-tile.is-selected {
    border-color: var(--color-accent, #2563EB);
    background-color: var(--color-accent-light, #EFF6FF);
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.12);
  }

  .tile-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .tile-category {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent, #2563EB);
  }

  .tile-title {
    font-family: var(--font-heading, 'Manrope', sans-serif);
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--color-primary, #0F172A);
  }

  .tile-checkbox {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1.5px solid #CBD5E1;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-left: 0.75rem;
    background: #FFFFFF;
    transition: all 0.2s ease;
  }

  .tile-checkbox .check-svg {
    opacity: 0;
    color: #FFFFFF;
    transform: scale(0.6);
    transition: all 0.2s ease;
  }

  .solution-tile.is-selected .tile-checkbox {
    background: var(--color-accent, #2563EB);
    border-color: var(--color-accent, #2563EB);
  }

  .solution-tile.is-selected .tile-checkbox .check-svg {
    opacity: 1;
    transform: scale(1);
  }

  /* Form Fields Grid */
  .site-booking-form {
    display: flex;
    flex-direction: column;
  }

  .form-fields-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .input-group.full-width {
    grid-column: 1 / -1;
  }

  .field-label {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-secondary, #334155);
  }

  .field-label .required {
    color: #DC2626;
  }

  .field-label .optional {
    color: var(--color-muted, #64748B);
    font-weight: 500;
    font-size: 0.78rem;
  }

  .field-input {
    width: 100%;
    height: 48px;
    padding: 0 1rem;
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: var(--radius-sm, 6px);
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 0.95rem;
    color: var(--color-primary, #0F172A);
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    outline: none;
  }

  .field-input::placeholder {
    color: #94A3B8;
    font-size: 0.9rem;
  }

  .field-input:focus {
    border-color: var(--color-accent, #2563EB);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }

  .field-textarea {
    height: 85px;
    padding: 0.75rem 1rem;
    resize: vertical;
  }

  /* Action Footer & Button */
  .form-action-footer {
    margin-top: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border, #E2E8F0);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .trust-commitments {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--color-secondary, #334155);
    font-weight: 500;
    flex-wrap: wrap;
  }

  .trust-commit-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .commit-dot {
    opacity: 0.4;
    color: var(--color-muted);
  }

  .submit-quote-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  /* 3 Support Cards */
  .contact-support-grid {
    max-width: 1020px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .support-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.75rem;
  }

  .support-card-top {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    margin-bottom: 0.85rem;
  }

  .icon-box-whatsapp, .icon-box-blue, .icon-box-navy {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm, 6px);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-box-whatsapp {
    background-color: var(--color-success-light, #F0FDF4);
    color: var(--color-success, #16A34A);
  }

  .icon-box-blue {
    background-color: var(--color-accent-light, #EFF6FF);
    color: var(--color-accent, #2563EB);
  }

  .icon-box-navy {
    background-color: #F1F5F9;
    color: var(--color-primary, #0F172A);
  }

  .support-title {
    font-family: var(--font-heading, 'Manrope', sans-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary, #0F172A);
    margin: 0 0 0.15rem 0;
  }

  .status-badge-green {
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--color-success, #16A34A);
    display: block;
  }

  .status-badge-muted {
    font-size: 0.74rem;
    color: var(--color-muted, #64748B);
    display: block;
  }

  .support-desc {
    font-size: 0.9rem;
    color: var(--color-body, #475569);
    line-height: 1.55;
    margin-bottom: 1.5rem;
  }

  .support-btn {
    width: 100%;
    font-size: 0.9rem;
    height: 44px;
    margin-top: auto;
  }

  .cities-pill-row {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: auto;
  }

  /* Responsive Adjustments */
  @media (max-width: 899px) {
    .contact-hero-section {
      padding: 2.5rem 1rem 2rem 1rem;
    }

    .contact-form-section {
      padding: 2rem 1rem 3.5rem 1rem;
    }

    .form-master-card {
      padding: 1.5rem 1.25rem;
      border-radius: 12px;
      margin-bottom: 2rem;
    }

    .solutions-grid {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .form-fields-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .input-group.full-width {
      grid-column: 1;
    }

    .form-action-footer {
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
    }

    .trust-commitments {
      justify-content: center;
      text-align: center;
      font-size: 0.8rem;
    }

    .submit-quote-btn {
      width: 100%;
      height: 48px;
    }

    .contact-support-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>

<script>
  function initContactSurvey() {
    const grid = document.getElementById('solutions-grid');
    const counter = document.getElementById('selected-counter');
    const form = document.getElementById('contact-booking-form');
    if (!grid || !counter || !form) return;

    const cards = grid.querySelectorAll<HTMLButtonElement>('.solution-tile');
    const selectedSolutions: string[] = [];

    function updateCounter() {
      const count = selectedSolutions.length;
      counter.textContent = `${count} selected`;
      if (count > 0) {
        counter.classList.remove('badge-neutral');
        counter.classList.add('badge-blue');
      } else {
        counter.classList.remove('badge-blue');
        counter.classList.add('badge-neutral');
      }
    }

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const name = card.dataset.name || '';
        const isSelected = card.classList.contains('is-selected');

        if (isSelected) {
          card.classList.remove('is-selected');
          card.setAttribute('aria-checked', 'false');
          const idx = selectedSolutions.indexOf(name);
          if (idx !== -1) selectedSolutions.splice(idx, 1);
        } else {
          card.classList.add('is-selected');
          card.setAttribute('aria-checked', 'true');
          if (!selectedSolutions.includes(name)) {
            selectedSolutions.push(name);
          }
        }

        updateCounter();
      });
    });

    // Form Submission: Compile into direct WhatsApp message
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const nameInput = document.getElementById('client-name') as HTMLInputElement;
      const phoneInput = document.getElementById('client-phone') as HTMLInputElement;
      const localityInput = document.getElementById('client-locality') as HTMLInputElement;
      const pincodeInput = document.getElementById('client-pincode') as HTMLInputElement;
      const notesInput = document.getElementById('client-notes') as HTMLTextAreaElement;

      const name = nameInput?.value.trim() || '';
      const phone = phoneInput?.value.trim() || '';
      const locality = localityInput?.value.trim() || '';
      const pincode = pincodeInput?.value.trim() || '';
      const notes = notesInput?.value.trim() || '';

      const solutionsText = selectedSolutions.length > 0
        ? selectedSolutions.join(', ')
        : 'All Safety Systems / General Consultation';

      let msg = `*Site Measurement & Quote Request - Invisible Safety*\n\n`;
      msg += `👤 *Client Name:* ${name}\n`;
      msg += `📞 *Mobile:* ${phone}\n`;
      msg += `📍 *Locality & City:* ${locality} (Pincode: ${pincode})\n`;
      msg += `🛡️ *Required Solutions:* ${solutionsText}\n`;
      if (notes) {
        msg += `📝 *Notes/Openings:* ${notes}\n`;
      }
      msg += `\n_Sent via Invisible Safety Online Consultation_`;

      const businessWhatsapp = "918309755398";
      const targetUrl = `https://wa.me/${businessWhatsapp}?text=${encodeURIComponent(msg)}`;
      window.open(targetUrl, '_blank');
    });
  }

  document.addEventListener('DOMContentLoaded', initContactSurvey);
  document.addEventListener('astro:page-load', initContactSurvey);
</script>
