---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2, Shield, Bird } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "SS304 Anti-Bird Spikes",
  "High-grade stainless steel SS304 bird spikes on UV-stabilized polycarbonate base for AC ledges, parapets, and window sills with custom site quote",
  120
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Animal & Bird Protection", url: "https://invisiblesafety.in/pigeon-nets/" },
  { name: "Bird Spikes", url: "https://invisiblesafety.in/bird-spikes/" }
]);

const specs = [
  { label: "Spike Metallurgy", value: "AISI 304 Marine Stainless Steel", icon: ShieldCheck },
  { label: "Base Structure", value: "Virgin UV-Resistant Polycarbonate", icon: Award },
  { label: "Humane Compliance", value: "100% Non-Lethal Blunt Tips", icon: Bird },
  { label: "Durability Guarantee", value: "5-Year Rust & Crack Warranty", icon: Wrench }
];

const subcategories = [
  {
    title: "Translucent Anti-Pigeon Netting",
    subtitle: "Near-invisible monofilament grid denying roosting access to pigeons without daylight blockage.",
    href: "/pigeon-nets/",
    image: "/images/pigeon-net.webp",
    spec: "Virgin UV-Stabilized Co-Polymer",
    badge: "Discreet Living"
  },
  {
    title: "Anti-Monkey Balcony Enclosures",
    subtitle: "High-tensile braided wire netting designed to withstand aggressive monkey pulling and tampering.",
    href: "/monkey-safety-nets/",
    image: "/images/safety-net-balcony.webp",
    spec: "Reinforced Multi-Cord Tension",
    badge: "Wildlife Defense"
  },
  {
    title: "Building Duct Shaft Enclosures",
    subtitle: "Continuous vertical netting closing deep building plumbing ducts to prevent bird nesting.",
    href: "/duct-safety-nets/",
    image: "/images/duct-net.webp",
    spec: "Shaft Void Protection",
    badge: "Hygiene Guard"
  },
  {
    title: "Fine-Mesh Insect & Mosquito Nets",
    subtitle: "Pleated and roller insect screens providing 100% insect protection with cross-ventilation.",
    href: "/mosquito-safety-nets/",
    image: "/images/terrace-top-net.jpg",
    spec: "Fiberglass Anti-Tear Mesh",
    badge: "Clean Airflow"
  }
];

const gallery = [
  {
    src: "/images/balcony-safety.webp",
    alt: "Stainless Steel Bird Spikes along Parapet",
    title: "SS304 Anti-Perching Ledge Spikes",
    caption: "Precision silicon-bonded spikes installed on high-rise AC ledges and parapet copings.",
    badge: "Facade Protection"
  },
  {
    src: "/images/pigeon-net.webp",
    alt: "Translucent Pigeon Net on Balcony",
    title: "Translucent Skyline Protection",
    caption: "Unobtrusive bird exclusion preserving pristine aesthetic elevation.",
    badge: "Penthouse Living"
  },
  {
    src: "/images/safety-net-balcony.webp",
    alt: "Reinforced Anti-Monkey Enclosure",
    title: "High-Tensile Balcony Barrier",
    caption: "Heavy-gauge netting protecting hillside residences against wildlife intrusion.",
    badge: "Perimeter Shield"
  },
  {
    src: "/images/terrace-top-net.jpg",
    alt: "Terrace Bird Exclusion Netting",
    title: "Rooftop Air Duct & Terrace Net",
    caption: "Wide-span horizontal netting keeping roof shafts free of bird nesting.",
    badge: "Clean Architecture"
  }
];
---

<SubPageLayout
  title="SS304 Stainless Steel Bird Spikes | Anti-Pigeon Ledge Repellent | Invisible Safety"
  description="High-grade SS304 stainless steel bird spikes on UV-stabilized polycarbonate base for AC ledges, parapets, and sills with custom site quote 100% humane, zero-rust guaranteed."
  canonicalUrl="/bird-spikes/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="HUMANE AVIAN EXCLUSION"
  heroTitle="STAINLESS STEEL BIRD SPIKES"
  heroSubtitle="Surgical-grade SS304 stainless steel blunt spikes mounted on flexible UV polycarbonate bases, preventing pigeons and birds from landing on narrow parapets, window sills, and AC units."
  heroImage="/images/balcony-safety.webp"
  heroImageAlt="SS304 Stainless Steel Bird Spikes Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Ledge Protection Dynamics Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">TARGETED PERCH DENIAL</span>
        <h2 class="editorial-title">Engineered Parapet &amp; AC Protection</h2>
        <p class="editorial-subtitle">
          Designed for narrow architectural surfaces where full netting is impractical or unnecessary.
        </p>
      </div>

      <div class="spikes-grid">
        <div class="spike-card">
          <h3 class="spike-card-title">Grade AISI 304 Stainless Steel</h3>
          <p class="spike-card-desc">
            Marine-grade stainless rods will never rust, stain exterior painted walls, or become brittle under intense direct tropical sunlight.
          </p>
        </div>

        <div class="spike-card">
          <h3 class="spike-card-title">Polycarbonate Flexible Base</h3>
          <p class="spike-card-desc">
            Virgin Makrolon polycarbonate strip bends smoothly along curved facade arches, AC compressor brackets, and undulating concrete surfaces.
          </p>
        </div>

        <div class="spike-card">
          <h3 class="spike-card-title">Industrial Silicone Bonding</h3>
          <p class="spike-card-desc">
            Mounted with weather-resistant industrial structural adhesive that bonds permanently without drilling into waterproofing membranes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Smart Cost Estimator -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Bird Spikes Quote</h2>
        <p class="editorial-subtitle">
          Configure running feet of parapets and AC ledges for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection category="safety-nets" title="Bird Spikes Questions &amp; Answers" />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .spikes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .spike-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .spike-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .spike-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .spike-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
