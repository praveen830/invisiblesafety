---
import BaseLayout from '../layouts/BaseLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { pricing } from '../data/pricing';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Check, Sparkles, MessageCircle, Phone, ArrowRight, Target, Activity } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Sports & Cricket Practice Nets",
  "High-impact UV-stabilized sports and cricket practice netting for rooftops, terraces, and clubhouses starting at ₹18/sq.ft.",
  18
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisprotect.com/" },
  { name: "Sports Nets", url: "https://invisprotect.com/sports-nets/" }
]);
