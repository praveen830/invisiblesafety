---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import FAQSection from '../components/FAQSection.astro';
import TrustSection from '../components/TrustSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2, Check, ArrowRight } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Sports & Cricket Practice Nets",
  "High-impact UV-stabilized sports and cricket practice netting for rooftops, terraces, and clubhouses with custom site quote",
  18
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Sports Nets", url: "https://invisiblesafety.in/sports-nets/" }
]);

const specs = [
  { label: "Core Composition", value: "High-Tenacity Multi-Strand HDPE", icon: ShieldCheck },
  { label: "Impact Rating", value: "Cricket Ball Tested (140+ km/h)", icon: Award },
  { label: "Mounting Metallurgy", value: "Rust-Proof Marine SS Wire Rope", icon: Wrench },
  { label: "Direct Warranty", value: "Certified High-Tension Guarantee", icon: CheckCircle2 }
];

const subcategories = [
  {
    title: "Rooftop Cricket Practice Nets",
    subtitle: "Enclosed practice cages allowing hard leather ball batting practice without perimeter danger.",
    href: "/sports-practice-nets/",
    image: "/images/sports-nets.webp",
    spec: "Heavy-Gauge Multi-Strand Braided Mesh",
    badge: "Most Popular"
  },
  {
    title: "Ceiling Cloth Drying Hangers",
    subtitle: "Individual stainless steel pull-down pipes maximizing balcony utility and airflow.",
    href: "/cloth-drying-hangers/",
    image: "/images/cloth-drying-hanger.jpg",
    spec: "100% Stainless Steel Rust-Proof Rods",
    badge: "Utility Suite"
  },
  {
    title: "Swimming Pool Protective Nets",
    subtitle: "High-tension surface barriers preventing accidental pool falls by infants and pets.",
    href: "/swimming-pool-nets/",
    image: "/images/swimming-pool-net.jpg",
    spec: "Corrosion-Proof Marine Anchors",
    badge: "Family Safety"
  },
  {
    title: "Coconut Palm Anti-Drop Netting",
    subtitle: "Suspended impact-absorption nets preventing heavy coconut fall damage to cars and residents.",
    href: "/coconut-safety-nets/",
    image: "/images/coconut-safety-net.jpg",
    spec: "Heavy Impact-Cushioning Webbing",
    badge: "Property Protection"
  }
];

const gallery = [
  {
    src: "/images/sports-nets.webp",
    alt: "Rooftop Cricket Turf Netting",
    title: "High-Rise Rooftop Cricket Turf",
    caption: "Full-height multi-lane cricket practice enclosure overlooking city skyline.",
    badge: "Society Turf"
  },
  {
    src: "/images/cloth-drying-hanger.jpg",
    alt: "Balcony Ceiling Clothes Hanger",
    title: "Architectural Pulley System",
    caption: "Retractable ceiling-mounted drying tracks preserving floor space.",
    badge: "Balcony Utility"
  },
  {
    src: "/images/swimming-pool-net.jpg",
    alt: "Swimming Pool Protective Cover",
    title: "Villas Pool Safety Barrier",
    caption: "Precision edge-anchored tension net safeguarding toddlers and pets.",
    badge: "Villa Safety"
  },
  {
    src: "/images/coconut-safety-net.jpg",
    alt: "Coconut Drop Catch Netting",
    title: "High-Impact Canopy Catch",
    caption: "Heavy-duty perimeter webbing preventing vehicular glass damage.",
    badge: "Property Protection"
  }
];
---

<SubPageLayout
  title="Sports & Cricket Practice Nets for Terraces & Rooftops | Invisible Safety"
  description="High-impact ball containment sports netting for cricket pitches, society turfs, and residential rooftops. Heavy-duty UV-stabilized polymer."
  canonicalUrl="/sports-nets/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="SPECIALTY LEISURE & UTILITIES"
  heroTitle="THE APERTURE COLLECTION"
  heroSubtitle="High-impact ball containment sports netting and structural utility arrays for residential rooftops, sports turf enclosures, and villas."
  heroImage="/images/sports-nets.webp"
  heroImageAlt="Sports and Cricket Practice Net Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Sports Netting Engineering Highlights -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">BALL RETENTION DYNAMICS</span>
        <h2 class="editorial-title">Engineering For High Velocity</h2>
        <p class="editorial-subtitle">
          Designed to safely dissipate kinetic energy from hard leather cricket balls and tennis shots.
        </p>
      </div>

      <div class="sports-specs-grid">
        <div class="sports-spec-card">
          <span class="sports-spec-num">01</span>
          <h3 class="sports-spec-title">UV-Treated Virgin HDPE</h3>
          <p class="sports-spec-desc">
            Mono-filament high-density polyethylene strands resistant to intense summer solar degradation and monsoon storms without softening or rotting.
          </p>
        </div>

        <div class="sports-spec-card">
          <span class="sports-spec-num">02</span>
          <h3 class="sports-spec-title">Double-Knotted Knitted Grid</h3>
          <p class="sports-spec-desc">
            Locked junction joints prevent mesh deformation when hit by high-speed drives, ensuring tight pitch containment over years of use.
          </p>
        </div>

        <div class="sports-spec-card">
          <span class="sports-spec-num">03</span>
          <h3 class="sports-spec-title">SS Wire Rope Suspensions</h3>
          <p class="sports-spec-desc">
            Heavy-gauge stainless steel guide cables and turnbuckles keep net ceilings taut and level, eliminating drooping across large rooftop spans.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Smart Cost Estimator -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Sports Net Cost</h2>
        <p class="editorial-subtitle">
          Configure turf or terrace area dimensions for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .sports-specs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .sports-spec-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    position: relative;
    transition: all 0.3s ease;
  }

  .sports-spec-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .sports-spec-num {
    font-size: 1.75rem;
    font-weight: 800;
    font-family: var(--font-brand, 'Cinzel', serif);
    color: var(--color-gold, #C5A880);
    display: block;
    margin-bottom: 0.75rem;
    opacity: 0.7;
  }

  .sports-spec-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .sports-spec-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
