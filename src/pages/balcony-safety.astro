---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import BeforeAfterSlider from '../components/react/BeforeAfterSlider';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2, Shield, Eye, Activity, Check, ArrowRight } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Balcony Fall Safety Solutions",
  "High-rise balcony safety grills and netting systems designed for modern residential towers in India with custom site quote",
  190
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Balcony Safety", url: "https://invisiblesafety.in/balcony-safety/" }
]);

const specs = [
  { label: "Core Metallurgy", value: "Virgin Japanese SS316 / HDPE Polymer", icon: ShieldCheck },
  { label: "Impact Rating", value: "400+ kgf Breaking Load (SS316)", icon: Award },
  { label: "Visual Permeability", value: "98% Unobstructed Skyline Vista", icon: Eye },
  { label: "Compliance Guarantee", value: "100% Gated Society RWA Approved", icon: CheckCircle2 }
];

const subcategories = [
  {
    title: "Balcony Invisible Grills",
    subtitle: "Floor-to-ceiling high-tensile SS316 marine cables providing 400+ kgf fall safety with unobstructed panoramic views.",
    href: "/balcony-invisible-grills/",
    image: "/images/hero-balcony.webp",
    spec: "Japanese SS316 (2.0mm / 2.5mm)",
    badge: "Flagship Luxury"
  },
  {
    title: "Apartment Balcony Safety Nets",
    subtitle: "UV-stabilized high-density polymer netting stopping infant and pet falls without cage-like aesthetic disruption.",
    href: "/safety-nets/",
    image: "/images/safety-net-balcony.webp",
    spec: "150+ kgf Impact Resistance",
    badge: "Child & Pet Core"
  },
  {
    title: "French Window Invisible Grills",
    subtitle: "Frameless tensile cable installations for floor-to-ceiling bedroom and living room glass sliding fenestrations.",
    href: "/window-invisible-grills/",
    image: "/images/window-invisible-grills.webp",
    spec: "50mm / 75mm Spacing Options",
    badge: "Fenestration Suite"
  },
  {
    title: "Child-Safe Calibrated Mesh",
    subtitle: "Zero-foothold tensioned safety systems strictly preventing toddler climbing leverage or head entrapment.",
    href: "/child-safety-invisible-grills/",
    image: "/images/child-safety.webp",
    spec: "50mm Anti-Entrapment Core",
    badge: "Toddler Proof"
  }
];

const gallery = [
  {
    src: "/images/balcony-safety.webp",
    alt: "Balcony Fall Safety Invisible Grills",
    title: "High-Rise Balcony Suite",
    caption: "Engineered SS316 cables securing a 24th-floor penthouse balcony overlooking the urban skyline.",
    badge: "High-Rise Specialized"
  },
  {
    src: "/images/hero-balcony.webp",
    alt: "Panoramic Skyline Invisible Grills",
    title: "Panoramic Skyline Deck",
    caption: "Full-width tensile installation preserving daylight and evening skyline vistas.",
    badge: "100% RWA Approved"
  },
  {
    src: "/images/safety-net-balcony.webp",
    alt: "Balcony Safety Net Array",
    title: "Resilient Balcony Netting",
    caption: "UV-treated high-density netting anchored with stainless steel eye bolts.",
    badge: "Impact Tested"
  },
  {
    src: "/images/child-safety.webp",
    alt: "Toddler and Pet Safe Balcony",
    title: "Toddler Anti-Fall System",
    caption: "Tight-calibrated barrier giving parents total peace of mind in high-rise residences.",
    badge: "Family Peace of Mind"
  }
];
---

<SubPageLayout
  title="Balcony Safety Grills & Fall Protection Systems | Invisible Safety"
  description="Engineered balcony fall-safety systems for high-rise apartments. SS316 marine invisible grills & reinforced safety mesh. 400+ kg breaking load, 100% RWA approved."
  canonicalUrl="/balcony-safety/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="HIGH-RISE BALCONY SPECIALIZATION"
  heroTitle="ENGINEERED BALCONY FALL PROTECTION"
  heroSubtitle="Balcony heights above the 4th floor present severe fall hazards. Our certified SS316 marine-grade tensile cables safeguard children and pets with 400+ kgf load resistance while preserving open 180° panoramic vistas."
  heroImage="/images/balcony-safety.webp"
  heroImageAlt="Engineered Balcony Fall Safety Systems"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Interactive Architectural Visualizer: Before vs After -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">THE ARCHITECTURAL DIFFERENCE</span>
        <h2 class="editorial-title">Balcony Transformation</h2>
        <p class="editorial-subtitle">
          Slide to experience the difference between bulky iron cages and our virtually invisible SS316 marine tensile system.
        </p>
      </div>

      <div class="visualizer-wrapper">
        <BeforeAfterSlider client:visible />
      </div>
    </div>
  </section>

  <!-- Interactive Smart Cost Estimator -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Balcony Safety Cost</h2>
        <p class="editorial-subtitle">
          Configure your balcony dimensions for real-time instant quotation and certified laser measurement scheduling.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection category="safety-nets" title="Balcony Safety Questions &amp; Answers" />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .visualizer-wrapper {
    max-width: 1080px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
