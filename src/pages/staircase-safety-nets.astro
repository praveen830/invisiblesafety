---
import BaseLayout from '../layouts/BaseLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Sparkles, MessageCircle, Phone, ArrowRight, Shield, Layers } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Staircase Safety Nets",
  "High-density polymer safety netting for multi-level stairwells, atrium voids, and duplex staircases from ₹25/sq.ft.",
  25
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisprotect.com/" },
  { name: "Core Safety Nets", url: "https://invisprotect.com/safety-nets/" },
  { name: "Staircase Safety Nets", url: "https://invisprotect.com/staircase-safety-nets/" }
]);
---

<BaseLayout
  title="Staircase Safety Nets | Multi-Level Void Drop Fall Defense | InvisProtect"
  description="Certified stairwell and atrium void fall-protection safety netting from ₹25/sq.ft. Anti-sag virgin Garware polymer with 3-year warranty."
  canonicalUrl="/staircase-safety-nets/"
  schema={[serviceSchema, breadcrumbs]}
>
  <section class="section-spacing" style="background: linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%); border-bottom: 1px solid #E2E8F0; padding-top: 2rem;">
    <div class="container">
      <nav style="font-size: 0.76rem; font-weight: 700; color: #64748B; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 2rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
        <a href="/" style="color: #64748B; text-decoration: none;">HOME</a>
        <span>/</span>
        <a href="/safety-nets/" style="color: #64748B; text-decoration: none;">CORE SAFETY NETS</a>
        <span>/</span>
        <span style="color: #C2410C;">STAIRCASE SAFETY NETS</span>
      </nav>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 3.5rem; align-items: start;">
        <div style="position: sticky; top: 100px;">
          <div style="position: relative; border-radius: 24px; overflow: hidden; background: #0F172A; box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.18); aspect-ratio: 3/4;">
            <img
              src="/images/safety-net-balcony.webp"
              alt="Staircase Safety Nets Enclosure"
              style="width: 100%; height: 100%; object-fit: cover;"
              loading="eager"
            />
            <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15, 23, 42, 0.1) 0%, rgba(15, 23, 42, 0.75) 100%); pointer-events: none;"></div>
            
            <div style="position: absolute; top: 16px; left: 16px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); border: 1px solid #BBF7D0; padding: 0.35rem 0.85rem; border-radius: 20px; font-size: 0.75rem; font-weight: 800; color: #15803D; display: flex; align-items: center; gap: 0.4rem;">
              <Layers size={13} /> STAIRWELL VOID PROTECTION
            </div>

            <div style="position: absolute; bottom: 20px; left: 20px; right: 20px; color: #FFFFFF; pointer-events: none;">
              <div style="font-size: 0.75rem; font-weight: 800; color: #4ADE80; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.25rem;">
                ATRIUM & DUPLEX VOID SHIELD
              </div>
              <div style="font-size: 1.4rem; font-weight: 900; line-height: 1.2;">
                Continuous Stairwell Fall Netting
              </div>
              <div style="font-size: 0.85rem; color: #CBD5E1; margin-top: 0.35rem;">
                100% Virgin Garware Polymer • Zero-Sag Rigging
              </div>
            </div>
          </div>
        </div>

        <div>
          <div style="display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.35rem 0.85rem; background: #F0FDF4; border: 1px solid #BBF7D0; border-radius: 20px; font-size: 0.78rem; font-weight: 800; color: #15803D; margin-bottom: 1rem;">
            <ShieldCheck size={14} /> MULTI-STOREY DROP ARREST
          </div>

          <h1 style="font-size: clamp(2.4rem, 4.2vw, 3.4rem); font-weight: 900; color: #0F172A; line-height: 1.15; margin-bottom: 0.75rem; letter-spacing: -0.03em;">
            STAIRCASE SAFETY NETS
          </h1>
          <p style="font-size: 1.2rem; font-weight: 600; color: #15803D; margin-bottom: 1.5rem; line-height: 1.4;">
            Certified high-density virgin polymer netting engineered for whole-stairwell void drops and multi-level railings.
          </p>

          <div style="display: flex; gap: 2rem; align-items: baseline; margin-bottom: 2rem; padding: 1.25rem 1.5rem; background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 14px;">
            <div>
              <span style="font-size: 0.72rem; color: #64748B; display: block; font-weight: 700; text-transform: uppercase;">Direct Starting Rate:</span>
              <span style="font-size: 2rem; font-weight: 900; color: #15803D;">₹25 <span style="font-size: 0.95rem; font-weight: 600; color: #64748B;">/ sq.ft</span></span>
            </div>
            <div style="width: 1px; height: 38px; background: #E2E8F0;"></div>
            <div>
              <span style="font-size: 0.72rem; color: #64748B; display: block; font-weight: 700; text-transform: uppercase;">Durability Warranty:</span>
              <span style="font-size: 1.25rem; font-weight: 800; color: #0284C7;">3-Year Anti-Sag</span>
            </div>
          </div>

          <p style="font-size: 1.05rem; color: #475569; line-height: 1.7; margin-bottom: 2rem;">
            In multi-storey apartments, schools, and commercial complexes, open vertical stairwell gaps present severe fall hazards. Staircase Safety Nets block the entire open shaft from top floor to ground level without blocking natural light, preventing accidental falls, toys dropping, or tragic injuries.
          </p>

          <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 16px; overflow: hidden; margin-bottom: 2.5rem; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);">
            <div style="padding: 1rem 1.5rem; background: #F8FAFC; border-bottom: 1px solid #E2E8F0; font-size: 0.82rem; font-weight: 800; color: #0F172A; letter-spacing: 0.08em; text-transform: uppercase;">
              TECHNICAL SPECIFICATION TABLE
            </div>
            <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem;">
              <tbody>
                <tr style="border-bottom: 1px solid #F1F5F9;">
                  <td style="padding: 0.9rem 1.5rem; font-weight: 700; color: #334155; width: 40%; background: #FAFAFA;">Polymer Brand</td>
                  <td style="padding: 0.9rem 1.5rem; color: #0F172A; font-weight: 600;">Garware Technical Fibres 100% Virgin Nylon</td>
                </tr>
                <tr style="border-bottom: 1px solid #F1F5F9;">
                  <td style="padding: 0.9rem 1.5rem; font-weight: 700; color: #334155; background: #FAFAFA;">Breaking Load</td>
                  <td style="padding: 0.9rem 1.5rem; color: #0F172A; font-weight: 600;">120+ kg to 250+ kg Single Knot Strength</td>
                </tr>
                <tr style="border-bottom: 1px solid #F1F5F9;">
                  <td style="padding: 0.9rem 1.5rem; font-weight: 700; color: #334155; background: #FAFAFA;">Aperture</td>
                  <td style="padding: 0.9rem 1.5rem; color: #0F172A; font-weight: 600;">25 mm / 30 mm Square Diamond Mesh</td>
                </tr>
                <tr style="border-bottom: 1px solid #F1F5F9;">
                  <td style="padding: 0.9rem 1.5rem; font-weight: 700; color: #334155; background: #FAFAFA;">Hardware</td>
                  <td style="padding: 0.9rem 1.5rem; color: #0F172A; font-weight: 600;">Stainless Steel Heavy-Duty Anchor Hooks & Turnbuckles</td>
                </tr>
                <tr>
                  <td style="padding: 0.9rem 1.5rem; font-weight: 700; color: #334155; background: #FAFAFA;">Warranty</td>
                  <td style="padding: 0.9rem 1.5rem; color: #16A34A; font-weight: 800;">3 Years Direct Anti-Sag & UV Breakdown Warranty</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="#estimator" class="btn btn-primary" style="padding: 0.95rem 1.85rem; background: #15803D; border-color: #15803D;">
              <span>Calculate Staircase Net Price</span>
              <ArrowRight size={17} />
            </a>
            <a
              href={`https://wa.me/${business.whatsapp}?text=Hi%20InvisProtect%2C%20I%20need%20Staircase%20Safety%20Nets%20installed.`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp"
              style="padding: 0.95rem 1.85rem;"
            >
              <MessageCircle size={17} />
              <span>Book Site Inspection on WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-spacing" style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0;" id="estimator">
    <div class="container">
      <div class="section-header" style="max-width: 780px; margin: 0 auto 3rem auto; text-align: center;">
        <span class="badge-emerald">INSTANT ESTIMATION</span>
        <h2>Calculate Staircase Safety Net Price</h2>
        <p>Enter your stairwell dimensions for instant pricing.</p>
      </div>
      <CostEstimator client:load />
    </div>
  </section>

  <TrustSection />
  <FAQSection category="safety-nets" title="Staircase Safety Nets FAQ" />
</BaseLayout>
