---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2 } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Staircase Safety Nets",
  "Vertical stairwell and duplex void fall-arrest safety netting for apartments, schools, and villas with custom site quote",
  18
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Safety Nets", url: "https://invisiblesafety.in/safety-nets/" },
  { name: "Staircase Safety Nets", url: "https://invisiblesafety.in/staircase-safety-nets/" }
]);

const specs = [
  { label: "Tensile Webbing", value: "High-Tenacity Virgin Nylon / HDPE", icon: ShieldCheck },
  { label: "Vertical Void Guard", value: "Continuous Floor-to-Floor Enclosure", icon: Award },
  { label: "Anchor Metallurgy", value: "Stainless Steel SS304 Wall Fasteners", icon: Wrench },
  { label: "Direct Warranty", value: "5-Year Certified Replacement Guarantee", icon: CheckCircle2 }
];

const subcategories = [
  {
    title: "Staircase Invisible Grills",
    subtitle: "Floor-to-ceiling vertical Japanese SS316 tension cables for luxury duplexes.",
    href: "/staircase-invisible-grills/",
    image: "/images/staircase-invisible-grills.webp",
    spec: "400+ kgf Breaking Load",
    badge: "SS316 Luxury"
  },
  {
    title: "Apartment Balcony Safety Nets",
    subtitle: "Full-perimeter protective enclosure stopping accidental falls without feeling caged.",
    href: "/balcony-safety/",
    image: "/images/safety-net-balcony.webp",
    spec: "Virgin High-Density Polymer",
    badge: "Residential Core"
  },
  {
    title: "Toddler & Pet Anti-Fall Nets",
    subtitle: "Calibrated mesh preventing toys, toddlers, or pets from squeezing through railings.",
    href: "/child-safety-nets/",
    image: "/images/child-safety.webp",
    spec: "Smooth Anti-Chafe Knots",
    badge: "Child Safe"
  },
  {
    title: "Terrace Top Fall Perimeter",
    subtitle: "Boundary safety netting installed over open roof parapets to secure terrace gatherings.",
    href: "/terrace-safety-nets/",
    image: "/images/terrace-top-net.jpg",
    spec: "High-Tensile Perimeter Tie Cords",
    badge: "Rooftop Guard"
  }
];

const gallery = [
  {
    src: "/images/staircase-invisible-grills.webp",
    alt: "Staircase Void Safety Net Array",
    title: "Duplex Stairwell Fall Barrier",
    caption: "Vertical continuous safety mesh sealing deep multi-floor central staircase voids in a luxury villa.",
    badge: "Void Guard"
  },
  {
    src: "/images/hero-balcony.webp",
    alt: "Balcony Invisible Grills",
    title: "Panoramic Skyline Aperture",
    caption: "High-contrast SS316 marine cables preserving panoramic cityscape views.",
    badge: "Skyline Vista"
  },
  {
    src: "/images/child-safety.webp",
    alt: "Child-Safe Calibrated Balcony",
    title: "Toddler Anti-Fall System",
    caption: "Zero footholds preventing climbing leverage with unyielding 400+ kg load strength.",
    badge: "Child & Pet Safety"
  },
  {
    src: "/images/terrace-top-net.jpg",
    alt: "Terrace Top Netting",
    title: "Terrace Party Deck Protection",
    caption: "Secured terrace boundary allowing safe evening gatherings and events.",
    badge: "Terrace Guard"
  }
];
---

<SubPageLayout
  title="Staircase Safety Nets | Stairwell Void Fall Protection | Invisible Safety"
  description="Floor-to-floor vertical stairwell safety netting for duplex homes, schools, and commercial apartments with custom site quote 150+ kg impact rating."
  canonicalUrl="/staircase-safety-nets/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="INTERNAL VOID FALL PROTECTION"
  heroTitle="STAIRCASE VOID SAFETY NETS"
  heroSubtitle="Floor-to-floor continuous high-tensile safety netting sealing central stairwell eye voids, open banister gaps, and duplex mezzanine drops against accidental falls."
  heroImage="/images/staircase-invisible-grills.webp"
  heroImageAlt="Staircase Safety Nets Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Staircase Void Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">CENTRAL VOID ENCLOSURE</span>
        <h2 class="editorial-title">Multi-Floor Stairwell Protection</h2>
        <p class="editorial-subtitle">
          Open stairwells in residential duplexes and schools pose extreme multi-story drop hazards.
        </p>
      </div>

      <div class="stair-nets-grid">
        <div class="stair-net-card">
          <h3 class="stair-card-title">Stairwell Eye Gap Closure</h3>
          <p class="stair-card-desc">
            Closes the central vertical void between ascending and descending flights, ensuring that even if a child slips over a banister, they are caught instantly at that floor level.
          </p>
        </div>

        <div class="stair-net-card">
          <h3 class="stair-card-title">Banister Railing Gap Fill</h3>
          <p class="stair-card-desc">
            Ornate or widely spaced railing spindles allow toddlers to squeeze through. The mesh ties securely along the internal face without damaging polished woodwork or marble.
          </p>
        </div>

        <div class="stair-net-card">
          <h3 class="stair-card-title">Commercial &amp; School Approved</h3>
          <p class="stair-card-desc">
            Widely installed in preschools, coaching academies, and hospital staircases to comply with municipal child safety and emergency fall prevention guidelines.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Estimator Section -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Staircase Net Quote</h2>
        <p class="editorial-subtitle">
          Configure stairwell dimensions for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stair-nets-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .stair-net-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .stair-net-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .stair-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .stair-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
