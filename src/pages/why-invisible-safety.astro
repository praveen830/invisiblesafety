---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustSection from '../components/TrustSection.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import { getBreadcrumbSchema } from '../utils/seo';
import { business } from '../data/business';
import { ShieldCheck, Check, X, MessageCircle } from 'lucide-react';

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.vercel.app/" },
  { name: "Why Invisible Safety", url: "https://invisiblesafety.vercel.app/why-invisible-safety/" }
]);
---

<BaseLayout
  title="Why Choose Invisible Safety | Architectural Safety vs Local Contractors"
  description="See why luxury homeowners trust Invisible Safety over unorganized local fabricators. Certified SS316 marine steel, IS 3521 harnesses, and direct warranty."
  canonicalUrl="/why-invisible-safety/"
  schema={[breadcrumbs]}
>
  <section class="section-spacing bg-warm" style="border-bottom: 1px solid var(--color-border);">
    <div class="container" style="text-align: center; max-width: 860px;">
      <span class="eyebrow" style="margin-bottom: 1rem;">The Invisible Safety Standard</span>
      <h1 style="font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 800; color: #0F172A; line-height: 1.15; margin-bottom: 1.25rem;">
        Engineered Safety vs <br />
        <span style="color: #2563EB;">Unregulated Contractors</span>
      </h1>
      <p style="font-size: 1.15rem; color: #475569; line-height: 1.6; max-width: 700px; margin: 0 auto 2rem auto;">
        When safeguarding your children on high-rise balconies, compromise is not an option. Discover the engineering, metallurgy, and accountability that sets Invisible Safety apart.
      </p>

      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="/invisible-grill-cost/" class="btn btn-primary">
          <span>Get Free Balcony Quote</span>
        </a>
        <a
          href={`https://wa.me/${business.whatsapp}?text=Hi%20Invisible%20Safety%2C%20I%20want%20to%20know%20more%20about%20your%20installation%20standards.`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
        >
          <MessageCircle size={17} />
          <span>Talk to Technical Lead</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Side-by-Side Detailed Comparison -->
  <section class="section-spacing bg-warm" style="border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">OBJECTIVE COMPARISON</span>
        <h2>How We Compare to Local Fabricators</h2>
        <p>A transparent look at the differences between certified engineering and low-cost shortcuts.</p>
      </div>

      <div class="grid-2" style="max-width: 980px; margin: 0 auto; gap: 2rem;">
        <!-- Invisible Safety Column -->
        <div class="card" style="border: 2px solid #2563EB; background: #FFFFFF; box-shadow: 0 8px 24px -4px rgba(37, 99, 235, 0.12); border-radius: 14px; padding: 2rem;">
          <div style="display: flex; align-items: center; gap: 0.5rem; color: #2563EB; font-weight: 700; font-size: 0.85rem; margin-bottom: 0.75rem;">
            <ShieldCheck size={20} />
            <span>INVISIBLE SAFETY STANDARDS</span>
          </div>
          <h3 style="font-size: 1.35rem; font-weight: 800; color: #0F172A; margin-bottom: 1.25rem;">
            Certified Architectural Excellence
          </h3>

          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.95rem; font-size: 0.92rem; color: #334155;">
            <li style="display: flex; gap: 0.65rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><Check size={18} color="#16A34A" /></span>
              <span><strong>Virgin SS316 Marine Alloy:</strong> Guaranteed 2.5% Molybdenum; lab test certificate provided on request.</span>
            </li>
            <li style="display: flex; gap: 0.65rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><Check size={18} color="#16A34A" /></span>
              <span><strong>IS 3521 Safety Harnesses:</strong> Technicians wear certified dual-lanyard fall arrest gear during entire job.</span>
            </li>
            <li style="display: flex; gap: 0.65rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><Check size={18} color="#16A34A" /></span>
              <span><strong>Hydraulic Swaging & Tensioning:</strong> Consistent 100+ kg tension per cable calibrated by gauge.</span>
            </li>
            <li style="display: flex; gap: 0.65rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><Check size={18} color="#16A34A" /></span>
              <span><strong>Official 10-Year Digital Warranty:</strong> Direct company warranty with free 3-month re-tension check.</span>
            </li>
            <li style="display: flex; gap: 0.65rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><Check size={18} color="#16A34A" /></span>
              <span><strong>Society RWA Compliance:</strong> Conforms strictly to elevation rules of luxury gated communities.</span>
            </li>
          </ul>
        </div>

        <!-- Local Fabricators Column -->
        <div class="card" style="border: 1px solid #FECACA; background: #FFF5F5; border-radius: 14px; padding: 2rem;">
          <div style="display: flex; align-items: center; gap: 0.5rem; color: #DC2626; font-weight: 700; font-size: 0.85rem; margin-bottom: 0.75rem;">
            <X size={20} />
            <span>UNORGANIZED CONTRACTORS</span>
          </div>
          <h3 style="font-size: 1.35rem; font-weight: 800; color: #991B1B; margin-bottom: 1.25rem;">
            Typical Shortcuts & Risks
          </h3>

          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.95rem; font-size: 0.92rem; color: #475569;">
            <li style="display: flex; gap: 0.65rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><X size={18} color="#DC2626" /></span>
              <span><strong>Inferior SS202 / SS304 Steel:</strong> Rusts and stains within 6–12 months, requiring complete replacement.</span>
            </li>
            <li style="display: flex; gap: 0.65rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><X size={18} color="#DC2626" /></span>
              <span><strong>Zero Safety Gear:</strong> Workers stand dangerously barefoot on 20th floor edges without lifelines.</span>
            </li>
            <li style="display: flex; gap: 0.65rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><X size={18} color="#DC2626" /></span>
              <span><strong>Manual Hand Pulling:</strong> Uneven loose cables that sag, flutter in the wind, and allow children to pull them apart.</span>
            </li>
            <li style="display: flex; gap: 0.65rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><X size={18} color="#DC2626" /></span>
              <span><strong>Verbal False Guarantees:</strong> No registered business identity; contractor stops answering calls after payment.</span>
            </li>
            <li style="display: flex; gap: 0.65rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><X size={18} color="#DC2626" /></span>
              <span><strong>Society Disapproval:</strong> Ugly misaligned tracks that result in warning notices from apartment RWAs.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <TrustSection />
  <ComparisonTable />
</BaseLayout>
