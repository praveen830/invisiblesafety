---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2 } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Coconut Tree Safety Nets",
  "High-impact tree canopy and suspended catchment safety netting preventing coconut fall damage with custom site quote",
  16
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Specialty Solutions", url: "https://invisiblesafety.in/sports-nets/" },
  { name: "Coconut Safety Nets", url: "https://invisiblesafety.in/coconut-safety-nets/" }
]);

const specs = [
  { label: "Impact Tensile Core", value: "Multi-Ply Heavy Nylon / HDPE", icon: ShieldCheck },
  { label: "Drop Protection", value: "Withstands Heavy Coconut Impact Drops", icon: Award },
  { label: "Anchor Cables", value: "Stainless Steel Tree Collar Grips", icon: Wrench },
  { label: "Durability Guarantee", value: "3-Year Weather & Sun Resistance", icon: CheckCircle2 }
];

const subcategories = [
  {
    title: "Swimming Pool Protective Nets",
    subtitle: "High-tension surface barriers preventing accidental pool falls by infants and pets.",
    href: "/swimming-pool-nets/",
    image: "/images/swimming-pool-net.jpg",
    spec: "Corrosion-Proof Marine Anchors",
    badge: "Family Safety"
  },
  {
    title: "Car Parking Perimeter Nets",
    subtitle: "Basement and podium parking barriers preventing ball strikes and vehicular glass damage.",
    href: "/car-parking-safety-nets/",
    image: "/images/car-parking-net.jpg",
    spec: "Weather-Resistant Multi-Strand Mesh",
    badge: "Basement Shield"
  },
  {
    title: "Rooftop Cricket Practice Nets",
    subtitle: "Enclosed practice cages allowing hard leather ball batting practice without perimeter danger.",
    href: "/sports-practice-nets/",
    image: "/images/sports-nets.webp",
    spec: "Heavy-Gauge Multi-Strand Mesh",
    badge: "Sports Suite"
  },
  {
    title: "Terrace Top Fall Perimeter",
    subtitle: "Boundary safety netting installed over open roof parapets to secure terrace gatherings.",
    href: "/terrace-safety-nets/",
    image: "/images/terrace-top-net.jpg",
    spec: "High-Tensile Perimeter Tie Cords",
    badge: "Rooftop Guard"
  }
];

const gallery = [
  {
    src: "/images/coconut-safety-net.jpg",
    alt: "Coconut Drop Catch Netting",
    title: "High-Impact Canopy Catch",
    caption: "Heavy-duty perimeter webbing suspended beneath palm canopies preventing vehicular glass damage.",
    badge: "Property Protection"
  },
  {
    src: "/images/swimming-pool-net.jpg",
    alt: "Swimming Pool Protective Cover",
    title: "Villas Pool Safety Barrier",
    caption: "Precision edge-anchored tension net safeguarding toddlers and pets.",
    badge: "Villa Safety"
  },
  {
    src: "/images/car-parking-net.jpg",
    alt: "Podium Parking Protection",
    title: "Podium Car Parking Barrier",
    caption: "Aesthetic perimeter mesh shielding luxury cars from stray ball impacts.",
    badge: "Podium Shield"
  },
  {
    src: "/images/sports-nets.webp",
    alt: "Sports Netting Rooftop Turf",
    title: "Rooftop Practice Enclosure",
    caption: "High-velocity ball containment enclosure for residential clubhouses.",
    badge: "Specialty Sports"
  }
];
---

<SubPageLayout
  title="Coconut Tree Safety Nets | Anti-Drop Canopy Catching | Invisible Safety"
  description="Heavy-duty coconut tree safety netting preventing falling coconut injuries and vehicle damage. UV-stabilized polymer with 3-year warranty."
  canonicalUrl="/coconut-safety-nets/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="PROPERTY & VEHICULAR DEFENSE"
  heroTitle="COCONUT PALM SAFETY NETS"
  heroSubtitle="Suspended high-tensile impact-absorption netting arrays positioned beneath palm tree canopies to safely catch falling coconuts before striking vehicles or pedestrians."
  heroImage="/images/coconut-safety-net.jpg"
  heroImageAlt="Coconut Tree Safety Nets Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Impact Dynamics Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">IMPACT ARREST INTEGRITY</span>
        <h2 class="editorial-title">Heavy Kinetic Drop Dissipation</h2>
        <p class="editorial-subtitle">
          A mature coconut dropping from 40 feet generates fatal impact force. Our suspended nets eliminate danger completely.
        </p>
      </div>

      <div class="coconut-grid">
        <div class="coconut-card">
          <h3 class="coconut-card-title">Vehicular Windshield Protection</h3>
          <p class="coconut-card-desc">
            Villas and apartment driveways flanked by coconut palms risk shattered windshields and dented roofs. The catchment funnel traps nuts gently without bounce-off.
          </p>
        </div>

        <div class="coconut-card">
          <h3 class="coconut-card-title">Tree Trunk Friendly Anchors</h3>
          <p class="coconut-card-desc">
            Installed with rubberized tree collar brackets that adjust to natural tree growth without strangling bark, driving nails, or harming coconut yield.
          </p>
        </div>

        <div class="coconut-card">
          <h3 class="coconut-card-title">UV Heat Resilient Strands</h3>
          <p class="coconut-card-desc">
            Infused with carbon black and UV inhibitors to withstand uninterrupted 365-day rooftop sun exposure and torrential monsoons.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Estimator Section -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Coconut Netting Quote</h2>
        <p class="editorial-subtitle">
          Configure number of trees and perimeter radius for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .coconut-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .coconut-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .coconut-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .coconut-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .coconut-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
