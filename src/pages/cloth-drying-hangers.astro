---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2 } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Ceiling Cloth Drying Hangers",
  "Individual pull-down ceiling mounted stainless steel cloth drying hangers for balconies and utility corridors with custom site quote",
  1800
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Specialty Solutions", url: "https://invisiblesafety.in/sports-nets/" },
  { name: "Cloth Drying Hangers", url: "https://invisiblesafety.in/cloth-drying-hangers/" }
]);

const specs = [
  { label: "Pipe Metallurgy", value: "100% Rust-Proof Stainless Steel", icon: ShieldCheck },
  { label: "Pulley System", value: "Dual Nylon Pulley with Smooth Cord", icon: Award },
  { label: "Weight Capacity", value: "5 kg Wet Weight Per Individual Pipe", icon: Wrench },
  { label: "Direct Warranty", value: "3-Year Mechanical Guarantee", icon: CheckCircle2 }
];

const subcategories = [
  {
    title: "Rooftop Cricket Practice Nets",
    subtitle: "Enclosed practice cages allowing hard leather ball batting practice without perimeter danger.",
    href: "/sports-practice-nets/",
    image: "/images/sports-nets.webp",
    spec: "Heavy-Gauge Multi-Strand Mesh",
    badge: "Sports Suite"
  },
  {
    title: "Balcony Invisible Grills",
    subtitle: "Floor-to-ceiling high-tensile SS316 marine cables safeguarding high-rise living balconies.",
    href: "/balcony-invisible-grills/",
    image: "/images/hero-balcony.webp",
    spec: "Japanese SS316 (2.0mm / 2.5mm)",
    badge: "Flagship Balcony"
  },
  {
    title: "Swimming Pool Protective Nets",
    subtitle: "High-tension surface barriers preventing accidental pool falls by infants and pets.",
    href: "/swimming-pool-nets/",
    image: "/images/swimming-pool-net.jpg",
    spec: "Corrosion-Proof Marine Anchors",
    badge: "Family Safety"
  },
  {
    title: "Coconut Palm Anti-Drop Netting",
    subtitle: "Suspended impact-absorption nets preventing heavy coconut fall damage to cars and residents.",
    href: "/coconut-safety-nets/",
    image: "/images/coconut-safety-net.jpg",
    spec: "Heavy Impact-Cushioning Webbing",
    badge: "Property Protection"
  }
];

const gallery = [
  {
    src: "/images/cloth-drying-hanger.jpg",
    alt: "Balcony Ceiling Clothes Hanger",
    title: "Architectural Pulley System",
    caption: "Retractable ceiling-mounted drying tracks preserving floor space and maximizing natural breeze.",
    badge: "Balcony Utility"
  },
  {
    src: "/images/hero-balcony.webp",
    alt: "Balcony Invisible Grills",
    title: "Panoramic Skyline Aperture",
    caption: "High-contrast SS316 marine cables preserving panoramic cityscape views.",
    badge: "Skyline Vista"
  },
  {
    src: "/images/sports-nets.webp",
    alt: "Sports Netting Rooftop Turf",
    title: "Rooftop Practice Enclosure",
    caption: "High-velocity ball containment enclosure for residential clubhouses.",
    badge: "Specialty Sports"
  },
  {
    src: "/images/swimming-pool-net.jpg",
    alt: "Pool Safety Cover",
    title: "Swimming Pool Barrier",
    caption: "Precision anchored surface barrier preventing toddler pool accidents.",
    badge: "Pool Safety"
  }
];
---

<SubPageLayout
  title="Ceiling Cloth Drying Hangers | Balcony Pulley System | Invisible Safety"
  description="Space-saving ceiling mounted stainless steel cloth drying hangers with smooth pull-down pulley system. 100% rust-proof with 3-year warranty."
  canonicalUrl="/cloth-drying-hangers/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="SPECIALTY BALCONY UTILITY"
  heroTitle="CEILING CLOTH DRYING HANGERS"
  heroSubtitle="Individual stainless steel pull-down ceiling pulley systems that maximize balcony floor space, utilizing warm ceiling airflow for faster laundry drying."
  heroImage="/images/cloth-drying-hanger.jpg"
  heroImageAlt="Ceiling Cloth Drying Hangers Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Utility Features Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">BALCONY SPACE OPTIMIZATION</span>
        <h2 class="editorial-title">Reclaim 100% Floor Area</h2>
        <p class="editorial-subtitle">
          Eliminate cumbersome folding stands that clutter balcony walkways and blow over in wind gusts.
        </p>
      </div>

      <div class="hanger-grid">
        <div class="hanger-card">
          <h3 class="hanger-card-title">Individual Pipe Lowering</h3>
          <p class="hanger-card-desc">
            Each stainless steel pipe lowers independently via its dedicated nylon cord and brass pulley, allowing effortless hanging without lifting heavy wet laundry loads.
          </p>
        </div>

        <div class="hanger-card">
          <h3 class="hanger-card-title">Ceiling Heat Convection</h3>
          <p class="hanger-card-desc">
            Because hot air naturally rises toward balcony ceilings, clothes dry up to 40% faster elevated overhead than resting on low floor stands.
          </p>
        </div>

        <div class="hanger-card">
          <h3 class="hanger-card-title">Grade 202 / 304 Stainless Steel</h3>
          <p class="hanger-card-desc">
            Mirror-polished rust-proof tubes ensure damp garments never develop rust stains or metallic discolorations, even in monsoon humidity.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Estimator Section -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Hanger Installation Quote</h2>
        <p class="editorial-subtitle">
          Select number of pipes (4, 5, or 6 pipes) and length for doorstep installation scheduling.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hanger-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .hanger-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .hanger-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .hanger-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .hanger-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
