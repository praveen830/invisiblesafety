---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2 } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Anti-Monkey Balcony Safety Nets",
  "High-tensile reinforced wire netting designed to withstand aggressive monkey pulling and tampering with custom site quote",
  22
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Animal & Bird Protection", url: "https://invisiblesafety.in/pigeon-nets/" },
  { name: "Monkey Safety Nets", url: "https://invisiblesafety.in/monkey-safety-nets/" }
]);

const specs = [
  { label: "Core Tensile Gauge", value: "Reinforced Multi-Strand Stainless / HDPE", icon: ShieldCheck },
  { label: "Bite & Tear Defense", value: "Anti-Tear Primed Locking Knots", icon: Award },
  { label: "Anchoring Force", value: "Heavy-Duty Expansion Anchor Bolts", icon: Wrench },
  { label: "Direct Warranty", value: "3-Year Wildlife Defense Guarantee", icon: CheckCircle2 }
];

const subcategories = [
  {
    title: "Translucent Anti-Pigeon Netting",
    subtitle: "Near-invisible monofilament grid denying roosting access to pigeons without daylight blockage.",
    href: "/pigeon-nets/",
    image: "/images/pigeon-net.webp",
    spec: "Virgin UV-Stabilized Co-Polymer",
    badge: "Discreet Living"
  },
  {
    title: "SS304 Polycarbonate Bird Spikes",
    subtitle: "Humane curved blunt spikes preventing bird perching on narrow parapets, AC units, and ledges.",
    href: "/bird-spikes/",
    image: "/images/balcony-safety.webp",
    spec: "Weather-Resistant Virgin Polycarbonate",
    badge: "Ledge Protection"
  },
  {
    title: "Apartment Balcony Safety Nets",
    subtitle: "Full-perimeter protective enclosure stopping accidental falls without feeling caged.",
    href: "/balcony-safety/",
    image: "/images/safety-net-balcony.webp",
    spec: "Virgin High-Density Polymer",
    badge: "Residential Core"
  },
  {
    title: "Fine-Mesh Insect & Mosquito Nets",
    subtitle: "Pleated and roller insect screens providing 100% insect protection with cross-ventilation.",
    href: "/mosquito-safety-nets/",
    image: "/images/terrace-top-net.jpg",
    spec: "Fiberglass Anti-Tear Mesh",
    badge: "Clean Airflow"
  }
];

const gallery = [
  {
    src: "/images/safety-net-balcony.webp",
    alt: "Reinforced Anti-Monkey Enclosure",
    title: "High-Tensile Balcony Barrier",
    caption: "Heavy-gauge netting protecting hillside residences and apartment balconies against aggressive wildlife intrusion.",
    badge: "Perimeter Shield"
  },
  {
    src: "/images/pigeon-net.webp",
    alt: "Translucent Pigeon Net on Balcony",
    title: "Translucent Skyline Protection",
    caption: "Unobtrusive bird exclusion preserving pristine aesthetic elevation.",
    badge: "Penthouse Living"
  },
  {
    src: "/images/balcony-safety.webp",
    alt: "Stainless Steel Bird Spikes along Parapet",
    title: "SS304 Anti-Perching Ledge Spikes",
    caption: "Precision silicon-bonded spikes installed on high-rise AC ledges.",
    badge: "Facade Care"
  },
  {
    src: "/images/terrace-top-net.jpg",
    alt: "Terrace Bird Exclusion Netting",
    title: "Rooftop Air Duct & Terrace Net",
    caption: "Wide-span horizontal netting keeping roof shafts free of bird nesting.",
    badge: "Clean Architecture"
  }
];
---

<SubPageLayout
  title="Anti-Monkey Safety Nets | Balcony Wildlife Protection | Invisible Safety"
  description="High-tensile reinforced anti-monkey balcony safety nets with custom site quote Stops aggressive monkey entry and destruction with 3-year warranty."
  canonicalUrl="/monkey-safety-nets/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="WILDLIFE EXCLUSION ARCHITECTURE"
  heroTitle="ANTI-MONKEY SAFETY NETS"
  heroSubtitle="Reinforced heavy-gauge tensile wire and polymer netting designed to withstand vigorous monkey chewing, shaking, and scaling, securing hillside and perimeter apartments."
  heroImage="/images/safety-net-balcony.webp"
  heroImageAlt="Anti-Monkey Safety Nets Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Monkey Defense Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">HEAVY-DUTY WILDLIFE DEFENSE</span>
        <h2 class="editorial-title">Engineered Against Animal Intrusion</h2>
        <p class="editorial-subtitle">
          Standard bird nets tear immediately under monkey claws. Our reinforced netting resists high pulling torque.
        </p>
      </div>

      <div class="monkey-grid">
        <div class="monkey-card">
          <h3 class="monkey-card-title">Heavy-Gauge Braided Core</h3>
          <p class="monkey-card-desc">
            Constructed with high-denier twisted polymer yarns that cannot be cut or bitten through by sharp teeth, keeping balconies 100% secure.
          </p>
        </div>

        <div class="monkey-card">
          <h3 class="monkey-card-title">Continuous Tension Anchoring</h3>
          <p class="monkey-card-desc">
            Anchored tightly every 4 inches along walls and ceilings with heavy steel eyebolts so monkeys cannot pry open corner gaps to crawl inside.
          </p>
        </div>

        <div class="monkey-card">
          <h3 class="monkey-card-title">Protects Plants &amp; Balcony Furniture</h3>
          <p class="monkey-card-desc">
            Allows you to maintain potted plants, dry clothing, and keep French balcony doors open without fear of monkey ransacking or aggressive confrontation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Estimator Section -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Anti-Monkey Net Quote</h2>
        <p class="editorial-subtitle">
          Configure balcony dimensions for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .monkey-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .monkey-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .monkey-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .monkey-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .monkey-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
