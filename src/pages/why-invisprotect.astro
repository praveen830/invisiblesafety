---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustSection from '../components/TrustSection.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import { getBreadcrumbSchema } from '../utils/seo';
import { business } from '../data/business';
import { ShieldCheck, Check, X, HardHat, FileCheck, ArrowRight, MessageCircle } from 'lucide-react';

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisprotect.com/" },
  { name: "Why InvisProtect", url: "https://invisprotect.com/why-invisprotect/" }
]);
---

<BaseLayout
  title="Why Choose InvisProtect | Architectural Safety vs Local Contractors"
  description="See why over 12,400 luxury homeowners trust InvisProtect over unorganized local fabricators. Certified SS316 marine steel, IS 3521 harnesses, and 10-year direct warranty."
  canonicalUrl="/why-invisprotect/"
  schema={[breadcrumbs]}
>
  <section class="section-spacing" style="background: radial-gradient(circle at 50% 0%, rgba(2, 132, 199, 0.2) 0%, rgba(9, 13, 22, 1) 75%); border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
    <div class="container" style="text-align: center; max-width: 860px;">
      <span class="badge-arch" style="margin-bottom: 1.25rem;">The InvisProtect Standard</span>
      <h1 style="font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 800; color: #FFFFFF; line-height: 1.15; margin-bottom: 1.25rem;">
        Engineered Safety vs <br />
        <span style="color: #38BDF8;">Unregulated Contractors</span>
      </h1>
      <p style="font-size: 1.15rem; color: #94A3B8; line-height: 1.6; max-width: 700px; margin: 0 auto 2rem auto;">
        When safeguarding your children on the 25th floor, compromise is not an option. Discover the engineering, metallurgy, and accountability that sets InvisProtect apart.
      </p>

      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="/invisible-grill-cost/" class="btn btn-primary">
          <span>Get Free Balcony Quote</span>
        </a>
        <a
          href={`https://wa.me/${business.whatsapp}?text=Hi%20InvisProtect%2C%20I%20want%20to%20know%20more%20about%20your%20installation%20standards.`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
        >
          <MessageCircle size={17} />
          <span>Talk to Technical Lead</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Side-by-Side Detailed Comparison -->
  <section class="section-spacing" style="background: #0B0F19; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
    <div class="container">
      <div class="section-header">
        <span class="badge-emerald">Objective Comparison</span>
        <h2>How We Compare to Local Fabricators</h2>
        <p>A transparent look at the differences between certified engineering and low-cost shortcuts.</p>
      </div>

      <div class="grid-2" style="max-width: 980px; margin: 0 auto;">
        <!-- InvisProtect Column -->
        <div class="arch-card" style="border-color: rgba(56, 189, 248, 0.4); background: rgba(17, 24, 39, 0.9);">
          <div style="display: flex; align-items: center; gap: 0.5rem; color: #38BDF8; font-weight: 700; font-size: 0.85rem; margin-bottom: 0.75rem;">
            <ShieldCheck size={18} />
            <span>INVISPROTECT STANDARDS</span>
          </div>
          <h3 style="font-size: 1.4rem; font-weight: 800; color: #FFFFFF; margin-bottom: 1.25rem;">
            Certified Architectural Excellence
          </h3>

          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.9rem; color: #CBD5E1;">
            <li style="display: flex; gap: 0.6rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><Check size={18} color="#10B981" /></span>
              <span><strong>Virgin SS316 Marine Alloy:</strong> Guaranteed 2.5% Molybdenum; lab test certificate provided on request.</span>
            </li>
            <li style="display: flex; gap: 0.6rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><Check size={18} color="#10B981" /></span>
              <span><strong>IS 3521 Safety Harnesses:</strong> Technicians wear certified dual-lanyard fall arrest gear during entire job.</span>
            </li>
            <li style="display: flex; gap: 0.6rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><Check size={18} color="#10B981" /></span>
              <span><strong>Hydraulic Swaging & Tensioning:</strong> Consistent 100+ kg tension per cable calibrated by gauge.</span>
            </li>
            <li style="display: flex; gap: 0.6rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><Check size={18} color="#10B981" /></span>
              <span><strong>Official 10-Year Digital Warranty:</strong> Direct company warranty with free 3-month re-tension check.</span>
            </li>
            <li style="display: flex; gap: 0.6rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><Check size={18} color="#10B981" /></span>
              <span><strong>Society RWA Compliance:</strong> Conforms strictly to elevation rules of luxury gated communities.</span>
            </li>
          </ul>
        </div>

        <!-- Local Fabricators Column -->
        <div class="arch-card" style="border-color: rgba(239, 68, 68, 0.2); background: rgba(15, 23, 42, 0.6);">
          <div style="display: flex; align-items: center; gap: 0.5rem; color: #EF4444; font-weight: 700; font-size: 0.85rem; margin-bottom: 0.75rem;">
            <X size={18} />
            <span>UNORGANIZED CONTRACTORS</span>
          </div>
          <h3 style="font-size: 1.4rem; font-weight: 800; color: #FFFFFF; margin-bottom: 1.25rem;">
            Typical Shortcuts & Risks
          </h3>

          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.9rem; color: #94A3B8;">
            <li style="display: flex; gap: 0.6rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><X size={18} color="#EF4444" /></span>
              <span><strong>Inferior SS202 / SS304 Steel:</strong> Rusts and stains within 6–12 months, requiring complete replacement.</span>
            </li>
            <li style="display: flex; gap: 0.6rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><X size={18} color="#EF4444" /></span>
              <span><strong>Zero Safety Gear:</strong> Workers stand dangerously barefoot on 20th floor edges without lifelines.</span>
            </li>
            <li style="display: flex; gap: 0.6rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><X size={18} color="#EF4444" /></span>
              <span><strong>Manual Hand Pulling:</strong> Uneven loose cables that sag, flutter in the wind, and allow children to pull them apart.</span>
            </li>
            <li style="display: flex; gap: 0.6rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><X size={18} color="#EF4444" /></span>
              <span><strong>Verbal False Guarantees:</strong> No registered business identity; contractor stops answering calls after payment.</span>
            </li>
            <li style="display: flex; gap: 0.6rem; align-items: flex-start;">
              <span style="flex-shrink: 0; margin-top: 2px;"><X size={18} color="#EF4444" /></span>
              <span><strong>Society Disapproval:</strong> Ugly misaligned tracks that result in warning notices from apartment RWAs.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <TrustSection />
  <ComparisonTable />
</BaseLayout>
