---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../data/business';
import { CheckCircle2, MessageCircle, Phone, Home, Clock } from 'lucide-react';
---

<BaseLayout
  title="Enquiry Received | Invisible Safety"
  description="Thank you for contacting Invisible Safety. Our team will reach out within 15 minutes."
  canonicalUrl="/thank-you/"
  noindex={true}
>
  <section class="section-spacing" style="text-align: center; min-height: 65vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(180deg, #F0F9FF 0%, #F8FAFC 100%); border-bottom: 1px solid #E2E8F0;">
    <div class="container" style="max-width: 650px;">
      <div style="width: 76px; height: 76px; border-radius: 50%; background: #DCFCE7; border: 2px solid #16A34A; display: flex; align-items: center; justify-content: center; color: #16A34A; margin: 0 auto 1.5rem auto;">
        <CheckCircle2 size={42} />
      </div>

      <span class="badge-emerald" style="margin-bottom: 1rem;">Enquiry Confirmed</span>

      <h1 style="font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 800; color: #0F233D; line-height: 1.2; margin-bottom: 1rem;">
        We've Received Your Request!
      </h1>

      <p style="color: #475569; font-size: 1.05rem; line-height: 1.6; margin-bottom: 2rem;">
        Our technical coordinator will review your balcony details and contact you via phone/WhatsApp promptly to schedule your quotation consultation.
      </p>

      <!-- Next steps box -->
      <div class="card" style="text-align: left; margin-bottom: 2rem; background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 16px; padding: 1.75rem; box-shadow: 0 4px 20px rgba(15, 35, 61, 0.05);">
        <h3 style="font-size: 1.15rem; font-weight: 700; color: #0F233D; margin-bottom: 1rem;">What happens next:</h3>
        <ol style="padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.92rem; color: #334155; line-height: 1.55;">
          <li><strong style="color: #0F233D;">Quick Confirmation Call:</strong> We clarify your balcony opening type and schedule a convenient visit time.</li>
          <li><strong style="color: #0F233D;">On-Site Survey:</strong> Our representative inspects the balcony opening, presents physical material samples, and measures.</li>
          <li><strong style="color: #0F233D;">Clear Transparent Quotation:</strong> Fixed, itemized quotation provided on the spot.</li>
        </ol>
      </div>

      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a
          href={`https://wa.me/${business.whatsapp}?text=Hi%20Invisible%20Safety%2C%20I%20just%20submitted%20a%20quote%20request%20on%20your%20website%20and%20wanted%20to%20follow%20up.`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
        >
          <MessageCircle size={17} />
          <span>Follow Up on WhatsApp</span>
        </a>
        <a href="/" class="btn btn-secondary">
          <Home size={16} />
          <span>Back to Home</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
