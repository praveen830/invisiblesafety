---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2, Ruler, Shield } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Child Safety Invisible Grills",
  "High-tensile 50mm anti-entrapment Japanese SS316 invisible grills engineered specifically for toddler and pet fall protection with custom site quote",
  190
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Invisible Grills", url: "https://invisiblesafety.in/invisible-grills/" },
  { name: "Child Safety Invisible Grills", url: "https://invisiblesafety.in/child-safety-invisible-grills/" }
]);

const specs = [
  { label: "Cable Metallurgy", value: "Virgin Japanese SS316 Marine Grade", icon: ShieldCheck },
  { label: "Anti-Entrapment Pitch", value: "Strict 50mm (2-Inch) Spacing", icon: Ruler },
  { label: "Tensile Breaking Load", value: "400+ kgf Impact Rating", icon: Award },
  { label: "Direct Warranty", value: "10-Year Direct Written Guarantee", icon: Wrench }
];

const subcategories = [
  {
    title: "Balcony Invisible Grills",
    subtitle: "Floor-to-ceiling high-tensile SS316 marine cables safeguarding high-rise living balconies.",
    href: "/balcony-invisible-grills/",
    image: "/images/hero-balcony.webp",
    spec: "Japanese SS316 (2.0mm / 2.5mm)",
    badge: "Flagship Balcony"
  },
  {
    title: "Toddler & Pet Safety Nets",
    subtitle: "High-density polymer netting designed to prevent toy drops and pet slipping through railings.",
    href: "/child-safety-nets/",
    image: "/images/child-safety.webp",
    spec: "Smooth Anti-Chafe Knots",
    badge: "Polymer Core"
  },
  {
    title: "French Window Invisible Grills",
    subtitle: "Frameless high-tensile safety barriers for low-sill windows and sliding fenestrations.",
    href: "/window-invisible-grills/",
    image: "/images/window-invisible-grills.webp",
    spec: "Direct Wall Anchor Tracks",
    badge: "Fenestration Guard"
  },
  {
    title: "Duplex Staircase Tension Grills",
    subtitle: "Floor-to-ceiling vertical cable dividers safeguarding duplex voids and floating stairs.",
    href: "/staircase-invisible-grills/",
    image: "/images/staircase-invisible-grills.webp",
    spec: "Floor-to-Ceiling SS316 Cables",
    badge: "Interior Luxury"
  }
];

const gallery = [
  {
    src: "/images/child-safety.webp",
    alt: "Child-Safe 50mm Invisible Grills",
    title: "Toddler Anti-Fall System",
    caption: "High-density 50mm cable spacing preventing toddler head entrapment with zero climbing leverage.",
    badge: "Toddler Proof"
  },
  {
    src: "/images/hero-balcony.webp",
    alt: "Balcony Invisible Grills",
    title: "Panoramic Skyline Aperture",
    caption: "High-contrast SS316 marine cables preserving panoramic cityscape views.",
    badge: "Skyline Vista"
  },
  {
    src: "/images/window-invisible-grills.webp",
    alt: "French Window Invisible Grills",
    title: "French Fenestration Suite",
    caption: "Full ventilation and child anti-fall safety with zero visual blockage.",
    badge: "Window Protection"
  },
  {
    src: "/images/staircase-invisible-grills.webp",
    alt: "Duplex Staircase Cables",
    title: "Duplex Void Tension Array",
    caption: "Floor-to-ceiling vertical cable array guarding modern architectural stairs.",
    badge: "Interior Architecture"
  }
];
---

<SubPageLayout
  title="Child Safety Invisible Grills | Toddler & Pet Balcony Protection | Invisible Safety"
  description="Engineered 50mm anti-head entrapment SS316 invisible grills for child safety on high-rise balconies with custom site quote Zero footholds with 400+ kg load capacity."
  canonicalUrl="/child-safety-invisible-grills/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="THE UNSEEN GUARDIAN"
  heroTitle="CHILD SAFETY INVISIBLE GRILLS"
  heroSubtitle="Calibrated 50mm anti-head entrapment spacing engineered to protect toddlers and pets without climbable steps, sharp edges, or view obstruction."
  heroImage="/images/child-safety.webp"
  heroImageAlt="Child Safety Invisible Grills Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Child Safety Engineering Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">PEDIATRIC SAFETY ARCHITECTURE</span>
        <h2 class="editorial-title">Zero-Climbing Leverage Standards</h2>
        <p class="editorial-subtitle">
          Eliminating the structural hazards inherent to horizontal bars and decorative grills.
        </p>
      </div>

      <div class="child-safety-grid">
        <div class="child-card">
          <h3 class="child-card-title">Anti-Entrapment 50mm Pitch</h3>
          <p class="child-card-desc">
            Standard horizontal balcony railings often have 100mm to 150mm gaps that allow toddlers to slip their heads or torsos through. Our 50mm calibrated spacing makes entrapment physically impossible.
          </p>
        </div>

        <div class="child-card">
          <h3 class="child-card-title">Vertical Zero-Foothold Design</h3>
          <p class="child-card-desc">
            Traditional mesh or decorative scrollwork provides footholds that active toddlers use as ladders to climb over railings. Smooth vertical cables offer zero horizontal leverage to stand on.
          </p>
        </div>

        <div class="child-card">
          <h3 class="child-card-title">DuPont Protective Nylon Sheathing</h3>
          <p class="child-card-desc">
            Every stainless steel core cable is clad in a transparent nylon protective sleeve that prevents skin chafing or pinched fingers even during vigorous toddler grasping.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Smart Cost Estimator -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Child Safety Grill Cost</h2>
        <p class="editorial-subtitle">
          Configure balcony dimensions for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection category="invisible-grills" title="Child Safety Invisible Grills Questions &amp; Answers" />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .child-safety-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .child-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .child-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .child-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .child-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
