---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQSection from '../components/FAQSection.astro';
import { getBreadcrumbSchema } from '../utils/seo';
import { business } from '../data/business';
import { 
  ShieldCheck, 
  Check, 
  FileCheck, 
  Phone, 
  MessageCircle, 
  Wrench,
  HelpCircle,
  ArrowRight
} from 'lucide-react';

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Service & Care", url: "https://invisiblesafety.in/warranty/" }
]);
---

<BaseLayout
  title="Service Information & Maintenance Care | Invisible Safety"
  description="Maintenance guidelines, care instructions, and customer support information for Invisible Safety invisible grills and safety nets."
  canonicalUrl="/warranty/"
  schema={[breadcrumbs]}
>
  <!-- Architectural Hero Section -->
  <section class="section-spacing" style="background: linear-gradient(180deg, #F0F9FF 0%, #F8FAFC 100%); border-bottom: 1px solid #E2E8F0; padding-top: 2.5rem; padding-bottom: 3.5rem;">
    <div class="container" style="max-width: 980px; text-align: center;">
      <!-- Breadcrumb Bar -->
      <nav style="font-size: 0.76rem; font-weight: 700; color: #64748B; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1.5rem; display: inline-flex; align-items: center; gap: 0.5rem; background: #FFFFFF; padding: 0.35rem 1rem; border-radius: 20px; border: 1px solid #E2E8F0;">
        <a href="/" style="color: #64748B; text-decoration: none;">HOME</a>
        <span>/</span>
        <span style="color: #0284C7;">SERVICE & CARE</span>
      </nav>

      <div style="display: flex; justify-content: center; margin-bottom: 1.25rem;">
        <span style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.4rem 1rem; background: #E0F2FE; border: 1px solid #BAE6FD; border-radius: 20px; font-size: 0.8rem; font-weight: 800; color: #0369A1; letter-spacing: 0.04em;">
          <ShieldCheck size={16} /> SERVICE & SUPPORT
        </span>
      </div>

      <h1 style="font-size: clamp(2.4rem, 4.5vw, 3.8rem); font-weight: 900; color: #0F172A; line-height: 1.18; margin-bottom: 1.25rem; letter-spacing: -0.03em;">
        Installation Support & <br />
        <span style="color: #0284C7;">Maintenance Care Guide</span>
      </h1>

      <p style="font-size: 1.15rem; color: #475569; line-height: 1.7; max-width: 760px; margin: 0 auto 2.25rem auto;">
        We focus on careful installation and customer support for all our invisible safety grills and safety nets. Follow these practical maintenance recommendations to keep your balcony installations in optimal condition.
      </p>

      <!-- Key Service Indicators -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; max-width: 820px; margin: 0 auto 2.5rem auto;">
        <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 14px; padding: 1.25rem 1rem; box-shadow: var(--shadow-sm); text-align: center;">
          <div style="font-size: 1.5rem; font-weight: 900; color: #0284C7; line-height: 1; margin-bottom: 0.35rem;">Installation Review</div>
          <div style="font-size: 0.82rem; font-weight: 700; color: #0F172A; text-transform: uppercase;">Post-Fit Walkthrough</div>
          <div style="font-size: 0.75rem; color: #64748B; margin-top: 0.25rem;">On-site inspection with customer upon job completion</div>
        </div>

        <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 14px; padding: 1.25rem 1rem; box-shadow: var(--shadow-sm); text-align: center;">
          <div style="font-size: 1.5rem; font-weight: 900; color: #16A34A; line-height: 1; margin-bottom: 0.35rem;">Direct Assistance</div>
          <div style="font-size: 0.82rem; font-weight: 700; color: #0F172A; text-transform: uppercase;">Phone & WhatsApp</div>
          <div style="font-size: 0.75rem; color: #64748B; margin-top: 0.25rem;">Reach our team directly for service inquiries</div>
        </div>

        <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 14px; padding: 1.25rem 1rem; box-shadow: var(--shadow-sm); text-align: center;">
          <div style="font-size: 1.5rem; font-weight: 900; color: #C2410C; line-height: 1; margin-bottom: 0.35rem;">Maintenance Help</div>
          <div style="font-size: 0.82rem; font-weight: 700; color: #0F172A; text-transform: uppercase;">Care Advice</div>
          <div style="font-size: 0.75rem; color: #64748B; margin-top: 0.25rem;">Guidance on cable cleaning and net care</div>
        </div>
      </div>

      <!-- Hero Actions -->
      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a
          href={`https://wa.me/${business.whatsapp}?text=Hi%20Invisible%20Safety%2C%20I%20have%20a%20question%20regarding%20my%20installation.`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
          style="padding: 0.9rem 1.75rem; font-size: 0.95rem;"
        >
          <MessageCircle size={18} />
          <span>Contact Support on WhatsApp</span>
        </a>
        <a href="#care-guidelines" class="btn btn-outline" style="padding: 0.9rem 1.75rem; font-size: 0.95rem; background: #FFFFFF;">
          <span>Explore Care Guidelines</span>
          <ArrowRight size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- Care & Maintenance Guidelines -->
  <section id="care-guidelines" class="section-spacing" style="background: #FFFFFF; border-bottom: 1px solid #E2E8F0;">
    <div class="container" style="max-width: 1040px;">
      <div style="text-align: center; max-width: 700px; margin: 0 auto 3rem auto;">
        <span style="font-size: 0.76rem; font-weight: 800; color: #0284C7; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.5rem; display: block;">
          MAINTENANCE ADVICE
        </span>
        <h2 style="font-size: clamp(2rem, 3.5vw, 2.7rem); font-weight: 900; color: #0F172A; letter-spacing: -0.02em; margin-bottom: 0.75rem;">
          Recommended Care & Cleaning
        </h2>
        <p style="font-size: 1.05rem; color: #64748B; line-height: 1.6;">
          Simple steps to maintain the appearance and longevity of your safety installations.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; margin-bottom: 3rem;">
        <!-- Card 1: Invisible Grills Care -->
        <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 20px; padding: 2.25rem; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #E0F2FE; color: #0284C7; font-size: 0.78rem; font-weight: 800; padding: 0.35rem 0.85rem; border-radius: 20px; margin-bottom: 1rem; border: 1px solid #BAE6FD;">
              <Wrench size={16} />
              <span>INVISIBLE GRILLS CARE</span>
            </div>

            <h3 style="font-size: 1.5rem; font-weight: 900; color: #0F172A; margin-bottom: 0.5rem; line-height: 1.25;">
              Caring for Stainless Steel Cables
            </h3>
            <p style="font-size: 0.92rem; color: #64748B; line-height: 1.6; margin-bottom: 1.5rem;">
              Invisible grills require minimal upkeep. Periodic cleaning preserves cable clarity and prevents surface residue buildup.
            </p>

            <ul style="list-style: none; padding: 0; margin: 0 0 2rem 0; display: flex; flex-direction: column; gap: 0.9rem;">
              <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <div style="width: 20px; height: 20px; border-radius: 50%; background: #DCFCE7; color: #16A34A; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 900; margin-top: 2px;">✓</div>
                <span style="font-size: 0.92rem; color: #1E293B; line-height: 1.5;"><strong>Dusting:</strong> Wipe cables occasionally with a dry microfibre cloth to remove airborne dust.</span>
              </li>
              <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <div style="width: 20px; height: 20px; border-radius: 50%; background: #DCFCE7; color: #16A34A; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 900; margin-top: 2px;">✓</div>
                <span style="font-size: 0.92rem; color: #1E293B; line-height: 1.5;"><strong>Cleaning Solution:</strong> For heavier residue, use lukewarm water with a mild dish soap. Wipe down with clean water.</span>
              </li>
              <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <div style="width: 20px; height: 20px; border-radius: 50%; background: #DCFCE7; color: #16A34A; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 900; margin-top: 2px;">✓</div>
                <span style="font-size: 0.92rem; color: #1E293B; line-height: 1.5;"><strong>Avoid Harsh Chemicals:</strong> Do not use bleach, hydrochloric acid, or steel wool on cables or aluminium profiles.</span>
              </li>
              <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <div style="width: 20px; height: 20px; border-radius: 50%; background: #DCFCE7; color: #16A34A; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 900; margin-top: 2px;">✓</div>
                <span style="font-size: 0.92rem; color: #1E293B; line-height: 1.5;"><strong>Periodic Check:</strong> Inspect anchor tracks and fasteners periodically to verify secure placement.</span>
              </li>
            </ul>
          </div>

          <a href="/invisible-grills/" class="btn btn-primary btn-sm" style="justify-content: center; font-weight: 800;">
            <span>Explore Invisible Grills →</span>
          </a>
        </div>

        <!-- Card 2: Safety Nets Care -->
        <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 20px; padding: 2.25rem; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: #DCFCE7; color: #16A34A; font-size: 0.78rem; font-weight: 800; padding: 0.35rem 0.85rem; border-radius: 20px; margin-bottom: 1rem; border: 1px solid #BBF7D0;">
              <ShieldCheck size={16} />
              <span>SAFETY NETS CARE</span>
            </div>

            <h3 style="font-size: 1.5rem; font-weight: 900; color: #0F172A; margin-bottom: 0.5rem; line-height: 1.25;">
              Caring for Balcony Safety Nets
            </h3>
            <p style="font-size: 0.92rem; color: #64748B; line-height: 1.6; margin-bottom: 1.5rem;">
              Safety nets are designed to withstand regular outdoor weather conditions. Simple maintenance preserves mesh alignment.
            </p>

            <ul style="list-style: none; padding: 0; margin: 0 0 2rem 0; display: flex; flex-direction: column; gap: 0.9rem;">
              <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <div style="width: 20px; height: 20px; border-radius: 50%; background: #DCFCE7; color: #16A34A; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 900; margin-top: 2px;">✓</div>
                <span style="font-size: 0.92rem; color: #1E293B; line-height: 1.5;"><strong>Visual Inspection:</strong> Check corner hooks and perimeter boundary ropes every 6 to 12 months.</span>
              </li>
              <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <div style="width: 20px; height: 20px; border-radius: 50%; background: #DCFCE7; color: #16A34A; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 900; margin-top: 2px;">✓</div>
                <span style="font-size: 0.92rem; color: #1E293B; line-height: 1.5;"><strong>Rinsing:</strong> Clean dust using a gentle water spray from a garden hose or wet cloth.</span>
              </li>
              <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <div style="width: 20px; height: 20px; border-radius: 50%; background: #DCFCE7; color: #16A34A; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 900; margin-top: 2px;">✓</div>
                <span style="font-size: 0.92rem; color: #1E293B; line-height: 1.5;"><strong>Avoid Sharp Objects:</strong> Keep sharp tools and direct heat sources away from nylon netting mesh.</span>
              </li>
              <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <div style="width: 20px; height: 20px; border-radius: 50%; background: #DCFCE7; color: #16A34A; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.75rem; font-weight: 900; margin-top: 2px;">✓</div>
                <span style="font-size: 0.92rem; color: #1E293B; line-height: 1.5;"><strong>Service Request:</strong> If a net requires re-hooking after severe weather or balcony renovation, contact our team.</span>
              </li>
            </ul>
          </div>

          <a href="/safety-nets/" class="btn btn-outline btn-sm" style="justify-content: center; font-weight: 800; border-color: #16A34A; color: #15803D; background: #F0FDF4;">
            <span>Explore Safety Nets →</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Request Process -->
  <section class="section-spacing" style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0;">
    <div class="container" style="max-width: 980px;">
      <div style="text-align: center; max-width: 700px; margin: 0 auto 3rem auto;">
        <span style="font-size: 0.76rem; font-weight: 800; color: #0284C7; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.5rem; display: block;">
          CUSTOMER SUPPORT
        </span>
        <h2 style="font-size: clamp(1.8rem, 3.2vw, 2.5rem); font-weight: 900; color: #0F172A; letter-spacing: -0.02em; margin-bottom: 0.75rem;">
          How to Request Service or Assistance
        </h2>
        <p style="font-size: 1.05rem; color: #64748B; line-height: 1.6;">
          Reach out if you need adjustments, re-tensioning, or new installations for your residence.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
        <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 14px; padding: 1.75rem; text-align: left;">
          <div style="font-size: 1.25rem; font-weight: 900; color: #0284C7; margin-bottom: 0.5rem;">Step 1</div>
          <h3 style="font-size: 1.1rem; font-weight: 800; color: #0F172A; margin-bottom: 0.5rem;">Send Details</h3>
          <p style="font-size: 0.88rem; color: #475569; line-height: 1.5;">
            Message us on WhatsApp with your location and photos of the area needing attention.
          </p>
        </div>

        <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 14px; padding: 1.75rem; text-align: left;">
          <div style="font-size: 1.25rem; font-weight: 900; color: #0284C7; margin-bottom: 0.5rem;">Step 2</div>
          <h3 style="font-size: 1.1rem; font-weight: 800; color: #0F172A; margin-bottom: 0.5rem;">Review & Estimate</h3>
          <p style="font-size: 0.88rem; color: #475569; line-height: 1.5;">
            Our team reviews your requirement and provides clear information and price estimates upfront.
          </p>
        </div>

        <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 14px; padding: 1.75rem; text-align: left;">
          <div style="font-size: 1.25rem; font-weight: 900; color: #0284C7; margin-bottom: 0.5rem;">Step 3</div>
          <h3 style="font-size: 1.1rem; font-weight: 800; color: #0F172A; margin-bottom: 0.5rem;">Service Visit</h3>
          <p style="font-size: 0.88rem; color: #475569; line-height: 1.5;">
            An experienced technician visits to carry out the necessary adjustments or installation work.
          </p>
        </div>
      </div>

      <div style="background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 16px; padding: 2rem; text-align: center; max-width: 680px; margin: 0 auto;">
        <h3 style="font-size: 1.25rem; font-weight: 800; color: #0F172A; margin-bottom: 0.75rem;">Need Assistance with an Installation?</h3>
        <p style="font-size: 0.95rem; color: #64748B; margin-bottom: 1.5rem;">
          Contact our customer team directly via phone or WhatsApp for prompt assistance.
        </p>
        <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
          <a href={`tel:${business.phoneRaw}`} class="btn btn-primary btn-sm">
            <Phone size={16} />
            <span>Call {business.phone}</span>
          </a>
          <a href={`https://wa.me/${business.whatsapp}?text=Hi%20Invisible%20Safety%2C%20I%20need%20assistance%20with%20my%20installation.`} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm">
            <MessageCircle size={16} />
            <span>WhatsApp Support</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQSection category="warranty" title="Frequently Asked Service & Care Questions" />
</BaseLayout>
