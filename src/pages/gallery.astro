---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryFilter from '../components/react/GalleryFilter';
import TrustSection from '../components/TrustSection.astro';
import { getBreadcrumbSchema } from '../utils/seo';
import { business } from '../data/business';
import { Sparkles, MessageCircle, Phone, ArrowRight } from 'lucide-react';

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://Invisible Safety.com/" },
  { name: "Project Gallery", url: "https://Invisible Safety.com/gallery/" }
]);
---

<BaseLayout
  title="Real Installation Gallery & Case Studies | Invisible Safety"
  description="Explore completed invisible grill and safety net installations across luxury apartments in Hyderabad, Visakhapatnam, and Vijayawada. Real photos, floor details, and verified reviews."
  canonicalUrl="/gallery/"
  schema={[breadcrumbs]}
>
  <!-- Light Architectural Hero Section -->
  <section class="section-spacing" style="background: linear-gradient(180deg, #F0F9FF 0%, #F8FAFC 100%); border-bottom: 1px solid #E2E8F0;">
    <div class="container" style="text-align: center; max-width: 860px;">
      <div style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.9rem; background: #E0F2FE; border: 1px solid #BAE6FD; border-radius: 20px; font-size: 0.8rem; font-weight: 700; color: #0369A1; margin-bottom: 1.25rem;">
        <Sparkles size={14} />
        <span>GENUINE FIELD CRAFTSMANSHIP</span>
      </div>
      <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.4rem); font-weight: 800; color: #0F172A; line-height: 1.2; margin-bottom: 1.25rem;">
        Real Projects. Real Homes. <br />
        <span style="color: #2563EB;">Uncompromised Views.</span>
      </h1>
      <p style="font-size: 1.12rem; color: #475569; line-height: 1.65; max-width: 700px; margin: 0 auto 2rem auto;">
        Browse through verified installations completed in premier high-rises including My Home Bhooja, Aparna Serene Park, Prestige High Fields, and Sea Pearl Beach Road.
      </p>

      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a
          href={`https://wa.me/${business.whatsapp}?text=Hi%20Invisible Safety%2C%20I%20saw%20your%20project%20gallery%20and%20want%20to%20know%20if%20you%20have%20installed%20in%20my%20community.`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
        >
          <MessageCircle size={17} />
          <span>Ask About Your Society</span>
        </a>
        <a href="/invisible-grill-cost/" class="btn btn-primary">
          <span>Calculate My Balcony</span>
          <ArrowRight size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- Filterable Gallery Island -->
  <section class="section-spacing bg-warm" style="border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <GalleryFilter client:load />
    </div>
  </section>

  <TrustSection />
</BaseLayout>
