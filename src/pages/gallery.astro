---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryFilter from '../components/react/GalleryFilter';
import TrustSection from '../components/TrustSection.astro';
import { getBreadcrumbSchema } from '../utils/seo';
import { business } from '../data/business';
import { Sparkles, MessageCircle, Phone, ArrowRight } from 'lucide-react';

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Project Gallery", url: "https://invisiblesafety.in/gallery/" }
]);
---

<BaseLayout
  title="Real Installation Gallery & Case Studies | Invisible Safety"
  description="Explore completed invisible grill and safety net installations across luxury apartments in Hyderabad, Visakhapatnam, and Vijayawada. Real photos, floor details, and verified reviews."
  canonicalUrl="/gallery/"
  schema={[breadcrumbs]}
>
  <!-- Luxury Architectural Hero Section -->
  <section class="section-spacing" style="background: #0D0D0D; color: #FFFFFF; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
    <div class="container" style="text-align: center; max-width: 860px;">
      <span class="editorial-eyebrow" style="color: var(--color-gold, #C5A880); font-size: 11px; font-weight: 700; letter-spacing: 0.25em; text-transform: uppercase; margin-bottom: 0.75rem; display: block;">
        DOCUMENTED RESIDENTIAL INSTALLATIONS
      </span>
      <h1 style="font-family: var(--font-brand, 'Cinzel', serif); font-size: clamp(2rem, 4.5vw, 3.4rem); font-weight: 800; color: #FFFFFF; line-height: 1.2; margin-bottom: 1.25rem; letter-spacing: 0.08em; text-transform: uppercase;">
        Architectural Portfolio <br />
        <span style="color: var(--color-gold, #C5A880);">&amp; Case Studies</span>
      </h1>
      <p style="font-family: var(--font-serif, 'Playfair Display', serif); font-style: italic; font-size: 1.12rem; color: #94A3B8; line-height: 1.65; max-width: 700px; margin: 0 auto 2.25rem auto;">
        Browse through verified installations completed in premier high-rises including My Home Bhooja, Aparna Serene Park, Prestige High Fields, and Sea Pearl Beach Road.
      </p>

      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="/contact/#quote" class="btn-editorial-pill">
          <span>REQUEST SITE SURVEY</span>
          <ArrowRight size={14} />
        </a>
        <a
          href={`https://wa.me/${business.whatsapp}?text=Hi%20Invisible Safety%2C%20I%20saw%20your%20project%20gallery%20and%20want%20to%20know%20if%20you%20have%20installed%20in%20my%20community.`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-editorial-pill-secondary"
        >
          <MessageCircle size={15} />
          <span>ASK ABOUT YOUR SOCIETY</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Filterable Gallery Island -->
  <section class="section-spacing bg-warm" style="border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <GalleryFilter client:load />
    </div>
  </section>

  <TrustSection />
</BaseLayout>
