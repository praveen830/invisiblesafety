---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2, Wind } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Mosquito & Insect Safety Screens",
  "High-transparency fiberglass and stainless steel mosquito mesh screens for windows and French doors with custom site quote",
  45
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Animal & Bird Protection", url: "https://invisiblesafety.in/pigeon-nets/" },
  { name: "Mosquito Safety Nets", url: "https://invisiblesafety.in/mosquito-safety-nets/" }
]);

const specs = [
  { label: "Mesh Composition", value: "Fine-Weave FiberGlass / SS304 Wire", icon: ShieldCheck },
  { label: "Aperture Precision", value: "100% Micro-Insect & Fly Exclusion", icon: Award },
  { label: "Frame Track", value: "Sleek Powder-Coated Aluminium", icon: Wrench },
  { label: "Airflow Index", value: "Maximum Cross-Ventilation", icon: Wind }
];

const subcategories = [
  {
    title: "French Window Invisible Grills",
    subtitle: "Frameless high-tensile safety barriers for low-sill windows and sliding fenestrations.",
    href: "/window-invisible-grills/",
    image: "/images/window-invisible-grills.webp",
    spec: "Direct Wall Anchor Tracks",
    badge: "Fenestration Guard"
  },
  {
    title: "Translucent Anti-Pigeon Netting",
    subtitle: "Near-invisible monofilament grid denying roosting access to pigeons without daylight blockage.",
    href: "/pigeon-nets/",
    image: "/images/pigeon-net.webp",
    spec: "Virgin UV-Stabilized Co-Polymer",
    badge: "Discreet Living"
  },
  {
    title: "Balcony Invisible Grills",
    subtitle: "Floor-to-ceiling high-tensile SS316 marine cables safeguarding high-rise living balconies.",
    href: "/balcony-invisible-grills/",
    image: "/images/hero-balcony.webp",
    spec: "Japanese SS316 (2.0mm / 2.5mm)",
    badge: "Flagship Balcony"
  },
  {
    title: "Apartment Balcony Safety Nets",
    subtitle: "Full-perimeter protective enclosure stopping accidental falls without feeling caged.",
    href: "/balcony-safety/",
    image: "/images/safety-net-balcony.webp",
    spec: "Virgin High-Density Polymer",
    badge: "Residential Core"
  }
];

const gallery = [
  {
    src: "/images/window-invisible-grills.webp",
    alt: "Window Insect Screen Mesh",
    title: "French Fenestration Screen",
    caption: "Fine-mesh insect barrier paired with invisible grills for dual anti-fall and vector safety.",
    badge: "Window Protection"
  },
  {
    src: "/images/hero-balcony.webp",
    alt: "Balcony Invisible Grills",
    title: "Panoramic Skyline Aperture",
    caption: "High-contrast SS316 marine cables preserving panoramic cityscape views.",
    badge: "Skyline Vista"
  },
  {
    src: "/images/pigeon-net.webp",
    alt: "Translucent Pigeon Net on Balcony",
    title: "Translucent Skyline Protection",
    caption: "Unobtrusive bird exclusion preserving pristine aesthetic elevation.",
    badge: "Penthouse Living"
  },
  {
    src: "/images/child-safety.webp",
    alt: "Child-Safe Calibrated Balcony",
    title: "Toddler Anti-Fall System",
    caption: "Zero footholds preventing climbing leverage with unyielding load strength.",
    badge: "Child & Pet Safety"
  }
];
---

<SubPageLayout
  title="Mosquito Safety Screens | Insect Mesh for Windows & Balconies | Invisible Safety"
  description="High-transparency fiberglass and SS304 mosquito screens with custom site quote Full insect defense with unhindered natural cross-ventilation."
  canonicalUrl="/mosquito-safety-nets/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="VECTOR & INSECT DEFENSE"
  heroTitle="MOSQUITO &amp; INSECT SCREENS"
  heroSubtitle="Ultra-fine architectural fiberglass and stainless steel insect mesh integrated into sleek sliding, magnetic, and roller frames, eliminating mosquitoes while preserving cross-ventilation."
  heroImage="/images/window-invisible-grills.webp"
  heroImageAlt="Mosquito Safety Screens Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Vector Defense Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">DISEASE &amp; ALLERGEN PREVENTION</span>
        <h2 class="editorial-title">Vector-Free Evening Airflow</h2>
        <p class="editorial-subtitle">
          Keep sliding doors and windows open all night without chemical vaporizers or smoky mosquito coils.
        </p>
      </div>

      <div class="mosq-grid">
        <div class="mosq-card">
          <h3 class="mosq-card-title">High-Transparency Weave</h3>
          <p class="mosq-card-desc">
            Engineered with microscopic charcoal filament coating that renders the mesh virtually transparent against daylight, avoiding darkened gloomy interiors.
          </p>
        </div>

        <div class="mosq-card">
          <h3 class="mosq-card-title">Dengue &amp; Malaria Shield</h3>
          <p class="mosq-card-desc">
            Precision pore pitch halts Aedes and Anopheles mosquitoes, fruit gnats, and nocturnal flying beetles from entering bedrooms and living spaces.
          </p>
        </div>

        <div class="mosq-card">
          <h3 class="mosq-card-title">Pet-Resistant Claw Defense</h3>
          <p class="mosq-card-desc">
            Heavy-gauge stainless steel SS304 wire mesh options resist clawing by curious cats and dogs without tearing or fraying at frame edges.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Estimator Section -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Insect Screen Quote</h2>
        <p class="editorial-subtitle">
          Configure window and door frame dimensions for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mosq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .mosq-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .mosq-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .mosq-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .mosq-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
