---
import BaseLayout from '../layouts/BaseLayout.astro';
import EngineeringSection from '../components/EngineeringSection.astro';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { getBreadcrumbSchema } from '../utils/seo';
import { business } from '../data/business';
import { ShieldCheck, Check, AlertCircle, Wrench, ArrowRight, MessageCircle } from 'lucide-react';

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Materials & SS316", url: "https://invisiblesafety.in/materials/" }
]);
---

<BaseLayout
  title="SS316 Marine Grade Steel Engineering & Wire Specs | Invisible Safety"
  description="Learn why virgin SS316 marine-grade stainless steel with 2.5% Molybdenum is non-negotiable for high-rise balconies. Wire breaking load, DuPont nylon casing, and aerospace tracks."
  canonicalUrl="/materials/"
  schema={[breadcrumbs]}
>
  <!-- Light Architectural Hero Section -->
  <section class="section-spacing" style="background: linear-gradient(180deg, #F0F9FF 0%, #F8FAFC 100%); border-bottom: 1px solid #E2E8F0;">
    <div class="container" style="text-align: center; max-width: 880px;">
      <div style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.9rem; background: #E0F2FE; border: 1px solid #BAE6FD; border-radius: 20px; font-size: 0.8rem; font-weight: 700; color: #0369A1; margin-bottom: 1.25rem;">
        <ShieldCheck size={14} />
        <span>METALLURGICAL CERTIFICATION & STANDARDS</span>
      </div>
      <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.4rem); font-weight: 800; color: #0F172A; line-height: 1.2; margin-bottom: 1.25rem;">
        The Science of SS316 <br />
        <span style="color: #2563EB;">Marine-Grade Architecture</span>
      </h1>
      <p style="font-size: 1.12rem; color: #475569; line-height: 1.65; max-width: 740px; margin: 0 auto 2rem auto;">
        Not all stainless steel is created equal. Cheap local fabricators often install interior-grade SS202 or SS304 that rusts in monsoons. Discover why Invisible Safety strictly mandates virgin SS316 marine alloy.
      </p>

      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a
          href={`https://wa.me/${business.whatsapp}?text=Hi%20Invisible Safety%2C%20please%20share%20your%20SS316%20test%20reports%20and%20cable%20specifications.`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
        >
          <MessageCircle size={17} />
          <span>Request Metallurgical Test Report</span>
        </a>
        <a href="/invisible-grill-cost/" class="btn btn-primary">
          <span>Calculate Balcony Cost</span>
          <ArrowRight size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- Steel Grade Chemical Composition Comparison -->
  <section class="section-spacing bg-warm" style="border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">CHEMICAL COMPOSITION</span>
        <h2>Why Molybdenum Makes All The Difference</h2>
        <p>Understanding the chemistry behind true coastal and high-humidity corrosion resistance.</p>
      </div>

      <div style="overflow-x: auto; background: #FFFFFF; border-radius: 14px; box-shadow: 0 2px 8px -2px rgba(15, 23, 42, 0.06); border: 1px solid #E2E8F0;">
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
          <thead>
            <tr style="background: #F8FAFC; border-bottom: 2px solid #E2E8F0;">
              <th style="padding: 1.25rem 1.5rem; color: #0F172A; font-weight: 700; font-size: 0.92rem;">Alloy Grade</th>
              <th style="padding: 1.25rem 1.5rem; color: #0F172A; font-weight: 700; font-size: 0.92rem;">Molybdenum (Mo) Content</th>
              <th style="padding: 1.25rem 1.5rem; color: #0F172A; font-weight: 700; font-size: 0.92rem;">Resistance to Salt & Acid Rain</th>
              <th style="padding: 1.25rem 1.5rem; color: #0F172A; font-weight: 700; font-size: 0.92rem;">Suitability for Balconies</th>
            </tr>
          </thead>
          <tbody style="font-size: 0.92rem; color: #334155;">
            <tr style="border-bottom: 1px solid #E2E8F0; background: #EFF6FF;">
              <td style="padding: 1.2rem 1.5rem; font-weight: 700; color: #1D4ED8;">
                Invisible Safety SS316 (Marine Grade)
              </td>
              <td style="padding: 1.2rem 1.5rem; color: #16A34A; font-weight: 700;">2.0% – 2.5% Mo</td>
              <td style="padding: 1.2rem 1.5rem; color: #16A34A; font-weight: 600;">Immune to chloride & pitting corrosion</td>
              <td style="padding: 1.2rem 1.5rem; color: #16A34A; font-weight: 600;">Optimal (10-Year Rust-Free Life)</td>
            </tr>
            <tr style="border-bottom: 1px solid #E2E8F0;">
              <td style="padding: 1.2rem 1.5rem; font-weight: 600; color: #0F172A;">SS304 (Food / Indoor Grade)</td>
              <td style="padding: 1.2rem 1.5rem; color: #DC2626; font-weight: 600;">0% (No Molybdenum)</td>
              <td style="padding: 1.2rem 1.5rem; color: #D97706;">Develops brown tea-staining & pits in 1-2 years</td>
              <td style="padding: 1.2rem 1.5rem; color: #D97706;">Indoor only; unsuitable for coastal balcony air</td>
            </tr>
            <tr>
              <td style="padding: 1.2rem 1.5rem; font-weight: 600; color: #0F172A;">SS202 (Low-Cost Commercial)</td>
              <td style="padding: 1.2rem 1.5rem; color: #DC2626; font-weight: 600;">0% (High Manganese substitute)</td>
              <td style="padding: 1.2rem 1.5rem; color: #DC2626; font-weight: 600;">Rapidly oxidizes and rusts in first monsoon</td>
              <td style="padding: 1.2rem 1.5rem; color: #DC2626; font-weight: 600;">Severe Hazard: Cable snapping risk</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Engineering Section -->
  <EngineeringSection />

  <!-- Track & Hardware Anatomy -->
  <section class="section-spacing bg-white" style="border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">HARDWARE ANATOMY</span>
        <h2>Precision Track & Anchorage System</h2>
        <p>A cable is only as dependable as the anchoring tracks holding it under tension.</p>
      </div>

      <div class="grid-3">
        <div class="card">
          <h3 style="font-size: 1.2rem; font-weight: 700; color: #0F172A; margin-bottom: 0.5rem;">6063-T6 Structural Aluminium</h3>
          <p style="font-size: 0.92rem; color: #475569; line-height: 1.6;">
            Extruded from architectural grade aluminum-magnesium-silicon alloy, heat treated to T6 temper for high tensile yield strength and zero warping under continuous cable tension.
          </p>
        </div>

        <div class="card">
          <h3 style="font-size: 1.2rem; font-weight: 700; color: #0F172A; margin-bottom: 0.5rem;">Hard Anodized Protective Finish</h3>
          <p style="font-size: 0.92rem; color: #475569; line-height: 1.6;">
            25-micron electrochemical oxide coat prevents aluminum oxidation, matching the subtle architectural hues of modern balcony frames.
          </p>
        </div>

        <div class="card">
          <h3 style="font-size: 1.2rem; font-weight: 700; color: #0F172A; margin-bottom: 0.5rem;">Concealed Locking Track Cover</h3>
          <p style="font-size: 0.92rem; color: #475569; line-height: 1.6;">
            A snap-fit aesthetic cover completely conceals anchor screw heads and tension barrels, shielding internal components from rainwater and dust accumulation.
          </p>
        </div>
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection category="installation" title="Installation & Materials FAQ" />
</BaseLayout>
