---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { pricing } from '../data/pricing';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2, Check, ArrowRight } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Balcony Safety Nets & Anti-Pigeon Solutions",
  "Certified high-density polyethylene (HDPE) and nylon safety netting for residential balconies, child safety, and pigeon deterrent.",
  pricing.safetyNet.balconyStandard
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Safety Nets", url: "https://invisiblesafety.in/safety-nets/" }
]);

const specs = [
  { label: "Polymer Standard", value: "Virgin UV-Stabilized Monofilament", icon: ShieldCheck },
  { label: "Impact Capacity", value: "150+ kgf Resistance per Mesh Unit", icon: Award },
  { label: "Weather Durability", value: "Heat, Rain & Monsoon Resistant", icon: Wrench },
  { label: "Replacement Warranty", value: "3 to 5-Year Certified Guarantee", icon: CheckCircle2 }
];

const subcategories = [
  {
    title: "Apartment Balcony Safety Nets",
    subtitle: "Full-perimeter protective enclosure stopping accidental falls without making balconies feel caged.",
    href: "/balcony-safety/",
    image: "/images/safety-net-balcony.webp",
    spec: "Virgin High-Density Polymer",
    badge: "Residential Core"
  },
  {
    title: "Toddler & Pet Anti-Fall Nets",
    subtitle: "Calibrated mesh preventing toys, toddlers, or pets from squeezing through railings.",
    href: "/child-safety-nets/",
    image: "/images/child-safety.webp",
    spec: "Anti-Chafe Smooth Knots",
    badge: "Child Safe"
  },
  {
    title: "Internal Stairwell Void Protection",
    subtitle: "Vertical safety netting closing large staircase eye gaps in villas and duplexes.",
    href: "/staircase-safety-nets/",
    image: "/images/staircase-invisible-grills.webp",
    spec: "Floor-to-Floor Continuous Webbing",
    badge: "Interior Void"
  },
  {
    title: "Terrace Top Fall Perimeter",
    subtitle: "Boundary safety netting installed over open parapets to secure terrace gatherings.",
    href: "/terrace-safety-nets/",
    image: "/images/terrace-top-net.jpg",
    spec: "High-Tensile Perimeter Tie Cords",
    badge: "Rooftop Guard"
  }
];

const gallery = [
  {
    src: "/images/safety-net-balcony.webp",
    alt: "Balcony Safety Net Overlooking City",
    title: "Apartment Balcony Fall Shield",
    caption: "UV-treated high-density netting installed on a 15th-floor luxury balcony.",
    badge: "Residential Core"
  },
  {
    src: "/images/balcony-safety.webp",
    alt: "Clean Balcony Safety Mesh",
    title: "Architectural Parapet Extension",
    caption: "Precision anchor installation providing total peace of mind for families.",
    badge: "Family Peace of Mind"
  },
  {
    src: "/images/child-safety.webp",
    alt: "Toddler Safe Balcony Railing",
    title: "Toddler & Pet Anti-Drop Barrier",
    caption: "Tight-grid netting stopping pets and toy drops with high impact resilience.",
    badge: "Pet & Child Guard"
  },
  {
    src: "/images/terrace-top-net.jpg",
    alt: "Terrace Top Fall Perimeter",
    title: "Terrace Party Deck Protection",
    caption: "Secured terrace boundary allowing safe evening gatherings and events.",
    badge: "Terrace Guard"
  }
];
---

<SubPageLayout
  title="Balcony Safety Nets & Living Spaces | Boundless Horizons | Invisible Safety"
  description="High-density UV-treated balcony safety nets, sports nets, and translucent anti-pigeon netting. 100% humane, zero-sag guarantee, SS304 anchors."
  canonicalUrl="/safety-nets/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="RESIDENTIAL PERIMETERS"
  heroTitle="BOUNDLESS HORIZONS"
  heroSubtitle="High-density UV-treated virgin polymer safety nets safeguarding living balconies, internal stairwells, and terrace perimeters."
  heroImage="/images/safety-net-balcony.webp"
  heroImageAlt="High-Rise Balcony Safety Net Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Polymer Material Highlights -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">TENSILE MONOFILAMENT DYNAMICS</span>
        <h2 class="editorial-title">Engineered For High-Altitude Safety</h2>
        <p class="editorial-subtitle">
          Manufactured with heat-set knots and UV stabilizers tested across Indian monsoon conditions.
        </p>
      </div>

      <div class="safety-features-grid">
        <div class="feature-card">
          <h3 class="feature-title">SS304 Corner Tensioning</h3>
          <p class="feature-desc">
            Anchored using heavy-duty AISI 304 marine stainless steel eye-bolts and perimeter cables, eliminating sag over years of sun exposure.
          </p>
        </div>

        <div class="feature-card">
          <h3 class="feature-title">Anti-Chafe Knots</h3>
          <p class="feature-desc">
            Ultra-smooth monofilament joints will not scratch toddler hands or pet paws during vigorous contact or balcony play.
          </p>
        </div>

        <div class="feature-card">
          <h3 class="feature-title">RWA Uniformity Approved</h3>
          <p class="feature-desc">
            Clean perimeter lines that conform to gated community architectural elevation guidelines without protruding iron cages.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Smart Cost Estimator -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Balcony Net Cost</h2>
        <p class="editorial-subtitle">
          Configure balcony dimensions for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .safety-features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .feature-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .feature-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .feature-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .feature-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
