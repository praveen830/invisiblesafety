---
import BaseLayout from '../layouts/BaseLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { pricing } from '../data/pricing';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { Shield, Check, MessageCircle, Phone, ArrowRight, Bird, Users, Sparkles, Target, Activity } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Balcony Safety Nets & Anti-Pigeon Solutions",
  "Certified high-density polyethylene (HDPE) and nylon safety netting for residential balconies, child safety, and pigeon deterrent.",
  pricing.safetyNet.balconyStandard
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Safety Nets", url: "https://invisiblesafety.in/safety-nets/" }
]);
---

<BaseLayout
  title="Balcony Safety Nets & Anti-Pigeon Nets | Invisible Safety India"
  description="High-density UV-treated balcony safety nets, sports nets, and translucent anti-pigeon netting. 100% humane, zero-sag guarantee, SS304 anchors with professional same-day installation."
  canonicalUrl="/safety-nets/"
  schema={[serviceSchema, breadcrumbs]}
>
  <!-- Hero Section -->
  <section class="section-spacing" style="background: linear-gradient(180deg, #F0FDF4 0%, #F8FAFC 100%); border-bottom: 1px solid #E2E8F0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3.5rem; align-items: center;">
        <div>
          <div style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.85rem; background: #DCFCE7; border: 1px solid #BBF7D0; border-radius: 20px; font-size: 0.8rem; font-weight: 700; color: #15803D; margin-bottom: 1.25rem;">
            <Shield size={14} /> CERTIFIED HIGH-DENSITY POLYMER PROTECTION
          </div>
          <h1 style="font-size: clamp(2.3rem, 4.5vw, 3.6rem); font-weight: 800; color: #0F172A; line-height: 1.15; margin-bottom: 1.25rem; letter-spacing: -0.03em;">
            Balcony Safety Nets & <br />
            <span style="color: #16A34A;">Pigeon Protection Meshes</span>
          </h1>
          <p style="font-size: 1.1rem; color: #475569; line-height: 1.65; margin-bottom: 2rem;">
            Protect children, pets, and balconies from accidental falls and hazardous bird nesting. Manufactured from 100% virgin UV-stabilized polymer with SS304 stainless steel perimeter anchors.
          </p>

          <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2.5rem;">
            <a href="#estimator" class="btn btn-primary">
              <span>Calculate Safety Net Cost</span>
              <ArrowRight size={17} />
            </a>
            <a
              href={`https://wa.me/${business.whatsapp}?text=Hi%20Invisible Safety%2C%20I%20need%20a%20quote%20for%20Balcony%20Safety%20Nets%20%2F%20Pigeon%20Nets.`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp"
            >
              <MessageCircle size={17} />
              <span>Get Quote on WhatsApp</span>
            </a>
          </div>

          <div style="display: inline-flex; align-items: center; gap: 1.5rem; background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 14px; padding: 0.85rem 1.5rem; box-shadow: var(--shadow-sm);">
            <div>
              <span style="font-size: 0.72rem; color: #64748B; display: block; font-weight: 600; text-transform: uppercase;">Quotation:</span>
              <span style="font-size: 1.25rem; font-weight: 800; color: #16A34A;">Custom Site Quote</span>
            </div>
            <div style="width: 1px; height: 32px; background: #E2E8F0;"></div>
            <div>
              <span style="font-size: 0.72rem; color: #64748B; display: block; font-weight: 600; text-transform: uppercase;">Turnaround:</span>
              <span style="font-size: 1.25rem; font-weight: 800; color: #0284C7;">Same-Day 2-3 Hrs</span>
            </div>
          </div>
        </div>

        <!-- Hero Image Showcase -->
        <div style="position: relative; border-radius: 20px; overflow: hidden; background: #FFFFFF; border: 1px solid #E2E8F0; padding: 0.85rem; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);">
          <div style="position: relative; border-radius: 14px; overflow: hidden; aspect-ratio: 16/9;">
            <img
              src="/images/safety-net-balcony.webp"
