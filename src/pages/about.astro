---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustSection from '../components/TrustSection.astro';
import { getBreadcrumbSchema } from '../utils/seo';
import { business } from '../data/business';
import { Shield, Award, Users, HardHat, CheckCircle2, ArrowRight } from 'lucide-react';

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "About Us", url: "https://invisiblesafety.in/about/" }
]);
---

<BaseLayout
  title="About Invisible Safety | Architectural Safety Specialists in India"
  description="Learn about Invisible Safety's mission to eliminate high-rise fall hazards across India without sacrificing modern architectural aesthetics. In-house trained teams, zero shortcuts."
  canonicalUrl="/about/"
  schema={[breadcrumbs]}
>
  <section class="section-spacing bg-warm" style="border-bottom: 1px solid var(--color-border);">
    <div class="container" style="text-align: center; max-width: 860px;">
      <span class="eyebrow" style="margin-bottom: 1rem;">
        Our Mission & Values
      </span>
      <h1 style="font-size: clamp(2.4rem, 5vw, 3.8rem); font-weight: 800; color: #0F172A; line-height: 1.15; margin-bottom: 1.25rem;">
        Pioneering Architectural <br />
        <span style="color: #2563EB;">Home Safety in India</span>
      </h1>
      <p style="font-size: 1.15rem; color: #475569; line-height: 1.6; max-width: 700px; margin: 0 auto 2rem auto;">
        Founded on the premise that child and pet protection should never turn your home into an iron cage. We engineer seamless, durable invisible grills that celebrate light, ventilation, and skyline views.
      </p>

      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="/invisible-grills/" class="btn btn-primary">
          <span>Explore Safety Solutions</span>
          <ArrowRight size={17} />
        </a>
        <a href="/contact/" class="btn btn-secondary">
          <span>Contact Our Office</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section class="section-spacing bg-white" style="border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Core Principles</span>
        <h2>The Three Tenets of Invisible Safety</h2>
        <p>How we approach every installation, from residential balconies to commercial duct shafts.</p>
      </div>

      <div class="grid-3">
        <div class="arch-card">
          <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(2, 132, 199, 0.15); display: flex; align-items: center; justify-content: center; color: #0284C7; margin-bottom: 1.25rem;">
            <Shield size={22} />
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 700; color: #0F233D; margin-bottom: 0.5rem;">Authentic Metallurgy</h3>
          <p style="font-size: 0.88rem; color: #475569; line-height: 1.6;">
            Every meter of cable installed uses stainless steel cable systems designed for residential balcony containment.
          </p>
        </div>

        <div class="arch-card">
          <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(16, 185, 129, 0.15); display: flex; align-items: center; justify-content: center; color: #16A34A; margin-bottom: 1.25rem;">
            <HardHat size={22} />
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 700; color: #0F233D; margin-bottom: 0.5rem;">Worker Safety Dignity</h3>
          <p style="font-size: 0.88rem; color: #475569; line-height: 1.6;">
            Safety starts with our own team. We never permit technicians to work at dangerous heights without safety harnesses and dual lifelines.
          </p>
        </div>

        <div class="arch-card">
          <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(245, 158, 11, 0.15); display: flex; align-items: center; justify-content: center; color: #D97706; margin-bottom: 1.25rem;">
            <Award size={22} />
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 700; color: #0F233D; margin-bottom: 0.5rem;">Uncompromising Accountability</h3>
          <p style="font-size: 0.88rem; color: #475569; line-height: 1.6;">
            We provide clear written documentation and warranty assurance with scheduled follow-up checks. If your cables require re-alignment, our team provides timely support.
          </p>
        </div>
      </div>
    </div>
  </section>

  <TrustSection />
</BaseLayout>
