---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2 } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Building Safety Nets & Facade Protection",
  "High-rise building facade, duct void, and perimeter safety netting for residential societies and commercial towers with custom site quote",
  20
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Construction & Industrial", url: "https://invisiblesafety.in/construction-safety-nets/" },
  { name: "Building Safety Nets", url: "https://invisiblesafety.in/building-safety-nets/" }
]);

const specs = [
  { label: "High-Altitude Tensile", value: "Virgin UV-Stabilized Polymer", icon: ShieldCheck },
  { label: "Facade Elevation", value: "Aesthetic Uniformity Compliant", icon: Award },
  { label: "Marine Anchoring", value: "AISI 304 Stainless Steel Rigging", icon: Wrench },
  { label: "Direct Warranty", value: "5-Year High-Altitude Guarantee", icon: CheckCircle2 }
];

const subcategories = [
  {
    title: "Building Duct Shaft Enclosures",
    subtitle: "Continuous vertical netting closing deep building plumbing ducts to prevent tool drops.",
    href: "/duct-safety-nets/",
    image: "/images/duct-net.webp",
    spec: "Shaft Void Protection",
    badge: "Hygiene Guard"
  },
  {
    title: "Construction Site Fall Nets",
    subtitle: "Dual-layer personnel fall arrest mesh with fine debris catch lining for active multi-story sites.",
    href: "/construction-safety-nets/",
    image: "/images/construction-safety-net.jpg",
    spec: "High-Impact Shock-Absorbing Core",
    badge: "Life Safety"
  },
  {
    title: "Apartment Balcony Safety Nets",
    subtitle: "Full-perimeter protective enclosure stopping accidental falls without feeling caged.",
    href: "/balcony-safety/",
    image: "/images/safety-net-balcony.webp",
    spec: "Virgin High-Density Polymer",
    badge: "Residential Core"
  },
  {
    title: "Car Parking Perimeter Nets",
    subtitle: "Basement and podium parking barriers preventing cricket ball strikes and vehicular damage.",
    href: "/car-parking-safety-nets/",
    image: "/images/car-parking-net.jpg",
    spec: "Weather-Resistant Multi-Strand Mesh",
    badge: "Basement Shield"
  }
];

const gallery = [
  {
    src: "/images/building-safety-net.jpg",
    alt: "Building Facade Safety Netting",
    title: "High-Rise Multi-Tower Facade",
    caption: "Full elevation perimeter netting installed across high-rise residential towers preserving structural safety.",
    badge: "Society Elevation"
  },
  {
    src: "/images/duct-net.webp",
    alt: "Vertical Duct Enclosure",
    title: "Internal Duct Void Enclosure",
    caption: "Continuous floor-to-floor vertical barrier protecting service shafts.",
    badge: "Shaft Protection"
  },
  {
    src: "/images/construction-safety-net.jpg",
    alt: "Construction Scaffolding Netting",
    title: "Tower Facade Catch Net",
    caption: "Engineered fall arrest network safeguarding active high-rise construction.",
    badge: "Commercial Site"
  },
  {
    src: "/images/car-parking-net.jpg",
    alt: "Podium Parking Protection",
    title: "Podium Car Parking Barrier",
    caption: "Aesthetic perimeter mesh shielding luxury cars from stray ball impacts.",
    badge: "Podium Shield"
  }
];
---

<SubPageLayout
  title="Building Safety Nets | High-Rise Facade & Society Netting | Invisible Safety"
  description="High-rise building safety nets for societies, commercial towers, and apartments with custom site quote RWA compliant with 5-year warranty."
  canonicalUrl="/building-safety-nets/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="HIGH-RISE STRUCTURAL FACADES"
  heroTitle="BUILDING ELEVATION SAFETY NETS"
  heroSubtitle="Comprehensive exterior facade, air-well shaft, and perimeter building safety netting engineered for residential gated societies, high-rise towers, and corporate campuses."
  heroImage="/images/building-safety-net.jpg"
  heroImageAlt="Building Safety Nets Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Building Facade Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">COMMUNITY ARCHITECTURE</span>
        <h2 class="editorial-title">Society-Wide Elevation Uniformity</h2>
        <p class="editorial-subtitle">
          Approved by resident welfare associations (RWAs) for preserving building aesthetic balance.
        </p>
      </div>

      <div class="bld-grid">
        <div class="bld-card">
          <h3 class="bld-card-title">Air-Well &amp; Courtyard Enclosure</h3>
          <p class="bld-card-desc">
            Encloses open internal sky-wells and central courtyards in luxury apartments, eliminating dangerous drop corridors without darkening interior windows.
          </p>
        </div>

        <div class="bld-card">
          <h3 class="bld-card-title">Facade Fall Protection</h3>
          <p class="bld-card-desc">
            Safeguards multi-story building perimeters during window cleaning and exterior facade maintenance, providing certified peace of mind for facility management.
          </p>
        </div>

        <div class="bld-card">
          <h3 class="bld-card-title">Zero Corrosion Anchors</h3>
          <p class="bld-card-desc">
            Anchored using heavy-duty AISI 304 marine expansion fasteners and guide cables that never drip rust streaks down painted exterior walls during monsoon rains.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Estimator Section -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Building Netting Quote</h2>
        <p class="editorial-subtitle">
          Configure society tower or shaft dimensions for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .bld-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .bld-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .bld-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .bld-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .bld-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
