---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryFilter from '../components/react/GalleryFilter';
import TrustSection from '../components/TrustSection.astro';
import { getBreadcrumbSchema } from '../utils/seo';
import { business } from '../data/business';
import { Sparkles, MessageCircle, Phone, ArrowRight } from 'lucide-react';

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Projects", url: "https://invisiblesafety.in/projects/" }
]);
---

<BaseLayout
  title="Completed High-Rise Installations & Projects | Invisible Safety"
  description="Explore completed case studies and verified architectural safety installations in Hyderabad, Vizag, and Vijayawada. Floor levels, square footage, and client feedback."
  canonicalUrl="/projects/"
  schema={[breadcrumbs]}
>
  <!-- Light Architectural Hero Section -->
  <section class="section-spacing" style="background: linear-gradient(180deg, #F0F9FF 0%, #F8FAFC 100%); border-bottom: 1px solid #E2E8F0;">
    <div class="container" style="text-align: center; max-width: 860px;">
      <div style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.9rem; background: #E0F2FE; border: 1px solid #BAE6FD; border-radius: 20px; font-size: 0.8rem; font-weight: 700; color: #0369A1; margin-bottom: 1.25rem;">
        <Sparkles size={14} />
        <span>VERIFIED HIGH-RISE CASE STUDIES</span>
      </div>
      <h1 style="font-size: clamp(2.2rem, 4.5vw, 3.4rem); font-weight: 800; color: #0F172A; line-height: 1.2; margin-bottom: 1.25rem;">
        Engineering Case Studies & <br />
        <span style="color: #2563EB;">Completed Projects</span>
      </h1>
      <p style="font-size: 1.12rem; color: #475569; line-height: 1.65; max-width: 700px; margin: 0 auto 2rem auto;">
        Real verified projects across My Home Bhooja, Aparna Serene Park, Prestige High Fields, Sea Pearl Vizag, and Fortune Heights Vijayawada.
      </p>

      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="/invisible-grill-cost/" class="btn btn-primary">
          <span>Calculate Your Space</span>
          <ArrowRight size={16} />
        </a>
        <a
          href={`https://wa.me/${business.whatsapp}?text=Hi%20Invisible Safety%2C%20I%20want%20to%20see%20more%20project%20photos%20of%20installations%20in%20my%20area.`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
        >
          <MessageCircle size={17} />
          <span>Request Society Photos</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Filterable Case Studies Island -->
  <section class="section-spacing bg-warm" style="border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <GalleryFilter client:load />
    </div>
  </section>

  <TrustSection />
</BaseLayout>
