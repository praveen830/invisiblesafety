---
import BaseLayout from '../layouts/BaseLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getBreadcrumbSchema } from '../utils/seo';
import { Ruler, ShieldCheck, CheckCircle2, ArrowRight, MessageCircle, Building2, Layers, Compass } from 'lucide-react';

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Free Site Quote", url: "https://invisiblesafety.in/invisible-grill-cost/" }
]);
---

<BaseLayout
  title="Custom Quotation & Free Site Measurement | Invisible Safety"
  description="Request a complimentary on-site laser measurement and custom transparent quotation for invisible safety grills and safety nets based on your balcony structure, height, and area."
  canonicalUrl="/invisible-grill-cost/"
  schema={[breadcrumbs]}
>
  <!-- Hero Section -->
  <section class="section-spacing" style="background: linear-gradient(180deg, #F0F9FF 0%, #F8FAFC 100%); border-bottom: 1px solid #E2E8F0;">
    <div class="container" style="text-align: center; max-width: 900px;">
      <div style="display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.35rem 0.9rem; background: #E0F2FE; border: 1px solid #BAE6FD; border-radius: 20px; font-size: 0.78rem; font-weight: 800; color: #0369A1; margin-bottom: 1.25rem; letter-spacing: 0.05em;">
        <Ruler size={15} />
        <span>COMPLIMENTARY ON-SITE EVALUATION</span>
      </div>
      <h1 style="font-size: clamp(2.3rem, 4.8vw, 3.5rem); font-weight: 800; color: #0F172A; line-height: 1.18; margin-bottom: 1.25rem; letter-spacing: -0.03em;">
        Site-Specific Custom Quotes & <br />
        <span style="color: #2563EB;">Free Laser Measurement</span>
      </h1>
      <p style="font-size: 1.12rem; color: #475569; line-height: 1.65; margin-bottom: 2rem; max-width: 760px; margin-left: auto; margin-right: auto;">
        Every residential tower and villa balcony has distinct structural requirements — including floor elevation, wind-load exposure, and mounting concrete. We provide 100% free on-site laser measurement to give you an exact, highly competitive quote with zero hidden charges.
      </p>

      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="#quote-tool" class="btn btn-primary">
          <span>Plan Site Measurement</span>
          <ArrowRight size={17} />
        </a>
        <a
          href={`https://wa.me/${business.whatsapp}?text=Hi%20Invisible Safety%2C%20I%20would%20like%20to%20book%20a%20free%20site%20laser%20measurement%20and%20quote%20for%20my%20balcony.`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
        >
          <MessageCircle size={17} />
          <span>Book Free Site Visit on WhatsApp</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Key Factors Explaining Custom Site-Based Pricing -->
  <section class="section-spacing" style="background: #FFFFFF; border-bottom: 1px solid #E2E8F0;">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">ENGINEERING INTEGRITY</span>
        <h2>How We Calculate Your Exact Site Quote</h2>
        <p>Instead of generic one-size-fits-all estimates, our senior structural engineers evaluate your exact space to guarantee uncompromised safety and fair pricing.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; max-width: 1100px; margin: 0 auto;">
        <div class="card" style="background: #F8FAFC; border: 1px solid #E2E8F0; padding: 1.8rem; border-radius: 14px;">
          <div style="width: 44px; height: 44px; border-radius: 10px; background: #E0F2FE; color: #0284C7; display: flex; align-items: center; justify-content: center; margin-bottom: 1.15rem;">
            <Building2 size={22} />
          </div>
          <h3 style="font-size: 1.15rem; font-weight: 700; color: #0F172A; margin-bottom: 0.6rem;">1. Floor Elevation & Wind Load</h3>
          <p style="font-size: 0.9rem; color: #475569; line-height: 1.55; margin: 0;">
            High-rise installations (10th floor and above) require reinforced stainless steel expansion anchors and tension dampeners to withstand severe monsoon winds and high-altitude vortexes.
          </p>
        </div>

        <div class="card" style="background: #F8FAFC; border: 1px solid #E2E8F0; padding: 1.8rem; border-radius: 14px;">
          <div style="width: 44px; height: 44px; border-radius: 10px; background: #DCFCE7; color: #16A34A; display: flex; align-items: center; justify-content: center; margin-bottom: 1.15rem;">
            <Compass size={22} />
          </div>
          <h3 style="font-size: 1.15rem; font-weight: 700; color: #0F172A; margin-bottom: 0.6rem;">2. Balcony Curvature & Brackets</h3>
          <p style="font-size: 0.9rem; color: #475569; line-height: 1.55; margin: 0;">
            L-shaped, curved, or multi-angle balconies require custom extruded aluminium mitre cuts and reinforced structural corner brackets to maintain continuous tension and zero sag.
          </p>
        </div>

        <div class="card" style="background: #F8FAFC; border: 1px solid #E2E8F0; padding: 1.8rem; border-radius: 14px;">
          <div style="width: 44px; height: 44px; border-radius: 10px; background: #FEF3C7; color: #D97706; display: flex; align-items: center; justify-content: center; margin-bottom: 1.15rem;">
            <Layers size={22} />
          </div>
          <h3 style="font-size: 1.15rem; font-weight: 700; color: #0F172A; margin-bottom: 0.6rem;">3. Material & Wire Gauge</h3>
          <p style="font-size: 0.9rem; color: #475569; line-height: 1.55; margin: 0;">
            We engineer solutions using virgin Japanese SS316 marine-grade cables (2.0mm or 2.5mm) with transparent UV-nylon coating and 50mm or 75mm spacing matched to your child and pet protection requirements.
          </p>
        </div>

        <div class="card" style="background: #F8FAFC; border: 1px solid #E2E8F0; padding: 1.8rem; border-radius: 14px;">
          <div style="width: 44px; height: 44px; border-radius: 10px; background: #F3E8FF; color: #9333EA; display: flex; align-items: center; justify-content: center; margin-bottom: 1.15rem;">
            <ShieldCheck size={22} />
          </div>
          <h3 style="font-size: 1.15rem; font-weight: 700; color: #0F172A; margin-bottom: 0.6rem;">4. Certified Safety Installation</h3>
          <p style="font-size: 0.9rem; color: #475569; line-height: 1.55; margin: 0;">
            Every quote includes certified work-at-height technicians equipped with IS 3521 full-body harnesses, laser-aligned cable anchoring, digital tension calibration, and written 10-year guarantee.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Measurement Planning Tool -->
  <section class="section-spacing" style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0;" id="quote-tool">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">CUSTOM QUOTATION</span>
        <h2>Plan Your Free Site Measurement</h2>
        <p>Select your product and approximate dimensions below to request a complimentary on-site evaluation and custom quote.</p>
      </div>

      <CostEstimator client:load />
    </div>
  </section>

  <!-- 4-Step Process -->
  <section class="section-spacing" style="background: #FFFFFF; border-bottom: 1px solid #E2E8F0;">
    <div class="container" style="max-width: 960px;">
      <div class="section-header">
        <span class="eyebrow">EFFORTLESS WORKFLOW</span>
        <h2>How Our Site Quotation Works</h2>
        <p>From initial measurement to final installation, we keep the process completely transparent and hassle-free.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem;">
        <div style="text-align: center; padding: 1.5rem 1rem;">
          <div style="width: 42px; height: 42px; border-radius: 50%; background: #2563EB; color: #FFFFFF; font-weight: 800; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem auto;">1</div>
          <h4 style="font-size: 1.05rem; font-weight: 700; color: #0F172A; margin-bottom: 0.4rem;">Free Site Visit</h4>
          <p style="font-size: 0.86rem; color: #64748B; line-height: 1.5; margin: 0;">Our technician visits your home with actual physical cable and net samples.</p>
        </div>

        <div style="text-align: center; padding: 1.5rem 1rem;">
          <div style="width: 42px; height: 42px; border-radius: 50%; background: #2563EB; color: #FFFFFF; font-weight: 800; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem auto;">2</div>
          <h4 style="font-size: 1.05rem; font-weight: 700; color: #0F172A; margin-bottom: 0.4rem;">Laser Measurement</h4>
          <p style="font-size: 0.86rem; color: #64748B; line-height: 1.5; margin: 0;">Accurate millimeter laser measuring of balconies, windows, and duct voids.</p>
        </div>

        <div style="text-align: center; padding: 1.5rem 1rem;">
          <div style="width: 42px; height: 42px; border-radius: 50%; background: #2563EB; color: #FFFFFF; font-weight: 800; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem auto;">3</div>
          <h4 style="font-size: 1.05rem; font-weight: 700; color: #0F172A; margin-bottom: 0.4rem;">Exact Written Quote</h4>
          <p style="font-size: 0.86rem; color: #64748B; line-height: 1.5; margin: 0;">Clear, transparent pricing sheet tailored to your building floor and layout.</p>
        </div>

        <div style="text-align: center; padding: 1.5rem 1rem;">
          <div style="width: 42px; height: 42px; border-radius: 50%; background: #2563EB; color: #FFFFFF; font-weight: 800; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem auto;">4</div>
          <h4 style="font-size: 1.05rem; font-weight: 700; color: #0F172A; margin-bottom: 0.4rem;">Precision Setup</h4>
          <p style="font-size: 0.86rem; color: #64748B; line-height: 1.5; margin: 0;">Installation by harness-certified technicians with written 10-year guarantee.</p>
        </div>
      </div>
    </div>
  </section>

  <FAQSection category="pricing" title="Frequently Asked Questions About Quotes & Visits" />
  <TrustSection />
</BaseLayout>
