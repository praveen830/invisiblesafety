---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2 } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Sports Practice Nets & Turf Enclosures",
  "High-velocity ball containment sports netting for cricket practice, terrace pitches, and clubhouses with custom site quote",
  18
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Specialty Solutions", url: "https://invisiblesafety.in/sports-nets/" },
  { name: "Sports Practice Nets", url: "https://invisiblesafety.in/sports-practice-nets/" }
]);

const specs = [
  { label: "Mesh Composition", value: "High-Tenacity Multi-Strand HDPE", icon: ShieldCheck },
  { label: "Velocity Rating", value: "Cricket Leather Ball Tested (140+ km/h)", icon: Award },
  { label: "Rigging Hardware", value: "Turnbuckle & SS Wire Rope Suspensions", icon: Wrench },
  { label: "Tension Warranty", value: "Certified High-Tension Guarantee", icon: CheckCircle2 }
];

const subcategories = [
  {
    title: "Ceiling Cloth Drying Hangers",
    subtitle: "Individual stainless steel pull-down pipes maximizing balcony utility and airflow.",
    href: "/cloth-drying-hangers/",
    image: "/images/cloth-drying-hanger.jpg",
    spec: "100% Stainless Steel Rust-Proof Rods",
    badge: "Utility Suite"
  },
  {
    title: "Swimming Pool Protective Nets",
    subtitle: "High-tension surface barriers preventing accidental pool falls by infants and pets.",
    href: "/swimming-pool-nets/",
    image: "/images/swimming-pool-net.jpg",
    spec: "Corrosion-Proof Marine Anchors",
    badge: "Family Safety"
  },
  {
    title: "Coconut Palm Anti-Drop Netting",
    subtitle: "Suspended impact-absorption nets preventing heavy coconut fall damage to cars and residents.",
    href: "/coconut-safety-nets/",
    image: "/images/coconut-safety-net.jpg",
    spec: "Heavy Impact-Cushioning Webbing",
    badge: "Property Protection"
  },
  {
    title: "Terrace Top Fall Perimeter",
    subtitle: "Boundary safety netting installed over open roof parapets to secure terrace gatherings.",
    href: "/terrace-safety-nets/",
    image: "/images/terrace-top-net.jpg",
    spec: "High-Tensile Perimeter Tie Cords",
    badge: "Rooftop Guard"
  }
];

const gallery = [
  {
    src: "/images/sports-nets.webp",
    alt: "Rooftop Cricket Turf Netting",
    title: "High-Rise Rooftop Cricket Turf",
    caption: "Full-height multi-lane cricket practice enclosure overlooking city skyline.",
    badge: "Society Turf"
  },
  {
    src: "/images/cloth-drying-hanger.jpg",
    alt: "Balcony Ceiling Clothes Hanger",
    title: "Architectural Pulley System",
    caption: "Retractable ceiling-mounted drying tracks preserving floor space.",
    badge: "Balcony Utility"
  },
  {
    src: "/images/swimming-pool-net.jpg",
    alt: "Pool Safety Cover",
    title: "Swimming Pool Barrier",
    caption: "Precision anchored surface barrier preventing toddler pool accidents.",
    badge: "Pool Safety"
  },
  {
    src: "/images/coconut-safety-net.jpg",
    alt: "Coconut Drop Catch Netting",
    title: "High-Impact Canopy Catch",
    caption: "Heavy-duty perimeter webbing preventing vehicular glass damage.",
    badge: "Property Protection"
  }
];
---

<SubPageLayout
  title="Sports Practice Nets | Rooftop Cricket Pitch Enclosures | Invisible Safety"
  description="High-velocity cricket and multi-sport practice nets for terraces, schools, and clubhouses with custom site quote UV-stabilized heavy polymer."
  canonicalUrl="/sports-practice-nets/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="HIGH-VELOCITY SPORTS APERTURE"
  heroTitle="SPORTS PRACTICE NETS &amp; TURFS"
  heroSubtitle="Turn open rooftops, school complexes, and residential terraces into professional cricket practice enclosures and multi-sport training turfs."
  heroImage="/images/sports-nets.webp"
  heroImageAlt="Sports Practice Nets Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Sports Dynamics Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">BALL IMPACT RESILIENCE</span>
        <h2 class="editorial-title">Multi-Sport Ball Retention</h2>
        <p class="editorial-subtitle">
          Constructed with knotted polyethylene mesh that absorbs and drops fast-moving balls safely inside the pitch.
        </p>
      </div>

      <div class="sports-grid">
        <div class="sports-card">
          <h3 class="sports-card-title">Leather Cricket Ball Tested</h3>
          <p class="sports-card-desc">
            Heavy-gauge multi-ply twisted yarns prevent breaking or mesh splitting under continuous hard leather ball bowling and batting impacts.
          </p>
        </div>

        <div class="sports-card">
          <h3 class="sports-card-title">Full Overhead Ceiling Enclosure</h3>
          <p class="sports-card-desc">
            Complete six-sided box cage design ensures lofted shots remain contained inside the net, protecting neighboring windows, cars, and solar panels.
          </p>
        </div>

        <div class="sports-card">
          <h3 class="sports-card-title">Retractable Pulley Curtains</h3>
          <p class="sports-card-desc">
            Optional sliding curtain tracks enable nets to be gathered against walls when the terrace is used for community gatherings or parties.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Estimator Section -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Sports Pitch Quote</h2>
        <p class="editorial-subtitle">
          Configure pitch length, width, and height for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .sports-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .sports-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .sports-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .sports-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .sports-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
