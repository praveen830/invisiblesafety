---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2, Check, ArrowRight } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Construction Site Safety Nets",
  "High-rise scaffolding and debris containment netting for construction sites with custom site quote",
  22
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Construction & Industrial", url: "https://invisiblesafety.in/construction-safety-nets/" },
  { name: "Construction Safety Nets", url: "https://invisiblesafety.in/construction-safety-nets/" }
]);

const specs = [
  { label: "Tensile Fiber", value: "Industrial Braided High-Ply Nylon / HDPE", icon: ShieldCheck },
  { label: "Load Capacity", value: "Engineered Fall Arrest & Debris Catch", icon: Award },
  { label: "Standards", value: "Compliant with IS 3521 / Industrial Anchors", icon: Wrench },
  { label: "Site Guarantee", value: "Commercial Site Safety Certification", icon: CheckCircle2 }
];

const subcategories = [
  {
    title: "Construction Site Fall Nets",
    subtitle: "Dual-layer personnel fall arrest mesh with fine debris catch lining for active multi-story sites.",
    href: "/construction-safety-nets/",
    image: "/images/construction-safety-net.jpg",
    spec: "High-Impact Shock-Absorbing Core",
    badge: "Life Safety"
  },
  {
    title: "Building Duct Shaft Enclosures",
    subtitle: "Continuous vertical netting closing deep building plumbing ducts to prevent accidental tool drops.",
    href: "/duct-safety-nets/",
    image: "/images/duct-net.webp",
    spec: "Corrosion-Proof Heavy Perimeter Rope",
    badge: "Shaft Safety"
  },
  {
    title: "Industrial Debris Containment",
    subtitle: "Heavy-duty warehouse perimeter screens containing pallet fragments and high-bay storage fall-off.",
    href: "/industrial-safety-nets/",
    image: "/images/industrial-safety-net.jpg",
    spec: "UV-Treated Industrial Polyethylene",
    badge: "Factory Grade"
  },
  {
    title: "Car Parking Perimeter Nets",
    subtitle: "Basement and podium parking barriers preventing cricket ball strikes and vehicular damage.",
    href: "/car-parking-safety-nets/",
    image: "/images/car-parking-net.jpg",
    spec: "Weather-Resistant Multi-Strand Mesh",
    badge: "Basement Shield"
  }
];

const gallery = [
  {
    src: "/images/construction-safety-net.jpg",
    alt: "Commercial High-Rise Scaffolding Net",
    title: "Multi-Tower Facade Catch Net",
    caption: "Engineered fall arrest network safeguarding active high-rise construction.",
    badge: "Commercial Site"
  },
  {
    src: "/images/duct-net.webp",
    alt: "Vertical Duct Shaft Enclosure",
    title: "Internal Duct Void Enclosure",
    caption: "Continuous floor-to-floor vertical barrier protecting service shafts.",
    badge: "Shaft Protection"
  },
  {
    src: "/images/industrial-safety-net.jpg",
    alt: "Industrial Warehouse Safety Netting",
    title: "Logistics Hub Storage Net",
    caption: "Ceiling-to-floor containment preventing high-bay pallet falls.",
    badge: "Warehouse Safety"
  },
  {
    src: "/images/car-parking-net.jpg",
    alt: "Podium Parking Protective Enclosure",
    title: "Podium Car Parking Barrier",
    caption: "Aesthetic perimeter mesh shielding luxury cars from stray ball impacts.",
    badge: "Podium Shield"
  }
];
---

<SubPageLayout
  title="Construction Safety Nets | Debris & Fall Containment | Invisible Safety"
  description="Heavy-duty scaffolding fall-arrest and debris containment safety nets for construction sites with custom site quote Certified 300+ kg drop catch with industrial certification."
  canonicalUrl="/construction-safety-nets/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="STRUCTURAL ARCHITECTURE"
  heroTitle="DEBRIS & FALL CONTAINMENT"
  heroSubtitle="Industrial-grade high-altitude fall arrest networks and structural void enclosures engineered in compliance with IS safety standards."
  heroImage="/images/construction-safety-net.jpg"
  heroImageAlt="Construction Safety Net Site Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Industrial Rigor Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INDUSTRIAL COMPLIANCE</span>
        <h2 class="editorial-title">Engineered Fall Arrest &amp; Debris Catch</h2>
        <p class="editorial-subtitle">
          Tested to absorb heavy kinetic drops from high altitudes, safeguarding personnel below.
        </p>
      </div>

      <div class="compliance-cards-grid">
        <div class="compliance-card">
          <h3 class="compliance-card-title">Shock Dissipation Matrix</h3>
          <p class="compliance-card-desc">
            Multi-tier braided weave stretches slightly under dynamic impact loads to safely cushion falls rather than snapping rigidly.
          </p>
        </div>

        <div class="compliance-card">
          <h3 class="compliance-card-title">Dual-Layer Debris Overlay</h3>
          <p class="compliance-card-desc">
            Combines large-gauge fall arrest mesh with fine micromesh lining capable of catching dropped screwdrivers, concrete debris, and small tools.
          </p>
        </div>

        <div class="compliance-card">
          <h3 class="compliance-card-title">Tested Anchoring Rigidity</h3>
          <p class="compliance-card-desc">
            Tied directly into steel structural scaffolding and RCC beam eye bolts with heavy boundary border ropes compliant with safety regulations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Smart Cost Estimator -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Construction Net Cost</h2>
        <p class="editorial-subtitle">
          Configure construction site or shaft dimensions for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .compliance-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .compliance-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .compliance-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .compliance-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .compliance-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
