---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustSection from '../components/TrustSection.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import EngineeringSection from '../components/EngineeringSection.astro';
import CostEstimator from '../components/react/CostEstimator';
import BeforeAfterSlider from '../components/react/BeforeAfterSlider';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { pricing } from '../data/pricing';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Check, Sparkles, MessageCircle, Phone, ArrowRight, Layers, Award, Activity, Eye, Shield } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "SS316 Marine Grade Invisible Grills",
  "Architectural high-tensile invisible grills for balconies and windows with 400+ kg breaking load and 10-year warranty.",
  pricing.invisibleGrill["2.0mm"]
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://Invisible Safety.com/" },
  { name: "Invisible Grills", url: "https://Invisible Safety.com/invisible-grills/" }
]);

const invisibleGrillConfigs = [
  {
    eyebrow: "THE HIGH-RISE APERTURE",
    title: "BALCONY INVISIBLE GRILLS",
    tagline: "Architectural safety panels offering uncompromised 180° panoramic skyline vistas with 400+ kg fall protection.",
    image: "/images/hero-balcony.webp",
    warranty: "10-Yr Guarantee",
    slug: "balcony-invisible-grills",
    spec: "Virgin Japanese SS316 (2.0mm / 2.5mm)",
    badge: "Most Popular"
  },
  {
    eyebrow: "THE SPIRAL ASCENT",
    title: "STAIRCASE INVISIBLE GRILLS",
    tagline: "Floor-to-ceiling tensioned cables safeguarding open stairwells, void drops, and luxury floating stairs.",
    image: "/images/staircase-invisible-grills.webp",
    warranty: "10-Yr Guarantee",
    slug: "staircase-invisible-grills",
    spec: "Floor-to-Ceiling SS316 Cables",
    badge: "Interior Safety"
  },
  {
    eyebrow: "THE FRAMELESS FENESTRATION",
    title: "WINDOWS INVISIBLE GRILLS",
    tagline: "Sleek architectural barriers for large sliding glass windows, French doors, and low-sill openings.",
    image: "/images/window-invisible-grills.webp",
    warranty: "10-Yr Guarantee",
    slug: "window-invisible-grills",
    spec: "50mm / 75mm Spacing Options",
    badge: "Maximum Airflow"
  },
  {
    eyebrow: "THE UNSEEN GUARDIAN",
    title: "CHILD SAFETY INVISIBLE GRILLS",
    tagline: "50mm anti-head entrapment spacing engineered to protect toddlers and pets without climbable steps.",
    image: "/images/child-safety.webp",
    warranty: "10-Yr Guarantee",
    slug: "child-safety-invisible-grills",
    spec: "50mm Anti-Entrapment Core",
    badge: "Toddler Proof"
  }
];
---

<BaseLayout
  title="SS316 Marine Grade Invisible Grills | Invisible Safety India"
  description="Premium Japanese SS316 marine-grade invisible safety grills for high-rise balconies and windows. 400+ kg load tested, rust-proof, RWA approved with 10-year warranty."
  canonicalUrl="/invisible-grills/"
  schema={[serviceSchema, breadcrumbs]}
>
  <!-- Hero Section -->
  <section class="section-spacing" style="background: linear-gradient(180deg, #F0F9FF 0%, #F8FAFC 100%); border-bottom: 1px solid #E2E8F0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3.5rem; align-items: center;">
        <div>
          <div style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.85rem; background: #E0F2FE; border: 1px solid #BAE6FD; border-radius: 20px; font-size: 0.8rem; font-weight: 700; color: #0369A1; margin-bottom: 1.25rem;">
            <Sparkles size={14} /> FLAGSHIP ARCHITECTURAL SAFETY
          </div>
          <h1 style="font-size: clamp(2.3rem, 4.5vw, 3.6rem); font-weight: 800; color: #0F172A; line-height: 1.15; margin-bottom: 1.25rem; letter-spacing: -0.03em;">
            SS316 Marine Grade <br />
            <span style="color: #0284C7;">Invisible Safety Grills</span>
          </h1>
          <p style="font-size: 1.1rem; color: #475569; line-height: 1.65; margin-bottom: 2rem;">
            Engineered for modern high-rise apartments and luxury residences. Enjoy full 180° panoramic skyline vistas while safeguarding children and pets with 400+ kg tensile fall safety.
          </p>

          <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2.5rem;">
            <a href="#estimator" class="btn btn-primary">
              <span>Calculate Your Balcony Cost</span>
              <ArrowRight size={17} />
            </a>
            <a
              href={`https://wa.me/${business.whatsapp}?text=Hi%20Invisible Safety%2C%20I%20want%20to%20know%20more%20about%20SS316%20Invisible%20Grills%20for%20my%20balcony.`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp"
            >
              <MessageCircle size={17} />
              <span>Consult On WhatsApp</span>
            </a>
          </div>

          <!-- Live Quote Callout -->
          <div style="display: inline-flex; align-items: center; gap: 1.5rem; background: #FFFFFF; border: 1px solid #E2E8F0; border-radius: 14px; padding: 0.85rem 1.5rem; box-shadow: var(--shadow-sm);">
            <div>
              <span style="font-size: 0.72rem; color: #64748B; display: block; font-weight: 600; text-transform: uppercase;">Quotation:</span>
              <span style="font-size: 1.25rem; font-weight: 800; color: #0284C7;">Custom Site Quote</span>
            </div>
            <div style="width: 1px; height: 32px; background: #E2E8F0;"></div>
            <div>
              <span style="font-size: 0.72rem; color: #64748B; display: block; font-weight: 600; text-transform: uppercase;">Official Warranty:</span>
              <span style="font-size: 1.25rem; font-weight: 800; color: #16A34A;">10 Years Direct</span>
            </div>
          </div>
        </div>

        <!-- Hero Image Showcase -->
        <div style="position: relative; border-radius: 20px; overflow: hidden; background: #FFFFFF; border: 1px solid #E2E8F0; padding: 0.85rem; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);">
          <div style="position: relative; border-radius: 14px; overflow: hidden; aspect-ratio: 16/9;">
            <img
              src="/images/invisible-grills-page.webp"
              alt="SS316 Marine Grade Invisible Grills Balcony Installation"
              style="width: 100%; height: 100%; object-fit: cover; display: block;"
              width="640"
              height="360"
              loading="eager"
            />
            <div style="position: absolute; top: 12px; left: 12px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); border: 1px solid #BAE6FD; border-radius: 20px; padding: 0.35rem 0.85rem; font-size: 0.75rem; font-weight: 700; color: #0284C7; display: flex; align-items: center; gap: 0.4rem;">
              <Activity size={14} /> 400+ kg Break Load
            </div>
            <div style="position: absolute; bottom: 12px; right: 12px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); border: 1px solid #BBF7D0; border-radius: 20px; padding: 0.35rem 0.85rem; font-size: 0.75rem; font-weight: 700; color: #16A34A; display: flex; align-items: center; gap: 0.4rem;">
              <Eye size={14} /> 98% Clear Panoramic Vista
            </div>
          </div>
          <div style="padding: 0.85rem 0.5rem 0.25rem 0.5rem; display: flex; justify-content: space-between; align-items: center; font-size: 0.82rem; color: #64748B;">
            <span>DuPont Nylon Membrane • Japanese SS316 Alloy</span>
            <span style="color: #16A34A; font-weight: 700;">✓ RWA Approved</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Curated Catalog: Available Invisible Grills Configurations (Matching User Screenshot) -->
  <section class="section-spacing" style="background: #FFFFFF; border-bottom: 1px solid #E2E8F0;">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem; margin-bottom: 2.5rem; padding-bottom: 1rem; border-bottom: 1px solid #F1F5F9;">
        <div>
          <div style="font-size: 0.76rem; font-weight: 800; color: #C2410C; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.4rem;">
            CURATED CATALOG
          </div>
          <h2 style="font-size: clamp(1.8rem, 3.5vw, 2.4rem); font-weight: 800; color: #0F172A; letter-spacing: -0.02em; margin: 0;">
            AVAILABLE INVISIBLE GRILLS CONFIGURATIONS
          </h2>
        </div>
        <div style="font-size: 0.88rem; color: #64748B;">
          Select a configuration for detailed engineering specifications
        </div>
      </div>

      <!-- 4-Card Grid -->
      <div class="grid-4" style="margin-bottom: 2rem;">
        {invisibleGrillConfigs.map(item => (
          <div class="arch-card config-card" style="display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; padding: 0; background: #FFFFFF; border: 1px solid #E2E8F0; transition: transform 0.25s ease, box-shadow 0.25s ease;">
            <!-- Portrait Image Container with Direct Subpage Link -->
            <a href={`/${item.slug}/`} style="position: relative; width: 100%; aspect-ratio: 3/4; overflow: hidden; background: #F1F5F9; display: block; text-decoration: none;">
              <img
                src={item.image}
                alt={item.title}
                style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;"
                class="hover-zoom-img"
                loading="lazy"
              />
              <div style="position: absolute; top: 12px; left: 12px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(6px); border: 1px solid #E2E8F0; padding: 0.25rem 0.6rem; border-radius: 6px; font-size: 0.72rem; font-weight: 700; color: #0284C7;">
                {item.badge}
              </div>
              <div style="position: absolute; bottom: 12px; right: 12px; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(6px); color: #FFFFFF; padding: 0.25rem 0.6rem; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">
                Custom Site Quote
              </div>
            </a>

            <!-- Card Content Body -->
            <div style="padding: 1.4rem 1.25rem 1.25rem 1.25rem; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                <div style="font-size: 0.7rem; font-weight: 800; color: #C2410C; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.35rem;">
                  {item.eyebrow}
                </div>
                <a href={`/${item.slug}/`} style="text-decoration: none; color: inherit; display: block;">
                  <h3 style="font-size: 1.08rem; font-weight: 800; color: #0F172A; letter-spacing: -0.01em; margin-bottom: 0.5rem; line-height: 1.3;">
                    {item.title}
                  </h3>
                </a>
                <p style="font-size: 0.82rem; color: #64748B; line-height: 1.5; margin-bottom: 1rem;">
                  {item.tagline}
                </p>
              </div>

              <div>
                <div style="font-size: 0.76rem; color: #334155; background: #F8FAFC; border: 1px solid #E2E8F0; padding: 0.45rem 0.7rem; border-radius: 6px; margin-bottom: 1rem; font-weight: 600;">
                  ✓ {item.spec}
                </div>

                <div style="display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 0.5rem;">
                  <a href={`/${item.slug}/`} class="btn btn-outline btn-sm" style="font-size: 0.76rem; padding: 0.5rem 0.4rem; justify-content: center; font-weight: 700; color: #C2410C; border-color: #FED7AA; background: #FFF7ED;">
                    <span>VIEW SPECS →</span>
                  </a>
                  <a
                    href={`https://wa.me/${business.whatsapp}?text=Hi%20Invisible Safety%2C%20I%20am%20interested%20in%20${encodeURIComponent(item.title)}.%20Please%20provide%20a%20site%20measurement%20and%20quote.`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-whatsapp btn-sm"
                    style="font-size: 0.76rem; padding: 0.5rem 0.4rem; justify-content: center;"
                  >
                    <span>Get Quote</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Technical Wire Specifications -->
  <section class="section-spacing" style="background: #FFFFFF; border-bottom: 1px solid #E2E8F0;">
    <div class="container">
      <div class="section-header">
        <span class="badge-emerald">Technical Options</span>
        <h2>Customized For Your Security Needs</h2>
        <p>
          Choose the optimal wire thickness and spacing profile for your family's lifestyle and balcony orientation.
        </p>
      </div>

      <div class="grid-2" style="max-width: 960px; margin: 0 auto;">
        <!-- 2.0mm Standard Option -->
        <div class="arch-card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <span class="badge-arch">Standard Specification</span>
            <span style="font-size: 1.05rem; font-weight: 800; color: #0284C7;">Custom Site Quote</span>
          </div>
          <h3 style="font-size: 1.3rem; font-weight: 800; color: #0F172A; margin-bottom: 0.5rem;">
            2.0 mm SS316 Marine Cable
          </h3>
          <p style="font-size: 0.9rem; color: #475569; line-height: 1.55; margin-bottom: 1.25rem;">
            Ultra-fine profile providing maximum visual invisibility. Ideal for mid-rise apartments and residential bedroom windows.
          </p>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.88rem; color: #334155; margin-bottom: 1.5rem;">
            <li style="display: flex; gap: 0.6rem; align-items: center;"><Check size={16} color="#16A34A" /> 350 kgf tensile breaking strength</li>
            <li style="display: flex; gap: 0.6rem; align-items: center;"><Check size={16} color="#16A34A" /> 99% light transmittance</li>
            <li style="display: flex; gap: 0.6rem; align-items: center;"><Check size={16} color="#16A34A" /> DuPont transparent nylon sheathing</li>
            <li style="display: flex; gap: 0.6rem; align-items: center;"><Check size={16} color="#16A34A" /> 5-Year Workmanship Warranty</li>
          </ul>
          <a href="#estimator" class="btn btn-outline" style="width: 100%; font-size: 0.9rem;">
            Request 2.0mm Site Inspection
          </a>
        </div>

        <!-- 2.5mm Heavy Duty Option -->
        <div class="arch-card featured-card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <span class="badge-emerald">Most Recommended (85% Choice)</span>
            <span style="font-size: 1.05rem; font-weight: 800; color: #0284C7;">Custom Site Quote</span>
          </div>
          <h3 style="font-size: 1.3rem; font-weight: 800; color: #0F172A; margin-bottom: 0.5rem;">
            2.5 mm SS316 Heavy-Duty Marine Cable
          </h3>
          <p style="font-size: 0.9rem; color: #475569; line-height: 1.55; margin-bottom: 1.25rem;">
            High-tensile reinforcement engineered specifically for high-rise towers (10th to 50th floors) with strong wind loads and energetic children.
          </p>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.88rem; color: #334155; margin-bottom: 1.5rem;">
            <li style="display: flex; gap: 0.6rem; align-items: center;"><Check size={16} color="#16A34A" /> 400+ kgf maximum tensile breaking strength</li>
            <li style="display: flex; gap: 0.6rem; align-items: center;"><Check size={16} color="#16A34A" /> Extreme wind load & gust resistance</li>
            <li style="display: flex; gap: 0.6rem; align-items: center;"><Check size={16} color="#16A34A" /> Child & pet anti-spread guarantee</li>
            <li style="display: flex; gap: 0.6rem; align-items: center;"><Check size={16} color="#16A34A" /> 10-Year Comprehensive Warranty</li>
          </ul>
          <a href="#estimator" class="btn btn-primary" style="width: 100%; font-size: 0.9rem;">
            Request 2.5mm Site Inspection
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Cable Spacing Comparison -->
  <section class="section-spacing" style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0;">
    <div class="container">
      <div class="section-header">
        <span class="badge-arch">Cable Spacing</span>
        <h2>50mm vs 75mm Cable Spacing</h2>
        <p>Understanding which spacing configuration is right for your home opening.</p>
      </div>

      <div class="grid-2" style="max-width: 900px; margin: 0 auto;">
        <div class="arch-card">
          <div style="font-size: 1.35rem; font-weight: 800; color: #0284C7; margin-bottom: 0.35rem;">
            50 mm (2 Inches)
          </div>
          <div style="font-weight: 700; color: #0F172A; margin-bottom: 0.75rem;">
            Child & Pet Safety Standard
          </div>
          <p style="font-size: 0.9rem; color: #475569; line-height: 1.6;">
            Strictly prevents toddler heads, hands, or household pets from squeezing through. Recommended for all balconies on the 3rd floor and higher where kids play.
          </p>
        </div>

        <div class="arch-card">
          <div style="font-size: 1.35rem; font-weight: 800; color: #0284C7; margin-bottom: 0.35rem;">
            75 mm (3 Inches)
          </div>
          <div style="font-weight: 700; color: #0F172A; margin-bottom: 0.75rem;">
            Panoramic Open View Standard
          </div>
          <p style="font-size: 0.9rem; color: #475569; line-height: 1.6;">
            Provides maximum visual openness while safely blocking adult body falls. Popular for master bedroom French windows and adult living sky-decks.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Metallurgical Engineering -->
  <EngineeringSection />

  <!-- Before / After Visualizer Island -->
  <section class="section-spacing" style="background: #FFFFFF; border-bottom: 1px solid #E2E8F0;">
    <div class="container">
      <div class="section-header">
        <span class="badge-arch">Panoramic Difference</span>
        <h2>Visual Comparison on Balconies</h2>
        <p>Drag the slider to experience the dramatic opening of high-rise living spaces.</p>
      </div>

      <BeforeAfterSlider client:visible />
    </div>
  </section>

  <!-- Comparison Matrix -->
  <ComparisonTable />

  <!-- Interactive Smart Cost Estimator -->
  <section class="section-spacing" style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0;" id="estimator">
    <div class="container">
      <div class="section-header">
        <span class="badge-arch">Transparent Pricing</span>
        <h2>Calculate Your Balcony Cost</h2>
        <p>Get a calibrated real-time cost estimate for your balcony measurements.</p>
      </div>

      <CostEstimator client:load />
    </div>
  </section>

  <!-- Trust Certification -->
  <TrustSection />

  <!-- FAQ Section -->
  <FAQSection category="invisible-grills" title="Invisible Grill Questions & Answers" />
</BaseLayout>
