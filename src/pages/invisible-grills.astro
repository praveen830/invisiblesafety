---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import TrustSection from '../components/TrustSection.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import EngineeringSection from '../components/EngineeringSection.astro';
import CostEstimator from '../components/react/CostEstimator';
import BeforeAfterSlider from '../components/react/BeforeAfterSlider';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { pricing } from '../data/pricing';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2, Ruler, Check, ArrowRight, Activity, Eye } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "SS316 Marine Grade Invisible Grills",
  "Architectural high-tensile invisible grills for balconies and windows with 400+ kg breaking load and 10-year warranty.",
  pricing.invisibleGrill["2.0mm"]
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Invisible Grills", url: "https://invisiblesafety.in/invisible-grills/" }
]);

const specs = [
  { label: "Cable Metallurgy", value: "Virgin Japanese SS316 Marine Grade", icon: ShieldCheck },
  { label: "Tensile Strength", value: "400+ kgf Breaking Load per Cable", icon: Award },
  { label: "Pitch Options", value: "50mm Child-Safe or 75mm Expansive View", icon: Ruler },
  { label: "Direct Warranty", value: "10-Year Structural Written Guarantee", icon: Wrench }
];

const subcategories = [
  {
    title: "Balcony Invisible Grills",
    subtitle: "Edge-to-edge floor-to-ceiling tensioned cables preserving 180° skyline panoramas with 400+ kgf safety.",
    href: "/balcony-invisible-grills/",
    image: "/images/hero-balcony.webp",
    spec: "Japanese SS316 (2.0mm / 2.5mm)",
    badge: "Most Popular"
  },
  {
    title: "French Window Invisible Grills",
    subtitle: "Frameless high-tensile safety barriers for low-sill windows and full-height French fenestrations.",
    href: "/window-invisible-grills/",
    image: "/images/window-invisible-grills.webp",
    spec: "Direct Wall Anchor Structural Tracks",
    badge: "Maximum Airflow"
  },
  {
    title: "Duplex Staircase Tension Grills",
    subtitle: "Architectural vertical cable dividers safeguarding duplex open voids and modern floating stairs.",
    href: "/staircase-invisible-grills/",
    image: "/images/staircase-invisible-grills.webp",
    spec: "Floor-to-Ceiling SS316 Cables",
    badge: "Interior Luxury"
  },
  {
    title: "Child-Safe Calibrated Spacing",
    subtitle: "50mm anti-head entrapment spacing engineered to safeguard toddlers without climbable rungs.",
    href: "/child-safety-invisible-grills/",
    image: "/images/child-safety.webp",
    spec: "50mm Anti-Entrapment Core",
    badge: "Toddler Proof"
  }
];

const gallery = [
  {
    src: "/images/hero-balcony.webp",
    alt: "Luxury Balcony with Invisible Grills",
    title: "Skyline High-Rise Balcony Suite",
    caption: "Virgin SS316 cables preserving 180° panoramic skyline vistas.",
    badge: "Penthouse Flagship"
  },
  {
    src: "/images/window-invisible-grills.webp",
    alt: "French Window Invisible Grills",
    title: "French Fenestration Suite",
    caption: "Full ventilation and child anti-fall safety with zero visual blockage.",
    badge: "Window Protection"
  },
  {
    src: "/images/staircase-invisible-grills.webp",
    alt: "Duplex Staircase Safety Cables",
    title: "Duplex Floating Staircase Array",
    caption: "Vertical architectural tension cables guarding interior stairwell voids.",
    badge: "Interior Architecture"
  },
  {
    src: "/images/child-safety.webp",
    alt: "Child-Safe Calibrated Balcony",
    title: "Toddler Anti-Fall System",
    caption: "Zero footholds preventing climbing leverage with unyielding 400+ kg load strength.",
    badge: "Child & Pet Safety"
  }
];
---

<SubPageLayout
  title="SS316 Marine Grade Invisible Grills | The Invisible Threshold | Invisible Safety"
  description="Premium Japanese SS316 marine-grade invisible safety grills for high-rise balconies and windows. 400+ kg load tested, rust-proof, RWA approved with 10-year warranty."
  canonicalUrl="/invisible-grills/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="FLAGSHIP ARCHITECTURAL SAFETY"
  heroTitle="THE INVISIBLE THRESHOLD"
  heroSubtitle="Virgin SS316 marine-grade tensile cables tensioned into structural tracks, preserving 180° uninterrupted panoramic views while providing 400+ kgf safety."
  heroImage="/images/hero-balcony.webp"
  heroImageAlt="SS316 Marine Grade Invisible Grills Balcony Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Technical Wire Thickness Comparison -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">METALLURGICAL CALIBRATION</span>
        <h2 class="editorial-title">Cable Thickness Options</h2>
        <p class="editorial-subtitle">
          Select between standard visual minimalism or heavy-duty high-altitude reinforcement.
        </p>
      </div>

      <div class="thickness-cards-grid">
        <!-- 2.0mm Option -->
        <div class="thickness-card">
          <div class="thickness-header">
            <span class="thickness-badge">Standard Specification</span>
            <span class="thickness-tag">Custom Site Quote</span>
          </div>
          <h3 class="thickness-title">2.0 mm SS316 Marine Cable</h3>
          <p class="thickness-desc">
            Ultra-fine profile providing maximum visual invisibility. Ideal for mid-rise apartments and residential bedroom windows.
          </p>
          <ul class="thickness-checklist">
            <li><Check size={16} color="#C5A880" /> 350 kgf tensile breaking strength</li>
            <li><Check size={16} color="#C5A880" /> 99% light transmittance</li>
            <li><Check size={16} color="#C5A880" /> DuPont transparent nylon sheathing</li>
            <li><Check size={16} color="#C5A880" /> 5-Year Workmanship Warranty</li>
          </ul>
          <a href="#estimator" class="btn-editorial-pill" style="width: 100%; text-align: center;">
            <span>REQUEST 2.0MM INSPECTION</span>
          </a>
        </div>

        <!-- 2.5mm Option -->
        <div class="thickness-card featured">
          <div class="thickness-header">
            <span class="thickness-badge highlight">Most Recommended (85% Choice)</span>
            <span class="thickness-tag">Custom Site Quote</span>
          </div>
          <h3 class="thickness-title">2.5 mm SS316 Heavy-Duty Marine Cable</h3>
          <p class="thickness-desc">
            High-tensile reinforcement engineered specifically for high-rise towers (10th to 50th floors) with strong wind loads and energetic children.
          </p>
          <ul class="thickness-checklist">
            <li><Check size={16} color="#C5A880" /> 400+ kgf maximum tensile breaking strength</li>
            <li><Check size={16} color="#C5A880" /> Extreme wind load &amp; gust resistance</li>
            <li><Check size={16} color="#C5A880" /> Child &amp; pet anti-spread guarantee</li>
            <li><Check size={16} color="#C5A880" /> 10-Year Comprehensive Warranty</li>
          </ul>
          <a href="#estimator" class="btn-editorial-pill" style="width: 100%; text-align: center; background: #FFFFFF; color: #000000;">
            <span>REQUEST 2.5MM INSPECTION</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Before / After Visualizer Island -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">THE ARCHITECTURAL DIFFERENCE</span>
        <h2 class="editorial-title">Visual Comparison on Balconies</h2>
        <p class="editorial-subtitle">
          Drag the slider to experience the dramatic opening of high-rise living spaces without iron cages.
        </p>
      </div>

      <div class="visualizer-wrapper">
        <BeforeAfterSlider client:visible />
      </div>
    </div>
  </section>

  <!-- Metallurgical Engineering Section -->
  <EngineeringSection />

  <!-- Comparison Matrix -->
  <ComparisonTable />

  <!-- Interactive Smart Cost Estimator -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Your Balcony Cost</h2>
        <p class="editorial-subtitle">
          Get a calibrated real-time cost estimate for your balcony measurements.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <!-- Trust Certification -->
  <TrustSection />

  <!-- FAQ Section -->
  <FAQSection category="invisible-grills" title="Invisible Grill Questions & Answers" />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .thickness-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.75rem;
    max-width: 1040px;
    margin: 0 auto;
  }

  .thickness-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .thickness-card.featured {
    border-color: rgba(197, 168, 128, 0.5);
    background: #171717;
  }

  .thickness-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .thickness-badge {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #94A3B8;
  }

  .thickness-badge.highlight {
    color: var(--color-gold, #C5A880);
  }

  .thickness-tag {
    font-size: 0.85rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .thickness-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.75rem 0;
  }

  .thickness-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .thickness-checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .thickness-checklist li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.88rem;
    color: #CBD5E1;
  }

  .visualizer-wrapper {
    max-width: 1080px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
