---
import SubPageLayout from '../layouts/SubPageLayout.astro';
import CostEstimator from '../components/react/CostEstimator';
import TrustSection from '../components/TrustSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { business } from '../data/business';
import { getServiceSchema, getBreadcrumbSchema } from '../utils/seo';
import { ShieldCheck, Award, Wrench, CheckCircle2 } from 'lucide-react';

const serviceSchema = getServiceSchema(
  "Terrace & Rooftop Safety Nets",
  "Perimeter roof boundary and parapet extension fall-safety netting for residential buildings with custom site quote",
  18
);

const breadcrumbs = getBreadcrumbSchema([
  { name: "Home", url: "https://invisiblesafety.in/" },
  { name: "Safety Nets", url: "https://invisiblesafety.in/safety-nets/" },
  { name: "Terrace Safety Nets", url: "https://invisiblesafety.in/terrace-safety-nets/" }
]);

const specs = [
  { label: "Polymer Quality", value: "Virgin UV-Stabilized Monofilament", icon: ShieldCheck },
  { label: "Wind Load Rating", value: "Tested in 120+ km/h Gusts", icon: Award },
  { label: "Support Posts", value: "Galvanized / Powder-Coated MS Pipes", icon: Wrench },
  { label: "Replacement Warranty", value: "3 to 5-Year Certified Guarantee", icon: CheckCircle2 }
];

const subcategories = [
  {
    title: "Apartment Balcony Safety Nets",
    subtitle: "Full-perimeter protective enclosure stopping accidental falls without feeling caged.",
    href: "/balcony-safety/",
    image: "/images/safety-net-balcony.webp",
    spec: "Virgin High-Density Polymer",
    badge: "Residential Core"
  },
  {
    title: "Rooftop Cricket Practice Nets",
    subtitle: "Enclosed practice cages allowing hard leather ball batting practice without perimeter danger.",
    href: "/sports-practice-nets/",
    image: "/images/sports-nets.webp",
    spec: "Heavy-Gauge Multi-Strand Mesh",
    badge: "Sports Suite"
  },
  {
    title: "Toddler & Pet Anti-Fall Nets",
    subtitle: "Calibrated mesh preventing toys, toddlers, or pets from squeezing through railings.",
    href: "/child-safety-nets/",
    image: "/images/child-safety.webp",
    spec: "Smooth Anti-Chafe Knots",
    badge: "Child Safe"
  },
  {
    title: "Swimming Pool Protective Nets",
    subtitle: "High-tension surface barriers preventing accidental pool falls by infants and pets.",
    href: "/swimming-pool-nets/",
    image: "/images/swimming-pool-net.jpg",
    spec: "Corrosion-Proof Marine Anchors",
    badge: "Family Safety"
  }
];

const gallery = [
  {
    src: "/images/terrace-top-net.jpg",
    alt: "Terrace Top Fall Perimeter Netting",
    title: "Terrace Party Deck Protection",
    caption: "High-tensile perimeter safety net extending low rooftop parapets to secure evening family gatherings.",
    badge: "Rooftop Guard"
  },
  {
    src: "/images/sports-nets.webp",
    alt: "Rooftop Sports Turf Net",
    title: "Rooftop Turf Enclosure",
    caption: "Full-height multi-sport practice net installed over building terrace.",
    badge: "Society Turf"
  },
  {
    src: "/images/safety-net-balcony.webp",
    alt: "Balcony Safety Net Array",
    title: "Apartment Balcony Fall Shield",
    caption: "UV-treated high-density netting installed on high-rise residential towers.",
    badge: "Residential Core"
  },
  {
    src: "/images/child-safety.webp",
    alt: "Child-Safe Calibrated Balcony",
    title: "Toddler Anti-Fall System",
    caption: "Zero footholds preventing climbing leverage with unyielding load strength.",
    badge: "Family Peace of Mind"
  }
];
---

<SubPageLayout
  title="Terrace Safety Nets | Rooftop Parapet Fall Protection | Invisible Safety"
  description="High-rise terrace top and roof boundary safety nets with custom site quote Extends low parapets to safeguard rooftop parties and children."
  canonicalUrl="/terrace-safety-nets/"
  schema={[serviceSchema, breadcrumbs]}
  heroEyebrow="ROOFTOP BOUNDARY DEFENSE"
  heroTitle="TERRACE &amp; ROOFTOP SAFETY NETS"
  heroSubtitle="Vertical and perimeter boundary safety netting installed above open terrace parapets, converting hazardous open rooftops into safe family gathering and party decks."
  heroImage="/images/terrace-top-net.jpg"
  heroImageAlt="Terrace Safety Nets Installation"
  specs={specs}
  subcategories={subcategories}
  gallery={gallery}
>
  <!-- Terrace Protection Section -->
  <section class="editorial-detail-section">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">ROOFTOP EXPANSION SAFETY</span>
        <h2 class="editorial-title">Safe Sky Deck Living</h2>
        <p class="editorial-subtitle">
          Most residential terrace parapets measure under 3 feet high—posing dangerous fall risks during evening functions.
        </p>
      </div>

      <div class="terrace-grid">
        <div class="terrace-card">
          <h3 class="terrace-card-title">Parapet Height Extension</h3>
          <p class="terrace-card-desc">
            Rigid steel posts anchored into the parapet elevate the protective net boundary to 6 or 8 feet, completely neutralizing low-wall fall danger for adults and children alike.
          </p>
        </div>

        <div class="terrace-card">
          <h3 class="terrace-card-title">High-Wind Aerodynamics</h3>
          <p class="terrace-card-desc">
            Open-mesh weave allows fierce rooftop wind currents to pass through freely without creating sail resistance that damages structural anchor masonry during monsoons.
          </p>
        </div>

        <div class="terrace-card">
          <h3 class="terrace-card-title">Pet Anti-Jump Guarantee</h3>
          <p class="terrace-card-desc">
            Dogs and cats can leap onto 3-foot parapet walls without warning. The vertical netting extension stops pets from jumping or slipping over building edges.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Estimator Section -->
  <section class="editorial-detail-section" id="estimator">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">INSTANT CALIBRATION &amp; ESTIMATE</span>
        <h2 class="editorial-title">Calculate Terrace Net Quote</h2>
        <p class="editorial-subtitle">
          Configure terrace perimeter running feet for an instant certified engineering quotation.
        </p>
      </div>

      <div class="estimator-box">
        <CostEstimator client:visible />
      </div>
    </div>
  </section>

  <TrustSection />
  <FAQSection />
</SubPageLayout>

<style>
  .editorial-detail-section {
    background-color: #0D0D0D;
    color: #FFFFFF;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .terrace-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .terrace-card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .terrace-card:hover {
    border-color: rgba(197, 168, 128, 0.4);
    transform: translateY(-3px);
  }

  .terrace-card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.65rem 0;
  }

  .terrace-card-desc {
    font-size: 0.88rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
  }

  .estimator-box {
    max-width: 960px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }
</style>
