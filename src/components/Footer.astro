---
import { business } from '../data/business';
import { Shield, Phone, Mail, MapPin, Clock, MessageCircle, ArrowRight } from 'lucide-react';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Column 1: Brand & About -->
      <div class="footer-col-brand">
        <div class="footer-brand">
          <img
            src="/images/logo.png"
            alt="Invisible Safety Logo"
            class="footer-logo-img"
            width="44"
            height="44"
            loading="lazy"
          />
          <span class="footer-brand-name">
            Invisible<span class="text-blue"> Safety</span>
          </span>
        </div>
        <p class="footer-tagline">
          {business.subtitle}
        </p>
        <p class="footer-subtext">
          Professional balcony and window safety solutions for residential apartments, villas, and commercial buildings.
        </p>

        <!-- Official Address -->
        <div class="footer-address-box">
          <div class="footer-address-header">
            <MapPin size={14} className="text-blue" />
            <span>Official Office</span>
          </div>
          <div class="footer-address-text">
            {business.address.street}, {business.address.locality}
          </div>
          <div class="footer-address-sub">
            {business.address.city}, {business.address.state} — {business.address.pincode}
          </div>
        </div>
      </div>

      <!-- Column 2: Products -->
      <div>
        <h4 class="footer-heading">Products</h4>
        <ul class="footer-links">
          <li><a href="/invisible-grills/">Invisible Grills</a></li>
          <li><a href="/balcony-invisible-grills/">Balcony Invisible Grills</a></li>
          <li><a href="/window-invisible-grills/">Window Invisible Grills</a></li>
          <li><a href="/staircase-invisible-grills/">Staircase Grills</a></li>
          <li><a href="/safety-nets/">Safety Nets</a></li>
          <li><a href="/pigeon-nets/">Anti-Pigeon Nets</a></li>
          <li><a href="/bird-spikes/">Bird Spikes</a></li>
          <li><a href="/construction-safety-nets/">Construction Safety</a></li>
        </ul>
      </div>

      <!-- Column 3: Applications -->
      <div>
        <h4 class="footer-heading">Applications</h4>
        <ul class="footer-links">
          <li><a href="/balcony-safety/">Balconies</a></li>
          <li><a href="/window-invisible-grills/">Windows & French Doors</a></li>
          <li><a href="/staircase-safety-nets/">Staircase Voids</a></li>
          <li><a href="/child-safety-nets/">Children Safety</a></li>
          <li><a href="/building-safety-nets/">High-Rise Buildings</a></li>
          <li><a href="/duct-safety-nets/">Ducts & Utility Shafts</a></li>
          <li><a href="/terrace-safety-nets/">Terrace Perimeters</a></li>
          <li><a href="/sports-nets/">Sports Enclosures</a></li>
        </ul>
      </div>

      <!-- Column 4: Company & Trust -->
      <div>
        <h4 class="footer-heading">Company</h4>
        <ul class="footer-links">
          <li><a href="/why-invisible-safety/">Why Invisible Safety</a></li>
          <li><a href="/materials/">Materials & SS316</a></li>
          <li><a href="/warranty/">Warranty Documentation</a></li>
          <li><a href="/projects/">Real Installations</a></li>
          <li><a href="/invisible-grill-cost/">Free Site Quote</a></li>
          <li><a href="/visualizer/">Visual Comparison Tool</a></li>
          <li><a href="/faq/">FAQs</a></li>
          <li><a href="/about/">About Us</a></li>
        </ul>
      </div>

      <!-- Column 5: Contact & Service Areas -->
      <div>
        <h4 class="footer-heading">Contact & Service</h4>
        <div class="footer-contact-list">
          <div class="contact-entry">
            <Phone size={15} className="text-blue" />
            <a href={`tel:${business.phoneRaw}`}>{business.phone}</a>
          </div>
          <div class="contact-entry">
            <MessageCircle size={15} color="#25D366" />
            <a href={`https://wa.me/${business.whatsapp}`} target="_blank" rel="noopener noreferrer" style="color: #25D366;">
              WhatsApp Support
            </a>
          </div>
          <div class="contact-entry">
            <Mail size={15} className="text-blue" />
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </div>
          <div class="contact-entry">
            <Clock size={15} className="text-blue" />
            <span>{business.hours}</span>
          </div>
        </div>

        <div class="footer-service-regions">
          <div class="service-regions-label">SERVICE REGIONS:</div>
          <div class="service-regions-links">
            <a href="/locations/hyderabad/">Hyderabad & Cyberabad</a>
            <a href="/locations/visakhapatnam/">Visakhapatnam (Vizag)</a>
            <a href="/locations/vijayawada/">Vijayawada & Amaravati</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="footer-copyright">
        © {new Date().getFullYear()} {business.name}. All rights reserved. Professional home safety installations.
      </div>
      <div class="footer-bottom-links">
        <a href="/warranty/">Warranty Terms</a>
        <a href="/contact/">Contact Office</a>
        <a href="/faq/">Knowledge Base</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0F172A;
    color: #94A3B8;
    border-top: 1px solid #1E293B;
    padding-top: 4.5rem;
    padding-bottom: 2.5rem;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1fr 1.3fr;
    gap: 2.5rem;
    margin-bottom: 3.5rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1rem;
  }

  .footer-logo-img {
    width: 44px;
    height: 44px;
    object-fit: contain;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.45));
  }

  .footer-brand-name {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    color: #FFFFFF;
  }

  .text-blue {
    color: #38BDF8;
  }

  .footer-tagline {
    font-size: 0.88rem;
    color: #E2E8F0;
    line-height: 1.5;
    margin-bottom: 0.75rem;
    font-weight: 500;
  }

  .footer-subtext {
    font-size: 0.82rem;
    color: #94A3B8;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .footer-address-box {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 0.85rem 1rem;
    font-size: 0.82rem;
  }

  .footer-address-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 0.35rem;
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
  }

  .footer-address-text {
    color: #E2E8F0;
    font-weight: 600;
    line-height: 1.4;
  }

  .footer-address-sub {
    color: #94A3B8;
  }

  .footer-heading {
    font-size: 0.95rem;
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.88rem;
  }

  .footer-links a {
    color: #94A3B8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: #FFFFFF;
  }

  .footer-contact-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .contact-entry {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .contact-entry a {
    color: #E2E8F0;
    text-decoration: none;
  }

  .contact-entry a:hover {
    color: #FFFFFF;
  }

  .footer-service-regions {
    border-top: 1px solid #1E293B;
    padding-top: 1rem;
  }

  .service-regions-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #64748B;
    margin-bottom: 0.5rem;
  }

  .service-regions-links {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.82rem;
  }

  .service-regions-links a {
    color: #CBD5E1;
    text-decoration: none;
  }

  .service-regions-links a:hover {
    color: #38BDF8;
  }

  .footer-bottom {
    border-top: 1px solid #1E293B;
    padding-top: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.82rem;
  }

  .footer-copyright {
    color: #64748B;
  }

  .footer-bottom-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-bottom-links a {
    color: #64748B;
    text-decoration: none;
  }

  .footer-bottom-links a:hover {
    color: #94A3B8;
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .footer-col-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
