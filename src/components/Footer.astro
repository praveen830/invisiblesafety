---
import { business } from '../data/business';
import { Phone, MessageCircle, Mail } from 'lucide-react';
---

<footer class="editorial-footer">
  <div class="footer-container">
    <!-- Brand Statement / Ethos Quote -->
    <div class="footer-quote-section">
      <blockquote class="editorial-quote">
        “The art of architectural protection — securing your sanctuary with quiet elegance.”
      </blockquote>
      <div class="quote-divider"></div>
    </div>

    <!-- Editorial Columns Grid -->
    <div class="footer-editorial-grid">
      <!-- Col 1: Brand & Contact Concierge -->
      <div class="footer-col-main">
        <span class="footer-brand-title">INVISIBLE SAFETY</span>
        <p class="footer-brand-desc">
          South India's premier architectural SS316 invisible grill and certified safety net specialist for modern high-rises and private residences.
        </p>

        <div class="footer-concierge-box">
          <span class="concierge-label">DIRECT CONCIERGE &amp; SURVEY</span>
          <a href={`tel:${business.phoneRaw}`} class="concierge-link">
            <Phone size={14} className="concierge-icon" />
            <span>Call: {business.phone}</span>
          </a>
          <a
            href={`https://wa.me/${business.whatsapp}?text=Hello%20Invisible%20Safety%2C%20I%20am%20interested%20in%20a%20site%20measurement%20and%20consultation.`}
            target="_blank"
            rel="noopener noreferrer"
            class="concierge-link concierge-whatsapp"
          >
            <MessageCircle size={14} className="concierge-icon-green" />
            <span>WhatsApp: +91 {business.whatsapp.slice(2)}</span>
          </a>
          <a href={`mailto:${business.email}`} class="concierge-link">
            <Mail size={14} className="concierge-icon" />
            <span>{business.email}</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Curated Collections (The 3 Pillars) -->
      <div>
        <h4 class="editorial-col-heading">3 CORE PILLARS</h4>
        <ul class="editorial-footer-links">
          <li><a href="/invisible-grills/">SS316 Balcony Invisible Grills</a></li>
          <li><a href="/window-invisible-grills/">Window &amp; French Door Grills</a></li>
          <li><a href="/staircase-invisible-grills/">Staircase Void Protection</a></li>
          <li><a href="/child-safety-invisible-grills/">Child-Safe Calibrated Grills</a></li>
          <li><a href="/safety-nets/">High-Rise Balcony Safety Nets</a></li>
          <li><a href="/pigeon-nets/">Anti-Pigeon Nets &amp; Spikes</a></li>
          <li><a href="/cloth-drying-hangers/">Ceiling Cloth Drying Hangers</a></li>
          <li><a href="/sports-nets/">Sports &amp; Cricket Nets</a></li>
        </ul>
      </div>

      <!-- Col 3: Craftsmanship & Tools -->
      <div>
        <h4 class="editorial-col-heading">TOOLS &amp; STANDARDS</h4>
        <ul class="editorial-footer-links">
          <li><a href="/visualizer/">Interactive 3D Balcony Visualizer</a></li>
          <li><a href="/invisible-grill-cost/">Dynamic Cost Estimator</a></li>
          <li><a href="/materials/">Virgin SS316 Metallurgy Specs</a></li>
          <li><a href="/gallery/">Real Installation Gallery</a></li>
          <li><a href="/projects/">Residential Portfolio</a></li>
          <li><a href="/warranty/">15-Year Warranty Terms</a></li>
          <li><a href="/why-invisible-safety/">Brand Heritage &amp; Safety Ethos</a></li>
          <li><a href="/faq/">Frequently Asked Questions</a></li>
        </ul>
      </div>

      <!-- Col 4: Regional Service Hubs -->
      <div>
        <h4 class="editorial-col-heading">SERVICE REGIONS</h4>
        <ul class="editorial-footer-links">
          <li><a href="/locations/hyderabad/">Hyderabad &amp; Secunderabad</a></li>
          <li><a href="/locations/visakhapatnam/">Visakhapatnam (Vizag)</a></li>
          <li><a href="/locations/vijayawada/">Vijayawada Central</a></li>
          <li><a href="/locations/amaravati/">Amaravati Capital Region</a></li>
          <li><a href="/locations/">Bengaluru Tech Corridor</a></li>
          <li><a href="/locations/">Chennai &amp; Kochi Corridors</a></li>
        </ul>

        <div class="hub-note">
          <span>Complimentary doorstep laser measurement across all gated societies (Aparna, My Home, Prestige &amp; Sobha).</span>
        </div>
      </div>
    </div>

    <!-- Editorial Bottom Bar -->
    <div class="footer-bottom-editorial">
      <div class="copyright-text">
        &copy; {new Date().getFullYear()} Invisible Safety Architectural Home Safety Solutions. All rights reserved.
      </div>
      <div class="footer-legal-links">
        <a href="/warranty/">15-Year Warranty</a>
        <span>·</span>
        <a href="/contact/">Concierge Survey</a>
        <span>·</span>
        <a href="/faq/">Safety FAQ</a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* =========================================================================
     SLATE-NAVY ARCHITECTURAL FOOTER
     ========================================================================= */
  .editorial-footer {
    background-color: #0F233D;
    color: #F8FAFC;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: clamp(3rem, 6vw, 5rem) 0 2.5rem 0;
    position: relative;
    z-index: 10;
  }

  .footer-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 3.5vw, 2.5rem);
    box-sizing: border-box;
  }

  /* Ethos Quote Section */
  .footer-quote-section {
    text-align: center;
    max-width: 780px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem) auto;
  }

  .editorial-quote {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-style: italic;
    font-size: clamp(1.15rem, 2.2vw, 1.75rem);
    line-height: 1.5;
    color: #F8FAFC;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.01em;
  }

  .quote-divider {
    width: 60px;
    height: 1px;
    background: #C6A66B;
    margin: 0 auto;
  }

  /* Grid Layout */
  .footer-editorial-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: clamp(1.5rem, 3.5vw, 3rem);
    padding-bottom: 3.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 960px) {
    .footer-editorial-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 580px) {
    .footer-editorial-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* Main Column */
  .footer-col-main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-brand-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    color: #FFFFFF;
    text-transform: uppercase;
  }

  .footer-brand-desc {
    font-size: 0.86rem;
    color: #CBD5E1;
    line-height: 1.6;
    margin: 0;
    max-width: 320px;
  }

  .footer-concierge-box {
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .concierge-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #C6A66B;
    text-transform: uppercase;
  }

  .concierge-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: #E2E8F0;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .concierge-link:hover {
    color: #FFFFFF;
  }

  .concierge-icon {
    color: #C6A66B;
    flex-shrink: 0;
  }

  .concierge-icon-green {
    color: #4ADE80;
    flex-shrink: 0;
  }

  /* Headings & Links */
  .editorial-col-heading {
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #C6A66B;
    text-transform: uppercase;
    margin: 0 0 1.25rem 0;
  }

  .editorial-footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .editorial-footer-links a {
    color: #CBD5E1;
    text-decoration: none;
    font-size: 0.86rem;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .editorial-footer-links a:hover {
    color: #FFFFFF;
    transform: translateX(3px);
  }

  .hub-note {
    margin-top: 1.25rem;
    font-size: 0.8rem;
    color: #94A3B8;
    line-height: 1.5;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
  }

  /* Bottom Bar */
  .footer-bottom-editorial {
    padding-top: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.82rem;
    color: #94A3B8;
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-legal-links a {
    color: #94A3B8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-legal-links a:hover {
    color: #F8FAFC;
  }
</style>