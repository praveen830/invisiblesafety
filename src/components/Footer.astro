---
import { business } from '../data/business';
import { Phone, MessageCircle, Mail, MapPin, ArrowRight } from 'lucide-react';
---

<footer class="editorial-footer">
  <div class="footer-container">
    <!-- Brand Statement / Ethos Quote -->
    <div class="footer-quote-section">
      <blockquote class="editorial-quote">
        “The art of architectural protection — securing your sanctuary with quiet elegance.”
      </blockquote>
      <div class="quote-divider"></div>
    </div>

    <!-- Editorial Columns Grid -->
    <div class="footer-editorial-grid">
      <!-- Col 1: Brand & Contact Concierge -->
      <div class="footer-col-main">
        <span class="footer-brand-title">INVISIBLE SAFETY</span>
        <p class="footer-brand-desc">
          India's premier architectural invisible grill and safety net specialist for modern luxury high-rises and private residences.
        </p>

        <div class="footer-concierge-box">
          <span class="concierge-label">DIRECT CONCIERGE &amp; SURVEY</span>
          <a href={`tel:${business.phoneRaw}`} class="concierge-link">
            <Phone size={14} className="concierge-icon" />
            <span>Call: {business.phone}</span>
          </a>
          <a
            href={`https://wa.me/${business.whatsapp}?text=Hello%20Invisible%20Safety%2C%20I%20am%20interested%20in%20a%20site%20measurement%20and%20consultation.`}
            target="_blank"
            rel="noopener noreferrer"
            class="concierge-link concierge-whatsapp"
          >
            <MessageCircle size={14} className="concierge-icon-green" />
            <span>WhatsApp: +91 {business.whatsapp.slice(2)}</span>
          </a>
          <a href={`mailto:${business.email}`} class="concierge-link">
            <Mail size={14} className="concierge-icon" />
            <span>{business.email}</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Curated Collections -->
      <div>
        <h4 class="editorial-col-heading">COLLECTIONS</h4>
        <ul class="editorial-footer-links">
          <li><a href="/invisible-grills/">Balcony SS316 Grills</a></li>
          <li><a href="/safety-nets/">Balcony Safety Nets</a></li>
          <li><a href="/window-invisible-grills/">Window Safety Grills</a></li>
          <li><a href="/staircase-invisible-grills/">Staircase Safety Grills</a></li>
          <li><a href="/child-safety-nets/">Children Anti-Fall Nets</a></li>
          <li><a href="/pigeon-nets/">Anti-Pigeon Nets &amp; Spikes</a></li>
          <li><a href="/sports-nets/">Sports &amp; Cricket Nets</a></li>
          <li><a href="/construction-safety-nets/">Construction &amp; Duct Nets</a></li>
        </ul>
      </div>

      <!-- Col 3: Craftsmanship & Tools -->
      <div>
        <h4 class="editorial-col-heading">TOOLS &amp; STANDARDS</h4>
        <ul class="editorial-footer-links">
          <li><a href="/visualizer/">Interactive 3D Visualizer</a></li>
          <li><a href="/invisible-grill-cost/">Instant Cost Estimator</a></li>
          <li><a href="/materials/">Virgin SS316 Metallurgy</a></li>
          <li><a href="/gallery/">Real Installation Gallery</a></li>
          <li><a href="/projects/">Residential Portfolio</a></li>
          <li><a href="/warranty/">10-Year Warranty Terms</a></li>
          <li><a href="/why-invisible-safety/">Why Invisible Safety</a></li>
          <li><a href="/faq/">Frequently Asked Questions</a></li>
        </ul>
      </div>

      <!-- Col 4: Regional Service Hubs -->
      <div>
        <h4 class="editorial-col-heading">SERVICE REGIONS</h4>
        <ul class="editorial-footer-links">
          <li><a href="/locations/hyderabad/">Hyderabad &amp; Secunderabad</a></li>
          <li><a href="/locations/visakhapatnam/">Visakhapatnam (Vizag)</a></li>
          <li><a href="/locations/vijayawada/">Vijayawada</a></li>
          <li><a href="/locations/amaravati/">Amaravati Capital Region</a></li>
          <li><a href="/locations/">All Regional Hubs</a></li>
        </ul>

        <div class="hub-note">
          <span>Doorstep laser measurement across all gated societies and high-rise apartments.</span>
        </div>
      </div>
    </div>

    <!-- Editorial Bottom Bar -->
    <div class="footer-bottom-editorial">
      <div class="copyright-text">
        &copy; {new Date().getFullYear()} Invisible Safety Architectural Home Safety Solutions. All rights reserved.
      </div>
      <div class="footer-legal-links">
        <a href="/warranty/">Warranty Guarantee</a>
        <span>·</span>
        <a href="/contact/">Concierge</a>
        <span>·</span>
        <a href="/faq/">Knowledge Base</a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* =========================================================================
     EDITORIAL LUXURY FOOTER
     ========================================================================= */
  .editorial-footer {
    background-color: #0D0D0D;
    color: #FFFFFF;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: clamp(3rem, 6vw, 5rem) 0 2.5rem 0;
    position: relative;
    z-index: 10;
  }

  .footer-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 3.5vw, 2.5rem);
    box-sizing: border-box;
  }

  /* Ethos Quote Section */
  .footer-quote-section {
    text-align: center;
    max-width: 780px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem) auto;
  }

  .editorial-quote {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-style: italic;
    font-size: clamp(1.15rem, 2.2vw, 1.75rem);
    line-height: 1.5;
    color: #F8FAFC;
    margin: 0 0 1.5rem 0;
    letter-spacing: -0.01em;
  }

  .quote-divider {
    width: 60px;
    height: 1px;
    background: var(--color-gold, #C5A880);
    margin: 0 auto;
  }

  /* Grid Layout */
  .footer-editorial-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: clamp(1.5rem, 3.5vw, 3rem);
    padding-bottom: 3.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 960px) {
    .footer-editorial-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 580px) {
    .footer-editorial-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* Main Column */
  .footer-col-main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-brand-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    color: #FFFFFF;
    text-transform: uppercase;
  }

  .footer-brand-desc {
    font-size: 0.85rem;
    color: #94A3B8;
    line-height: 1.6;
    margin: 0;
    max-width: 320px;
  }

  .footer-concierge-box {
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .concierge-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-gold, #C5A880);
    text-transform: uppercase;
  }

  .concierge-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: #E2E8F0;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .concierge-link:hover {
    color: #FFFFFF;
  }

  .concierge-icon {
    color: var(--color-gold, #C5A880);
    flex-shrink: 0;
  }

  .concierge-icon-green {
    color: #4ADE80;
    flex-shrink: 0;
  }

  /* Headings & Links */
  .editorial-col-heading {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--color-gold, #C5A880);
    text-transform: uppercase;
    margin: 0 0 1.25rem 0;
  }

  .editorial-footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .editorial-footer-links a {
    color: #94A3B8;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 400;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .editorial-footer-links a:hover {
    color: #FFFFFF;
    transform: translateX(2px);
  }

  .hub-note {
    margin-top: 1.25rem;
    font-size: 0.76rem;
    color: #64748B;
    line-height: 1.5;
  }

  /* Bottom Bar */
  .footer-bottom-editorial {
    padding-top: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.78rem;
    color: #64748B;
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-legal-links a {
    color: #94A3B8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-legal-links a:hover {
    color: #FFFFFF;
  }

  @media (max-width: 640px) {
    .footer-bottom-editorial {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
