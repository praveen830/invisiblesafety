---
import { business } from '../data/business';
import { ShieldCheck, HardHat, FileText, Anchor, Award } from 'lucide-react';
---

<section class="trust-section">
  <div class="container">
    <div class="section-header">
      <span class="badge-blue">
        <Award size={14} />
        Installation Standards
      </span>
      <h2>Safety Is Not A Marketing Slogan</h2>
      <p>
        Every Invisible Safety installation focuses on structural alignment, calibrated mechanical tensioning, and disciplined on-site safety standards.
      </p>
    </div>

    <div class="grid-4">
      <div class="arch-card trust-card">
        <div class="trust-icon-box anchor-box">
          <Anchor size={24} />
        </div>
        <div class="trust-tag-row">
          <span class="trust-pill steel-pill">
            STAINLESS STEEL CORE
          </span>
        </div>
        <h3 class="trust-card-title">Stainless steel</h3>
        <p class="trust-card-desc">
          Stainless steel cables encased in a transparent protective sleeve, designed for outdoor balconies and weathering resistance.
        </p>
      </div>

      <div class="arch-card trust-card">
        <div class="trust-icon-box load-box">
          <ShieldCheck size={24} />
        </div>
        <div class="trust-tag-row">
          <span class="trust-pill load-pill">
            FALL PROTECTION
          </span>
        </div>
        <h3 class="trust-card-title">Balcony Safety</h3>
        <p class="trust-card-desc">
          durable wire system designed to help safeguard children and household pets on balconies without blocking views.
        </p>
      </div>

      <div class="arch-card trust-card">
        <div class="trust-icon-box harness-box">
          <HardHat size={24} />
        </div>
        <div class="trust-tag-row">
          <span class="trust-pill harness-pill">
            SAFETY PROTOCOLS
          </span>
        </div>
        <h3 class="trust-card-title">Experienced Rigging Team</h3>
        <p class="trust-card-desc">
          Our on-site installation teams use dedicated safety harnesses and personal protective equipment for secure balcony installations.
        </p>
      </div>

      <div class="arch-card trust-card">
        <div class="trust-icon-box warranty-box">
          <FileText size={24} />
        </div>
        <div class="trust-tag-row">
          <span class="trust-pill warranty-pill">
            DIRECT SERVICE
          </span>
        </div>
        <h3 class="trust-card-title">Direct Workmanship Assurance</h3>
        <p class="trust-card-desc">
          Clear quotation and workmanship warranty covering cable alignment, track fixings, and scheduled support.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-section {
    padding-top: 5rem;
    padding-bottom: 5rem;
    background: #F0F5FA; /* Soft Sky Blue for Trust Sections */
    border-top: 1px solid #E2E8F0;
    border-bottom: 1px solid #E2E8F0;
  }

  .trust-card {
    display: flex;
    flex-direction: column;
    padding: 1.85rem 1.65rem;
    background: #FFFFFF;
    border-radius: 16px;
    border: 1px solid rgba(45, 137, 239, 0.15);
    box-shadow: 0 4px 20px -2px rgba(15, 35, 61, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .trust-card:hover {
    transform: translateY(-4px);
    border-color: #2D89EF;
    box-shadow: 0 12px 28px -4px rgba(15, 35, 61, 0.1);
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .section-header {
    text-align: center;
    max-width: 48rem;
    margin: 0 auto 3.5rem auto;
  }

  .badge-blue {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #2D89EF;
    background: #FFFFFF;
    padding: 0.4rem 0.9rem;
    border-radius: 9999px;
    border: 1px solid rgba(45, 137, 239, 0.25);
    margin-bottom: 1rem;
  }

  .section-header h2 {
    font-family: var(--font-brand);
    font-size: 2rem;
    font-weight: 800;
    color: #0F233D;
    line-height: 1.25;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .section-header h2 {
      font-size: 2.5rem;
    }
  }

  .section-header p {
    font-size: 1rem;
    color: #475569;
    line-height: 1.6;
  }

  .grid-4 {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .grid-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .grid-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .trust-icon-box {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .anchor-box {
    background: #EBF3FA;
    color: #2D89EF;
  }

  .load-box {
    background: #FEF3C7;
    color: #D97706;
  }

  .harness-box {
    background: #E0E7FF;
    color: #4F46E5;
  }

  .warranty-box {
    background: #D1FAE5;
    color: #059669;
  }

  .trust-tag-row {
    margin-bottom: 0.75rem;
  }

  .trust-pill {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    text-transform: uppercase;
  }

  .steel-pill {
    background: #EBF3FA;
    color: #1E40AF;
  }

  .load-pill {
    background: #FEF3C7;
    color: #92400E;
  }

  .harness-pill {
    background: #E0E7FF;
    color: #3730A3;
  }

  .warranty-pill {
    background: #D1FAE5;
    color: #065F46;
  }

  .trust-card-title {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 700;
    color: #0F233D;
    line-height: 1.35;
    margin-bottom: 0.6rem;
  }

  .trust-card-desc {
    font-size: 0.875rem;
    color: #475569;
    line-height: 1.55;
    margin: 0;
  }
</style>
