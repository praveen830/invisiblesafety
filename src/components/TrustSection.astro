---
import { business } from '../data/business';
import { ShieldCheck, HardHat, FileText, Anchor, Award } from 'lucide-react';
---

<section class="trust-section">
  <div class="container">
    <div class="section-header">
      <span class="badge-blue">
        <Award size={14} />
        Metallurgical Certification
      </span>
      <h2>Safety Is Not A Marketing Slogan</h2>
      <p>
        Every Invisible Safety installation is backed by physical laboratory metallurgical certification, calibrated mechanical tensioning, and strict work-at-height engineering standards.
      </p>
    </div>

    <div class="grid-4">
      <div class="arch-card trust-card">
        <div class="trust-icon-box anchor-box">
          <Anchor size={24} />
        </div>
        <div class="trust-tag-row">
          <span class="trust-pill ss316-pill">
            SS316 MARINE ALLOY
          </span>
        </div>
        <h3 class="trust-card-title">Virgin SS316 Marine Grade</h3>
        <p class="trust-card-desc">
          Enriched with 2.5% Molybdenum to prevent pitting corrosion. Will never rust or stain, even in coastal salt air or heavy monsoon climates.
        </p>
      </div>

      <div class="arch-card trust-card">
        <div class="trust-icon-box load-box">
          <ShieldCheck size={24} />
        </div>
        <div class="trust-tag-row">
          <span class="trust-pill load-pill">
            400+ KGF TESTED
          </span>
        </div>
        <h3 class="trust-card-title">400+ kg Breaking Load</h3>
        <p class="trust-card-desc">
          High-tensile cables withstand massive instantaneous impact. Impossible for toddlers or energetic pets to separate or force through.
        </p>
      </div>

      <div class="arch-card trust-card">
        <div class="trust-icon-box harness-box">
          <HardHat size={24} />
        </div>
        <div class="trust-tag-row">
          <span class="trust-pill harness-pill">
            IS 3521 HARNESS
          </span>
        </div>
        <h3 class="trust-card-title">Certified Technicians</h3>
        <p class="trust-card-desc">
          Our field teams undergo rigorous work-at-height certification. Every high-rise tower installation utilizes dual-lanyard lifelines and helmet gear.
        </p>
      </div>

      <div class="arch-card trust-card">
        <div class="trust-icon-box warranty-box">
          <FileText size={24} />
        </div>
        <div class="trust-tag-row">
          <span class="trust-pill warranty-pill">
            10 YEARS DIRECT
          </span>
        </div>
        <h3 class="trust-card-title">10-Year Direct Guarantee</h3>
        <p class="trust-card-desc">
          Written guarantee certificate on cable tensile integrity and aluminium track anchoring, including complimentary re-tensioning inspection.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .trust-section {
    padding-top: 5rem;
    padding-bottom: 5rem;
    background: #F0F5FA; /* Soft Sky Blue for Trust Sections */
    border-top: 1px solid #E2E8F0;
    border-bottom: 1px solid #E2E8F0;
  }

  .trust-card {
    display: flex;
    flex-direction: column;
    padding: 1.85rem 1.65rem;
    background: #FFFFFF;
    border-radius: 16px;
    border: 1px solid rgba(45, 137, 239, 0.15);
    box-shadow: 0 4px 20px -2px rgba(15, 35, 61, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .trust-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px -4px rgba(15, 35, 61, 0.12);
    border-color: #2D89EF;
  }

  .trust-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .anchor-box {
    background: #F0F5FA;
    color: #2D89EF;
    border: 1px solid rgba(45, 137, 239, 0.25);
  }

  .load-box {
    background: #DCFCE7;
    color: #15803D;
    border: 1px solid rgba(37, 211, 102, 0.3);
  }

  .harness-box {
    background: #FDF6EE;
    color: #8C6F32;
    border: 1px solid rgba(198, 166, 107, 0.35);
  }

  .warranty-box {
    background: #F0F5FA;
    color: #2D89EF;
    border: 1px solid rgba(45, 137, 239, 0.25);
  }

  .trust-tag-row {
    margin-bottom: 0.65rem;
  }

  .trust-pill {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    letter-spacing: 0.04em;
    display: inline-block;
  }

  .ss316-pill {
    color: #2D89EF;
    background: #F0F5FA;
    border: 1px solid rgba(45, 137, 239, 0.25);
  }

  .load-pill {
    color: #15803D;
    background: #DCFCE7;
    border: 1px solid rgba(37, 211, 102, 0.25);
  }

  .harness-pill {
    color: #8C6F32;
    background: #FDF6EE;
    border: 1px solid rgba(198, 166, 107, 0.3);
  }

  .warranty-pill {
    color: #2D89EF;
    background: #F0F5FA;
    border: 1px solid rgba(45, 137, 239, 0.25);
  }

  .trust-card-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: #0F233D;
    margin-bottom: 0.55rem;
    line-height: 1.25;
  }

  .trust-card-desc {
    font-size: 0.88rem;
    color: #1E293B;
    line-height: 1.55;
  }
</style>
