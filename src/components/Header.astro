---
import { business } from '../data/business';
import { X, Phone, MessageCircle, ChevronDown, ShieldCheck } from 'lucide-react';

const pillar1Grills = [
  { name: "SS316 Balcony Invisible Grills", href: "/invisible-grills/", desc: "Flagship 2.0mm/2.5mm marine-grade cables" },
  { name: "Window & French Door Grills", href: "/window-invisible-grills/", desc: "Unobstructed ventilation & child safety" },
  { name: "Staircase Tension Grills", href: "/staircase-invisible-grills/", desc: "Architectural vertical void safety" },
  { name: "Child-Safe Calibrated Grills", href: "/child-safety-invisible-grills/", desc: "50mm high-density fall protection" },
  { name: "SS316 Metallurgy Specifications", href: "/materials/", desc: "Molybdenum rust-proof certification" }
];

const pillar2Nets = [
  { name: "High-Rise Balcony Safety Nets", href: "/safety-nets/", desc: "Virgin Garware UV-stabilized polymer" },
  { name: "Anti-Pigeon Nets & Deterrence", href: "/pigeon-nets/", desc: "100% humane bird barrier mesh" },
  { name: "SS304 Bird Spikes", href: "/bird-spikes/", desc: "Polycarbonate base ledge protection" },
  { name: "Child & Toddler Anti-Fall Nets", href: "/child-safety-nets/", desc: "High-impact fall containment" },
  { name: "Sports & Cricket Practice Nets", href: "/sports-nets/", desc: "Heavy-gauge turf and rooftop cages" }
];

const pillar3Hangers = [
  { name: "Ceiling Cloth Drying Hangers", href: "/cloth-drying-hangers/", desc: "Individual pull-down stainless steel pipes" },
  { name: "Balcony Utility Drying Solutions", href: "/cloth-drying-hangers/#utility", desc: "Reclaim 100% usable balcony floor space" }
];

const serviceCities = [
  { name: "Hyderabad & Secunderabad", href: "/locations/hyderabad/", tag: "Central Hub" },
  { name: "Visakhapatnam (Vizag)", href: "/locations/visakhapatnam/", tag: "Coastal Hub" },
  { name: "Vijayawada", href: "/locations/vijayawada/", tag: "Urban Hub" },
  { name: "Amaravati Capital Region", href: "/locations/amaravati/", tag: "Capital Hub" },
  { name: "Bengaluru", href: "/locations/", tag: "South Hub" },
  { name: "Chennai & Kochi", href: "/locations/", tag: "Coastal Corridor" }
];
---

<header class="arch-header" id="arch-header">
  <div class="header-container">
    <!-- Left: Mobile Trigger & Brand -->
    <div class="header-left">
      <button
        class="mobile-menu-toggle"
        id="mobile-drawer-open-btn"
        aria-label="Open Navigation Menu"
        aria-expanded="false"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>

      <a href="/" class="brand-logo" aria-label="Invisible Safety - Home">
        <span class="brand-mark">INVISIBLE SAFETY</span>
        <span class="brand-sub">ARCHITECTURAL RESIDENTIAL SAFETY</span>
      </a>
    </div>

    <!-- Center: Desktop Navigation with 3-Pillar Dropdowns -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <!-- Pillar 1 Dropdown -->
      <div class="nav-dropdown-wrapper">
        <button class="nav-dropdown-btn" aria-haspopup="true">
          <span>Invisible Grills</span>
          <ChevronDown size={14} className="dropdown-chevron" />
        </button>
        <div class="nav-dropdown-menu">
          <div class="dropdown-header">
            <span class="dropdown-badge">PILLAR 1: SS316 MARINE GRADE</span>
          </div>
          {pillar1Grills.map((item) => (
            <a href={item.href} class="dropdown-link-item">
              <span class="link-item-title">{item.name}</span>
              <span class="link-item-desc">{item.desc}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Pillar 2 Dropdown -->
      <div class="nav-dropdown-wrapper">
        <button class="nav-dropdown-btn" aria-haspopup="true">
          <span>Safety Nets</span>
          <ChevronDown size={14} className="dropdown-chevron" />
        </button>
        <div class="nav-dropdown-menu">
          <div class="dropdown-header">
            <span class="dropdown-badge">PILLAR 2: CERTIFIED HDPE NETS</span>
          </div>
          {pillar2Nets.map((item) => (
            <a href={item.href} class="dropdown-link-item">
              <span class="link-item-title">{item.name}</span>
              <span class="link-item-desc">{item.desc}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Pillar 3 Dropdown -->
      <div class="nav-dropdown-wrapper">
        <button class="nav-dropdown-btn" aria-haspopup="true">
          <span>Cloth Hangers</span>
          <ChevronDown size={14} className="dropdown-chevron" />
        </button>
        <div class="nav-dropdown-menu">
          <div class="dropdown-header">
            <span class="dropdown-badge">PILLAR 3: SPACE RECLAMATION</span>
          </div>
          {pillar3Hangers.map((item) => (
            <a href={item.href} class="dropdown-link-item">
              <span class="link-item-title">{item.name}</span>
              <span class="link-item-desc">{item.desc}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Interactive Links -->
      <a href="/visualizer/" class="nav-single-link">
        <span>3D Visualizer</span>
      </a>

      <a href="/invisible-grill-cost/" class="nav-single-link highlight-link">
        <span>Cost Calculator</span>
      </a>

      <a href="/locations/" class="nav-single-link">
        <span>Service Cities</span>
      </a>
    </nav>

    <!-- Right: High-Contrast CTA & Quick Contact -->
    <div class="header-right">
      <a
        href={`tel:${business.phoneRaw}`}
        class="header-phone-link"
        aria-label={`Call Invisible Safety at ${business.phone}`}
      >
        <Phone size={15} className="phone-icon" />
        <span class="phone-number">{business.phone}</span>
      </a>

      <a
        href="/contact/#quote"
        class="header-primary-cta"
        aria-label="Book Free Site Inspection"
      >
        <span>Book Free Inspection</span>
      </a>
    </div>
  </div>

  <!-- Accessible, Responsive Mobile Navigation Drawer (Zero Horizontal Overflow, 48px Min Touch Targets) -->
  <div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop" aria-hidden="true"></div>

  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <div class="drawer-top-bar">
      <a href="/" class="brand-logo" aria-label="Invisible Safety">
        <span class="brand-mark">INVISIBLE SAFETY</span>
      </a>
      <button
        class="drawer-close-button"
        id="mobile-drawer-close-btn"
        aria-label="Close navigation menu"
      >
        <X size={22} strokeWidth={2} />
      </button>
    </div>

    <div class="drawer-scroll-content">
      <!-- Direct Emergency & Free Measurement Callout -->
      <div class="drawer-trust-banner">
        <div class="trust-banner-badge">
          <ShieldCheck size={14} />
          <span>15-Year SS316 Warranty &amp; Free Survey</span>
        </div>
        <p class="trust-banner-text">
          Certified doorstep laser measurement across Hyderabad, Vizag, Vijayawada, Amaravati, Bengaluru &amp; Chennai.
        </p>
      </div>

      <!-- Pillar 1 Section -->
      <div class="drawer-nav-section">
        <span class="drawer-section-label">PILLAR 1: SS316 INVISIBLE GRILLS</span>
        <div class="drawer-links-stack">
          {pillar1Grills.map((item) => (
            <a href={item.href} class="drawer-touch-link">
              <span class="touch-link-main">{item.name}</span>
              <span class="touch-link-sub">{item.desc}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Pillar 2 Section -->
      <div class="drawer-nav-section">
        <span class="drawer-section-label">PILLAR 2: BALCONY &amp; PIGEON NETS</span>
        <div class="drawer-links-stack">
          {pillar2Nets.map((item) => (
            <a href={item.href} class="drawer-touch-link">
              <span class="touch-link-main">{item.name}</span>
              <span class="touch-link-sub">{item.desc}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Pillar 3 Section -->
      <div class="drawer-nav-section">
        <span class="drawer-section-label">PILLAR 3: CLOTH DRYING HANGERS</span>
        <div class="drawer-links-stack">
          {pillar3Hangers.map((item) => (
            <a href={item.href} class="drawer-touch-link">
              <span class="touch-link-main">{item.name}</span>
              <span class="touch-link-sub">{item.desc}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Interactive Planning & Tools -->
      <div class="drawer-nav-section">
        <span class="drawer-section-label">INTERACTIVE PLANNING TOOLS</span>
        <div class="drawer-links-stack">
          <a href="/visualizer/" class="drawer-touch-link highlight">
            <span class="touch-link-main">Interactive 3D Balcony Visualizer</span>
            <span class="touch-link-sub">Preview SS316 cable spacing on high-rise layouts</span>
          </a>
          <a href="/invisible-grill-cost/" class="drawer-touch-link highlight">
            <span class="touch-link-main">Dynamic Sq.Ft. Cost Estimator</span>
            <span class="touch-link-sub">Calculate instant balcony price quotation</span>
          </a>
          <a href="/gallery/" class="drawer-touch-link">
            <span class="touch-link-main">Real Projects Gallery</span>
            <span class="touch-link-sub">High-resolution verified installation photos</span>
          </a>
          <a href="/warranty/" class="drawer-touch-link">
            <span class="touch-link-main">15-Year Warranty Terms</span>
            <span class="touch-link-sub">Written metallurgical guarantee certificate</span>
          </a>
        </div>
      </div>

      <!-- Service Locations Hub -->
      <div class="drawer-nav-section">
        <span class="drawer-section-label">REGIONAL SERVICE HUBS</span>
        <div class="drawer-city-grid">
          {serviceCities.map((city) => (
            <a href={city.href} class="city-pill-link">
              <span class="city-name">{city.name}</span>
              <span class="city-tag">{city.tag}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Drawer Sticky Bottom Actions -->
    <div class="drawer-bottom-actions">
      <a
        href={`tel:${business.phoneRaw}`}
        class="drawer-btn drawer-btn-phone"
        aria-label="Direct Phone Call"
      >
        <Phone size={16} />
        <span>Call: {business.phone}</span>
      </a>

      <a
        href={`https://wa.me/${business.whatsapp}?text=Hello%20Invisible%20Safety%2C%20I%20am%20interested%20in%20a%20free%20site%20measurement%20and%20quotation.`}
        target="_blank"
        rel="noopener noreferrer"
        class="drawer-btn drawer-btn-whatsapp"
        aria-label="Chat on WhatsApp"
      >
        <MessageCircle size={16} />
        <span>WhatsApp Quote</span>
      </a>
    </div>
  </div>
</header>

<style>
  /* =========================================================================
     LIGHT-FIRST ARCHITECTURAL STICKY HEADER
     ========================================================================= */
  .arch-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 900;
    height: 72px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(26, 54, 93, 0.08);
    box-shadow: 0 2px 12px -2px rgba(26, 54, 93, 0.04);
    transition: all 0.25s ease;
  }

  .header-container {
    max-width: 1360px;
    height: 100%;
    margin: 0 auto;
    padding: 0 clamp(1rem, 3vw, 2.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    gap: 1.5rem;
  }

  /* Left: Brand Identity & Mobile Hamburger */
  .header-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .mobile-menu-toggle {
    display: none;
    background: transparent;
    border: 1px solid rgba(26, 54, 93, 0.15);
    border-radius: 8px;
    width: 44px;
    height: 44px;
    padding: 10px;
    cursor: pointer;
    flex-direction: column;
    justify-content: space-around;
    align-items: center;
    outline: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .mobile-menu-toggle:hover {
    background: #F4F9FD;
    border-color: #1A365D;
  }

  .hamburger-bar {
    width: 20px;
    height: 2px;
    background-color: #1A365D;
    border-radius: 2px;
    transition: all 0.2s ease;
  }

  .brand-logo {
    text-decoration: none;
    display: flex;
    flex-direction: column;
  }

  .brand-mark {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: clamp(0.95rem, 1.4vw, 1.18rem);
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #1A365D;
    line-height: 1.15;
    white-space: nowrap;
  }

  .brand-sub {
    font-family: var(--font-sans);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #C6A66B;
    text-transform: uppercase;
    margin-top: 2px;
  }

  /* Center: Desktop Navigation */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-dropdown-wrapper {
    position: relative;
  }

  .nav-dropdown-btn {
    background: transparent;
    border: none;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 600;
    color: #334155;
    padding: 8px 12px;
    border-radius: 8px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 0.2s ease;
  }

  .dropdown-chevron {
    transition: transform 0.2s ease;
    color: #64748B;
  }

  .nav-dropdown-btn:hover,
  .nav-dropdown-wrapper:focus-within .nav-dropdown-btn {
    color: #1A365D;
    background: #F4F9FD;
  }

  .nav-dropdown-wrapper:hover .dropdown-chevron,
  .nav-dropdown-wrapper:focus-within .dropdown-chevron {
    transform: rotate(180deg);
    color: #1A365D;
  }

  /* Desktop Dropdown Flyout Menu */
  .nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 320px;
    background: #FFFFFF;
    border: 1px solid rgba(26, 54, 93, 0.08);
    border-radius: 16px;
    box-shadow: 0 16px 36px -4px rgba(26, 54, 93, 0.12), 0 4px 12px -2px rgba(26, 54, 93, 0.04);
    padding: 0.75rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    z-index: 920;
  }

  .nav-dropdown-wrapper:hover .nav-dropdown-menu,
  .nav-dropdown-wrapper:focus-within .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(4px);
    pointer-events: auto;
  }

  .dropdown-header {
    padding: 6px 12px 10px 12px;
    border-bottom: 1px solid #F1F5F9;
    margin-bottom: 6px;
  }

  .dropdown-badge {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #C6A66B;
    text-transform: uppercase;
  }

  .dropdown-link-item {
    display: flex;
    flex-direction: column;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .dropdown-link-item:hover {
    background-color: #F4F9FD;
  }

  .link-item-title {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 600;
    color: #1A365D;
    line-height: 1.3;
  }

  .link-item-desc {
    font-size: 0.76rem;
    color: #64748B;
    margin-top: 2px;
  }

  .nav-single-link {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 600;
    color: #334155;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .nav-single-link:hover {
    color: #1A365D;
    background: #F4F9FD;
  }

  .nav-single-link.highlight-link {
    color: #1A365D;
    background: #EBF4FA;
    font-weight: 700;
  }

  .nav-single-link.highlight-link:hover {
    background: #E0EFF9;
  }

  /* Right: Quick Call & High-Contrast CTA */
  .header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .header-phone-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    color: #1A365D;
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .header-phone-link:hover {
    background: #F4F9FD;
  }

  .phone-icon {
    color: #C6A66B;
  }

  .header-primary-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 1.25rem;
    background: #1A365D;
    color: #FFFFFF !important;
    border: 1px solid #1A365D;
    border-radius: 9999px;
    font-family: var(--font-sans);
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(26, 54, 93, 0.15);
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .header-primary-cta:hover {
    background: #0F233D;
    border-color: #0F233D;
    box-shadow: 0 6px 16px rgba(26, 54, 93, 0.25);
    transform: translateY(-1px);
  }

  /* =========================================================================
     ACCESSIBLE MOBILE NAVIGATION DRAWER
     ========================================================================= */
  .mobile-drawer-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 35, 61, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 998;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .mobile-drawer-backdrop.is-active {
    display: block;
    opacity: 1;
  }

  .mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 100%;
    max-width: 380px;
    background: #FFFFFF;
    color: #1A365D;
    z-index: 999;
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 8px 0 32px rgba(26, 54, 93, 0.15);
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    overflow-y: hidden;
    box-sizing: border-box;
  }

  .mobile-drawer.is-open {
    transform: translateX(0);
  }

  .drawer-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid #E2E8F0;
    background: #F8FAFC;
    flex-shrink: 0;
    min-height: 64px;
  }

  .drawer-close-button {
    background: transparent;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1A365D;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .drawer-close-button:hover {
    background: #E2E8F0;
  }

  .drawer-scroll-content {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .drawer-trust-banner {
    background: #F4F9FD;
    border: 1px solid #BAE6FD;
    border-radius: 12px;
    padding: 12px 14px;
  }

  .trust-banner-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 700;
    color: #0284C7;
    margin-bottom: 4px;
  }

  .trust-banner-text {
    font-size: 11px;
    color: #475569;
    line-height: 1.45;
    margin: 0;
  }

  .drawer-nav-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .drawer-section-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #C6A66B;
    text-transform: uppercase;
  }

  .drawer-links-stack {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* 48px Min Touch Target for Mobile Compliance */
  .drawer-touch-link {
    min-height: 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 8px 14px;
    border-radius: 10px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    text-decoration: none;
    transition: all 0.15s ease;
    touch-action: manipulation;
  }

  .drawer-touch-link:hover,
  .drawer-touch-link:active {
    background: #EBF4FA;
    border-color: #BAE6FD;
  }

  .drawer-touch-link.highlight {
    background: #EBF4FA;
    border-color: #BAE6FD;
  }

  .touch-link-main {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: #1A365D;
    line-height: 1.3;
  }

  .touch-link-sub {
    font-size: 11px;
    color: #64748B;
    margin-top: 2px;
  }

  /* Service Cities Pills */
  .drawer-city-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .city-pill-link {
    min-height: 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6px 12px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .city-pill-link:hover,
  .city-pill-link:active {
    background: #EBF4FA;
    border-color: #BAE6FD;
  }

  .city-name {
    font-size: 12px;
    font-weight: 600;
    color: #1A365D;
    line-height: 1.2;
  }

  .city-tag {
    font-size: 9px;
    font-weight: 700;
    color: #C6A66B;
    text-transform: uppercase;
    margin-top: 2px;
  }

  /* Sticky Drawer Footer Actions */
  .drawer-bottom-actions {
    padding: 16px 20px;
    background: #F8FAFC;
    border-top: 1px solid #E2E8F0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-shrink: 0;
  }

  .drawer-btn {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 10px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s ease;
    touch-action: manipulation;
  }

  .drawer-btn:active {
    transform: scale(0.98);
  }

  .drawer-btn-phone {
    background: #1A365D;
    color: #FFFFFF !important;
  }

