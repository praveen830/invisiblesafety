---
import { business } from '../data/business';
import { Phone, Globe, X, ArrowRight, ShieldCheck, Sparkles, Bird, Heart, Layers, ChevronDown } from 'lucide-react';

const mainNavigation = [
  {
    name: "Invisible Grills",
    href: "/invisible-grills/",
    badge: "Flagship SS316",
    badgeColor: "#0284C7",
    rate: "From ₹190/sq.ft",
    warranty: "10-Year Direct Warranty",
    subLinks: [
      { name: "Balcony Invisible Grills", href: "/balcony-invisible-grills/", desc: "400+ kgf load tested SS316 marine wires" },
      { name: "Staircase Invisible Grills", href: "/staircase-invisible-grills/", desc: "Floor-to-ceiling vertical tension for duplex stairs" },
      { name: "Windows Invisible Grills", href: "/window-invisible-grills/", desc: "Clear aperture window protection without iron cages" },
      { name: "Child Safety Invisible Grills", href: "/child-safety-invisible-grills/", desc: "50mm anti-head entrapment spacing with zero-climb" },
      { name: "Balcony Cost Calculator", href: "/invisible-grill-cost/", desc: "Instant online square-foot price calculation" }
    ]
  },
  {
    name: "Core Safety Nets",
    href: "/safety-nets/",
    badge: "Apartment Standard",
    badgeColor: "#15803D",
    rate: "From ₹25/sq.ft",
    warranty: "3-Year Certified Warranty",
    subLinks: [
      { name: "Balcony Safety Nets", href: "/balcony-safety/", desc: "High-density virgin polymer whole-balcony mesh" },
      { name: "Child Safety Nets", href: "/child-safety-nets/", desc: "Zero-climb anti-fall netting for gated towers" },
      { name: "Staircase Safety Nets", href: "/staircase-safety-nets/", desc: "Void protection for open multi-level stairwells" },
      { name: "Building Perimeter Nets", href: "/building-safety-nets/", desc: "Certified fall perimeter netting for tall buildings" }
    ]
  },
  {
    name: "Construction & Industrial",
    href: "/duct-safety-nets/",
    badge: "Site Heavy Grade",
    badgeColor: "#D97706",
    rate: "From ₹22/sq.ft",
    warranty: "Industrial Certified",
    subLinks: [
      { name: "Construction Safety Nets", href: "/construction-safety-nets/", desc: "High-rise scaffolding and debris containment netting" },
      { name: "Industrial Debris Nets", href: "/industrial-safety-nets/", desc: "Heavy-ply containment for warehouse & factory bays" },
      { name: "Terrace Top Nets", href: "/terrace-safety-nets/", desc: "Open sky terrace and rooftop event perimeter safety" },
      { name: "Car Parking Safety Nets", href: "/car-parking-safety-nets/", desc: "Overhead ceiling fall protection for parking basements" }
    ]
  },
  {
    name: "Animal & Bird Protection",
    href: "/animals-birds-safety-nets/",
    badge: "100% Humane",
    badgeColor: "#16A34A",
    rate: "From ₹28/sq.ft",
    warranty: "UV-Resistant",
    subLinks: [
      { name: "Anti-Pigeon Nets", href: "/pigeon-nets/", desc: "0.7mm translucent netting barring pigeons & acidic guano" },
      { name: "Stainless Steel Bird Spikes", href: "/bird-spikes/", desc: "Discreet blunt-tip stainless steel spikes preventing bird landing" },
      { name: "Monkey Safety Nets", href: "/monkey-safety-nets/", desc: "High-gauge, tear-resistant safety nets against monkey entry" },
      { name: "Mosquito Safety Nets", href: "/mosquito-safety-nets/", desc: "Precision-woven fiberglass and stainless steel window mesh" }
    ]
  },
  {
    name: "Specialty Solutions",
    href: "/sports-nets/",
    badge: "Recreational & Utility",
    badgeColor: "#0284C7",
    rate: "From ₹18/sq.ft",
    warranty: "High Impact Tested",
    subLinks: [
      { name: "Sports Practice Nets", href: "/sports-practice-nets/", desc: "High-velocity ball containment cages for rooftop cricket" },
      { name: "Coconut Safety Nets", href: "/coconut-safety-nets/", desc: "Heavy-ply palm canopy nets protecting parked vehicles" },
      { name: "Swimming Pool Nets", href: "/swimming-pool-nets/", desc: "Child-safe drowning prevention mesh covers for pools" },
      { name: "Cloth Drying Hangers", href: "/cloth-drying-hangers/", desc: "Ceiling-mounted stainless steel pulley drying systems" }
    ]
  }
];
---

<!-- Architectural Top Header -->
<header class="site-header">
  <div class="header-inner">
    <!-- Left: Menu Trigger -->
    <div class="header-left">
      <button
        id="arch-menu-toggle"
        type="button"
        class="menu-trigger-btn"
        aria-label="Open Navigation Menu"
        aria-expanded="false"
      >
        <span class="hamburger-icon">
          <span></span>
          <span></span>
        </span>
        <span class="menu-label">MENU</span>
      </button>
    </div>

    <!-- Center: Brand Logo -->
    <div class="header-center">
      <a href="/" class="brand-link">
        <span class="brand-title">INVISPROTECT</span>
        <span class="brand-sub">ARCHITECTURAL SAFETY</span>
      </a>
    </div>

    <!-- Right: Quick Category Navigation & Actions with Hover Dropdowns -->
    <div class="header-right">
      {mainNavigation.map((cat, i) => (
        <div class="nav-dropdown-item">
          <a href={cat.href} class={`desktop-quick-link ${i === 0 ? 'highlight-link-pill' : ''}`}>
            <span>{cat.name}</span>
            <ChevronDown size={12} className="nav-chevron" />
          </a>

          <!-- Mouseover Sub-Categories Dropdown Panel -->
          <div class="nav-dropdown-menu">
            <div class="nav-dropdown-inner">
              <div class="nav-dropdown-header">
                <div class="dropdown-header-left">
                  <a href={cat.href} class="dropdown-cat-title">{cat.name}</a>
                  <span class="dropdown-cat-badge" style={`color: ${cat.badgeColor}; border-color: ${cat.badgeColor}40; background: ${cat.badgeColor}12;`}>
                    {cat.badge}
                  </span>
                </div>
                <div class="dropdown-header-meta">
                  <span class="meta-rate">{cat.rate}</span>
                  <span class="meta-dot">•</span>
                  <span class="meta-warranty">{cat.warranty}</span>
                </div>
              </div>

              <div class="nav-dropdown-links-list">
                {cat.subLinks.map(sub => (
                  <a href={sub.href} class="dropdown-sub-link">
                    <div class="sub-link-row">
                      <span class="sub-link-title">{sub.name}</span>
                      <ArrowRight size={13} className="sub-link-arrow" />
                    </div>
                    <p class="sub-link-desc">{sub.desc}</p>
                  </a>
                ))}
              </div>

              <div class="nav-dropdown-footer">
                <a href={cat.href} class="dropdown-view-all">
                  <span>Explore Entire {cat.name} Page</span>
                  <ArrowRight size={13} />
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}

      <!-- Cost Calculator (Kept by default as requested) -->
      <a href="/invisible-grill-cost/" class="desktop-quick-link calc-quick-link">
        <span>Cost Calculator</span>
      </a>

      <!-- Contact Us (Kept by default as requested) -->
      <a href="/contact/" class="header-contact-btn">
        <span>CONTACT US</span>
      </a>

      <!-- Get A Quote (Kept by default as requested) -->
      <a href="/invisible-grill-cost/" class="btn btn-primary btn-sm header-quote-btn">
        <span>GET A QUOTE</span>
      </a>
    </div>
  </div>
</header>

<!-- Full-Screen Architectural Navigation Drawer (Matching User Reference) -->
<div id="arch-drawer-overlay" class="drawer-overlay" aria-hidden="true">
  <div class="drawer-panel">
    <!-- Drawer Header -->
    <div class="drawer-header">
      <div class="drawer-brand">
        <span class="drawer-logo">INVISPROTECT</span>
        <span class="drawer-tagline">ARCHITECTURAL SAFETY</span>
      </div>
      <button id="arch-drawer-close" type="button" class="drawer-close-btn" aria-label="Close Menu">
        <X size={22} />
      </button>
    </div>

    <!-- Drawer Columns (Left Navigation List + Right Dynamic Image Preview) -->
    <div class="drawer-content-grid">
      <!-- Left: Navigation Links matching user's screenshot -->
      <nav class="drawer-nav-column">
        <!-- Group 1: Primary Product Ecosystem with Direct Page Routing -->
        <div class="drawer-nav-group">
          <div class="drawer-cat-block">
            <a href="/invisible-grills/" class="drawer-nav-link primary-cat" data-preview="/images/hero-balcony.webp" data-title="SS316 Invisible Grills">
              Invisible Grills
            </a>
            <!-- Sub-categories nested inside Invisible Grills -->
            <div class="drawer-sublinks-nested">
              <a href="/balcony-invisible-grills/" class="drawer-sub-link" data-preview="/images/hero-balcony.webp" data-title="Balcony Invisible Grills">
                <span class="sub-dot"></span>
                <span>Balcony Invisible Grills</span>
              </a>
              <a href="/staircase-invisible-grills/" class="drawer-sub-link" data-preview="/images/staircase-invisible-grills.webp" data-title="Staircase Invisible Grills">
                <span class="sub-dot"></span>
                <span>Staircase Invisible Grills</span>
              </a>
              <a href="/window-invisible-grills/" class="drawer-sub-link" data-preview="/images/window-invisible-grills.webp" data-title="Windows Invisible Grills">
                <span class="sub-dot"></span>
                <span>Windows Invisible Grills</span>
              </a>
              <a href="/child-safety-invisible-grills/" class="drawer-sub-link" data-preview="/images/child-safety.webp" data-title="Child Safety Invisible Grills">
                <span class="sub-dot"></span>
                <span>Child Safety Invisible Grills</span>
              </a>
            </div>
          </div>

          <div class="drawer-cat-block">
            <a href="/safety-nets/" class="drawer-nav-link primary-cat" data-preview="/images/safety-net-balcony.webp" data-title="Core Safety Nets">
              Core Safety Nets
            </a>
            <!-- Sub-categories nested inside Core Safety Nets -->
            <div class="drawer-sublinks-nested">
              <a href="/child-safety-nets/" class="drawer-sub-link" data-preview="/images/child-safety.webp" data-title="Child Safety Nets">
                <span class="sub-dot"></span>
                <span>Child Safety Nets (Anti-Fall)</span>
              </a>
              <a href="/balcony-safety/" class="drawer-sub-link" data-preview="/images/safety-net-balcony.webp" data-title="Balcony Safety Nets">
                <span class="sub-dot"></span>
                <span>Balcony Safety Nets</span>
              </a>
              <a href="/staircase-safety-nets/" class="drawer-sub-link" data-preview="/images/balcony-safety.webp" data-title="Staircase Safety Nets">
                <span class="sub-dot"></span>
                <span>Staircase Safety Nets</span>
              </a>
              <a href="/building-safety-nets/" class="drawer-sub-link" data-preview="/images/building-safety-net.jpg" data-title="Building Perimeter Nets">
                <span class="sub-dot"></span>
                <span>Building Perimeter Nets</span>
              </a>
            </div>
          </div>

          <div class="drawer-cat-block">
            <a href="/duct-safety-nets/" class="drawer-nav-link primary-cat" data-preview="/images/construction-safety-net.jpg" data-title="Construction & Industrial Nets">
              Construction & Industrial
            </a>
            <div class="drawer-sublinks-nested">
              <a href="/construction-safety-nets/" class="drawer-sub-link" data-preview="/images/construction-safety-net.jpg" data-title="Construction Safety Nets">
                <span class="sub-dot"></span>
                <span>Construction Safety Nets</span>
              </a>
              <a href="/industrial-safety-nets/" class="drawer-sub-link" data-preview="/images/industrial-safety-net.jpg" data-title="Industrial Safety Nets">
                <span class="sub-dot"></span>
                <span>Industrial Debris Nets</span>
              </a>
              <a href="/terrace-safety-nets/" class="drawer-sub-link" data-preview="/images/terrace-top-net.jpg" data-title="Terrace Top Nets">
                <span class="sub-dot"></span>
                <span>Terrace Top Nets</span>
              </a>
              <a href="/car-parking-safety-nets/" class="drawer-sub-link" data-preview="/images/car-parking-net.jpg" data-title="Car Parking Safety Nets">
                <span class="sub-dot"></span>
                <span>Car Parking Safety Nets</span>
              </a>
            </div>
          </div>

          <div class="drawer-cat-block">
            <a href="/animals-birds-safety-nets/" class="drawer-nav-link primary-cat" data-preview="/images/pigeon-net.webp" data-title="Animals & Birds Safety Nets">
              Animal & Bird Protection
            </a>
            <div class="drawer-sublinks-nested">
              <a href="/pigeon-nets/" class="drawer-sub-link" data-preview="/images/pigeon-net.webp" data-title="Anti-Pigeon Nets">
                <span class="sub-dot"></span>
                <span>Anti-Pigeon Nets</span>
              </a>
              <a href="/bird-spikes/" class="drawer-sub-link" data-preview="/images/pigeon-net.webp" data-title="Stainless Steel Bird Spikes">
                <span class="sub-dot"></span>
                <span>Stainless Steel Bird Spikes</span>
              </a>
              <a href="/monkey-safety-nets/" class="drawer-sub-link" data-preview="/images/safety-net-balcony.webp" data-title="Monkey Safety Nets">
                <span class="sub-dot"></span>
                <span>Monkey Safety Nets</span>
              </a>
              <a href="/mosquito-safety-nets/" class="drawer-sub-link" data-preview="/images/window-invisible-grills.webp" data-title="Mosquito Safety Nets">
                <span class="sub-dot"></span>
                <span>Mosquito Safety Nets</span>
              </a>
            </div>
          </div>

          <div class="drawer-cat-block">
            <a href="/sports-nets/" class="drawer-nav-link primary-cat" data-preview="/images/sports-nets.webp" data-title="Specialty Sports Solutions">
              Specialty Solutions
            </a>
            <div class="drawer-sublinks-nested">
              <a href="/sports-practice-nets/" class="drawer-sub-link" data-preview="/images/sports-nets.webp" data-title="Sports Practice Nets">
                <span class="sub-dot"></span>
                <span>Sports Practice Nets</span>
              </a>
              <a href="/coconut-safety-nets/" class="drawer-sub-link" data-preview="/images/coconut-safety-net.jpg" data-title="Coconut Safety Nets">
                <span class="sub-dot"></span>
                <span>Coconut Safety Nets</span>
              </a>
              <a href="/swimming-pool-nets/" class="drawer-sub-link" data-preview="/images/swimming-pool-net.jpg" data-title="Swimming Pool Nets">
                <span class="sub-dot"></span>
                <span>Swimming Pool Nets</span>
              </a>
              <a href="/cloth-drying-hangers/" class="drawer-sub-link" data-preview="/images/cloth-drying-hanger.jpg" data-title="Balcony Cloth Drying Hangers">
                <span class="sub-dot"></span>
                <span>Cloth Drying Hangers</span>
              </a>
            </div>
          </div>
        </div>

        <div class="drawer-nav-divider"></div>

        <!-- Group 2: Philosophy, Craftsmanship & Exploration -->
        <div class="drawer-nav-group">
          <a href="/invisible-grill-cost/" class="drawer-nav-link highlight-accent" data-preview="/images/hero-balcony.webp" data-title="Cost Calculator">
            Online Cost Calculator
          </a>
          <a href="/#solutions-explorer" class="drawer-nav-link" data-preview="/images/balcony-safety.webp" data-title="Solutions Explorer">
            Solutions Explorer
          </a>
          <a href="/gallery/" class="drawer-nav-link" data-preview="/images/window-invisible-grills.webp" data-title="Real Installations">
            Real Installations
          </a>
          <a href="/materials/" class="drawer-nav-link" data-preview="/images/staircase-invisible-grills.webp" data-title="Materials & SS316 Specs">
            Materials & Specs
          </a>
          <a href="/about/" class="drawer-nav-link" data-preview="/images/invisible-grills-page.webp" data-title="Our Story">
            Our Story
          </a>
          <a href="/warranty/" class="drawer-nav-link accent-warranty" data-preview="/images/hero-balcony.webp" data-title="10-Year Direct Warranty Terms">
            Warranty Terms
          </a>
          <a href="/faq/" class="drawer-nav-link" data-preview="/images/safety-net-balcony.webp" data-title="Safety FAQ">
            Safety FAQ
          </a>
        </div>

        <div class="drawer-nav-divider"></div>

        <!-- Group 3: Advisory & Regional Operations -->
        <div class="drawer-nav-group footer-group">
          <a href="/contact/" class="drawer-info-link">
            <Phone size={16} color="#C2410C" />
            <span>Client Service Advisory</span>
          </a>

          <a href="/locations/" class="drawer-info-link">
            <Globe size={16} color="#64748B" />
            <span>Regional Operations · Telangana & Andhra Pradesh</span>
          </a>
        </div>
      </nav>

      <!-- Right: Architectural Preview Panel (Visible on Desktop) -->
      <div class="drawer-preview-column">
        <div class="preview-card">
          <div class="preview-img-box">
            <img
              id="drawer-preview-img"
              src="/images/hero-balcony.webp"
              alt="InvisProtect Architectural Safety System"
              loading="lazy"
            />
            <div class="preview-overlay">
              <span class="preview-badge">ARCHITECTURAL SPECIFICATION</span>
              <h4 id="drawer-preview-title">SS316 Invisible Grills</h4>
              <p id="drawer-preview-desc">Virgin Japanese SS316 marine alloy cables tested to 400+ kgf load with 98% open vista.</p>
            </div>
          </div>
          <div class="preview-meta">
            <div class="meta-item">
              <span class="meta-label">Starting Price</span>
              <span class="meta-val">₹190 / sq.ft</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Direct Warranty</span>
              <span class="meta-val">10 Years</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Society Approval</span>
              <span class="meta-val">100% RWA Approved</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Header Top Bar */
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(226, 232, 240, 0.85);
    height: 74px;
    display: flex;
    align-items: center;
  }

  .header-inner {
    width: 100%;
    max-width: 1680px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* Left Menu Trigger */
  .header-left {
    display: flex;
    align-items: center;
    min-width: 110px;
  }

  .menu-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem 0.6rem;
    border-radius: 6px;
    transition: opacity 0.2s ease;
  }

  .menu-trigger-btn:hover {
    opacity: 0.7;
  }

  .hamburger-icon {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 18px;
  }

  .hamburger-icon span {
    display: block;
    height: 2px;
    width: 100%;
    background: #0F172A;
    border-radius: 2px;
    transition: transform 0.2s ease;
  }

  .menu-label {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #0F172A;
    text-transform: uppercase;
  }

  /* Center Brand Logo */
  .header-center {
    text-align: center;
  }

  .brand-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
  }

  .brand-title {
    font-size: 1.18rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    color: #0F172A;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .brand-sub {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: #64748B;
    text-transform: uppercase;
    margin-top: 2px;
  }

  /* Right Quick Categories & Actions */
  .header-right {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    justify-content: flex-end;
    flex-wrap: nowrap;
  }

  /* Nav Dropdown on Hover */
  .nav-dropdown-item {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .nav-dropdown-item .desktop-quick-link {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    cursor: pointer;
  }

  .nav-chevron {
    color: #64748B;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
  }

  .nav-dropdown-item:hover .nav-chevron {
    transform: rotate(180deg);
    color: #0284C7;
  }

  .nav-dropdown-item:hover .desktop-quick-link {
    color: #0284C7;
    background: #F1F5F9;
  }

  /* Flyout Dropdown Panel */
  .nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    padding-top: 10px; /* Invisible hover bridge */
    z-index: 1050;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.22s;
  }

  /* Anchor dropdown to right for items near right boundary */
  .nav-dropdown-item:nth-last-of-type(-n+2) .nav-dropdown-menu {
    left: auto;
    right: 0;
    transform: translateY(8px);
  }

  .nav-dropdown-item:hover .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .nav-dropdown-item:nth-last-of-type(-n+2):hover .nav-dropdown-menu {
    transform: translateY(0);
  }

  .nav-dropdown-inner {
    width: 360px;
    background: #FFFFFF;
    border-radius: 16px;
    border: 1px solid #E2E8F0;
    box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.16), 0 0 0 1px rgba(0, 0, 0, 0.04);
    overflow: hidden;
    text-align: left;
  }

  .nav-dropdown-header {
    padding: 0.95rem 1.25rem 0.75rem 1.25rem;
    border-bottom: 1px solid #F1F5F9;
    background: #F8FAFC;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .dropdown-header-left {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .dropdown-cat-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: #0F172A;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .dropdown-cat-title:hover {
    color: #0284C7;
  }

  .dropdown-cat-badge {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 20px;
    border: 1px solid;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .dropdown-header-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.76rem;
    color: #64748B;
  }

  .meta-rate {
    font-weight: 800;
    color: #0284C7;
  }

  .meta-dot {
    opacity: 0.4;
  }

  .meta-warranty {
    font-weight: 600;
    color: #16A34A;
  }

