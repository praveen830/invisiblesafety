---
import { business } from '../data/business';
import { Phone, MessageCircle, ChevronDown, X, ArrowRight, ShieldCheck, MapPin } from 'lucide-react';

const coreServices = [
  {
    name: "Balcony Invisible Grills",
    href: "/invisible-grills/",
    desc: "2.0mm & 2.5mm stainless steel cables",
    badge: "Flagship"
  },
  {
    name: "Window & French Door Grills",
    href: "/window-invisible-grills/",
    desc: "Unobstructed panoramic daylight & child safety",
    badge: "Child-Safe"
  },
  {
    name: "High-Rise Balcony Safety Nets",
    href: "/safety-nets/",
    desc: "Weather-resistant durable polymer mesh",
    badge: "Popular"
  },
  {
    name: "Anti-Pigeon Nets & Spikes",
    href: "/pigeon-nets/",
    desc: "Humane bird deterrence & durable spikes",
    badge: "Bird-Proof"
  },
  {
    name: "Child Safety Grills & Nets",
    href: "/child-safety-invisible-grills/",
    desc: "Safety containment for toddlers & pets",
    badge: "Safety"
  },
  {
    name: "Ceiling Cloth Drying Hangers",
    href: "/cloth-drying-hangers/",
    desc: "Individual pull-down stainless steel space-saving pipes",
    badge: "Utility"
  }
];

const serviceCities = [
  { name: "Hyderabad", href: "/locations/hyderabad/", state: "Telangana", tag: "Central Operations" },
  { name: "Vizag (Visakhapatnam)", href: "/locations/visakhapatnam/", state: "Andhra Pradesh", tag: "Coastal Hub" },
  { name: "Vijayawada", href: "/locations/vijayawada/", state: "Andhra Pradesh", tag: "Urban Hub" },
  { name: "Amaravati", href: "/locations/amaravati/", state: "Andhra Pradesh", tag: "Capital Region" }
];
---

<header class="arch-header-wrapper" id="arch-header">
  <!-- 1. Slim Top Deep Royal Navy Utility Bar -->
  <div class="top-utility-bar">
    <div class="utility-container">
      <!-- Left: Cities Announcement -->
      <div class="utility-left">
        <!-- Desktop Full String (>=768px) -->
        <span class="utility-text-desktop">
          Serving Telangana &amp; Andhra Pradesh <span class="utility-sep">|</span> Architectural Residential Safety
        </span>
        <!-- Mobile Compact (<768px) -->
        <span class="utility-text-mobile">
          Telangana &amp; Andhra Pradesh
        </span>
      </div>

      <!-- Right: Direct Contact & WhatsApp Us Badge -->
      <div class="utility-right">
        <a href={`tel:${business.phoneRaw}`} class="utility-phone-link" aria-label={`Call ${business.phone}`}>
          <Phone size={12} className="utility-phone-icon" />
          <span class="phone-digits">{business.phone}</span>
        </a>

        <a
          href={`https://wa.me/${business.whatsapp}?text=Hello%20Invisible%20Safety%2C%20I%20would%20like%20to%20book%20a%20free%20site%20visit.`}
          target="_blank"
          rel="noopener noreferrer"
          class="utility-whatsapp-badge"
          aria-label="WhatsApp Us"
        >
          <MessageCircle size={12} className="utility-wa-icon" />
          <span>WhatsApp Us</span>
        </a>
      </div>
    </div>
  </div>

  <!-- 2. Clean White Sticky Navbar -->
  <div class="main-navbar">
    <div class="navbar-container">
      <!-- Left: Brand Logo & Subtitle -->
      <a href="/" class="brand-logo" aria-label="Invisiblesafety.in - Home">
        <span class="brand-mark">Invisiblesafety<span class="brand-tld">.in</span></span>
        <span class="brand-sub">Safety. Style. Peace of Mind.</span>
      </a>

      <!-- Center: Desktop Navigation Links & Dropdowns -->
      <nav class="desktop-nav" aria-label="Main Navigation">
        <a href="/" class="nav-link">Home</a>

        <!-- Services Dropdown (6 Core Services) -->
        <div class="nav-dropdown-item">
          <button class="nav-dropdown-toggle" aria-haspopup="true" aria-expanded="false">
            <span>Services</span>
            <ChevronDown size={14} className="dropdown-chevron" />
          </button>

          <div class="nav-dropdown-menu services-dropdown-menu">
            <div class="dropdown-header">
              <span class="dropdown-header-title">ARCHITECTURAL SAFETY SERVICES</span>
              <a href="/solutions/" class="dropdown-view-all">All Solutions →</a>
            </div>

            <div class="services-dropdown-grid">
              {coreServices.map((service) => (
                <a href={service.href} class="dropdown-card-item">
                  <div class="card-item-top">
                    <span class="card-item-title">{service.name}</span>
                    <span class="card-item-badge">{service.badge}</span>
                  </div>
                  <span class="card-item-desc">{service.desc}</span>
                </a>
              ))}
            </div>

            <div class="dropdown-footer-ribbon">
              <div class="footer-ribbon-item">
                <span class="ribbon-label">Quick Tools:</span>
                <a href="/visualizer/" class="ribbon-link">3D Balcony Visualizer</a>
                <span class="ribbon-sep">·</span>
                <a href="/invisible-grill-cost/" class="ribbon-link">Dynamic Cost Estimator</a>
              </div>
            </div>
          </div>
        </div>

        <a href="/gallery/" class="nav-link">Our Work</a>

        <!-- Locations Dropdown (7 Cities) -->
        <div class="nav-dropdown-item">
          <button class="nav-dropdown-toggle" aria-haspopup="true" aria-expanded="false">
            <span>Locations</span>
            <ChevronDown size={14} className="dropdown-chevron" />
          </button>

          <div class="nav-dropdown-menu locations-dropdown-menu">
            <div class="dropdown-header">
              <span class="dropdown-header-title">TELANGANA &amp; ANDHRA PRADESH SERVICE HUBS</span>
              <span class="dropdown-header-sub">Complimentary On-Site Survey</span>
            </div>

            <div class="locations-dropdown-grid">
              {serviceCities.map((city) => (
                <a href={city.href} class="location-item-link">
                  <div class="location-item-icon">
                    <MapPin size={14} />
                  </div>
                  <div class="location-item-text">
                    <span class="location-item-city">{city.name}</span>
                    <span class="location-item-state">{city.state} · {city.tag}</span>
                  </div>
                </a>
              ))}
            </div>

            <div class="locations-dropdown-footer">
              <p class="locations-footer-note">
                <ShieldCheck size={14} className="note-shield" />
                <span>Balcony safety installations for residential apartments and communities.</span>
              </p>
            </div>
          </div>
        </div>

        <a href="/about/" class="nav-link">About Us</a>
        <a href="/contact/" class="nav-link">Contact</a>
      </nav>

      <!-- Right: Desktop CTA & Mobile Hamburger -->
      <div class="navbar-right">
        <!-- Desktop CTA -->
        <a href="/contact/#quote" class="nav-cta-btn" aria-label="Book a Free Visit">
          <span>Book a Free Visit</span>
          <ArrowRight size={15} className="cta-arrow" />
        </a>

        <!-- Mobile Hamburger (48x48px min touch target) -->
        <button
          class="mobile-menu-btn"
          id="mobile-drawer-open-btn"
          aria-label="Open Navigation Menu"
          aria-expanded="false"
        >
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- 3. Accessible Slide-out Mobile Navigation Drawer (min-h-[48px] touch targets, zero overflow) -->
  <div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop" aria-hidden="true"></div>

  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <div class="drawer-header">
      <a href="/" class="brand-logo" aria-label="Invisiblesafety.in - Home">
        <span class="brand-mark">Invisiblesafety<span class="brand-tld">.in</span></span>
        <span class="brand-sub">Safety. Style. Peace of Mind.</span>
      </a>

      <button
        class="drawer-close-btn"
        id="mobile-drawer-close-btn"
        aria-label="Close Navigation Menu"
      >
        <X size={22} strokeWidth={2.2} />
      </button>
    </div>

    <div class="drawer-content">
      <!-- Trust Highlight Banner -->
      <div class="drawer-trust-banner">
        <div class="drawer-banner-title">
          <ShieldCheck size={15} />
          <span>Architectural Safety Solutions</span>
        </div>
        <p class="drawer-banner-desc">
          Professional safety grills and netting installations across Telangana &amp; Andhra Pradesh.
        </p>
      </div>

      <!-- Quick Main Links -->
      <div class="drawer-section">
        <a href="/" class="drawer-primary-link">Home</a>
      </div>

      <!-- 6 Core Services -->
      <div class="drawer-section">
        <span class="drawer-section-heading">ARCHITECTURAL SERVICES</span>
        <div class="drawer-links-list">
          {coreServices.map((service) => (
            <a href={service.href} class="drawer-service-link">
              <div class="drawer-service-info">
                <span class="drawer-service-name">{service.name}</span>
                <span class="drawer-service-desc">{service.desc}</span>
              </div>
              <span class="drawer-service-badge">{service.badge}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Planning Tools -->
      <div class="drawer-section">
        <span class="drawer-section-heading">INTERACTIVE TOOLS</span>
        <div class="drawer-tools-grid">
          <a href="/visualizer/" class="drawer-tool-pill">
            <span class="tool-pill-title">3D Balcony Visualizer</span>
            <span class="tool-pill-sub">Preview cable spacing</span>
          </a>
          <a href="/invisible-grill-cost/" class="drawer-tool-pill highlight">
            <span class="tool-pill-title">Cost Calculator</span>
            <span class="tool-pill-sub">Instant sq.ft estimation</span>
          </a>
        </div>
      </div>

      <!-- 7 Regional Cities -->
      <div class="drawer-section">
        <div class="drawer-section-header-row">
          <span class="drawer-section-heading">7 SERVICE CITIES</span>
          <a href="/locations/" class="drawer-view-all">All Cities →</a>
        </div>
        <div class="drawer-cities-grid">
          {serviceCities.map((city) => (
            <a href={city.href} class="drawer-city-pill">
              <span class="city-pill-name">{city.name}</span>
              <span class="city-pill-tag">{city.tag}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Brand & Information Links -->
      <div class="drawer-section">
        <span class="drawer-section-heading">EXPLORE &amp; PORTFOLIO</span>
        <div class="drawer-simple-links">
          <a href="/gallery/" class="drawer-touch-item">Our Work (Gallery)</a>
          <a href="/about/" class="drawer-touch-item">About Us</a>
          <a href="/materials/" class="drawer-touch-item">Materials & Specifications</a>
          <a href="/warranty/" class="drawer-touch-item">Service & Maintenance</a>
          <a href="/contact/" class="drawer-touch-item">Contact & Inquiries</a>
        </div>
      </div>
    </div>

    <!-- Drawer Sticky Bottom Actions -->
    <div class="drawer-footer-actions">
      <a
        href={`tel:${business.phoneRaw}`}
        class="drawer-action-btn btn-call"
        aria-label="Call Invisible Safety"
      >
        <Phone size={17} />
        <span>Call: {business.phone}</span>
      </a>

      <a
        href={`https://wa.me/${business.whatsapp}?text=Hello%20Invisible%20Safety%2C%20I%20would%20like%20to%20book%20a%20free%20site%20visit.`}
        target="_blank"
        rel="noopener noreferrer"
        class="drawer-action-btn btn-whatsapp"
        aria-label="WhatsApp Quote"
      >
        <MessageCircle size={17} />
        <span>WhatsApp Quote</span>
      </a>
    </div>
  </div>
</header>

<style>
  /* =========================================================================
     HEADER WRAPPER (Sticky, Zero Horizontal Overflow)
     ========================================================================= */
  .arch-header-wrapper {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 900;
    width: 100%;
    box-sizing: border-box;
    transition: transform 0.25s ease;
  }

  /* =========================================================================
     1. TOP SLIM UTILITY BAR (Deep Royal Navy #0F233D)
     ========================================================================= */
  .top-utility-bar {
    background-color: #0F233D;
    color: #FFFFFF;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    height: 34px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
  }

  .utility-container {
    max-width: 1360px;
    margin: 0 auto;
    width: 100%;
    padding: 0 clamp(1rem, 3vw, 2.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    gap: 1rem;
  }

  .utility-left {
    display: flex;
    align-items: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #F8FAFC;
    font-size: 11.5px;
    letter-spacing: 0.02em;
  }

  .utility-sep {
    color: #C6A66B;
    margin: 0 6px;
    font-weight: 700;
  }

  .utility-dot {
    color: rgba(255, 255, 255, 0.4);
    margin: 0 4px;
  }

  .utility-text-desktop {
    display: inline;
  }

  .utility-text-mobile {
    display: none;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .utility-right {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .utility-phone-link {
    color: #FFFFFF;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 600;
    transition: color 0.15s ease;
    white-space: nowrap;
  }

  .utility-phone-link:hover {
    color: #C6A66B;
  }

  .utility-phone-icon {
    color: #C6A66B;
    flex-shrink: 0;
  }

  .utility-whatsapp-badge {
    background-color: #25D366;
    color: #FFFFFF !important;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 9px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: 0 2px 6px rgba(37, 211, 102, 0.35);
    transition: background-color 0.15s ease, transform 0.15s ease;
    white-space: nowrap;
  }

  .utility-whatsapp-badge:hover {
    background-color: #20BA5A;
    transform: translateY(-1px);
  }

  .utility-wa-icon {
    flex-shrink: 0;
  }

  /* =========================================================================
     2. CLEAN WHITE STICKY NAVBAR (bg-white/95 backdrop-blur-md shadow-sm)
     ========================================================================= */
  .main-navbar {
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid #E2E8F0;
    box-shadow: 0 1px 3px 0 rgba(15, 35, 61, 0.04);
    height: 68px;
    display: flex;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
  }

  .navbar-container {
    max-width: 1360px;
    margin: 0 auto;
    width: 100%;
    height: 100%;
    padding: 0 clamp(1rem, 3vw, 2.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    gap: 1.5rem;
  }

  /* Brand Logo & Tagline */
  .brand-logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-mark {
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 1.5vw, 1.35rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #0F233D;
    line-height: 1.15;
    white-space: nowrap;
  }

  .brand-tld {
    color: #2D89EF;
    font-weight: 800;
  }

  .brand-sub {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    color: #64748B;
    letter-spacing: 0.04em;
    margin-top: 1px;
    white-space: nowrap;
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: #1E293B;
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 8px;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: #0F233D;
    background-color: #F0F5FA;
  }

  /* Dropdown Wrapper */
  .nav-dropdown-item {
    position: relative;
  }

  .nav-dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: #1E293B;
    padding: 8px 12px;
    border-radius: 8px;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .dropdown-chevron {
    color: #64748B;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-dropdown-item:hover .nav-dropdown-toggle,
  .nav-dropdown-item:focus-within .nav-dropdown-toggle {
    color: #0F233D;
    background-color: #F0F5FA;
  }

  .nav-dropdown-item:hover .dropdown-chevron,
  .nav-dropdown-item:focus-within .dropdown-chevron {
    transform: rotate(180deg);
    color: #0F233D;
  }

  /* Dropdown Flyout Menu */
  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;
    box-shadow: 0 16px 36px -4px rgba(15, 35, 61, 0.12), 0 4px 12px -2px rgba(15, 35, 61, 0.04);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.2s;
    z-index: 950;
    overflow: hidden;
  }

  .nav-dropdown-item:hover .nav-dropdown-menu,
  .nav-dropdown-item:focus-within .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  .dropdown-header {
    padding: 12px 18px;
    background: #FAFCFE;
    border-bottom: 1px solid #E2E8F0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .dropdown-header-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #C6A66B;
    text-transform: uppercase;
  }

  .dropdown-header-sub {
    font-size: 11px;
    color: #64748B;
    font-weight: 600;
  }

  .dropdown-view-all {
    font-size: 11px;
    font-weight: 700;
    color: #2D89EF;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .dropdown-view-all:hover {
    color: #0F233D;
  }

  /* Services Dropdown (2-Column Grid) */
  .services-dropdown-menu {
    width: 620px;
  }

  .services-dropdown-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding: 12px 14px;
    background: #FFFFFF;
  }

  .dropdown-card-item {
    display: flex;
    flex-direction: column;
    padding: 10px 12px;
    border-radius: 10px;
    background: #FAFCFE;
    border: 1px solid #F1F5F9;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .dropdown-card-item:hover {
    background: #F0F5FA;
    border-color: rgba(45, 137, 239, 0.35);
    transform: translateY(-1px);
  }

  .card-item-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin-bottom: 2px;
  }

  .card-item-title {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    color: #0F233D;
    line-height: 1.3;
  }

  .card-item-badge {
    font-size: 9.5px;
    font-weight: 700;
    color: #2D89EF;
    background: #EBF4FE;
    padding: 1px 6px;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .card-item-desc {
    font-size: 11px;
    color: #64748B;
    line-height: 1.35;
  }

  .dropdown-footer-ribbon {
    padding: 10px 18px;
    background: #FAFCFE;
    border-top: 1px solid #E2E8F0;
    font-size: 12px;
  }

  .footer-ribbon-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #64748B;
  }

  .ribbon-label {
    font-weight: 700;
    color: #0F233D;
  }

  .ribbon-link {
    color: #2D89EF;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .ribbon-link:hover {
    color: #0F233D;
    text-decoration: underline;
  }

  .ribbon-sep {
    color: #CBD5E1;
  }

  /* Locations Dropdown (2-Column Grid) */
  .locations-dropdown-menu {
    width: 480px;
  }

  .locations-dropdown-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    padding: 12px 14px;
    background: #FFFFFF;
  }

  .location-item-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    background: #FAFCFE;
    border: 1px solid #F1F5F9;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .location-item-link:hover {
    background: #F0F5FA;
    border-color: rgba(45, 137, 239, 0.35);
  }

  .location-item-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #F0F5FA;
    border: 1px solid rgba(45, 137, 239, 0.2);
    color: #2D89EF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .location-item-text {
    display: flex;
    flex-direction: column;
  }

  .location-item-city {
    font-size: 13px;
    font-weight: 700;
    color: #0F233D;
    line-height: 1.2;
  }

  .location-item-state {
    font-size: 10px;
    color: #64748B;
    margin-top: 1px;
  }

  .locations-dropdown-footer {
    padding: 10px 16px;
    background: #FAFCFE;
