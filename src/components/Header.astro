---
import { business } from '../data/business';
import { Menu, X, Phone, User, ArrowRight } from 'lucide-react';

const productsNav = [
  { name: "Balcony SS316 Invisible Grills", href: "/invisible-grills/", desc: "SS316 marine-grade tensile cable architecture" },
  { name: "High-Rise Safety Nets", href: "/safety-nets/", desc: "High-density polymer balcony and child protection" },
  { name: "Pigeon Exclusion & Spikes", href: "/pigeon-nets/", desc: "Humane anti-pigeon netting & stainless steel spikes" },
  { name: "Window & French Door Grills", href: "/window-invisible-grills/", desc: "Unobstructed ventilation and child safety" },
  { name: "Staircase Void Protection", href: "/staircase-invisible-grills/", desc: "Sleek vertical safety cables for duplex voids" },
  { name: "Construction & Industrial Nets", href: "/construction-safety-nets/", desc: "Heavy-duty perimeter and void containment" },
  { name: "Sports Practice & Turf Nets", href: "/sports-nets/", desc: "Cricket practice cages and multi-sport turf netting" }
];

const navigationLinks = [
  { name: "Invisible Grills", href: "/invisible-grills/" },
  { name: "Safety Nets", href: "/safety-nets/" },
  { name: "Visualizer", href: "/visualizer/" },
  { name: "Cost Estimator", href: "/invisible-grill-cost/" },
  { name: "Gallery", href: "/gallery/" },
  { name: "Locations", href: "/locations/" }
];
---

<header class="editorial-header" id="editorial-header">
  <div class="header-inner">
    <!-- Left: Minimalist Hamburger Menu Trigger -->
    <div class="header-left">
      <button class="editorial-menu-trigger" id="editorial-menu-btn" aria-label="Open Navigation Menu">
        <span class="menu-bar"></span>
        <span class="menu-bar"></span>
      </button>

      <!-- Desktop Nav Links -->
      <nav class="desktop-editorial-nav" aria-label="Main Navigation">
        {navigationLinks.slice(0, 3).map((link) => (
          <a href={link.href} class="nav-editorial-link">{link.name}</a>
        ))}
      </nav>
    </div>

    <!-- Center: Bold Spaced Architectural Brand Logo -->
    <div class="header-center">
      <a href="/" class="brand-editorial-link" aria-label="Invisible Safety - Architectural Home Safety">
        <span class="brand-primary-text">INVISIBLE SAFETY</span>
      </a>
    </div>

    <!-- Right: Minimal Inquiry / Contact Action -->
    <div class="header-right">
      <nav class="desktop-editorial-nav" aria-label="Secondary Navigation">
        {navigationLinks.slice(3).map((link) => (
          <a href={link.href} class="nav-editorial-link">{link.name}</a>
        ))}
      </nav>

      <a
        href="/contact/"
        class="editorial-icon-btn"
        aria-label="Direct Inquiry & Contact"
        title="Schedule Site Consultation"
      >
        <User size={18} strokeWidth={1.8} />
      </a>
    </div>
  </div>

  <!-- Minimalist Full-Screen / Slide-Out Luxury Drawer -->
  <div class="editorial-drawer" id="editorial-drawer" aria-hidden="true">
    <div class="drawer-header">
      <a href="/" class="brand-editorial-link" aria-label="Invisible Safety">
        <span class="brand-primary-text">INVISIBLE SAFETY</span>
      </a>
      <button class="drawer-close-btn" id="editorial-close-btn" aria-label="Close Menu">
        <X size={22} strokeWidth={1.5} />
      </button>
    </div>

    <div class="drawer-body">
      <div class="drawer-group">
        <span class="drawer-group-label">CURATED SAFETY COLLECTIONS</span>
        {productsNav.map((prod) => (
          <a href={prod.href} class="drawer-nav-item">
            <span class="drawer-item-title">{prod.name}</span>
            <span class="drawer-item-desc">{prod.desc}</span>
          </a>
        ))}
      </div>

      <div class="drawer-group">
        <span class="drawer-group-label">INTERACTIVE TOOLS &amp; ARCHITECTURE</span>
        <a href="/visualizer/" class="drawer-link-simple">Interactive Balcony 3D Visualizer</a>
        <a href="/invisible-grill-cost/" class="drawer-link-simple">Instant Cost Estimator &amp; Quote</a>
        <a href="/materials/" class="drawer-link-simple">Marine Grade SS316 Metallurgy</a>
        <a href="/gallery/" class="drawer-link-simple">Real Completed Projects Gallery</a>
        <a href="/locations/" class="drawer-link-simple">Regional Service Hubs (4 Cities)</a>
        <a href="/warranty/" class="drawer-link-simple">10-Year Written Warranty Terms</a>
        <a href="/why-invisible-safety/" class="drawer-link-simple">Brand Heritage &amp; Ethos</a>
        <a href="/faq/" class="drawer-link-simple">Frequently Asked Questions</a>
        <a href="/contact/" class="drawer-link-simple">Complimentary Doorstep Laser Survey</a>
      </div>

      <div class="drawer-footer">
        <p class="drawer-ethos-quote">
          "The art of architectural protection — securing your sanctuary with quiet elegance."
        </p>
        <a href={`tel:${business.phoneRaw}`} class="drawer-phone-btn">
          <Phone size={15} />
          <span>Call: {business.phone}</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* =========================================================================
     MINIMALIST TRANSLUCENT EDITORIAL HEADER
     ========================================================================= */
  .editorial-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 900;
    height: 64px;
    background: rgba(249, 248, 246, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .header-inner {
    max-width: 1360px;
    height: 100%;
    margin: 0 auto;
    padding: 0 clamp(1rem, 3.5vw, 2.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
  }

  /* Left: Hamburger + Left Nav */
  .header-left {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    flex: 1;
  }

  .editorial-menu-trigger {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px 4px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 26px;
    outline: none;
  }

  .menu-bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background: #0D0D0D;
    transition: transform 0.25s ease, width 0.25s ease;
  }

  .editorial-menu-trigger:hover .menu-bar:first-child {
    width: 26px;
  }

  .editorial-menu-trigger:hover .menu-bar:last-child {
    width: 18px;
  }

  /* Center: Brand Identity */
  .header-center {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    flex-shrink: 0;
  }

  .brand-editorial-link {
    text-decoration: none;
    color: #0D0D0D;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .brand-primary-text {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: clamp(0.85rem, 1.3vw, 1.12rem);
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #0D0D0D;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }

  .brand-editorial-link:hover .brand-primary-text {
    opacity: 0.8;
  }

  @media (max-width: 640px) {
    .header-left, .header-right {
      flex: 0 0 auto;
    }
    .brand-primary-text {
      font-size: 0.82rem;
      letter-spacing: 0.12em;
    }
  }

  /* Right: Right Nav + Icon */
  .header-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.75rem;
    flex: 1;
  }

  .desktop-editorial-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-editorial-link {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #334155;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-editorial-link:hover {
    color: #0D0D0D;
  }

  .editorial-icon-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0D0D0D;
    text-decoration: none;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background: rgba(255, 255, 255, 0.6);
    transition: all 0.25s ease;
  }

  .editorial-icon-btn:hover {
    background: #0D0D0D;
    color: #FFFFFF;
    border-color: #0D0D0D;
  }

  /* =========================================================================
     SLIDE-OVER LUXURY DRAWER
     ========================================================================= */
  .editorial-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 100%;
    max-width: 440px;
    background: #0D0D0D;
    color: #FFFFFF;
    z-index: 1000;
    transform: translateX(-100%);
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.35, 1);
    box-shadow: 20px 0 60px rgba(0, 0, 0, 0.6);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding: 1.5rem clamp(1.25rem, 3vw, 2rem);
    box-sizing: border-box;
  }

  .editorial-drawer.is-open {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 1.75rem;
  }

  .drawer-header .brand-primary-text {
    color: #FFFFFF;
    font-size: 0.95rem;
  }

  .drawer-close-btn {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .drawer-close-btn:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  .drawer-body {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .drawer-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .drawer-group-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--color-gold, #C5A880);
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .drawer-nav-item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    transition: transform 0.2s ease;
  }

  .drawer-nav-item:hover {
    transform: translateX(4px);
  }

  .drawer-item-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    color: #F8FAFC;
    margin-bottom: 0.2rem;
  }

  .drawer-item-desc {
    font-size: 0.78rem;
    color: #94A3B8;
  }

  .drawer-link-simple {
    font-size: 0.9rem;
    font-weight: 500;
    color: #E2E8F0;
    text-decoration: none;
    padding: 0.4rem 0;
    transition: color 0.2s ease;
  }

  .drawer-link-simple:hover {
    color: var(--color-gold, #C5A880);
  }

  .drawer-footer {
    margin-top: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .drawer-ethos-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.88rem;
    line-height: 1.6;
    color: #CBD5E1;
    margin: 0;
  }

  .drawer-phone-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 12px 20px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 2px;
    color: #FFFFFF;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: all 0.2s ease;
  }

  .drawer-phone-btn:hover {
    background: #FFFFFF;
    color: #0D0D0D;
  }

  @media (max-width: 1024px) {
    .desktop-editorial-nav {
      display: none;
    }
  }
</style>

<script>
  function setupEditorialDrawer() {
    const menuBtn = document.getElementById('editorial-menu-btn');
    const closeBtn = document.getElementById('editorial-close-btn');
    const drawer = document.getElementById('editorial-drawer');

    if (!drawer) return;

    menuBtn?.addEventListener('click', () => {
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    });

    const closeDrawer = () => {
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    closeBtn?.addEventListener('click', closeDrawer);

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
        closeDrawer();
      }
    });

    // Close when clicking links inside drawer
    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });
  }

  document.addEventListener('DOMContentLoaded', setupEditorialDrawer);
  document.addEventListener('astro:page-load', setupEditorialDrawer);
</script>
