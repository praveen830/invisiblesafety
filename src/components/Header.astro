---
import { business } from '../data/business';
import {
  Menu,
  X,
  Phone,
  ChevronDown,
  MapPin,
  ShieldCheck,
  CheckCircle2,
  ExternalLink,
  MessageCircle,
  Sparkles
} from 'lucide-react';

// 3 Main Service Dropdowns
const invisibleGrillsService = {
  title: "Invisible Grills",
  href: "/invisible-grills/",
  badge: "Bestseller",
  items: [
    { name: "Balcony SS316 Invisible Grills", href: "/balcony-invisible-grills/", desc: "SS316 marine-grade tensile cable architecture for high-rises" },
    { name: "Window & French Door Grills", href: "/window-invisible-grills/", desc: "Unobstructed ventilation and child safety" },
    { name: "Child Safety Invisible Grills", href: "/child-safety-invisible-grills/", desc: "50mm calibrated spacing for toddler protection" },
    { name: "Staircase Void Protection Grills", href: "/staircase-invisible-grills/", desc: "Vertical tension cables for duplex voids" },
    { name: "Virgin SS316 Metallurgy", href: "/materials/", desc: "Japanese AISI 316 steel with DuPont nylon casing" },
    { name: "Invisible Grill Cost Estimator", href: "/invisible-grill-cost/", desc: "Instant area and quote calculator" }
  ]
};

const safetyNetsService = {
  title: "Safety Nets",
  href: "/safety-nets/",
  badge: "High Density",
  items: [
    { name: "High-Rise Balcony Safety Nets", href: "/balcony-safety/", desc: "Garware virgin HDPE whole-balcony containment" },
    { name: "Child & Toddler Safety Nets", href: "/child-safety-nets/", desc: "Heavy-duty anti-fall barrier for young children & pets" },
    { name: "Building Duct & Shaft Nets", href: "/duct-safety-nets/", desc: "Enclosures for building voids and utility duct shafts" },
    { name: "Construction & Industrial Nets", href: "/construction-safety-nets/", desc: "Heavy-duty worker fall arrest and debris catch rigging" },
    { name: "Terrace & Swimming Pool Nets", href: "/terrace-safety-nets/", desc: "Perimeter fall prevention for rooftop decks & pools" },
    { name: "Sports & Cricket Practice Nets", href: "/sports-nets/", desc: "High-velocity cricket pitches and multi-sport enclosures" }
  ]
};

const birdProtectionService = {
  title: "Bird Protection",
  href: "/bird-protection/",
  badge: "Humane",
  items: [
    { name: "Anti-Pigeon Safety Nets", href: "/pigeon-nets/", desc: "0.7mm translucent nylon & HDPE mesh for balconies & ledges" },
    { name: "SS304 Stainless Steel Bird Spikes", href: "/bird-spikes/", desc: "Marine-grade spikes on UV-stabilized polycarbonate base" },
    { name: "Humane Bird & Animal Deterrence", href: "/bird-protection/", desc: "Clean balconies without harm to birds or skyline view" },
    { name: "Anti-Monkey Balcony Enclosures", href: "/monkey-safety-nets/", desc: "Heavy gauge containment to repel monkeys" },
    { name: "Micro-Mesh Mosquito Nets", href: "/mosquito-safety-nets/", desc: "Insect-proof fine mesh with complete airflow" }
  ]
};

// 4 State Location Switcher
const states = [
  {
    id: "bengaluru",
    name: "Bengaluru",
    state: "Karnataka",
    tagline: "Metro high-rises & tech parks",
    hubs: "Whitefield, Indiranagar, HSR Layout, Koramangala, Bellandur, Electronic City, Sarjapur",
    href: "/locations/"
  },
  {
    id: "telangana",
    name: "Telangana",
    state: "Hyderabad & Secunderabad",
    tagline: "High-rise towers & gated villas",
    hubs: "Financial District, Gachibowli, HITEC City, Kokapet, Kondapur, Madhapur, Jubilee Hills",
    href: "/locations/hyderabad/"
  },
  {
    id: "andhra-pradesh",
    name: "Andhra Pradesh",
    state: "Vizag, Vijayawada & Amaravati",
    tagline: "Coastal corrosion-proof SS316 & urban hubs",
    hubs: "Beach Road, MVP Colony, Madhurawada, Benz Circle, Tadepalli, Mangalagiri",
    href: "/locations/visakhapatnam/"
  },
  {
    id: "kerala",
    name: "Kerala",
    state: "Kochi, Trivandrum & Kozhikode",
    tagline: "Coastal humidity & heavy monsoon protection",
    hubs: "Marine Drive, Kakkanad, Edappally, Panampilly Nagar, Kaloor, Aluva",
    href: "/locations/"
  }
];
---

<header class="coastal-header" id="main-header">
  <div class="header-inner">
    <!-- Brand Logo: Soft Light Navy Blue (#1E3A5F) -->
    <div class="header-brand-wrap">
      <a href="/" class="brand-link" aria-label="Invisible Safety - Home">
        <div class="brand-icon-shield">
          <ShieldCheck size={22} className="shield-svg" />
        </div>
        <div class="brand-text-block">
          <span class="brand-name">INVISIBLE SAFETY</span>
          <span class="brand-subtext">ARCHITECTURAL HOME PROTECTION</span>
        </div>
      </a>
    </div>

    <!-- Desktop Navigation: 3 Main Service Dropdowns + Interactive Tools -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <!-- Dropdown 1: Invisible Grills -->
      <div class="nav-dropdown-wrapper">
        <button type="button" class="nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          <span>Invisible Grills</span>
          <ChevronDown size={14} className="dropdown-chevron" />
        </button>
        <div class="nav-dropdown-menu">
          <div class="dropdown-header-strip">
            <span class="dropdown-category-title">SS316 MARINE INVISIBLE GRILLS</span>
            <a href="/invisible-grills/" class="dropdown-view-all">All Invisible Grills &rarr;</a>
          </div>
          <div class="dropdown-items-grid">
            {invisibleGrillsService.items.map((item) => (
              <a href={item.href} class="dropdown-item">
                <span class="dropdown-item-title">{item.name}</span>
                <span class="dropdown-item-desc">{item.desc}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Dropdown 2: Safety Nets -->
      <div class="nav-dropdown-wrapper">
        <button type="button" class="nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          <span>Safety Nets</span>
          <ChevronDown size={14} className="dropdown-chevron" />
        </button>
        <div class="nav-dropdown-menu">
          <div class="dropdown-header-strip">
            <span class="dropdown-category-title">HIGH-DENSITY SAFETY NETS</span>
            <a href="/safety-nets/" class="dropdown-view-all">All Safety Nets &rarr;</a>
          </div>
          <div class="dropdown-items-grid">
            {safetyNetsService.items.map((item) => (
              <a href={item.href} class="dropdown-item">
                <span class="dropdown-item-title">{item.name}</span>
                <span class="dropdown-item-desc">{item.desc}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Dropdown 3: Bird Protection -->
      <div class="nav-dropdown-wrapper">
        <button type="button" class="nav-dropdown-trigger" aria-expanded="false" aria-haspopup="true">
          <span>Bird Protection</span>
          <ChevronDown size={14} className="dropdown-chevron" />
        </button>
        <div class="nav-dropdown-menu">
          <div class="dropdown-header-strip">
            <span class="dropdown-category-title">ANTI-PIGEON &amp; BIRD EXCLUSION</span>
            <a href="/bird-protection/" class="dropdown-view-all">All Bird Protection &rarr;</a>
          </div>
          <div class="dropdown-items-grid">
            {birdProtectionService.items.map((item) => (
              <a href={item.href} class="dropdown-item">
                <span class="dropdown-item-title">{item.name}</span>
                <span class="dropdown-item-desc">{item.desc}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Quick Nav Links -->
      <a href="/visualizer/" class="nav-link">3D Visualizer</a>
      <a href="/invisible-grill-cost/" class="nav-link">Cost Calculator</a>
      <a href="/gallery/" class="nav-link">Gallery</a>
    </nav>

    <!-- Header Actions: 4 State Location Switcher + Warm Peach-Gold Call CTA -->
    <div class="header-actions">
      <!-- 4 State Location Switcher -->
      <div class="location-switcher-wrap" id="location-switcher-wrap">
        <button
          type="button"
          class="location-switcher-btn"
          id="location-switcher-btn"
          aria-expanded="false"
          aria-haspopup="true"
          title="Switch installation state / city"
        >
          <MapPin size={15} className="text-cyan" />
          <span class="location-btn-label" id="current-location-text">Telangana</span>
          <ChevronDown size={12} className="loc-chevron" />
        </button>

        <!-- Dropdown Menu for 4 States -->
        <div class="location-dropdown-panel" id="location-dropdown-panel">
          <div class="loc-dropdown-header">
            <span>SELECT REGIONAL HUB (4 STATES)</span>
          </div>
          <div class="loc-dropdown-list">
            {states.map((st) => (
              <button
                type="button"
                class="loc-option-btn"
                data-state-id={st.id}
                data-state-name={st.name}
                data-state-href={st.href}
              >
                <div class="loc-option-top">
                  <span class="loc-state-name">{st.name}</span>
                  <span class="loc-region-tag">{st.state}</span>
                </div>
                <span class="loc-sub-hubs">{st.hubs}</span>
              </button>
            ))}
          </div>
          <div class="loc-dropdown-footer">
            <a href="/locations/" class="loc-view-all-link">
              <span>View all regional installation hubs</span>
              <ExternalLink size={12} />
            </a>
          </div>
        </div>
      </div>

      <!-- Direct Call CTA: Warm Peach-Gold Gradient with Dark Navy Bold Text -->
      <a
        href={`tel:${business.phoneRaw}`}
        class="header-call-btn"
        aria-label="Call +91 83097 55398"
        title="Direct phone consultation"
      >
        <Phone size={15} className="phone-icon-spin" />
        <span class="call-btn-text">Call: {business.phone}</span>
      </a>

      <!-- Mobile Hamburger Trigger -->
      <button
        type="button"
        class="mobile-menu-trigger"
        id="mobile-menu-trigger"
        aria-label="Toggle navigation menu"
      >
        <Menu size={22} id="hamburger-icon" />
        <X size={22} id="close-icon" class="hidden" />
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu (Responsive Coastal Theme) -->
  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-inner">
      <!-- 4 State Switcher for Mobile -->
      <div class="mobile-state-section">
        <span class="mobile-section-heading">SELECT YOUR STATE / HUB</span>
        <div class="mobile-state-chips">
          {states.map((st) => (
            <button
              type="button"
              class="mobile-state-chip"
              data-state-id={st.id}
              data-state-name={st.name}
            >
              <MapPin size={13} />
              <span>{st.name}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- 3 Main Service Accordions for Mobile -->
      <div class="mobile-services-section">
        <span class="mobile-section-heading">CORE SAFETY SERVICES</span>

        <!-- Invisible Grills Mobile Accordion -->
        <details class="mobile-accordion">
          <summary class="mobile-summary">
            <span>SS316 Invisible Grills</span>
            <ChevronDown size={16} />
          </summary>
          <div class="mobile-sublinks">
            <a href="/invisible-grills/" class="mobile-sublink font-bold text-cyan-600">&bull; All Invisible Grills Overview</a>
            {invisibleGrillsService.items.map((item) => (
              <a href={item.href} class="mobile-sublink">{item.name}</a>
            ))}
          </div>
        </details>

        <!-- Safety Nets Mobile Accordion -->
        <details class="mobile-accordion">
          <summary class="mobile-summary">
            <span>Certified Safety Nets</span>
            <ChevronDown size={16} />
          </summary>
          <div class="mobile-sublinks">
            <a href="/safety-nets/" class="mobile-sublink font-bold text-cyan-600">&bull; All Safety Nets Overview</a>
            {safetyNetsService.items.map((item) => (
              <a href={item.href} class="mobile-sublink">{item.name}</a>
            ))}
          </div>
        </details>

        <!-- Bird Protection Mobile Accordion -->
        <details class="mobile-accordion">
          <summary class="mobile-summary">
            <span>Bird &amp; Pigeon Protection</span>
            <ChevronDown size={16} />
          </summary>
          <div class="mobile-sublinks">
            <a href="/bird-protection/" class="mobile-sublink font-bold text-cyan-600">&bull; All Bird Protection Overview</a>
            {birdProtectionService.items.map((item) => (
              <a href={item.href} class="mobile-sublink">{item.name}</a>
            ))}
          </div>
        </details>
      </div>

      <!-- Quick Links -->
      <div class="mobile-quick-links">
        <span class="mobile-section-heading">TOOLS &amp; ESTIMATORS</span>
        <a href="/visualizer/" class="mobile-direct-link">Interactive 3D Balcony Visualizer</a>
        <a href="/invisible-grill-cost/" class="mobile-direct-link">Instant Cost &amp; Price Calculator</a>
        <a href="/gallery/" class="mobile-direct-link">Real Completed Project Gallery</a>
        <a href="/warranty/" class="mobile-direct-link">10-Year Written Warranty Certificate</a>
        <a href="/why-invisible-safety/" class="mobile-direct-link">Why Invisible Safety Heritage</a>
        <a href="/faq/" class="mobile-direct-link">Frequently Asked Questions</a>
        <a href="/contact/" class="mobile-direct-link">Contact &amp; Laser Survey Booking</a>
      </div>

      <!-- Mobile CTA Buttons (Call & WhatsApp) -->
      <div class="mobile-bottom-actions">
        <a href={`tel:${business.phoneRaw}`} class="mobile-action-call">
          <Phone size={17} />
          <span>Call: {business.phone}</span>
        </a>
        <a
          href={`https://wa.me/${business.whatsapp}?text=Hello%20Invisible%20Safety%2C%20I%20am%20interested%20in%20a%20site%20measurement%20survey.`}
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-action-wa"
          id="mobile-drawer-wa"
        >
          <MessageCircle size={18} />
          <span>Chat on WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* =========================================================================
     STICKY CONVERSION NAVBAR (Coastal Architectural Palette)
     ========================================================================= */
  .coastal-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    height: 72px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid #D8E6F3;
    box-shadow: 0 4px 20px -2px rgba(30, 58, 95, 0.05);
    transition: background-color 0.25s ease, box-shadow 0.25s ease;
  }

  .header-inner {
    max-width: 1360px;
    height: 100%;
    margin: 0 auto;
    padding: 0 clamp(1rem, 3.5vw, 2.5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    box-sizing: border-box;
  }

  /* Brand Logo */
  .header-brand-wrap {
    flex-shrink: 0;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: inherit;
  }

  .brand-icon-shield {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: #EBF3FA;
    border: 1px solid #D8E6F3;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0284C7;
    transition: all 0.25s ease;
  }

  .brand-link:hover .brand-icon-shield {
    background: #0284C7;
    color: #FFFFFF;
    border-color: #0284C7;
  }

  .brand-text-block {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.18rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #1E3A5F;
    line-height: 1.1;
  }

  .brand-subtext {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #64748B;
    text-transform: uppercase;
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  @media (max-width: 1080px) {
    .desktop-nav {
      display: none;
    }
  }

  .nav-link {
    font-size: 0.92rem;
    font-weight: 600;
    color: #334155;
    text-decoration: none;
    padding: 0.5rem 0.65rem;
    border-radius: 6px;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .nav-link:hover {
    color: #0284C7;
    background: #EBF3FA;
  }

  /* Nav Dropdown Trigger & Panel */
  .nav-dropdown-wrapper {
    position: relative;
  }

  .nav-dropdown-trigger {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 600;
    color: #1E3A5F;
    background: transparent;
    border: none;
    padding: 0.5rem 0.65rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .nav-dropdown-trigger:hover,
  .nav-dropdown-wrapper:hover .nav-dropdown-trigger {
    color: #0284C7;
    background: #EBF3FA;
  }

  .dropdown-chevron {
    transition: transform 0.2s ease;
    color: #64748B;
  }

  .nav-dropdown-wrapper:hover .dropdown-chevron {
    transform: rotate(180deg);
    color: #0284C7;
  }

  .nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 480px;
    background: #FFFFFF;
    border: 1px solid #D8E6F3;
    border-radius: 12px;
    padding: 1rem;
    box-shadow: 0 12px 36px -4px rgba(30, 58, 95, 0.14);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1010;
  }

  .nav-dropdown-wrapper:hover .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-header-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.65rem;
    margin-bottom: 0.65rem;
    border-bottom: 1px solid #EBF3FA;
  }

  .dropdown-category-title {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #0284C7;
  }

  .dropdown-view-all {
    font-size: 0.78rem;
    font-weight: 700;
    color: #1E3A5F;
    text-decoration: none;
  }

  .dropdown-view-all:hover {
    color: #0284C7;
  }

  .dropdown-items-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
  }

  .dropdown-item {
    display: flex;
    flex-direction: column;
    padding: 0.65rem 0.75rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .dropdown-item:hover {
    background: #EBF3FA;
    transform: translateY(-1px);
  }

  .dropdown-item-title {
    font-size: 0.86rem;
    font-weight: 700;
    color: #1E3A5F;
    margin-bottom: 0.15rem;
  }

  .dropdown-item-desc {
    font-size: 0.75rem;
    color: #64748B;
    line-height: 1.35;
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* 4 State Location Switcher */
  .location-switcher-wrap {
    position: relative;
  }

  .location-switcher-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    background: #EBF3FA;
    border: 1px solid #D8E6F3;
    border-radius: 9999px;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    color: #1E3A5F;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .location-switcher-btn:hover {
    background: #E0F2FE;
    border-color: #0284C7;
    color: #0284C7;
  }

  .loc-chevron {
    color: #64748B;
    transition: transform 0.2s ease;
  }

  .location-switcher-wrap.is-open .loc-chevron {
    transform: rotate(180deg);
  }

  .location-dropdown-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 360px;
    background: #FFFFFF;
    border: 1px solid #D8E6F3;
    border-radius: 12px;
    padding: 0.85rem;
    box-shadow: 0 12px 36px -4px rgba(30, 58, 95, 0.15);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1020;
  }

  .location-switcher-wrap.is-open .location-dropdown-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .loc-dropdown-header {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #64748B;
    padding: 0.25rem 0.5rem 0.65rem 0.5rem;
    border-bottom: 1px solid #EBF3FA;
    margin-bottom: 0.5rem;
  }

  .loc-dropdown-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .loc-option-btn {
    display: flex;
    flex-direction: column;
    text-align: left;
    width: 100%;
    padding: 0.6rem 0.75rem;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .loc-option-btn:hover,
  .loc-option-btn.active {
    background: #EBF3FA;
    border-color: #0284C7;
  }

  .loc-option-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.15rem;
  }

  .loc-state-name {
    font-size: 0.92rem;
    font-weight: 700;
    color: #1E3A5F;
  }

  .loc-region-tag {
    font-size: 0.72rem;
    font-weight: 600;
    color: #0284C7;
  }

  .loc-sub-hubs {
    font-size: 0.72rem;
    color: #64748B;
    line-height: 1.3;
  }

  .loc-dropdown-footer {
    padding-top: 0.65rem;
    margin-top: 0.5rem;
    border-top: 1px solid #EBF3FA;
    text-align: center;
  }

  .loc-view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #0284C7;
    text-decoration: none;
  }

  /* Direct Call CTA: Warm Peach-Gold Gradient with Dark Navy Bold Text */
  .header-call-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
    color: #0F1E36 !important;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    padding: 0.55rem 1.15rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid #F59E0B;
    box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .header-call-btn:hover {
    background: linear-gradient(135deg, #FBBF24 0%, #EA580C 100%);
    color: #0F1E36 !important;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(245, 158, 11, 0.45);
    border-color: #FBBF24;
