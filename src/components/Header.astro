  /* Mobile Hamburger Button */
  .mobile-menu-trigger {
    display: none;
    background: #EBF3FA;
    border: 1px solid #D8E6F3;
    border-radius: 8px;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    color: #1E3A5F;
    cursor: pointer;
  }

  @media (max-width: 1080px) {
    .mobile-menu-trigger {
      display: flex;
    }
  }

  /* Mobile Slide-in Drawer */
  .mobile-drawer {
    position: fixed;
    top: 72px;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(15, 30, 54, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .mobile-drawer.is-open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-drawer-inner {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 88%;
    max-width: 380px;
    background: #FFFFFF;
    overflow-y: auto;
    padding: 1.5rem;
    box-shadow: -10px 0 30px rgba(0, 0, 0, 0.2);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mobile-section-heading {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: #0284C7;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.65rem;
  }

  .mobile-state-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .mobile-state-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    background: #EBF3FA;
    border: 1px solid #D8E6F3;
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 700;
    color: #1E3A5F;
    cursor: pointer;
  }

  .mobile-state-chip.active {
    background: #0284C7;
    color: #FFFFFF;
    border-color: #0284C7;
  }

  .mobile-accordion {
    border: 1px solid #D8E6F3;
    border-radius: 8px;
    margin-bottom: 0.65rem;
    overflow: hidden;
  }

  .mobile-summary {
    padding: 0.85rem 1rem;
    font-weight: 700;
    color: #1E3A5F;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
    background: #F8FAFC;
  }

  .mobile-summary::-webkit-details-marker {
    display: none;
