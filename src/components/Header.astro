  }

  .mobile-quick-links {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .mobile-direct-link {
    font-size: 0.88rem;
    font-weight: 600;
    color: #1E3A5F;
    text-decoration: none;
    padding: 0.35rem 0;
  }

  .mobile-direct-link:hover {
    color: #0284C7;
  }

  .mobile-bottom-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid #EBF3FA;
  }

  .mobile-action-call {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
    color: #0F1E36 !important;
    font-weight: 800;
    height: 48px;
    border-radius: 8px;
    text-decoration: none;
  }

  .mobile-action-wa {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: #25D366;
    color: #FFFFFF !important;
    font-weight: 700;
    height: 48px;
    border-radius: 8px;
    text-decoration: none;
  }

  .hidden {
    display: none !important;
  }
</style>

<script>
  function setupHeaderInteractivity() {
    // Location Switcher Logic
    const switcherWrap = document.getElementById('location-switcher-wrap');
    const switcherBtn = document.getElementById('location-switcher-btn');
    const locationText = document.getElementById('current-location-text');
    const optionBtns = document.querySelectorAll('.loc-option-btn');
    const mobileChips = document.querySelectorAll('.mobile-state-chip');

    // Retrieve stored location or default to Telangana
    let currentLocation = localStorage.getItem('invis_active_location') || 'Telangana';

    function setLocation(locName: string, shouldPersist = true) {
      currentLocation = locName;
      if (shouldPersist) {
        localStorage.setItem('invis_active_location', locName);
      }
      if (locationText) {
        locationText.textContent = locName;
      }

      // Update active classes
      optionBtns.forEach(btn => {
        if (btn.getAttribute('data-state-name') === locName) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      mobileChips.forEach(chip => {
        if (chip.getAttribute('data-state-name') === locName) {
          chip.classList.add('active');
        } else {
          chip.classList.remove('active');
        }
      });

      // Dispatch custom event to notify Floating WhatsApp & other components
      window.dispatchEvent(new CustomEvent('invis:location-change', {
        detail: { location: locName }
      }));
    }

    // Initialize with current location
    setLocation(currentLocation, false);

    // Toggle dropdown panel
    if (switcherBtn && switcherWrap) {
      switcherBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        switcherWrap.classList.toggle('is-open');
      });

      document.addEventListener('click', (e) => {
        if (!switcherWrap.contains(e.target as Node)) {
          switcherWrap.classList.remove('is-open');
        }
      });
    }

    // Click handler for desktop location options
    optionBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const stateName = btn.getAttribute('data-state-name');
        if (stateName) {
          setLocation(stateName);
          if (switcherWrap) switcherWrap.classList.remove('is-open');
        }
      });
    });

    // Click handler for mobile chips
    mobileChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const stateName = chip.getAttribute('data-state-name');
        if (stateName) {
          setLocation(stateName);
        }
      });
    });

    // Mobile Hamburger Toggle
    const mobileTrigger = document.getElementById('mobile-menu-trigger');
    const mobileDrawer = document.getElementById('mobile-drawer');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (mobileTrigger && mobileDrawer && hamburgerIcon && closeIcon) {
      mobileTrigger.addEventListener('click', () => {
        const isOpen = mobileDrawer.classList.toggle('is-open');
        mobileDrawer.setAttribute('aria-hidden', String(!isOpen));
        if (isOpen) {
          hamburgerIcon.classList.add('hidden');
          closeIcon.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        } else {
          hamburgerIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
          document.body.style.overflow = '';
        }
      });

      // Close drawer on background click
      mobileDrawer.addEventListener('click', (e) => {
        if (e.target === mobileDrawer) {
          mobileDrawer.classList.remove('is-open');
          mobileDrawer.setAttribute('aria-hidden', 'true');
          hamburgerIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
          document.body.style.overflow = '';
        }
      });
    }
  }

  document.addEventListener('DOMContentLoaded', setupHeaderInteractivity);
  document.addEventListener('astro:page-load', setupHeaderInteractivity);
</script>
