<script>
  const toggleBtn = document.getElementById('arch-menu-toggle');
  const closeBtn = document.getElementById('arch-drawer-close');
  const overlay = document.getElementById('arch-drawer-overlay');
  const previewImg = document.getElementById('drawer-preview-img') as HTMLImageElement;
  const previewTitle = document.getElementById('drawer-preview-title');
  const previewDesc = document.getElementById('drawer-preview-desc');
  const navLinks = document.querySelectorAll('.drawer-nav-link');

  const descriptions: Record<string, string> = {
    "SS316 Invisible Grills": "Virgin Japanese SS316 marine alloy cables tested to 400+ kgf load with 98% open vista.",
    "Animals & Birds Safety Nets": "0.7mm translucent monofilament bird exclusion & high-tensile pet balcony netting from ₹28/sq.ft.",
    "Child Safety Nets": "50mm anti-head entrapment spacing and zero climbable footholds for toddlers from ₹35/sq.ft.",
    "Core Safety Nets": "Certified high-density virgin polymer mesh offering reliable whole-balcony anti-fall security from ₹25/sq.ft.",
    "Construction & Industrial Nets": "Industrial heavy-ply duct covers and building plumbing shaft safety nets from ₹22/sq.ft.",
    "Specialty Sports Solutions": "Heavy-duty UV-stabilized cricket practice cages and ball containment enclosures from ₹18/sq.ft.",
    "Solutions Explorer": "Find your exact safety system based on your space requirement.",
    "The Lifestyle": "Safety designed around modern high-rise living and thoughtful home architecture.",
    "The Craftsmanship": "8-step precision installation protocol by certified company technicians.",
    "Our Story": "Architectural safety without compromising the view.",
    "10-Year Direct Warranty Terms": "Official 10-year zero rust guarantee and structural warranty coverage.",
    "Safety FAQ": "Answers to apartment permissions, wire gauge, and load safety questions."
  };

  function openDrawer() {
    if (overlay) {
      overlay.classList.add('active');
      overlay.setAttribute('aria-hidden', 'false');
      toggleBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeDrawer() {
    if (overlay) {
      overlay.classList.remove('active');
      overlay.setAttribute('aria-hidden', 'true');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
  }

  toggleBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);

  overlay?.addEventListener('click', (e) => {
    if (e.target === overlay) {
      closeDrawer();
    }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay?.classList.contains('active')) {
      closeDrawer();
    }
  });

  navLinks.forEach((link) => {
    link.addEventListener('mouseenter', () => {
      const preview = link.getAttribute('data-preview');
      const title = link.getAttribute('data-title');
      if (preview && previewImg) {
        previewImg.src = preview;
      }
      if (title && previewTitle) {
        previewTitle.textContent = title;
        if (previewDesc && descriptions[title]) {
          previewDesc.textContent = descriptions[title];
        }
      }
    });

    link.addEventListener('click', () => {
      closeDrawer();
    });
  });
</script>
