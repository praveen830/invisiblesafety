---
import { ArrowRight, X, ShieldCheck, Check, Sparkles } from 'lucide-react';

interface Props {
  className?: string;
  isStandalone?: boolean;
}

const { className = "", isStandalone = false } = Astro.props;

/**
 * High-Converting SEO-Direct Divisions:
 * 1. SS316 MARINE INVISIBLE GRILLS -> /solutions/invisible-grills
 * 2. ANTI-PIGEON NETS & BIRD SPIKES -> /solutions/bird-protection
 * 3. BALCONY & CHILD SAFETY NETS -> /solutions/safety-nets
 * 4. SPORTS PRACTICE & TURF NETS -> /solutions/sports-nets
 * 5. COMMERCIAL & INDUSTRIAL SAFETY NETS -> /solutions/construction-safety
 */
const collections = [
  {
    id: "invisible-threshold",
    eyebrow: "FLAGSHIP FALL PROTECTION",
    title: "SS316 MARINE INVISIBLE GRILLS",
    subtitle: "Parallel vertical SS316 2mm marine cables anchored into structural tracks with 98% daylight clarity.",
    image: "/images/category-invisible-grills.jpg",
    mobileImage: "/images/category-invisible-grills.jpg",
    link: "/invisible-grills/",
    specs: {
      material: "Virgin Japanese SS316 Marine-Grade Stainless Steel",
      tensileLoad: "400+ kgf Breaking Strength per Cable",
      spacing: "50mm Child-Safe or 75mm Expansive Skyline View",
      warranty: "10-Year Direct Written Guarantee"
    },
    solutions: [
      { name: "Balcony Invisible Grills", href: "/balcony-invisible-grills/" },
      { name: "French Window Invisible Grills", href: "/window-invisible-grills/" },
      { name: "Duplex Staircase Tension Grills", href: "/staircase-invisible-grills/" },
      { name: "Child-Safe Calibrated Spacing", href: "/child-safety-invisible-grills/" }
    ]
  },
  {
    id: "winged-sanctuary",
    eyebrow: "HUMANE BIRD & PIGEON CONTROL",
    title: "ANTI-PIGEON NETS & BIRD SPIKES",
    subtitle: "Translucent HDPE pigeon barrier netting and stainless steel spikes safeguarding balconies and AC ledges.",
    image: "/images/category-bird-protection.jpg",
    mobileImage: "/images/category-bird-protection.jpg",
    link: "/bird-protection/",
    specs: {
      material: "0.7mm Translucent UV-Stabilized Co-Polymer",
      features: "100% Humane Exclusion, Zero Skyline Blockage",
      spikes: "SS304 Marine Spikes on UV Polycarbonate Base",
      warranty: "3-Year Clean Balcony Living Guarantee"
    },
    solutions: [
      { name: "Translucent Anti-Pigeon Netting", href: "/pigeon-nets/" },
      { name: "SS304 Polycarbonate Bird Spikes", href: "/bird-spikes/" },
      { name: "Anti-Monkey Balcony Enclosures", href: "/monkey-safety-nets/" },
      { name: "Fine-Mesh Insect & Mosquito Nets", href: "/mosquito-safety-nets/" }
    ]
  },
  {
    id: "boundless-horizons",
    eyebrow: "BALCONY & CHILD PROTECTION",
    title: "BALCONY & CHILD SAFETY NETS",
    subtitle: "Durable high-visibility child and pet anti-fall safety netting securely anchored to high-rise railings.",
    image: "/images/category-child-safety.jpg",
    mobileImage: "/images/category-child-safety.jpg",
    link: "/safety-nets/",
    specs: {
      material: "High-Density Virgin UV-Treated Polymer",
      tensileLoad: "150+ kgf Impact Resistance per Mesh Unit",
      durability: "Weatherproof Monofilament (IS Standard)",
      warranty: "3 to 5-Year Certified Replacement Guarantee"
    },
    solutions: [
      { name: "Apartment Balcony Safety Nets", href: "/balcony-safety/" },
      { name: "Toddler & Pet Anti-Fall Nets", href: "/child-safety-nets/" },
      { name: "Internal Stairwell Void Protection", href: "/staircase-safety-nets/" },
      { name: "Terrace Top Fall Perimeter", href: "/terrace-safety-nets/" }
    ]
  },
  {
    id: "aperture-collection",
    eyebrow: "SPORTS NETS & HOME UTILITIES",
    title: "SPORTS PRACTICE & TURF NETS",
    subtitle: "Heavy-gauge nylon cricket practice pitches, rooftop sports enclosures, and engineered utility arrays.",
    image: "/images/sports-nets-twilight.jpg",
    mobileImage: "/images/sports-nets-twilight.jpg",
    link: "/sports-nets/",
    specs: {
      material: "High-Tenacity Multi-Strand Polyethylene",
      impactResistance: "Cricket Leather & High-Velocity Impact Tested",
      mounting: "Ceiling Pulley & Tension-Cable Mounted",
      warranty: "Certified High-Tension Long-Life Guarantee"
    },
    solutions: [
      { name: "Rooftop Cricket Practice Nets", href: "/sports-practice-nets/" },
      { name: "Ceiling Cloth Drying Hangers", href: "/cloth-drying-hangers/" },
      { name: "Swimming Pool Protective Nets", href: "/swimming-pool-nets/" },
      { name: "Coconut Palm Anti-Drop Netting", href: "/coconut-safety-nets/" }
    ]
  },
  {
    id: "structural-architecture",
    eyebrow: "COMMERCIAL & INDUSTRIAL FALL ARREST",
    title: "COMMERCIAL & INDUSTRIAL SAFETY NETS",
    subtitle: "Industrial building void safety nets, debris catch systems, and perimeter fall containment rigging.",
    image: "/images/category-structural-safety.jpg",
    mobileImage: "/images/category-structural-safety.jpg",
    link: "/construction-safety/",
    specs: {
      material: "Heavy-Ply Braided Nylon / HDPE Industrial Grade",
      tensileLoad: "Industrial Fall Arrest & Debris Containment",
      compliance: "IS 3521 / Industrial Safety Harness Anchoring",
      warranty: "Commercial Site-Grade Certification"
    },
    solutions: [
      { name: "Construction Site Fall Nets", href: "/construction-safety-nets/" },
      { name: "Building Duct Shaft Enclosures", href: "/duct-safety-nets/" },
      { name: "Industrial Debris Containment", href: "/industrial-safety-nets/" },
      { name: "Car Parking Perimeter Nets", href: "/car-parking-safety-nets/" }
    ]
  }
];
---

<div class={`editorial-collections-feed snap-y-mandatory ${className}`} id="collections-showcase">
  {collections.map((item) => (
    <a
      href={item.link}
      class="editorial-snap-card group"
      id={`collection-${item.id}`}
      data-id={item.id}
      aria-label={`Explore ${item.title}: ${item.subtitle}`}
    >
      <!-- Edge-to-Edge Full-Bleed Photograph with Smooth 0.8s Hover Scale -->
      <div class="card-bg-wrap">
        {item.mobileImage ? (
          <picture>
            <source media="(max-width: 768px)" srcset={item.mobileImage} />
            <img
              src={item.image}
              alt={`${item.title} - ${item.subtitle}`}
              class="card-bg-image"
              loading="lazy"
              width="1920"
              height="1080"
            />
          </picture>
        ) : (
          <img
            src={item.image}
            alt={`${item.title} - ${item.subtitle}`}
            class="card-bg-image"
            loading="lazy"
            width="1920"
            height="1080"
          />
        )}
        <!-- Coastal Atmospheric Scrim Overlay -->
        <div class="editorial-scrim-overlay"></div>
      </div>

      <!-- Center-Bottom Content Box -->
      <div class="card-content-anchor">
        <div class="card-text-stack">
          <!-- Cyan Eyebrow Micro-Typography -->
          <span class="card-eyebrow">
            {item.eyebrow}
          </span>

          <!-- High-Converting SEO-Direct Title -->
          <h2 class="card-title">
            {item.title}
          </h2>

          <!-- Descriptive Subtitle -->
          <p class="card-subtitle">
            {item.subtitle}
          </p>

          <!-- Action Row: Warm Peach-Gold Primary CTA & Frosted White-Blue Secondary -->
          <div class="card-action-row">
            <span class="btn-editorial-glass">
              <span>EXPLORE</span>
              <ArrowRight size={14} />
            </span>

            <button
              type="button"
              class="btn-editorial-glass-secondary trigger-specs-modal"
              data-collection-id={item.id}
              aria-label={`View engineering details for ${item.title}`}
            >
              <span>SPECIFICATIONS</span>
            </button>
          </div>
        </div>
      </div>
    </a>
  ))}

  <!-- =========================================================================
       SPECIFICATIONS BOTTOM-SHEET MODAL (Coastal Frosted Theme)
       ========================================================================= -->
  <div class="specs-modal-backdrop" id="specs-modal-backdrop" aria-hidden="true">
    <div class="specs-sheet" id="specs-sheet">
      <div class="sheet-header">
        <div>
          <span class="sheet-eyebrow" id="modal-eyebrow">ENGINEERING &amp; METALLURGY</span>
          <h3 class="sheet-title" id="modal-title">SS316 MARINE INVISIBLE GRILLS</h3>
        </div>
        <button type="button" class="sheet-close-btn" id="modal-close-btn" aria-label="Close specifications">
          <X size={20} />
        </button>
      </div>

      <div class="sheet-body">
        <div class="specs-grid" id="modal-specs-grid">
          <!-- Populated dynamically via JS -->
        </div>

        <div class="sheet-solutions-block">
          <span class="sheet-solutions-title">AVAILABLE CONFIGURATIONS</span>
          <div class="sheet-solutions-list" id="modal-solutions-list">
            <!-- Populated dynamically via JS -->
          </div>
        </div>

        <div class="sheet-footer">
          <a href="/contact/#quote" class="btn-primary" style="width: 100%; text-align: center; height: 50px;">
            <span>SCHEDULE COMPLIMENTARY SITE SURVEY</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* =========================================================================
     COLLECTIONS FEED (100DVH SNAP SCROLLING STACK)
     ========================================================================= */
  .editorial-collections-feed {
    width: 100%;
    position: relative;
    background: #F4F7FB;
    scroll-snap-type: y mandatory;
  }

  .editorial-snap-card {
    position: relative;
    width: 100%;
    min-height: 100dvh;
    height: 100dvh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    border-bottom: 1px solid #D8E6F3;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    background: #0F1E36;
  }

  .card-bg-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .card-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: contrast(1.05) saturate(1.04);
    transform: scale(1.0);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .editorial-snap-card:hover .card-bg-image {
    transform: scale(1.03);
  }

  .editorial-scrim-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 30, 54, 0.15) 0%,
      rgba(15, 30, 54, 0.45) 50%,
      rgba(15, 30, 54, 0.88) 100%
    );
    pointer-events: none;
    z-index: 2;
    transition: background 0.4s ease;
  }

  .editorial-snap-card:hover .editorial-scrim-overlay {
    background: linear-gradient(
      180deg,
      rgba(15, 30, 54, 0.1) 0%,
      rgba(15, 30, 54, 0.4) 50%,
      rgba(15, 30, 54, 0.92) 100%
    );
  }

  /* Content Anchor */
  .card-content-anchor {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2.5rem);
    padding-bottom: clamp(2.75rem, 7vh, 4.75rem);
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .card-text-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 840px;
    width: 100%;
  }

  .card-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #38BDF8;
    background: rgba(15, 30, 54, 0.6);
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(56, 189, 248, 0.3);
    margin-bottom: 0.75rem;
    backdrop-filter: blur(8px);
  }

  .card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: clamp(1.7rem, 4.4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.04em;
    color: #FFFFFF;
    text-transform: uppercase;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8), 0 4px 20px rgba(0, 0, 0, 0.6);
    margin: 0 0 0.85rem 0;
    max-width: 100%;
  }

  .card-subtitle {
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    color: #E2E8F0;
    line-height: 1.55;
    margin: 0 0 2rem 0;
    max-width: 680px;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.85);
  }

  .card-action-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .card-title {
      font-size: clamp(1.4rem, 6.2vw, 2.1rem);
    }

    .card-subtitle {
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
    }

    .card-action-row {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
      gap: 0.75rem;
    }

    .card-action-row span,
    .card-action-row button {
      width: 100%;
      justify-content: center;
    }
  }

  /* =========================================================================
     BOTTOM-SHEET MODAL (Frosted White-Blue)
     ========================================================================= */
  .specs-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 30, 54, 0.65);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 1050;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .specs-modal-backdrop.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .specs-sheet {
    width: 100%;
    max-width: 680px;
    background: #FFFFFF;
    border: 1px solid #D8E6F3;
    border-radius: 20px 20px 0 0;
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    box-shadow: 0 -20px 60px rgba(30, 58, 95, 0.2);
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    max-height: 85vh;
    overflow-y: auto;
    box-sizing: border-box;
    color: var(--color-body);
  }

  .specs-modal-backdrop.is-active .specs-sheet {
    transform: translateY(0);
  }

  .sheet-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #EBF3FA;
    margin-bottom: 1.5rem;
  }

  .sheet-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.25rem;
  }

  .sheet-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--color-primary);
    margin: 0;
  }

  .sheet-close-btn {
    background: #F1F5F9;
    border: 1px solid #D8E6F3;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .sheet-close-btn:hover {
    background: #EBF3FA;
    color: var(--color-primary);
  }

  .sheet-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 480px) {
    .specs-grid {
      grid-template-columns: 1fr;
    }
  }

  .spec-item {
    background: #F8FAFC;
    border: 1px solid #D8E6F3;
    border-radius: 8px;
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .spec-item-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #64748B;
    text-transform: uppercase;
  }

  .spec-item-value {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .sheet-solutions-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sheet-solutions-title {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--color-primary);
    text-transform: uppercase;
  }

  .sheet-solutions-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .sheet-solution-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: #F8FAFC;
    border: 1px solid #D8E6F3;
    border-radius: 8px;
    color: var(--color-primary);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .sheet-solution-link:hover {
    background: #EBF3FA;
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .sheet-footer {
    margin-top: 0.5rem;
  }
</style>

<script define:vars={{ collections }}>
  function setupEditorialSpecsModal() {
    const backdrop = document.getElementById('specs-modal-backdrop');
    const closeBtn = document.getElementById('modal-close-btn');
    const modalEyebrow = document.getElementById('modal-eyebrow');
    const modalTitle = document.getElementById('modal-title');
    const modalSpecsGrid = document.getElementById('modal-specs-grid');
    const modalSolutionsList = document.getElementById('modal-solutions-list');
    const triggerButtons = document.querySelectorAll('.trigger-specs-modal');

    if (!backdrop || !closeBtn || !modalSpecsGrid || !modalSolutionsList) return;

    function openModal(collectionId) {
      const collection = collections.find((c) => c.id === collectionId);
      if (!collection) return;

      if (modalEyebrow) modalEyebrow.textContent = collection.eyebrow + ' · ENGINEERING';
      if (modalTitle) modalTitle.textContent = collection.title;

      // Populate specs grid
      modalSpecsGrid.innerHTML = '';
      Object.entries(collection.specs).forEach(([key, val]) => {
        const item = document.createElement('div');
        item.className = 'spec-item';
        item.innerHTML = `
          <span class="spec-item-label">${key.replace(/([A-Z])/g, ' $1')}</span>
          <span class="spec-item-value">${val}</span>
        `;
        modalSpecsGrid.appendChild(item);
      });

      // Populate solutions list
      modalSolutionsList.innerHTML = '';
      collection.solutions.forEach((sol) => {
        const a = document.createElement('a');
        a.href = sol.href;
        a.className = 'sheet-solution-link';
        a.innerHTML = `<span>${sol.name}</span><span>&rarr;</span>`;
        modalSolutionsList.appendChild(a);
      });

      backdrop.classList.add('is-active');
      backdrop.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      backdrop.classList.remove('is-active');
      backdrop.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    triggerButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation(); // Prevents parent card link from navigating
        const id = btn.getAttribute('data-collection-id');
        if (id) openModal(id);
      });
    });

    closeBtn.addEventListener('click', closeModal);

    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop.classList.contains('is-active')) {
        closeModal();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupEditorialSpecsModal);
  document.addEventListener('astro:page-load', setupEditorialSpecsModal);
</script>
