---
import { ArrowRight, X, ShieldCheck, Check, Sparkles } from 'lucide-react';

interface Props {
  className?: string;
  isStandalone?: boolean;
}

const { className = "", isStandalone = false } = Astro.props;

const collections = [
  {
    id: "invisible-threshold",
    eyebrow: "THE ATELIER",
    title: "THE INVISIBLE THRESHOLD",
    subtitle: "Balcony & Window Invisible Grills",
    image: "/images/hero-balcony.webp",
    link: "/invisible-grills/",
    specs: {
      material: "Virgin SS316 Marine-Grade Stainless Steel",
      tensileLoad: "400+ kgf Breaking Strength per Cable",
      spacing: "50mm Child-Safe or 75mm Expansive View",
      warranty: "10-Year Direct Structural Warranty"
    },
    solutions: [
      { name: "Balcony Invisible Grills", href: "/balcony-invisible-grills/" },
      { name: "French Window Invisible Grills", href: "/window-invisible-grills/" },
      { name: "Duplex Staircase Tension Grills", href: "/staircase-invisible-grills/" },
      { name: "Child-Safe Calibrated Spacing", href: "/child-safety-invisible-grills/" }
    ]
  },
  {
    id: "boundless-horizons",
    eyebrow: "CORE SAFETY NETS",
    title: "BOUNDLESS HORIZONS",
    subtitle: "Living Spaces & Children Safety Nets",
    image: "/images/safety-net-balcony.webp",
    link: "/safety-nets/",
    specs: {
      material: "High-Density Virgin UV-Treated Polymer",
      tensileLoad: "150+ kgf Impact Resistance per Mesh Unit",
      durability: "Weatherproof Monofilament (IS Standard)",
      warranty: "3 to 5-Year Certified Replacement Guarantee"
    },
    solutions: [
      { name: "Apartment Balcony Safety Nets", href: "/balcony-safety/" },
      { name: "Toddler & Pet Anti-Fall Nets", href: "/child-safety-nets/" },
      { name: "Internal Stairwell Void Protection", href: "/staircase-safety-nets/" },
      { name: "Terrace Top Fall Perimeter", href: "/terrace-safety-nets/" }
    ]
  },
  {
    id: "structural-architecture",
    eyebrow: "STRUCTURAL ARCHITECTURE",
    title: "DEBRIS & FALL CONTAINMENT",
    subtitle: "Heavy-Duty Construction & Void Nets",
    image: "/images/construction-safety-net.jpg",
    link: "/construction-safety-nets/",
    specs: {
      material: "Heavy-Ply Braided Nylon / HDPE Industrial Grade",
      tensileLoad: "Industrial Fall Arrest & Debris Containment",
      compliance: "IS 3521 / Industrial Safety Harness Anchoring",
      warranty: "Commercial Site-Grade Certification"
    },
    solutions: [
      { name: "Construction Site Fall Nets", href: "/construction-safety-nets/" },
      { name: "Building Duct Shaft Enclosures", href: "/duct-safety-nets/" },
      { name: "Industrial Debris Containment", href: "/industrial-safety-nets/" },
      { name: "Car Parking Perimeter Nets", href: "/car-parking-safety-nets/" }
    ]
  },
  {
    id: "winged-sanctuary",
    eyebrow: "ANIMAL & BIRD PROTECTION",
    title: "THE WINGED SANCTUARY",
    subtitle: "Pigeon Nets & Stainless Steel Bird Spikes",
    image: "/images/pigeon-net.webp",
    link: "/pigeon-nets/",
    specs: {
      material: "0.7mm Translucent UV-Stabilized Monofilament",
      features: "100% Humane Exclusion, Zero Silhouette Blockage",
      durability: "Sun-Resistant Anti-Rot Polymer Spikes",
      warranty: "3-Year Clean Living Warranty"
    },
    solutions: [
      { name: "Translucent Anti-Pigeon Netting", href: "/pigeon-nets/" },
      { name: "SS304 Polycarbonate Bird Spikes", href: "/bird-spikes/" },
      { name: "Anti-Monkey Balcony Enclosures", href: "/monkey-safety-nets/" },
      { name: "Fine-Mesh Insect & Mosquito Nets", href: "/mosquito-safety-nets/" }
    ]
  },
  {
    id: "aperture-collection",
    eyebrow: "SPECIALTY SOLUTIONS",
    title: "THE APERTURE COLLECTION",
    subtitle: "Sports Practice Nets & Utilities",
    image: "/images/sports-nets.webp",
    link: "/sports-nets/",
    specs: {
      material: "Impact-Absorbing Multi-Strand Polyethylene",
      testing: "Cricket Ball & High-Velocity Impact Tested",
      installation: "Ceiling Pulley & Tension-Cable Mounted",
      warranty: "Long-Life High-Tension Guarantee"
    },
    solutions: [
      { name: "Rooftop Cricket Practice Nets", href: "/sports-practice-nets/" },
      { name: "Ceiling Cloth Drying Hangers", href: "/cloth-drying-hangers/" },
      { name: "Swimming Pool Protective Nets", href: "/swimming-pool-nets/" },
      { name: "Coconut Palm Anti-Drop Netting", href: "/coconut-safety-nets/" }
    ]
  }
];
---

<div class={`editorial-collections-feed ${className}`} id="collections-showcase">
  {collections.map((item, index) => (
    <article
      class="editorial-snap-card"
      id={`collection-${item.id}`}
      data-id={item.id}
    >
      <!-- Edge-to-Edge Full-Bleed Photograph -->
      <div class="card-bg-wrap">
        <img
          src={item.image}
          alt={`${item.title} - ${item.subtitle}`}
          class="card-bg-image"
          loading="lazy"
          width="1920"
          height="1080"
        />
        <!-- Ambient Cinematic Bottom Scrim Overlay -->
        <div class="editorial-scrim-overlay"></div>
      </div>

      <!-- Center-Bottom Content Box -->
      <div class="card-content-anchor">
        <div class="card-text-stack">
          <!-- Overline Eyebrow -->
          <span class="card-eyebrow">
            {item.eyebrow}
          </span>

          <!-- High-End Luxury Title -->
          <h2 class="card-title">
            {item.title}
          </h2>

          <!-- 1-Line Micro-Copy Subtitle -->
          <p class="card-subtitle">
            {item.subtitle}
          </p>

          <!-- Minimal Outline CTA Buttons -->
          <div class="card-action-row">
            <a href={item.link} class="btn-editorial-solid">
              <span>EXPLORE</span>
            </a>

            <button
              type="button"
              class="btn-editorial-outline trigger-specs-modal"
              data-collection-id={item.id}
              aria-label={`View craftsmanship details for ${item.title}`}
            >
              <span>SPECIFICATIONS</span>
            </button>
          </div>
        </div>
      </div>
    </article>
  ))}

  <!-- =========================================================================
       EDITORIAL CRAFTSMANSHIP & SPECIFICATIONS BOTTOM-SHEET MODAL
       Keeps main photography clean while providing instant technical depth on demand
       ========================================================================= -->
  <div class="specs-modal-backdrop" id="specs-modal-backdrop" aria-hidden="true">
    <div class="specs-sheet" id="specs-sheet">
      <div class="sheet-header">
        <div>
          <span class="sheet-eyebrow" id="modal-eyebrow">CRAFTSMANSHIP &amp; METALLURGY</span>
          <h3 class="sheet-title" id="modal-title">THE INVISIBLE THRESHOLD</h3>
        </div>
        <button type="button" class="sheet-close-btn" id="modal-close-btn" aria-label="Close specifications">
          <X size={20} />
        </button>
      </div>

      <div class="sheet-body">
        <div class="specs-grid" id="modal-specs-grid">
          <!-- Populated dynamically via JS -->
        </div>

        <div class="sheet-solutions-block">
          <span class="sheet-solutions-title">AVAILABLE CONFIGURATIONS</span>
          <div class="sheet-solutions-list" id="modal-solutions-list">
            <!-- Populated dynamically via JS -->
          </div>
        </div>

        <div class="sheet-footer">
          <a href="/contact/#quote" class="btn-editorial-solid" style="width: 100%; text-align: center;">
            <span>SCHEDULE COMPLIMENTARY SITE SURVEY</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* =========================================================================
     EDITORIAL COLLECTIONS FEED (SNAP STREAM)
     ========================================================================= */
  .editorial-collections-feed {
    width: 100%;
    position: relative;
    background: #0D0D0D;
    scroll-snap-type: y proximity;
  }

  .editorial-snap-card {
    position: relative;
    width: 100%;
    min-height: clamp(560px, 86vh, 100dvh);
    height: 100dvh;
    scroll-snap-align: start;
    scroll-snap-stop: normal;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .card-bg-wrap {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .card-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.01);
    transition: transform 1.8s cubic-bezier(0.25, 1, 0.35, 1);
  }

  .editorial-snap-card:hover .card-bg-image {
    transform: scale(1.04);
  }

  /* Scrim Overlay: Gradient keeps bottom 40% deep & legible */
  .editorial-scrim-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.1) 0%,
      rgba(0, 0, 0, 0.02) 30%,
      rgba(0, 0, 0, 0.3) 55%,
      rgba(0, 0, 0, 0.72) 80%,
      rgba(0, 0, 0, 0.92) 100%
    );
    pointer-events: none;
    z-index: 2;
  }

  /* Content Anchor */
  .card-content-anchor {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 920px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2.5rem);
    padding-bottom: clamp(2.5rem, 6vh, 4.5rem);
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .card-text-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 780px;
    width: 100%;
  }

  .card-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #E2E8F0;
    margin-bottom: 0.75rem;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.85);
  }

  .card-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: clamp(1.6rem, 3.8vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.1em;
    color: #FFFFFF;
    text-transform: uppercase;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.9), 0 4px 28px rgba(0, 0, 0, 0.75);
    margin: 0 0 0.65rem 0;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .card-subtitle {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-style: italic;
    font-size: clamp(0.95rem, 1.3vw, 1.2rem);
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.5;
    margin: 0 0 1.85rem 0;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.85);
  }

  .card-action-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .card-title {
      font-size: clamp(1.35rem, 5.8vw, 1.95rem);
      letter-spacing: 0.05em;
    }

    .card-subtitle {
      font-size: 0.92rem;
      margin-bottom: 1.35rem;
    }

    .card-action-row {
      flex-direction: column;
      width: 100%;
      max-width: 290px;
      gap: 0.65rem;
    }

    .card-action-row a,
    .card-action-row button {
      width: 100%;
      justify-content: center;
    }
  }

  /* =========================================================================
     CRAFTSMANSHIP & SPECIFICATIONS BOTTOM-SHEET MODAL
     ========================================================================= */
  .specs-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 1050;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .specs-modal-backdrop.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .specs-sheet {
    width: 100%;
    max-width: 640px;
    background: #111111;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 16px 16px 0 0;
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    box-shadow: 0 -20px 60px rgba(0, 0, 0, 0.8);
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.35, 1);
    max-height: 85vh;
    overflow-y: auto;
    box-sizing: border-box;
    color: #FFFFFF;
  }

  .specs-modal-backdrop.is-active .specs-sheet {
    transform: translateY(0);
  }

  .sheet-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 1.5rem;
  }

  .sheet-eyebrow {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--color-gold, #C5A880);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.25rem;
  }

  .sheet-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #FFFFFF;
    margin: 0;
  }

  .sheet-close-btn {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #CBD5E1;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .sheet-close-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
  }

  .sheet-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 480px) {
    .specs-grid {
      grid-template-columns: 1fr;
    }
  }

  .spec-item {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .spec-item-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #94A3B8;
    text-transform: uppercase;
  }

  .spec-item-value {
    font-size: 0.88rem;
    font-weight: 600;
    color: #F8FAFC;
  }

  .sheet-solutions-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sheet-solutions-title {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--color-gold, #C5A880);
    text-transform: uppercase;
  }

  .sheet-solutions-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .sheet-solution-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    color: #E2E8F0;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .sheet-solution-link:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
    color: #FFFFFF;
  }

  .sheet-footer {
    margin-top: 0.5rem;
  }
</style>

<script define:vars={{ collections }}>
  function setupEditorialSpecsModal() {
    const backdrop = document.getElementById('specs-modal-backdrop');
    const closeBtn = document.getElementById('modal-close-btn');
    const modalEyebrow = document.getElementById('modal-eyebrow');
    const modalTitle = document.getElementById('modal-title');
    const modalSpecsGrid = document.getElementById('modal-specs-grid');
    const modalSolutionsList = document.getElementById('modal-solutions-list');
    const triggerButtons = document.querySelectorAll('.trigger-specs-modal');

    if (!backdrop || !closeBtn || !modalSpecsGrid || !modalSolutionsList) return;

    function openModal(collectionId) {
      const collection = collections.find((c) => c.id === collectionId);
      if (!collection) return;

      if (modalEyebrow) modalEyebrow.textContent = collection.eyebrow + ' · CRAFTSMANSHIP';
      if (modalTitle) modalTitle.textContent = collection.title;

      // Populate specs grid
      modalSpecsGrid.innerHTML = '';
      Object.entries(collection.specs).forEach(([key, val]) => {
        const item = document.createElement('div');
        item.className = 'spec-item';
        item.innerHTML = `
          <span class="spec-item-label">${key.replace(/([A-Z])/g, ' $1')}</span>
          <span class="spec-item-value">${val}</span>
        `;
        modalSpecsGrid.appendChild(item);
      });

      // Populate solutions list
      modalSolutionsList.innerHTML = '';
      collection.solutions.forEach((sol) => {
        const a = document.createElement('a');
        a.href = sol.href;
        a.className = 'sheet-solution-link';
        a.innerHTML = `<span>${sol.name}</span><span>&rarr;</span>`;
        modalSolutionsList.appendChild(a);
      });

      backdrop.classList.add('is-active');
      backdrop.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      backdrop.classList.remove('is-active');
      backdrop.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    triggerButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const id = btn.getAttribute('data-collection-id');
        if (id) openModal(id);
      });
    });

    closeBtn.addEventListener('click', closeModal);

    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop.classList.contains('is-active')) {
        closeModal();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupEditorialSpecsModal);
  document.addEventListener('astro:page-load', setupEditorialSpecsModal);
</script>
