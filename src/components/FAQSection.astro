---
import { faqs, type FAQItem } from '../data/faq';
import { HelpCircle, ChevronDown } from 'lucide-react';

export interface Props {
  category?: "invisible-grill" | "safety-net" | "installation" | "warranty" | "pricing";
  limit?: number;
  title?: string;
}

const { category, limit = 6, title = "Frequently Asked Questions" } = Astro.props;

const filteredFaqs = category ? faqs.filter(f => f.category === category) : faqs;
const displayFaqs = limit ? filteredFaqs.slice(0, limit) : filteredFaqs;
---

<section class="section-spacing" style="background: #090D16; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
  <div class="container">
    <div class="section-header">
      <span class="badge-arch">Clear Answers</span>
      <h2>{title}</h2>
      <p>
        Straightforward, transparent information about invisible grill engineering, safety load ratings, and building rules.
      </p>
    </div>

    <div style="max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 1rem;">
      {displayFaqs.map((faq, idx) => (
        <details class="faq-item" style="background: rgba(17, 24, 39, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; overflow: hidden; transition: border-color 0.2s ease;">
          <summary style="padding: 1.25rem 1.5rem; font-family: var(--font-heading); font-size: 1.05rem; font-weight: 600; color: #FFFFFF; cursor: pointer; display: flex; justify-content: space-between; align-items: center; list-style: none; user-select: none;">
            <span>{faq.question}</span>
            <span class="faq-icon" style="color: #38BDF8; transition: transform 0.2s ease; margin-left: 1rem;">+</span>
          </summary>
          <div style="padding: 0 1.5rem 1.25rem 1.5rem; font-size: 0.92rem; color: #94A3B8; line-height: 1.6; border-top: 1px solid rgba(255, 255, 255, 0.05); padding-top: 0.75rem;">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>

    <div style="text-align: center; margin-top: 2.5rem;">
      <a href="/faq/" class="btn btn-outline" style="font-size: 0.9rem;">
        <span>Browse All Questions & Answers</span>
      </a>
    </div>
  </div>
</section>

<style>
  details[open] {
    border-color: rgba(56, 189, 248, 0.3) !important;
    background: rgba(17, 24, 39, 0.9) !important;
  }
  details[open] .faq-icon {
    transform: rotate(45deg);
    color: #EF4444;
  }
  summary::-webkit-details-marker {
    display: none;
  }
</style>
