---
import { faqs, type FAQItem } from '../data/faq';
import { HelpCircle, ChevronDown } from 'lucide-react';

export interface Props {
  category?: "invisible-grill" | "safety-net" | "installation" | "warranty" | "pricing";
  limit?: number;
  title?: string;
  subtitle?: string;
}

const {
  category,
  limit = 6,
  title = "Frequently Asked Questions",
  subtitle = "Straightforward, practical information about invisible grill installation, balcony safety, and building society approvals."
} = Astro.props;

const filteredFaqs = category ? faqs.filter(f => f.category === category) : faqs;
const displayFaqs = limit ? filteredFaqs.slice(0, limit) : filteredFaqs;
---

<section class="section-spacing bg-warm" id="faqs">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">COMMON QUESTIONS</span>
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>

    <div class="faq-list">
      {displayFaqs.map((faq, idx) => (
        <details class="faq-item">
          <summary class="faq-summary">
            <span>{faq.question}</span>
            <span class="faq-toggle-icon">+</span>
          </summary>
          <div class="faq-content">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>

    <div class="faq-footer">
      <a href="/faq/" class="btn btn-secondary">
        <span>View All Questions & Answers</span>
      </a>
    </div>
  </div>
</section>

<style>
  .faq-list {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-item:hover {
    border-color: #CBD5E1;
  }

  .faq-item[open] {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-sm);
  }

  .faq-summary {
    padding: 1.25rem 1.5rem;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-primary);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    user-select: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-toggle-icon {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-accent);
    transition: transform 0.2s ease;
    margin-left: 1rem;
  }

  .faq-item[open] .faq-toggle-icon {
    transform: rotate(45deg);
    color: var(--color-body);
  }

  .faq-content {
    padding: 0 1.5rem 1.25rem 1.5rem;
    font-size: 0.95rem;
    color: var(--color-body);
    line-height: 1.65;
    border-top: 1px solid var(--color-border-light);
    padding-top: 0.85rem;
  }

  .faq-footer {
    text-align: center;
    margin-top: 2.5rem;
  }
</style>
