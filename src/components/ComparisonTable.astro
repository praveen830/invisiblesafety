---
import { Check, X, ShieldAlert, Sparkles } from 'lucide-react';
---

<section class="section-spacing" style="background: #F8FAFC; border-bottom: 1px solid #E2E8F0;">
  <div class="container">
    <div class="section-header">
      <span class="badge-arch">Direct Comparison</span>
      <h2>Invisible Grills vs Traditional Grills</h2>
      <p>
        Compare how modern architectural SS316 invisible grills radically outperform outdated heavy iron bars across safety, aesthetics, and building compliance.
      </p>
    </div>

    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
      <table style="width: 100%; border-collapse: collapse; text-align: left; background: #FFFFFF; border-radius: 16px; overflow: hidden; border: 1px solid #E2E8F0; box-shadow: var(--shadow-card);">
        <thead>
          <tr style="border-bottom: 1px solid #E2E8F0; background: #F8FAFC;">
            <th style="padding: 1.25rem 1.5rem; font-size: 0.95rem; color: #475569; font-weight: 700; width: 28%;">Feature / Factor</th>
            <th style="padding: 1.25rem 1.5rem; font-size: 1rem; color: #0284C7; font-weight: 800; width: 36%; background: #F0F9FF; border-left: 1px solid #BAE6FD; border-right: 1px solid #BAE6FD;">
              InvisProtect SS316 Invisible Grills
            </th>
            <th style="padding: 1.25rem 1.5rem; font-size: 0.95rem; color: #475569; font-weight: 700; width: 36%;">Traditional MS / Iron Box Grills</th>
          </tr>
        </thead>
        <tbody style="font-size: 0.92rem; color: #334155;">
          <tr style="border-bottom: 1px solid #F1F5F9;">
            <td style="padding: 1.1rem 1.5rem; font-weight: 600; color: #0F172A;">Visual Transparency</td>
            <td style="padding: 1.1rem 1.5rem; background: #F0F9FF; border-left: 1px solid #BAE6FD; border-right: 1px solid #BAE6FD; color: #15803D; font-weight: 600;">
              ✓ 98% Unobstructed panoramic vista
            </td>
            <td style="padding: 1.1rem 1.5rem; color: #DC2626;">
              ✗ Blocks 40–60% of natural view & daylight
            </td>
          </tr>

          <tr style="border-bottom: 1px solid #F1F5F9;">
            <td style="padding: 1.1rem 1.5rem; font-weight: 600; color: #0F172A;">Child Fall Prevention</td>
            <td style="padding: 1.1rem 1.5rem; background: #F0F9FF; border-left: 1px solid #BAE6FD; border-right: 1px solid #BAE6FD; color: #15803D; font-weight: 600;">
              ✓ Cannot be climbed (zero horizontal steps)
            </td>
            <td style="padding: 1.1rem 1.5rem; color: #DC2626;">
              ✗ Creates ladder footholds children can climb
            </td>
          </tr>

          <tr style="border-bottom: 1px solid #F1F5F9;">
            <td style="padding: 1.1rem 1.5rem; font-weight: 600; color: #0F172A;">Rust & Weather Resistance</td>
            <td style="padding: 1.1rem 1.5rem; background: #F0F9FF; border-left: 1px solid #BAE6FD; border-right: 1px solid #BAE6FD; color: #15803D; font-weight: 600;">
              ✓ SS316 Marine Grade (100% rust-proof)
            </td>
            <td style="padding: 1.1rem 1.5rem; color: #DC2626;">
              ✗ Prone to rust; requires painting every 2 years
            </td>
          </tr>

          <tr style="border-bottom: 1px solid #F1F5F9;">
            <td style="padding: 1.1rem 1.5rem; font-weight: 600; color: #0F172A;">Fire Rescue & Evacuation</td>
            <td style="padding: 1.1rem 1.5rem; background: #F0F9FF; border-left: 1px solid #BAE6FD; border-right: 1px solid #BAE6FD; color: #15803D; font-weight: 600;">
              ✓ Can be cut by firemen in seconds with wire cutters
            </td>
            <td style="padding: 1.1rem 1.5rem; color: #DC2626;">
              ✗ Lethal fire trap: cannot be cut without power saws
            </td>
          </tr>

          <tr style="border-bottom: 1px solid #F1F5F9;">
            <td style="padding: 1.1rem 1.5rem; font-weight: 600; color: #0F172A;">Society / RWA Elevation Rules</td>
            <td style="padding: 1.1rem 1.5rem; background: #F0F9FF; border-left: 1px solid #BAE6FD; border-right: 1px solid #BAE6FD; color: #15803D; font-weight: 600;">
              ✓ 100% compliant; maintains building façade
            </td>
            <td style="padding: 1.1rem 1.5rem; color: #DC2626;">
              ✗ Frequently banned by luxury high-rise RWAs
            </td>
          </tr>

          <tr>
            <td style="padding: 1.1rem 1.5rem; font-weight: 600; color: #0F172A;">Maintenance Effort</td>
            <td style="padding: 1.1rem 1.5rem; background: #F0F9FF; border-left: 1px solid #BAE6FD; border-right: 1px solid #BAE6FD; color: #15803D; font-weight: 600;">
              ✓ Zero maintenance; simple water wipe down
            </td>
            <td style="padding: 1.1rem 1.5rem; color: #DC2626;">
              ✗ High; rust scraping, sanding & messy paint
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
