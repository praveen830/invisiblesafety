---
import { business } from '../data/business';
import { Phone, MessageCircle, Calculator } from 'lucide-react';
---

<div class="mobile-bottom-bar" id="sticky-mobile-bar">
  <a
    href={`tel:${business.phoneRaw}`}
    class="mobile-bottom-btn mobile-bottom-btn-call"
    aria-label="Call Invisible Safety"
  >
    <Phone size={18} />
    <span>Call</span>
  </a>

  <a
    href={`https://wa.me/${business.whatsapp}?text=Hello%20Invisible%20Safety%2C%20I%20am%20looking%20for%20a%20site%20measurement%20and%20quotation.`}
    target="_blank"
    rel="noopener noreferrer"
    class="mobile-bottom-btn mobile-bottom-btn-whatsapp"
    aria-label="Chat on WhatsApp"
  >
    <MessageCircle size={18} />
    <span>WhatsApp</span>
  </a>

  <a
    href="/contact/#quote"
    class="mobile-bottom-btn mobile-bottom-btn-quote"
    aria-label="Get a Free Quote"
  >
    <Calculator size={18} />
    <span>GET A QUOTE</span>
  </a>
</div>
