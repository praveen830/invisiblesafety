---
import { business } from '../data/business';
import { Phone, MessageCircle, Calendar } from 'lucide-react';
---

<aside class="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-white/95 backdrop-blur-md border-t border-slate-200 shadow-lg px-3 py-2.5 pb-safe" aria-label="Direct Quick Contact">
  <div class="flex items-center justify-between gap-2 max-w-md mx-auto">
    <!-- 1. Free Visit (Deep Royal Navy #0F233D -> scrolls to #contact-booking) -->
    <a
      href="#contact-booking"
      class="flex-1 flex items-center justify-center gap-1.5 min-h-[44px] px-2.5 py-2 rounded-full bg-[#0F233D] hover:bg-[#1E3A5F] text-white text-xs font-bold shadow-xs active:scale-[0.98] transition-all text-center"
      aria-label="Book Free Site Visit"
    >
      <Calendar size={14} className="text-[#C6A66B] shrink-0" />
      <span class="whitespace-nowrap">Free Visit</span>
    </a>

    <!-- 2. WhatsApp (Vibrant Green #25D366 -> pre-filled WhatsApp link) -->
    <a
      href={`https://wa.me/${business.whatsapp}?text=Hello%20Invisible%20Safety%2C%20I%20am%20interested%20in%20an%20instant%20quote%20and%20free%20site%20inspection.`}
      target="_blank"
      rel="noopener noreferrer"
      class="flex-1 flex items-center justify-center gap-1.5 min-h-[44px] px-2.5 py-2 rounded-full bg-[#25D366] hover:bg-[#20BA5A] text-white text-xs font-bold shadow-xs active:scale-[0.98] transition-all text-center"
      aria-label="WhatsApp Invisible Safety"
    >
      <MessageCircle size={15} className="text-white shrink-0" />
      <span class="whitespace-nowrap">WhatsApp</span>
    </a>

    <!-- 3. Call (Deep Royal Navy #0F233D -> tel) -->
    <a
      href={`tel:${business.phoneRaw}`}
      class="flex-1 flex items-center justify-center gap-1.5 min-h-[44px] px-2.5 py-2 rounded-full bg-[#0F233D] hover:bg-[#1E3A5F] text-white text-xs font-bold shadow-xs active:scale-[0.98] transition-all text-center"
      aria-label={`Call Invisible Safety at ${business.phone}`}
    >
      <Phone size={14} className="text-[#C6A66B] shrink-0" />
      <span class="whitespace-nowrap">Call</span>
    </a>
  </div>
</aside>

<style>
  .pb-safe {
    padding-bottom: max(10px, env(safe-area-inset-bottom, 10px));
  }
</style>
