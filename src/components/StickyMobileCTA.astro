---
import { business } from '../data/business';
import { Phone, MessageCircle } from 'lucide-react';
---

<aside class="mobile-sticky-action-bar" aria-label="Direct Quick Contact">
  <div class="mobile-action-inner">
    <!-- Click-to-Call Action Button -->
    <a
      href={`tel:${business.phoneRaw}`}
      class="mobile-action-btn btn-phone"
      aria-label="Call Invisible Safety"
    >
      <Phone size={18} strokeWidth={2.2} />
      <span>Call Now</span>
    </a>

    <!-- Direct WhatsApp Quote Action Button -->
    <a
      href={`https://wa.me/${business.whatsapp}?text=Hello%20Invisible%20Safety%2C%20I%20am%20interested%20in%20an%20instant%20quote%20and%20free%20site%20inspection.`}
      target="_blank"
      rel="noopener noreferrer"
      class="mobile-action-btn btn-whatsapp"
      aria-label="WhatsApp Invisible Safety"
    >
      <MessageCircle size={18} strokeWidth={2.2} />
      <span>WhatsApp Quote</span>
    </a>
  </div>
</aside>

<style>
  .mobile-sticky-action-bar {
    display: none;
  }

  @media (max-width: 767px) {
    .mobile-sticky-action-bar {
      display: block;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 950;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-top: 1px solid rgba(226, 232, 240, 0.9);
      box-shadow: 0 -4px 20px -2px rgba(26, 54, 93, 0.08);
      padding: 10px 16px;
      padding-bottom: max(10px, env(safe-area-inset-bottom, 10px));
    }

    .mobile-action-inner {
      display: flex;
      align-items: center;
      gap: 12px;
      max-width: 480px;
      margin: 0 auto;
    }

    .mobile-action-btn {
      flex: 1;
      min-height: 48px;
      height: 48px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border-radius: 9999px;
      font-family: var(--font-sans);
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      touch-action: manipulation;
    }

    .mobile-action-btn:active {
      transform: scale(0.98);
    }

    .btn-phone {
      background-color: #F8FAFC;
      color: #1A365D;
      border: 1px solid #CBD5E1;
    }

    .btn-whatsapp {
      background-color: #16A34A;
      color: #FFFFFF;
      border: 1px solid #15803D;
      box-shadow: 0 4px 12px rgba(22, 163, 74, 0.25);
    }
  }
</style>
