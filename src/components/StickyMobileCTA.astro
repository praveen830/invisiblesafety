---
import { business } from '../data/business';
import { Phone, MessageCircle } from 'lucide-react';
---

<aside class="editorial-floating-actions" aria-label="Direct Quick Contact">
  <!-- Minimalist Frosted Call Button (Bottom Left) -->
  <a
    href={`tel:${business.phoneRaw}`}
    class="editorial-floating-btn btn-call"
    aria-label="Direct Phone Call"
    title="Call Invisible Safety"
  >
    <Phone size={19} strokeWidth={2} />
  </a>

  <!-- Minimalist Frosted WhatsApp Button (Bottom Right) -->
  <a
    href={`https://wa.me/${business.whatsapp}?text=Hello%20Invisible%20Safety%2C%20I%20am%20interested%20in%20a%20site%20measurement%20and%20architectural%20consultation.`}
    target="_blank"
    rel="noopener noreferrer"
    class="editorial-floating-btn btn-whatsapp"
    aria-label="Chat on WhatsApp"
    title="WhatsApp Invisible Safety"
  >
    <MessageCircle size={21} strokeWidth={2} />
  </a>
</aside>
