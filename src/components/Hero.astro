---
import { ArrowRight, Phone, ShieldCheck, Sparkles } from 'lucide-react';
import { business } from '../data/business';
---

<section class="editorial-hero">
  <!-- Edge-to-Edge Fullscreen Photography with Coastal Dynamic Contrast -->
  <div class="hero-media-wrapper">
    <picture>
      <source media="(max-width: 768px)" srcset="/images/hero-balcony-twilight-mobile.jpg" />
      <img
        src="/images/hero-balcony-twilight.jpg"
        alt="Architectural penthouse balcony with modern SS316 invisible safety grills overlooking metropolitan skyline at twilight"
        class="hero-media-img"
        loading="eager"
        width="1920"
        height="1080"
      />
    </picture>
    <!-- Coastal Architectural Multi-Stop Scrim Overlay -->
    <div class="hero-cinematic-scrim"></div>
  </div>

  <!-- Center-Bottom Content Overlay -->
  <div class="hero-content-container">
    <div class="hero-editorial-box">
      <!-- Cyan Eyebrow Badge -->
      <div class="hero-eyebrow-wrap">
        <span class="hero-editorial-eyebrow">
          <Sparkles size={13} className="text-cyan" />
          SS316 MARINE GRADE &bull; 10-YEAR WARRANTY
        </span>
      </div>

      <!-- Pure White / Navy Crisp Headline -->
      <h1 class="hero-editorial-title">
        INVISIBLE GRILLS &amp; SAFETY NETS
      </h1>

      <!-- High Legibility Subtitle -->
      <p class="hero-editorial-subtitle">
        Architectural residential safety engineered with 400+ kgf tensile SS316 cables and certified safety nets for unobstructed penthouse panoramas.
      </p>

      <!-- Conversion Actions: Warm Peach-Gold CTA + Frosted White-Blue Secondary -->
      <div class="hero-editorial-actions">
        <a href="/contact/#quote" class="hero-btn-primary">
          <span>REQUEST FREE SITE SURVEY</span>
          <ArrowRight size={15} />
        </a>

        <a href="#collections-showcase" class="hero-btn-secondary">
          <span>EXPLORE SAFETY SOLUTIONS</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* =========================================================================
     FULL-BLEED COASTAL HERO (100dvh)
     ========================================================================= */
  .editorial-hero {
    position: relative;
    width: 100%;
    min-height: 100dvh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    background-color: #0F1E36;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    border-bottom: 1px solid #D8E6F3;
  }

  .hero-media-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .hero-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: contrast(1.05) saturate(1.04);
    transform: scale(1.0);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .editorial-hero:hover .hero-media-img {
    transform: scale(1.03);
  }

  /* Coastal Atmospheric Scrim: Deep Navy & Ice Blue undertone */
  .hero-cinematic-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 30, 54, 0.18) 0%,
      rgba(15, 30, 54, 0.45) 50%,
      rgba(15, 30, 54, 0.9) 100%
    );
    pointer-events: none;
    z-index: 2;
  }

  /* Content Anchor */
  .hero-content-container {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 3.5vw, 2.5rem);
    padding-bottom: clamp(2.5rem, 6.5vh, 4.5rem);
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .hero-editorial-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 840px;
    width: 100%;
  }

  .hero-eyebrow-wrap {
    margin-bottom: 0.85rem;
  }

  .hero-editorial-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #38BDF8;
    background: rgba(15, 30, 54, 0.65);
    padding: 0.35rem 1.15rem;
    border-radius: 9999px;
    border: 1px solid rgba(56, 189, 248, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .hero-editorial-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: clamp(1.75rem, 4.8vw, 3.6rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.05em;
    color: #FFFFFF;
    text-transform: uppercase;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8), 0 4px 20px rgba(0, 0, 0, 0.6);
    margin: 0 0 0.85rem 0;
    max-width: 100%;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .hero-editorial-subtitle {
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.8vw, 1.12rem);
    color: #F1F5F9;
    line-height: 1.55;
    margin: 0 0 2rem 0;
    max-width: 680px;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.85);
    font-weight: 400;
  }

  .hero-editorial-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.15rem;
    flex-wrap: wrap;
  }

  /* Primary CTA: Warm Peach-Gold Gradient with Dark Navy Bold Text */
  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.85rem 2.25rem;
    background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
    color: #0F1E36 !important;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 800;
    text-decoration: none;
    border-radius: 9999px;
    border: 1px solid #F59E0B;
    box-shadow: 0 4px 20px rgba(245, 158, 11, 0.45);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-btn-primary:hover {
    background: linear-gradient(135deg, #FBBF24 0%, #EA580C 100%);
    color: #0F1E36 !important;
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(245, 158, 11, 0.6);
    border-color: #FBBF24;
  }

  /* Secondary: Frosted White-Blue Capsule */
  .hero-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.85rem 2.25rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #1E3A5F !important;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    text-decoration: none;
    border-radius: 9999px;
    border: 1px solid #D8E6F3;
    box-shadow: 0 4px 18px rgba(30, 58, 95, 0.15);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-btn-secondary:hover {
    background: #EBF3FA;
    color: #0284C7 !important;
    border-color: #0284C7;
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(2, 132, 199, 0.25);
  }

  @media (max-width: 640px) {
    .hero-editorial-actions {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
      gap: 0.75rem;
    }

    .hero-editorial-actions a {
      width: 100%;
    }
  }
</style>
