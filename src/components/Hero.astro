---
import { ArrowRight } from 'lucide-react';
---

<section class="editorial-hero">
  <!-- Edge-to-Edge Fullscreen Photography with High Dynamic Contrast & Responsive Crops -->
  <div class="hero-media-wrapper">
    <picture>
      <source media="(max-width: 768px)" srcset="/images/hero-balcony-twilight-mobile.jpg" />
      <img
        src="/images/hero-balcony-twilight.jpg"
        alt="Architectural penthouse balcony with modern SS316 invisible safety grills overlooking metropolitan skyline at twilight"
        class="hero-media-img"
        loading="eager"
        width="1920"
        height="1080"
      />
    </picture>
    <!-- Heavy Ambient Multi-Stop Vignette Overlay -->
    <div class="hero-cinematic-scrim"></div>
  </div>

  <!-- Center-Bottom Editorial Content Overlay -->
  <div class="hero-content-container">
    <div class="hero-editorial-box">
      <!-- Gold Eyebrow Micro-Typography -->
      <span class="hero-editorial-eyebrow">
        THE ARCHITECTURAL STANDARD
      </span>

      <!-- Pure White Editorial Headline -->
      <h1 class="hero-editorial-title">
        INVISIBLE GRILLS &amp; SAFETY NETS
      </h1>

      <!-- One-Sentence Italic Sub-Caption -->
      <p class="hero-editorial-subtitle">
        Architectural protection engineered with high-tension SS316 cables for unobstructed penthouse vistas.
      </p>

      <!-- Translucent Black-Glass Capsule Controls -->
      <div class="hero-editorial-actions">
        <a href="/contact/#quote" class="btn-editorial-glass">
          <span>REQUEST SITE SURVEY</span>
        </a>

        <a href="#collections-showcase" class="btn-editorial-glass-secondary">
          <span>EXPLORE SOLUTIONS</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* =========================================================================
     FULL-BLEED EDITORIAL HERO (100dvh)
     ========================================================================= */
  .editorial-hero {
    position: relative;
    width: 100%;
    min-height: 100dvh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    background-color: #121316;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hero-media-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  /* High Dynamic Contrast: Stainless steel reflections & skyline pop against daytime lighting */
  .hero-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: contrast(1.06) saturate(1.05);
    transform: scale(1.0);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .editorial-hero:hover .hero-media-img {
    transform: scale(1.03);
  }

  /* Drastically Reduced Dark Overlay: natural daylight breathes with legibility gradient at bottom */
  .hero-cinematic-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.1) 0%,
      rgba(0, 0, 0, 0.05) 50%,
      rgba(0, 0, 0, 0.7) 100%
    );
    pointer-events: none;
    z-index: 2;
  }

  /* Content Anchor */
  .hero-content-container {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 3.5vw, 2.5rem);
    padding-bottom: clamp(2.5rem, 6vh, 4.5rem);
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .hero-editorial-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 820px;
    width: 100%;
  }

  .hero-editorial-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #D4AF37;
    margin-bottom: 0.75rem;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.9);
  }

  .hero-editorial-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: clamp(1.6rem, 4.6vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.08em;
    color: #FFFFFF;
    text-transform: uppercase;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.8));
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8), 0 4px 20px rgba(0, 0, 0, 0.6);
    margin: 0 0 0.85rem 0;
    max-width: 100%;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .hero-editorial-subtitle {
    font-family: var(--font-sans);
    font-size: clamp(0.9rem, 1.8vw, 1.05rem);
    color: #F1F1F1;
    line-height: 1.55;
    margin: 0 0 2rem 0;
    max-width: 640px;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.85);
    font-weight: 400;
  }

  .hero-editorial-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .hero-editorial-actions {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
      gap: 0.75rem;
    }

    .hero-editorial-actions a {
      width: 100%;
    }
  }
</style>
