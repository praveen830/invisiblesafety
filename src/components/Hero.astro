---
import { ArrowRight } from 'lucide-react';
---

<section class="editorial-hero">
  <!-- Edge-to-Edge Fullscreen Photography -->
  <div class="hero-media-wrapper">
    <img
      src="/images/hero-balcony.webp"
      alt="Architectural balcony with modern invisible safety grills overlooking city skyline at golden hour"
      class="hero-media-img"
      loading="eager"
      width="1920"
      height="1080"
    />
    <!-- Cinematic Ambient Scrim Overlay -->
    <div class="hero-cinematic-scrim"></div>
  </div>

  <!-- Center-Bottom Editorial Content Overlay -->
  <div class="hero-content-container">
    <div class="hero-editorial-box">
      <!-- Minimalist Overline / Eyebrow -->
      <span class="hero-editorial-eyebrow">
        THE ARCHITECTURAL STANDARD
      </span>

      <!-- High-Fashion Editorial Headline -->
      <h1 class="hero-editorial-title">
        INVISIBLE GRILLS &amp; SAFETY NETS
      </h1>

      <!-- Single-Line Micro-Copy -->
      <p class="hero-editorial-subtitle">
        Architectural safety for modern discerning homes.
      </p>

      <!-- Minimal Frosted Glass Action Buttons -->
      <div class="hero-editorial-actions">
        <a href="/contact/#quote" class="btn-editorial-pill">
          <span>REQUEST SITE SURVEY</span>
        </a>

        <a href="#collections-showcase" class="btn-editorial-outline">
          <span>EXPLORE SOLUTIONS</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* =========================================================================
     FULL-BLEED EDITORIAL HERO (100dvh)
      ========================================================================= */
  .editorial-hero {
    position: relative;
    width: 100%;
    min-height: 100dvh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    background-color: #0D0D0D;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .hero-media-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .hero-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.0);
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .editorial-hero:hover .hero-media-img {
    transform: scale(1.04);
  }

  /* Soft Cinematic Scrim Overlay */
  .hero-cinematic-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.25) 0%,
      transparent 30%,
      rgba(0, 0, 0, 0.45) 60%,
      rgba(0, 0, 0, 0.9) 100%
    );
    opacity: 0.65;
    transition: opacity 0.8s cubic-bezier(0.25, 1, 0.5, 1);
    pointer-events: none;
    z-index: 2;
  }

  .editorial-hero:hover .hero-cinematic-scrim {
    opacity: 0.8;
  }

  /* Content Anchor */
  .hero-content-container {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 3.5vw, 2.5rem);
    padding-bottom: clamp(2.25rem, 5.5vh, 4rem);
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .hero-editorial-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 820px;
  }

  .hero-editorial-eyebrow {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #E2E8F0;
    margin-bottom: 0.65rem;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.85);
  }

  .hero-editorial-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: clamp(1.4rem, 4.5vw, 3.2rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.05em;
    color: #FFFFFF;
    text-transform: uppercase;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.9), 0 4px 30px rgba(0, 0, 0, 0.7);
    margin: 0 0 0.65rem 0;
    max-width: 100%;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .hero-editorial-subtitle {
    font-family: var(--font-serif, 'Playfair Display', serif);
    font-style: italic;
    font-size: clamp(0.85rem, 2vw, 1.15rem);
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.5;
    margin: 0 0 1.65rem 0;
    max-width: 580px;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.85);
  }

  .hero-editorial-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .hero-editorial-actions {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
      gap: 0.75rem;
    }

    .hero-editorial-actions a {
      width: 100%;
    }
  }
</style>
