---
import { business } from '../data/business';
import { Phone, MessageCircle, ShieldCheck, Eye, Award, ArrowRight } from 'lucide-react';
---

<section class="arch-hero-section relative bg-gradient-to-b from-[#F0F5FA] via-white to-white md:py-12 lg:py-16 overflow-hidden">
  <div class="hero-inner-container max-w-7xl mx-auto px-0 md:px-6 lg:px-8">
    <div class="flex flex-col md:grid md:grid-cols-2 md:gap-8 lg:gap-14 md:items-center">

      <!-- =========================================================================
           PHOTO BLOCK:
           Mobile (<768px): Top Photo Block, strictly 4:5, 100% unobstructed, zero text
           Desktop (≥768px): Right Column (order-2), cleanly framed with full clarity
           ========================================================================= -->
      <div class="hero-media-col order-1 md:order-2 w-full">
        <div class="hero-photo-frame relative w-full aspect-[4/5] md:aspect-[4/3] lg:aspect-[16/11] overflow-hidden md:rounded-3xl md:shadow-card md:border md:border-slate-200/80">
          <picture class="block w-full h-full">
            <source
              media="(min-width: 768px)"
              srcset="/images/hero-balcony.webp"
              type="image/webp"
              width="1376"
              height="768"
            />
            <source
              media="(max-width: 767px)"
              srcset="/images/hero-balcony-twilight-mobile.jpg"
              type="image/jpeg"
              width="768"
              height="1376"
            />
            <img
              src="/images/hero-balcony.webp"
              alt="High-rise apartment balcony protected with SS316 invisible safety grills"
              class="hero-img w-full h-full object-cover object-center"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="1376"
              height="768"
            />
          </picture>
        </div>
      </div>

      <!-- =========================================================================
           CONTENT / CONVERSION COLUMN:
           Mobile (<768px): Elevated Conversion Card directly below photo (-mt-6 z-10)
           Desktop (≥768px): Left Column (order-1), architectural high-trust showcase
           ========================================================================= -->
      <div class="hero-content-col order-2 md:order-1 w-full">
        <div class="hero-conversion-card relative z-10 -mt-6 mx-3.5 p-5 md:mt-0 md:mx-0 md:p-0 bg-gradient-to-b from-[#F0F5FA] to-white md:bg-transparent rounded-3xl md:rounded-none shadow-card md:shadow-none border border-slate-100/90 md:border-0">

          <!-- Architectural Eyebrow Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-slate-200/80 text-[11px] font-bold text-[#0F233D] mb-3 shadow-2xs">
            <span class="w-2 h-2 rounded-full bg-[#25D366] animate-pulse"></span>
            <span>South India's Architectural Safety Specialist</span>
          </div>

          <!-- Single Authoritative SEO H1 -->
          <h1 class="font-brand text-2xl sm:text-3xl md:text-4xl lg:text-[2.75rem] font-extrabold text-[#0F233D] tracking-tight leading-[1.18] mb-2 md:mb-4">
            Invisible Grills &amp; Safety Nets<span class="hidden md:inline"> for a Safer, Happier Home</span>
          </h1>

          <!-- Value Proposition & Subtitle -->
          <p class="text-sm md:text-base lg:text-lg text-slate-600 leading-relaxed mb-4 md:mb-6">
            <span class="font-bold text-[#0F233D] block md:inline">Safety. Style. Peace of Mind.</span>
            <span class="text-slate-500 hidden md:inline"> — Preserve 98% panoramic daylight and balcony vistas while safeguarding your loved ones with 400+ kg tensile SS316 marine-grade cables and certified polymer safety nets.</span>
          </p>

          <!-- =====================================================================
               MOBILE TRUST BADGES (<768px):
               3 compact trust badges in a clean horizontal row
               ===================================================================== -->
          <div class="flex items-center justify-between gap-1.5 sm:gap-2 mb-5 md:hidden">
            <div class="flex-1 flex items-center justify-center gap-1.5 py-2 px-1 bg-white rounded-xl border border-slate-200/80 shadow-2xs">
              <ShieldCheck size={14} className="text-[#2D89EF] shrink-0" />
              <span class="text-[11px] font-bold text-[#0F233D] whitespace-nowrap">SS316 Grade</span>
            </div>
            <div class="flex-1 flex items-center justify-center gap-1.5 py-2 px-1 bg-white rounded-xl border border-slate-200/80 shadow-2xs">
              <Award size={14} className="text-[#C6A66B] shrink-0" />
              <span class="text-[11px] font-bold text-[#0F233D] whitespace-nowrap">15-Yr Warranty</span>
            </div>
            <div class="flex-1 flex items-center justify-center gap-1.5 py-2 px-1 bg-white rounded-xl border border-slate-200/80 shadow-2xs">
              <Eye size={14} className="text-[#2D89EF] shrink-0" />
              <span class="text-[11px] font-bold text-[#0F233D] whitespace-nowrap">100% Clear View</span>
            </div>
          </div>

          <!-- =====================================================================
               DESKTOP TRUST ICONS (≥768px):
               3 crisp trust icons in the left column
               ===================================================================== -->
          <div class="hidden md:grid md:grid-cols-3 gap-3 my-6 py-4 border-y border-slate-200/80">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-[#F0F5FA] flex items-center justify-center text-[#2D89EF] shrink-0 border border-[#2D89EF]/20">
                <ShieldCheck size={20} />
              </div>
              <div>
                <span class="block text-sm font-bold text-[#0F233D]">100% Safety</span>
                <span class="block text-xs text-slate-500">400+ kg breaking load</span>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-[#FDF6EE] flex items-center justify-center text-[#C6A66B] shrink-0 border border-[#C6A66B]/30">
                <Award size={20} />
              </div>
              <div>
                <span class="block text-sm font-bold text-[#0F233D]">SS316 Marine</span>
                <span class="block text-xs text-slate-500">Virgin Japanese steel</span>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-[#F0F5FA] flex items-center justify-center text-[#2D89EF] shrink-0 border border-[#2D89EF]/20">
                <Eye size={20} />
              </div>
              <div>
                <span class="block text-sm font-bold text-[#0F233D]">Clear View</span>
                <span class="block text-xs text-slate-500">98% daylight clarity</span>
              </div>
            </div>
          </div>

          <!-- =====================================================================
               SIDE-BY-SIDE PILL CTA BUTTONS (min-h-[48px])
               ===================================================================== -->
          <div class="grid grid-cols-2 gap-3 sm:flex sm:items-center sm:gap-4 mb-3">
            <!-- Call Now CTA -->
            <a
              href={`tel:${business.phoneRaw}`}
              class="btn-hero-call flex items-center justify-center gap-2 min-h-[48px] px-5 py-3 rounded-full bg-[#0F233D] hover:bg-[#1A365D] text-white font-bold text-sm shadow-md transition-all active:scale-[0.98] text-center"
              aria-label={`Call Now at ${business.phone}`}
            >
              <Phone size={16} className="text-[#C6A66B] shrink-0" />
              <span>Call Now</span>
            </a>

            <!-- WhatsApp CTA -->
            <a
              href={`https://wa.me/${business.whatsapp}?text=Hello%20Invisible%20Safety%2C%20I%20am%20interested%20in%20an%20instant%20quote%20for%20balcony%20invisible%20grills%20%26%20safety%20nets.`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-hero-whatsapp flex items-center justify-center gap-2 min-h-[48px] px-5 py-3 rounded-full bg-[#25D366] hover:bg-[#20BA5A] text-white font-bold text-sm shadow-md transition-all active:scale-[0.98] text-center"
              aria-label="Chat on WhatsApp"
            >
              <MessageCircle size={17} className="text-white shrink-0" />
              <span class="md:hidden">WhatsApp</span>
              <span class="hidden md:inline">Chat on WhatsApp</span>
            </a>
          </div>

          <!-- Quick Jump Link to Estimator -->
          <div class="pt-2 text-center md:text-left">
            <a href="#interactive-planner" class="inline-flex items-center gap-1.5 text-xs md:text-sm font-semibold text-slate-500 hover:text-[#0F233D] transition-colors">
              <span>Calculate Cost &amp; Preview 3D Balcony</span>
              <ArrowRight size={13} className="text-[#C6A66B]" />
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Ensure smooth transition and prevent any CLS */
  .arch-hero-section {
    contain: layout paint;
  }

  .hero-img {
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-photo-frame:hover .hero-img {
    transform: scale(1.02);
  }

  /* Responsive shadow & card refinement */
  @media (max-width: 767px) {
    .hero-photo-frame {
      border-radius: 0 0 1.25rem 1.25rem;
    }
  }
</style>
