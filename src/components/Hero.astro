---
import { business } from '../data/business';
import { ArrowRight, CheckCircle2, ShieldCheck, MapPin, Sparkles, Eye, Award } from 'lucide-react';
---

<section class="hero-section">
  <!-- Attractive Vibrant Balcony Photograph Background (Bright Daylight) -->
  <div class="hero-bg-container">
    <img
      src="/images/hero-balcony.webp"
      alt="Modern apartment balcony with professionally installed invisible safety grills"
      class="hero-bg-img"
      loading="eager"
      width="1920"
      height="1080"
    />
    <!-- Soft Light Fade on Left Edge Only - Center & Right are 100% Bright, Sunny & Attractive -->
    <div class="hero-overlay"></div>
  </div>

  <div class="container hero-container">
    <!-- Pinned to Left Side: Clean, Compact, Not Center -->
    <div class="hero-content">
      <!-- Refined Eyebrow Pill -->
      <div class="hero-eyebrow-pill">
        <Sparkles size={14} className="eyebrow-sparkle" />
        <span>ARCHITECTURAL SAFETY SOLUTIONS</span>
      </div>

      <!-- Main Heading with Elegant Light-Theme Typography -->
      <h1 class="hero-title">
        Invisible Grills & <br />
        <span class="hero-title-accent">Safety Solutions</span> <br />
        for Modern Homes
      </h1>

      <!-- Supporting Body Copy in Crisp Slate -->
      <p class="hero-description">
        Protect your high-rise balconies, French windows, and open staircases without losing your skyline view. Engineered with marine-grade SS316 cables and high-tenacity safety systems.
      </p>

      <!-- Primary Action Buttons -->
      <div class="hero-actions">
        <a href="/contact/#quote" class="btn btn-primary btn-lg hero-btn-quote">
          <span>GET A FREE QUOTE</span>
          <ArrowRight size={18} />
        </a>

        <a href="/visualizer/" class="btn btn-secondary btn-lg hero-btn-visualizer">
          <Eye size={18} />
          <span>TRY VISUALIZER</span>
        </a>
      </div>

      <!-- City Service Coverage Strip -->
      <div class="hero-location-strip">
        <MapPin size={15} className="location-icon" />
        <span>Free doorstep site measurement across <strong>Hyderabad, Vizag & Vijayawada</strong></span>
      </div>

      <!-- Sleek Feature Chips (Clean Light Glass Style) -->
      <div class="hero-chips-strip">
        <div class="hero-chip">
          <ShieldCheck size={15} className="chip-icon" />
          <span>SS316 Marine Grade</span>
        </div>
        <div class="hero-chip">
          <Award size={15} className="chip-icon" />
          <span>400+ kgf Breaking Load</span>
        </div>
        <div class="hero-chip">
          <Eye size={15} className="chip-icon" />
          <span>98% Panoramic Clarity</span>
        </div>
        <div class="hero-chip">
          <CheckCircle2 size={15} className="chip-icon" />
          <span>10-Year Warranty</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: clamp(580px, 82vh, 760px);
    display: flex;
    align-items: center;
    padding: clamp(40px, 5vw, 70px) 0;
    overflow: hidden;
    background-color: #F8FAFC;
  }

  .hero-bg-container {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    filter: brightness(1.04) contrast(1.05) saturate(1.12);
    transform: scale(1.01);
    transition: transform 1.5s cubic-bezier(0.25, 1, 0.35, 1);
  }

  .hero-section:hover .hero-bg-img {
    transform: scale(1.03);
  }

  /* 
   * SOFT LIGHT LEFT SCENE FADE:
   * Keeps the center and right 65%+ of the image 100% natural, sunny, and attractive.
   * Provides clean, soft light tone strictly behind the left-side text.
   */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.96) 0%,
      rgba(255, 255, 255, 0.90) 24%,
      rgba(255, 255, 255, 0.55) 40%,
      rgba(255, 255, 255, 0.12) 56%,
      transparent 72%
    );
    pointer-events: none;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1400px;
    padding: 0 clamp(1rem, 3.5vw, 3.5rem);
  }

  /* Text Pinned to Left Side - NOT in the Center */
  .hero-content {
    max-width: 490px;
    margin-right: auto;
    margin-left: 0;
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  /* Refined Light Eyebrow Badge */
  .hero-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.9rem;
    background: #EFF6FF;
    border: 1px solid #BFDBFE;
    border-radius: 30px;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #1D4ED8;
    margin-bottom: 1.15rem;
    width: fit-content;
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.08);
  }

  .eyebrow-sparkle {
    color: #2563EB;
  }

  /* Main Headline with Refined Light Theme Colors */
  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 3.6vw, 3.25rem);
    font-weight: 800;
    line-height: 1.16;
    letter-spacing: -0.025em;
    color: #0F172A;
    margin-bottom: 1.15rem;
  }

  .hero-title-accent {
    color: #0284C7;
    display: inline-block;
  }

  /* Value Description */
  .hero-description {
    font-size: clamp(0.98rem, 1.1vw, 1.08rem);
    color: #475569;
    line-height: 1.65;
    margin-bottom: 1.65rem;
  }

  /* Action Buttons */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.35rem;
    flex-wrap: wrap;
  }

  .hero-btn-quote {
    background: #2563EB;
    color: #FFFFFF;
    box-shadow: 0 6px 18px -3px rgba(37, 99, 235, 0.4);
    font-weight: 700;
    padding: 0.8rem 1.5rem;
    border-radius: 8px;
    border: none;
  }

  .hero-btn-quote:hover {
    background: #1D4ED8;
    box-shadow: 0 10px 24px -4px rgba(37, 99, 235, 0.55);
    transform: translateY(-2px);
  }

  .hero-btn-visualizer {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.8rem 1.35rem;
    border-radius: 8px;
    background: #FFFFFF;
    border: 1.5px solid #CBD5E1;
    color: #0F172A;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    transition: all 0.2s ease;
  }

  .hero-btn-visualizer:hover {
    border-color: #2563EB;
    color: #2563EB;
    background: #F8FAFC;
    transform: translateY(-2px);
  }

  /* Location Strip */
  .hero-location-strip {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: #64748B;
    margin-bottom: 1.5rem;
  }

  .location-icon {
    color: #0284C7;
    flex-shrink: 0;
  }

  .hero-location-strip strong {
    color: #1E293B;
  }

  /* Sleek Feature Chips (Clean Light Glass Style) */
  .hero-chips-strip {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .hero-chip {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid #E2E8F0;
    border-radius: 20px;
    padding: 0.35rem 0.8rem;
    color: #334155;
    font-size: 0.76rem;
    font-weight: 600;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.04);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .hero-chip:hover {
    border-color: #38BDF8;
    color: #0F172A;
    transform: translateY(-1px);
  }

  .chip-icon {
    color: #0284C7;
    flex-shrink: 0;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .hero-section {
      min-height: auto;
      padding: 40px 0;
    }

    .hero-overlay {
      background: rgba(255, 255, 255, 0.88);
    }

    .hero-content {
      max-width: 100%;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
