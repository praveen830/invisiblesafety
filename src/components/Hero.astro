---
import { business } from '../data/business';
import { ArrowRight, CheckCircle2, ShieldCheck, MapPin, Sparkles } from 'lucide-react';
---

<section class="hero-section">
  <!-- Realistic Indian Apartment Balcony Photograph Background -->
  <div class="hero-bg-container">
    <img
      src="/images/hero-balcony.webp"
      alt="Modern apartment balcony with professionally installed invisible safety grills"
      class="hero-bg-img"
      loading="eager"
      width="1920"
      height="1080"
    />
    <!-- Subtle, light gradient that preserves 100% of photo vibrance & clarity -->
    <div class="hero-overlay"></div>
  </div>

  <!-- Floating Installation Feature Badge Over The Balcony Image -->
  <div class="hero-image-badge">
    <div class="badge-icon-wrap">
      <ShieldCheck size={20} />
    </div>
    <div class="badge-info">
      <span class="badge-title">SS316 Marine Grade Cables</span>
      <span class="badge-desc">400+ kgf Breaking Load • 98% Panoramic View</span>
    </div>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      <!-- Architectural Eyebrow Pill -->
      <div class="hero-eyebrow-pill">
        <ShieldCheck size={14} />
        <span>ARCHITECTURAL SAFETY SOLUTIONS</span>
      </div>

      <!-- Primary H1 -->
      <h1 class="hero-title">
        Invisible Grills & Safety Solutions for Modern Homes
      </h1>

      <!-- Supporting Body Copy -->
      <p class="hero-description">
        Protect balconies, windows and open spaces with professionally installed invisible grills and safety net systems designed for modern residential spaces.
      </p>

      <!-- Primary Action Buttons -->
      <div class="hero-actions">
        <a href="/contact/#quote" class="btn btn-primary btn-lg">
          <span>GET A FREE QUOTE</span>
          <ArrowRight size={18} />
        </a>

        <a href="#protect-journey" class="btn btn-secondary btn-lg">
          <span>VIEW OUR PRODUCTS</span>
        </a>
      </div>

      <!-- Verified Trust Strip -->
      <div class="hero-trust-strip">
        <div class="trust-item">
          <CheckCircle2 size={16} className="text-blue" />
          <span>SS316 options</span>
        </div>
        <span class="trust-divider">•</span>
        <div class="trust-item">
          <CheckCircle2 size={16} className="text-blue" />
          <span>Professional installation</span>
        </div>
        <span class="trust-divider">•</span>
        <div class="trust-item">
          <MapPin size={16} className="text-blue" />
          <span>Service across Hyderabad, Vizag & Vijayawada</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: clamp(580px, 78vh, 720px);
    display: flex;
    align-items: center;
    padding: 64px 0;
    overflow: hidden;
    background-color: #0F172A;
  }

  .hero-bg-container {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    filter: brightness(1.02) contrast(1.04) saturate(1.08);
    transform: scale(1.01);
    transition: transform 1.2s cubic-bezier(0.25, 1, 0.35, 1);
  }

  .hero-section:hover .hero-bg-img {
    transform: scale(1.02);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    /* Ultra-subtle light vignette so background image is fully highlighted and attractive */
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.52) 0%,
      rgba(255, 255, 255, 0.22) 38%,
      rgba(0, 0, 0, 0) 65%
    );
    pointer-events: none;
  }

  /* Floating badge on the right over the balcony photo */
  .hero-image-badge {
    position: absolute;
    right: 2.5rem;
    bottom: 2.5rem;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background: rgba(15, 23, 42, 0.84);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50px;
    padding: 0.65rem 1.35rem 0.65rem 0.85rem;
    color: #FFFFFF;
    box-shadow: 0 16px 36px -6px rgba(15, 23, 42, 0.38);
    pointer-events: none;
    transition: transform 0.3s ease;
  }

  .badge-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #0284C7;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    flex-shrink: 0;
  }

  .badge-info {
    display: flex;
    flex-direction: column;
  }

  .badge-title {
    font-size: 0.86rem;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.25;
  }

  .badge-desc {
    font-size: 0.72rem;
    color: #BAE6FD;
    line-height: 1.25;
    font-weight: 500;
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  /* Frosted Glass Architectural Card for crisp readability without blocking image view */
  .hero-content {
    max-width: 610px;
    background: rgba(255, 255, 255, 0.90);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 2.75rem 2.5rem;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.95);
    box-shadow: 0 20px 45px -10px rgba(15, 23, 42, 0.16), 0 0 0 1px rgba(255, 255, 255, 0.6);
  }

  .hero-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    background: #E0F2FE;
    border: 1px solid #BAE6FD;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #0369A1;
    margin-bottom: 1.15rem;
    width: fit-content;
  }

  .hero-title {
    font-size: clamp(2.1rem, 3.8vw, 3.2rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.025em;
    margin-bottom: 1.15rem;
    color: #0F172A;
  }

  .hero-description {
    font-size: 1.08rem;
    color: #475569;
    line-height: 1.65;
    margin-bottom: 1.85rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .hero-trust-strip {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    font-size: 0.86rem;
    font-weight: 600;
    color: #475569;
    padding-top: 1rem;
    border-top: 1px solid #E2E8F0;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .trust-divider {
    color: #CBD5E1;
  }

  .text-blue {
    color: var(--color-accent);
  }

  @media (max-width: 1024px) {
    .hero-image-badge {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .hero-section {
      min-height: auto;
      padding: 40px 0 48px 0;
    }

    .hero-overlay {
      background: rgba(255, 255, 255, 0.4);
    }

    .hero-content {
      max-width: 100%;
      padding: 2rem 1.5rem;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.94);
    }
  }

  @media (max-width: 500px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }

    .hero-trust-strip {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .trust-divider {
      display: none;
    }
  }
</style>
