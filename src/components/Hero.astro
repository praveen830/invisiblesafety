---
import { business } from '../data/business';
import { ArrowRight, CheckCircle2, ShieldCheck, MapPin } from 'lucide-react';
---

<section class="hero-section">
  <!-- Realistic Indian Apartment Balcony Photograph Background -->
  <div class="hero-bg-container">
    <img
      src="/images/hero-balcony.webp"
      alt="Modern apartment balcony with professionally installed invisible safety grills"
      class="hero-bg-img"
      loading="eager"
      width="1920"
      height="1080"
    />
    <!-- Clean, natural gradient overlay for optimal text legibility -->
    <div class="hero-overlay"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      <!-- Small Eyebrow -->
      <span class="hero-eyebrow">
        ARCHITECTURAL SAFETY SOLUTIONS
      </span>

      <!-- Primary H1 -->
      <h1 class="hero-title">
        Invisible Grills & Safety Solutions for Modern Homes
      </h1>

      <!-- Supporting Body Copy -->
      <p class="hero-description">
        Protect balconies, windows and open spaces with professionally installed invisible grills and safety net systems designed for modern residential spaces.
      </p>

      <!-- Primary Action Buttons -->
      <div class="hero-actions">
        <a href="/contact/#quote" class="btn btn-primary btn-lg">
          <span>GET A FREE QUOTE</span>
          <ArrowRight size={18} />
        </a>

        <a href="#protect-journey" class="btn btn-secondary btn-lg">
          <span>VIEW OUR PRODUCTS</span>
        </a>
      </div>

      <!-- Verified Trust Strip -->
      <div class="hero-trust-strip">
        <div class="trust-item">
          <CheckCircle2 size={16} className="text-blue" />
          <span>SS316 options</span>
        </div>
        <span class="trust-divider">•</span>
        <div class="trust-item">
          <CheckCircle2 size={16} className="text-blue" />
          <span>Professional installation</span>
        </div>
        <span class="trust-divider">•</span>
        <div class="trust-item">
          <MapPin size={16} className="text-blue" />
          <span>Service across Hyderabad, Vizag & Vijayawada</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 580px;
    display: flex;
    align-items: center;
    padding: 72px 0 80px 0;
    overflow: hidden;
    background-color: var(--color-bg-warm);
  }

  .hero-bg-container {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    /* Clean white gradient on left for high contrast text readability */
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.92) 42%, rgba(255, 255, 255, 0.6) 75%, rgba(255, 255, 255, 0.2) 100%);
  }

  .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-content {
    max-width: 650px;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 0.85rem;
  }

  .hero-title {
    margin-bottom: 1.25rem;
    color: var(--color-primary);
  }

  .hero-description {
    font-size: 1.15rem;
    color: var(--color-secondary);
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.25rem;
    flex-wrap: wrap;
  }

  .hero-trust-strip {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-secondary);
    padding-top: 1rem;
    border-top: 1px solid rgba(226, 232, 240, 0.8);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .trust-divider {
    color: #CBD5E1;
  }

  .text-blue {
    color: var(--color-accent);
  }

  @media (max-width: 900px) {
    .hero-overlay {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.97) 0%, rgba(255, 255, 255, 0.9) 100%);
    }

    .hero-section {
      min-height: auto;
      padding: 56px 0 64px 0;
    }
  }

  @media (max-width: 500px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-actions .btn {
      width: 100%;
    }

    .hero-trust-strip {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .trust-divider {
      display: none;
    }
  }
</style>
