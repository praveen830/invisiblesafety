---
import { PhoneCall, Ruler, FileCheck, Wrench, Award, ChevronRight } from 'lucide-react';
---

<section class="section-spacing" style="background: #090D16; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
  <div class="container">
    <div class="section-header">
      <span class="badge-emerald">Frictionless Experience</span>
      <h2>Our 4-Step Precision Workflow</h2>
      <p>
        From your initial enquiry to final tension sign-off, experience transparent pricing, certified high-rise safety, and flawless installation.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; position: relative;">
      <!-- Step 1 -->
      <div class="arch-card" style="position: relative;">
        <div style="font-size: 2.5rem; font-weight: 800; color: rgba(56, 189, 248, 0.2); line-height: 1; margin-bottom: 0.75rem; font-family: var(--font-heading);">
          01
        </div>
        <div style="width: 40px; height: 40px; border-radius: 8px; background: rgba(2, 132, 199, 0.15); display: flex; align-items: center; justify-content: center; color: #38BDF8; margin-bottom: 1rem;">
          <PhoneCall size={20} />
        </div>
        <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; color: #FFFFFF;">
          Fast Enquiry & Triage
        </h3>
        <p style="font-size: 0.85rem; color: #94A3B8; line-height: 1.5;">
          Connect instantly via WhatsApp or phone. Our technical team responds within 15 minutes to understand your balcony specifications and requirements.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="arch-card" style="position: relative;">
        <div style="font-size: 2.5rem; font-weight: 800; color: rgba(56, 189, 248, 0.2); line-height: 1; margin-bottom: 0.75rem; font-family: var(--font-heading);">
          02
        </div>
        <div style="width: 40px; height: 40px; border-radius: 8px; background: rgba(2, 132, 199, 0.15); display: flex; align-items: center; justify-content: center; color: #38BDF8; margin-bottom: 1rem;">
          <Ruler size={20} />
        </div>
        <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; color: #FFFFFF;">
          Laser Site Measurement
        </h3>
        <p style="font-size: 0.85rem; color: #94A3B8; line-height: 1.5;">
          Our engineer arrives at your home with optical laser distance meters and real physical SS316 wire & track samples so you can inspect material quality firsthand.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="arch-card" style="position: relative;">
        <div style="font-size: 2.5rem; font-weight: 800; color: rgba(56, 189, 248, 0.2); line-height: 1; margin-bottom: 0.75rem; font-family: var(--font-heading);">
          03
        </div>
        <div style="width: 40px; height: 40px; border-radius: 8px; background: rgba(2, 132, 199, 0.15); display: flex; align-items: center; justify-content: center; color: #38BDF8; margin-bottom: 1rem;">
          <Wrench size={20} />
        </div>
        <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; color: #FFFFFF;">
          Harness-Certified Install
        </h3>
        <p style="font-size: 0.85rem; color: #94A3B8; line-height: 1.5;">
          Trained technicians equipped with IS 3521 full-body harnesses install heavy-duty track frames and tension each cable to precise kilogram-force calibration.
        </p>
      </div>

      <!-- Step 4 -->
      <div class="arch-card" style="position: relative;">
        <div style="font-size: 2.5rem; font-weight: 800; color: rgba(56, 189, 248, 0.2); line-height: 1; margin-bottom: 0.75rem; font-family: var(--font-heading);">
          04
        </div>
        <div style="width: 40px; height: 40px; border-radius: 8px; background: rgba(16, 185, 129, 0.15); display: flex; align-items: center; justify-content: center; color: #34D399; margin-bottom: 1rem;">
          <Award size={20} />
        </div>
        <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; color: #FFFFFF;">
          Sign-Off & 10-Yr Warranty
        </h3>
        <p style="font-size: 0.85rem; color: #94A3B8; line-height: 1.5;">
          You inspect and approve the tension. We issue your digital 10-year warranty certificate with a free 3-month complimentary tension inspection voucher.
        </p>
      </div>
    </div>
  </div>
</section>
