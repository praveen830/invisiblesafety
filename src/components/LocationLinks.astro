---
import { locations } from '../data/locations';
import { MapPin, ArrowRight, Phone } from 'lucide-react';
---

<section class="section-spacing bg-warm" style="border-bottom: 1px solid var(--color-border);">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">DEDICATED SERVICE HUBS</span>
      <h2>Locally Certified Installation Teams</h2>
      <p>
        Invisible Safety operates dedicated on-ground field crews with laser measurement tools and full work-at-height safety gear in each service city.
      </p>
    </div>

    <div class="grid-3">
      {Object.values(locations).map(loc => (
        <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; background: #FFFFFF;">
          <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; color: #2563EB; font-weight: 700; font-size: 0.85rem; margin-bottom: 0.5rem;">
              <MapPin size={16} />
              <span>{loc.state.toUpperCase()}</span>
            </div>

            <h3 style="font-size: 1.35rem; font-weight: 700; color: #0F172A; margin-bottom: 0.6rem;">
              {loc.name}
            </h3>

            <p style="font-size: 0.92rem; color: #475569; line-height: 1.6; margin-bottom: 1.25rem;">
              {loc.heroSubheadline}
            </p>

            <div style="font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.04em;">
              Popular Localities Served:
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.5rem;">
              {loc.keyAreas.slice(0, 4).map(area => (
                <span style="font-size: 0.78rem; background: #F1F5F9; border: 1px solid #E2E8F0; padding: 0.25rem 0.6rem; border-radius: 6px; color: #475569; font-weight: 500;">
                  {area.name.split('&')[0].trim()}
                </span>
              ))}
            </div>
          </div>

          <div style="border-top: 1px solid #F1F5F9; padding-top: 1rem; display: flex; justify-content: space-between; align-items: center;">
            <a href={`/locations/${loc.slug}/`} class="btn btn-secondary btn-sm" style="font-size: 0.84rem; display: inline-flex; align-items: center; gap: 0.35rem;">
              <span>View City Hub</span>
              <ArrowRight size={14} />
            </a>
            <span style="font-size: 0.78rem; color: #16A34A; font-weight: 700;">Same-Day Site Visit</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
