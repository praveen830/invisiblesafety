---
import { locations } from '../data/locations';
import { MapPin, ArrowRight, Phone } from 'lucide-react';
---

<section class="section-spacing" style="background: #0B0F19; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
  <div class="container">
    <div class="section-header">
      <span class="badge-emerald">Dedicated Service Hubs</span>
      <h2>Locally Certified Installation Teams</h2>
      <p>
        InvisProtect operates dedicated on-ground field crews with laser measurement tools and full work-at-height safety gear in each service city.
      </p>
    </div>

    <div class="grid-3">
      {Object.values(locations).map(loc => (
        <div class="arch-card" style="display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; color: #38BDF8; font-weight: 700; font-size: 0.85rem; margin-bottom: 0.5rem;">
              <MapPin size={16} />
              <span>{loc.state.toUpperCase()}</span>
            </div>

            <h3 style="font-size: 1.4rem; font-weight: 700; color: #FFFFFF; margin-bottom: 0.6rem;">
              {loc.name}
            </h3>

            <p style="font-size: 0.88rem; color: #94A3B8; line-height: 1.5; margin-bottom: 1.25rem;">
              {loc.heroSubheadline}
            </p>

            <div style="font-size: 0.78rem; font-weight: 600; color: #CBD5E1; margin-bottom: 0.4rem; text-transform: uppercase; letter-spacing: 0.04em;">
              Popular Localities Served:
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1.5rem;">
              {loc.keyAreas.slice(0, 4).map(area => (
                <span style="font-size: 0.75rem; background: rgba(255, 255, 255, 0.05); padding: 0.2rem 0.55rem; border-radius: 4px; color: #CBD5E1;">
                  {area.name.split('&')[0].trim()}
                </span>
              ))}
            </div>
          </div>

          <div style="border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 1rem; display: flex; justify-content: space-between; align-items: center;">
            <a href={`/locations/${loc.slug}/`} class="btn btn-outline btn-sm" style="font-size: 0.82rem; display: flex; align-items: center; gap: 0.3rem;">
              <span>View City Hub</span>
              <ArrowRight size={14} />
            </a>
            <span style="font-size: 0.78rem; color: #10B981; font-weight: 600;">Same-Day Site Visit</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
