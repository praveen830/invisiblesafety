---
/**
 * Invisible Safety — Location Architecture & Presentation Foundation
 * GeoConversionCTA.astro
 * 
 * Reusable editorial call-to-action block:
 * - Rich deep navy background with warm amber/gold accents
 * - Direct click-to-call with approved business number: +91 83097 55398
 * - Direct WhatsApp dispatch with pre-filled location context
 * - Preserves existing persistent desktop and mobile dock behavior
 */

export interface Props {
  headline?: string;
  subheadline?: string;
  locationName?: string;
  productName?: string;
  phone?: string;
  whatsapp?: string;
  className?: string;
}

const {
  headline,
  subheadline,
  locationName = 'your area',
  productName,
  phone = '+91 83097 55398',
  whatsapp = '918309755398',
  className = ''
} = Astro.props;

const cleanPhone = phone.replace(/[^0-9]/g, '');
const telHref = `tel:+${cleanPhone}`;

const waText = encodeURIComponent(
  `Hi Invisible Safety, I am in ${locationName} and would like to schedule a free doorstep measurement survey${productName ? ` for ${productName}` : ''}.`
);
const waHref = `https://wa.me/${whatsapp}?text=${waText}`;

const displayHeadline = headline || `Inquire About Balcony Safety in ${locationName}`;
const displaySubheadline = subheadline || `Connect with our team to discuss balcony safety requirements and check installation availability in ${locationName}.`;
---

<section class={`geo-conversion-cta relative bg-[#0F233D] text-white py-14 md:py-20 overflow-hidden ${className}`}>
  <!-- Subtle Gradient Lighting Accent -->
  <div class="absolute -top-24 -right-24 w-96 h-96 bg-[#C6A66B]/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <!-- Tag -->
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-widest text-[#C6A66B] bg-white/5 border border-white/10 mb-4">
      <span class="w-1.5 h-1.5 rounded-full bg-[#C6A66B] animate-pulse"></span>
      CONSULTATION & SURVEY INQUIRIES
    </span>

    <!-- Main Headline -->
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white max-w-3xl mx-auto leading-tight text-balance">
      {displayHeadline}
    </h2>

    <!-- Subheadline -->
    <p class="text-sm sm:text-base text-slate-300 mt-3 max-w-2xl mx-auto text-pretty leading-relaxed">
      {displaySubheadline}
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 mt-8 max-w-md mx-auto">
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-xl bg-[#25D366] hover:bg-[#20BA5A] text-white font-bold text-sm sm:text-base transition-all shadow-lg hover:shadow-xl active:scale-[0.99]"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.97.529 1.834.811 2.8.812l.004.001c3.182 0 5.769-2.587 5.77-5.767.001-3.181-2.585-5.767-5.778-5.769zm3.376 8.204c-.143.402-.832.748-1.156.793-.324.045-.636.074-1.802-.408-1.424-.59-2.339-2.029-2.408-2.122-.069-.093-.574-.766-.574-1.464s.366-1.042.497-1.184c.131-.143.286-.179.381-.179s.191.006.274.012c.088.006.205-.033.32.245.12.286.408 1.002.444 1.074.036.072.06.155.012.25-.048.096-.072.155-.143.238-.072.083-.152.186-.217.25-.072.072-.147.149-.063.293.083.143.371.611.796.99.548.487 1.011.638 1.154.71.143.072.227.06.311-.036.084-.096.358-.417.454-.56.096-.143.191-.12.322-.072.131.048.834.393.977.464.143.072.239.108.274.167.036.06.036.346-.107.748zM12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.977-1.396A9.957 9.957 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
        </svg>
        <span>WhatsApp Dispatch</span>
      </a>

      <a
        href={telHref}
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm sm:text-base border border-white/20 transition-all"
      >
        <svg class="w-4 h-4 text-[#C6A66B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>Call: {phone}</span>
      </a>
    </div>

    <!-- Product Hallmarks -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-6 text-xs text-slate-400">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-[#C6A66B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        Invisible Grills
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-[#C6A66B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        Balcony Safety Nets
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-[#C6A66B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        Bird Spikes
      </span>
    </div>
  </div>
</section>
