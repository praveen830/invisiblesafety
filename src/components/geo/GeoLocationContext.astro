---
/**
 * Invisible Safety — Location Architecture & Presentation Foundation
 * GeoLocationContext.astro
 * 
 * Reusable location engineering & climate context section:
 * - Details localized environmental factors (high salt-air humidity, monsoon downpours, wind zones)
 * - Highlights high-rise architecture and building profile considerations
 * - Purely data-driven with safe fallbacks; no fabricated claims
 */

export interface Props {
  title?: string;
  subtitle?: string;
  climateFactors?: string[];
  architectureStyle?: string;
  concerns?: string[];
  windZoneRating?: string;
  climateOverview?: string;
  className?: string;
}

const {
  title = 'Localized Architectural & Climate Engineering',
  subtitle = 'Balcony safety systems calibrated for regional climate patterns and high-rise structural demands.',
  climateFactors = [],
  architectureStyle,
  concerns = [],
  windZoneRating,
  climateOverview,
  className = ''
} = Astro.props;
---

<section class={`geo-location-context py-12 md:py-16 bg-slate-50/60 border-y border-slate-100 ${className}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="max-w-3xl mb-10">
      <span class="text-xs uppercase tracking-widest font-semibold text-[#0F233D]/70 bg-white border border-slate-200 px-3 py-1 rounded-full shadow-sm">
        REGIONAL ENGINEERING PROFILE
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#0F233D] tracking-tight mt-3">
        {title}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 mt-2 text-pretty">
        {subtitle}
      </p>
    </div>

    <!-- Editorial Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Card 1: Climate & Atmospheric Dynamics -->
      {(climateFactors.length > 0 || climateOverview) && (
        <div class="bg-white p-6 sm:p-7 rounded-2xl border border-slate-200/90 shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-[#C6A66B] mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#0F233D] tracking-tight">
              Atmospheric & Climate Dynamics
            </h3>
            {climateOverview && (
              <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
                {climateOverview}
              </p>
            )}
            {climateFactors.length > 0 && (
              <ul class="mt-4 space-y-2 text-xs sm:text-sm text-slate-600">
                {climateFactors.map((factor) => (
                  <li class="flex items-start gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#C6A66B] mt-2 flex-shrink-0"></span>
                    <span>{factor}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>

          {windZoneRating && (
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-slate-700">
              <span class="text-slate-500 font-normal">Regional Wind Exposure:</span>
              <span class="bg-slate-100 px-2.5 py-1 rounded-md text-[#0F233D]">{windZoneRating}</span>
            </div>
          )}
        </div>
      )}

      <!-- Card 2: High-Rise Architecture Profile -->
      {architectureStyle && (
        <div class="bg-white p-6 sm:p-7 rounded-2xl border border-slate-200/90 shadow-sm flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-200 flex items-center justify-center text-[#2D89EF] mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#0F233D] tracking-tight">
              Architecture & Facade Integration
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
              Engineered specifically for:
            </p>
            <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-100 mt-3 text-xs sm:text-sm font-medium text-slate-800">
              {architectureStyle}
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 text-xs text-slate-500">
            Designed for residential apartment balconies, preserving natural light and views.
          </div>
        </div>
      )}

      <!-- Card 3: Engineering Solutions & Standards -->
      <div class="bg-white p-6 sm:p-7 rounded-2xl border border-slate-200/90 shadow-sm flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-600 mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-[#0F233D] tracking-tight">
            Key Safety Concerns Addressed
          </h3>
          <ul class="mt-4 space-y-2 text-xs sm:text-sm text-slate-600">
            {(concerns.length > 0 ? concerns : [
              'High-rise balcony edge containment for children & pets',
              'Humane pigeon exclusion without blocking daylight',
              'Weather-resistant materials enduring local outdoor humidity'
            ]).map((concern) => (
              <li class="flex items-start gap-2">
                <svg class="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span>{concern}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-100 text-xs text-slate-500">
          Custom-measured on-site to fit specific balcony dimensions and openings.
        </div>
      </div>
    </div>
  </div>
</section>
