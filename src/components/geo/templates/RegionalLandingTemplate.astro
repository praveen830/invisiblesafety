---
/**
 * Invisible Safety — Location Architecture & Presentation Foundation
 * RegionalLandingTemplate.astro
 * 
 * OBSOLETE / SCOPED TO TELUGU STATES:
 * Regional South India scope has been retired per business decision.
 * Retained for backward-compatible Astro template consumers, defaulting to State scope.
 * 
 * STRICT CONSTRAINT: Does NOT register production routes.
 */

import type { StateSlug, ProductSlug } from '../../../data/geo/types.ts';
import { resolveCampaignConfig } from '../../../data/geo/campaigns.ts';
import { products } from '../../../data/geo/products.ts';
import GeoLandingLayout from '../../../layouts/GeoLandingLayout.astro';
import GeoHero from '../GeoHero.astro';
import GeoServiceGrid from '../GeoServiceGrid.astro';
import GeoTrustInformation from '../GeoTrustInformation.astro';
import GeoRelatedLocations from '../GeoRelatedLocations.astro';
import GeoFAQSection from '../GeoFAQSection.astro';
import GeoConversionCTA from '../GeoConversionCTA.astro';

export interface Props {
  productSlug?: ProductSlug;
  overrideStateSlug?: StateSlug;
}

const { productSlug, overrideStateSlug = 'telangana' } = Astro.props;

// Resolve strongly typed campaign data scoped to state
const campaign = resolveCampaignConfig('state', overrideStateSlug, undefined, productSlug);
const product = productSlug ? products[productSlug] : undefined;

// Telugu Regional FAQs
const regionalFaqs = product ? product.defaultFaqs : [
  {
    question: 'Across which states does Invisible Safety operate?',
    answer: 'Invisible Safety operates across Andhra Pradesh and Telangana, providing architectural safety installations for high-rise residences and gated communities.'
  },
  {
    question: 'How do I request a site measurement survey?',
    answer: 'You can contact our local team via direct telephone (+91 83097 55398) or WhatsApp to schedule a technician visit to your residential society.'
  },
  {
    question: 'Do invisible grills alter apartment building aesthetics?',
    answer: 'Invisible grills feature slim stainless steel cables that provide a low-visibility profile from a distance, designed to preserve building exterior aesthetics while securing balcony openings.'
  }
];
---

<GeoLandingLayout
  level="state"
  stateSlug={overrideStateSlug}
  campaign={campaign}
  productSlug={productSlug}
>
  <!-- Hero Section -->
  <GeoHero
    eyebrow={campaign.eyebrow}
    headline={campaign.headline}
    subheadline={campaign.subheadline}
    desktopWebp={campaign.heroImage.desktop}
    mobileWebp={campaign.heroImage.mobile}
    imageAlt={campaign.heroImage.alt}
    primaryCtaText={campaign.cta.primaryText}
    phoneText={campaign.cta.phoneText}
    phoneNumber={campaign.cta.phoneNumber}
    whatsappText={campaign.cta.whatsappText}
    whatsappPrefill={campaign.cta.whatsappPrefill}
    breadcrumbs={campaign.schema.breadcrumbs}
    valuePills={campaign.valueProposition}
    statusPill={{
      text: campaign.operationalAvailability === 'confirmed' ? 'Active Network' : 'Regional Coverage',
      variant: campaign.operationalAvailability === 'confirmed' ? 'confirmed' : 'pending'
    }}
  />

  <!-- Trust & Protection Section -->
  <GeoTrustInformation
    title="Balcony Safety Solutions"
    subtitle="Safety installations across residential high-rises and communities in Telangana and Andhra Pradesh."
  />

  <!-- Approved Catalogue Section -->
  <GeoServiceGrid
    title={product ? `Other Safety Solutions in ${campaign.eyebrow}` : `Approved Safety Catalogue`}
    subtitle={product ? `In addition to ${product.name}, explore our full suite of balcony safety and netting systems.` : `Protective netting, invisible grills, and bird exclusion solutions for apartments.`}
    currentProductSlug={productSlug}
    stateSlug={overrideStateSlug}
  />

  <!-- Hierarchy Navigation (Target States) -->
  <GeoRelatedLocations
    level="state"
    currentStateSlug={overrideStateSlug}
    currentProductSlug={productSlug}
  />

  <!-- FAQ Section -->
  <GeoFAQSection
    title={product ? `${product.name} FAQs` : `Safety FAQs`}
    faqs={regionalFaqs}
  />

  <!-- Final Conversion CTA -->
  <GeoConversionCTA
    headline={campaign.headline}
    subheadline="Contact our team for measurement inquiries and pricing."
    locationName="Telangana & Andhra Pradesh"
    productName={product?.name}
  />
</GeoLandingLayout>
