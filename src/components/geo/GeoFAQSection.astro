---
/**
 * Invisible Safety — Location Architecture & Presentation Foundation
 * GeoFAQSection.astro
 * 
 * Reusable FAQ accordion with Schema.org FAQPage structured data:
 * - Fully accessible native <details> / <summary> elements
 * - Clean editorial styling with animated chevron indicators
 * - Purely data-driven from verified FAQ entries
 */

export interface FAQItem {
  question: string;
  answer: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  faqs: FAQItem[];
  className?: string;
}

const {
  title = 'Frequently Asked Questions',
  subtitle = 'Clear answers regarding balcony safety installations, materials, and survey bookings.',
  faqs = [],
  className = ''
} = Astro.props;

// Generate Schema.org FAQPage structured data
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section class={`geo-faq-section py-12 md:py-16 bg-white ${className}`}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 md:mb-12">
      <span class="text-xs uppercase tracking-widest font-semibold text-[#0F233D]/70 bg-slate-100 px-3 py-1 rounded-full">
        CLEAR ANSWERS
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#0F233D] tracking-tight mt-3">
        {title}
      </h2>
      <p class="text-base text-slate-600 mt-2 text-pretty">
        {subtitle}
      </p>
    </div>

    <!-- Accordion Items -->
    <div class="space-y-4">
      {faqs.map((faq) => (
        <details
          class="group rounded-2xl border border-slate-200/90 bg-slate-50/40 p-5 md:p-6 transition-colors hover:bg-slate-50 open:bg-white open:border-slate-300 open:shadow-md"
        >
          <summary class="flex items-center justify-between cursor-pointer list-none select-none text-left">
            <span class="text-base sm:text-lg font-bold text-[#0F233D] group-hover:text-[#1A365D] transition-colors pr-4">
              {faq.question}
            </span>
            <div class="w-8 h-8 rounded-full bg-white border border-slate-200 flex items-center justify-center text-slate-500 group-hover:border-[#0F233D] group-hover:text-[#0F233D] flex-shrink-0 transition-transform duration-300 group-open:rotate-180">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </summary>
          <div class="pt-4 text-sm sm:text-base text-slate-600 leading-relaxed border-t border-slate-100 mt-4">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>

    <!-- Still Have Questions CTA -->
    <div class="mt-10 p-5 rounded-2xl bg-slate-50 border border-slate-200/80 text-center flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-left">
        <h4 class="text-sm font-bold text-[#0F233D]">Have a specific installation query?</h4>
        <p class="text-xs text-slate-500">Our team is available to assist with your questions.</p>
      </div>
      <div class="flex items-center gap-3">
        <a
          href="tel:+918309755398"
          class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-xs font-semibold text-[#0F233D] hover:bg-slate-100 transition-colors"
        >
          Call: +91 83097 55398
        </a>
        <a
          href="https://wa.me/918309755398"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 rounded-xl bg-[#0F233D] text-xs font-semibold text-white hover:bg-[#1A365D] transition-colors"
        >
          WhatsApp Chat
        </a>
      </div>
    </div>
  </div>

  <!-- Injected FAQPage Schema -->
  {faqs.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}
</section>
