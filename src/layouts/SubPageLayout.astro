---
import BaseLayout from './BaseLayout.astro';
import {
  ShieldCheck,
  Award,
  Wrench,
  CheckCircle2,
  ArrowRight,
  Phone,
  MessageCircle,
  Maximize2,
  X,
  ChevronRight
} from 'lucide-react';
import { business } from '../data/business';
import { projects } from '../data/projects';

export interface SpecItem {
  label: string;
  value: string;
  icon?: any;
}

export interface GalleryItem {
  src: string;
  alt: string;
  title: string;
  caption?: string;
  badge?: string;
}

export interface SubCategoryItem {
  title: string;
  subtitle: string;
  href: string;
  image?: string;
  spec?: string;
  badge?: string;
}

export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  schema?: Record<string, any> | Record<string, any>[];
  
  // Breadcrumb Props
  breadcrumbs?: BreadcrumbItem[];

  // Hero Props
  heroEyebrow?: string;
  heroTitle: string;
  heroSubtitle: string;
  heroImage: string;
  heroImageMobile?: string;
  heroImageAlt?: string;
  
  // Specifications Ribbon (Technical Hallmarks)
  specs?: SpecItem[];
  
  // 2-Column Editorial Visual Gallery
  gallery?: GalleryItem[];
  galleryEyebrow?: string;
  galleryTitle?: string;
  gallerySubtitle?: string;
  
  // Subcategories / Solutions
  subcategories?: SubCategoryItem[];
  subcategoriesTitle?: string;
  subcategoriesSubtitle?: string;
}

const {
  title,
  description,
  canonicalUrl,
  schema,
  breadcrumbs = [
    { name: "Home", url: "/" }
  ],
  heroEyebrow = "ARCHITECTURAL INTEGRATION",
  heroTitle,
  heroSubtitle,
  heroImage,
  heroImageMobile,
  heroImageAlt = "Invisible Safety Architectural Installation",
  specs = [
    { label: "Material Metallurgy", value: "stainless steel", icon: ShieldCheck },
    { label: "Safety Feature", value: "Residential Balcony Protection", icon: Award },
    { label: "Service Support", value: "Installation & Fitting Support", icon: Wrench },
    { label: "Compliance & Safety", value: "Society Elevation Compliant", icon: CheckCircle2 }
  ],
  gallery = [
    {
      src: "/images/ai-generated/architectural/invisible-grills/invisible-grills-desktop-hero.webp",
      alt: "Luxury High-Rise Balcony Invisible Grills",
      title: "Skyline Panorama Balcony",
      caption: "stainless steel 2mm cables preserving unobstructed 180° penthouse view in crisp daylight.",
      badge: "Flagship Residential"
    },
    {
      src: "/images/ai-generated/safety-nets/pigeon-safety-nets/pigeon-safety-net-desktop-hero.webp",
      alt: "Translucent Bird Netting and Stainless Steel Spikes",
      title: "Translucent Sanctuary Net & Spikes",
      caption: "0.7mm nylon netting and stainless steel spikes on AC ledges for bird exclusion.",
      badge: "Humane Exclusion"
    },
    {
      src: "/images/ai-generated/safety-nets/child-safety-nets/child-safety-net-desktop-hero.webp",
      alt: "High-Rise Child and Pet Anti-Fall Safety Mesh",
      title: "Toddler & Pet Anti-Fall System",
      caption: "Calibrated high-density polymer safety grid preventing accidental falls and slips.",
      badge: "Child & Pet Safety"
    },
    {
      src: "/images/category-structural-safety.jpg",
      alt: "Commercial Building Void Safety Containment Net",
      title: "Structural Fall & Void Network",
      caption: "Industrial heavy-duty safety containment netting with visible border ropes and carabiners.",
      badge: "Structural Containment"
    }
  ],
  galleryEyebrow = "VERIFIED RESIDENTIAL INSTALLATIONS",
  galleryTitle = "Architectural Portfolio",
  gallerySubtitle = "Documented installations across luxury penthouses, gated villas, and high-rise residences.",
  subcategories,
  subcategoriesTitle = "ENGINEERED CONFIGURATIONS",
  subcategoriesSubtitle = "Explore specialized solutions engineered for diverse structural requirements."
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
>
  <!-- =========================================================================
       1. HERO HEADER: High-Impact Photography & Light-First Scrim
       ========================================================================= -->
  <header class="subpage-hero">
    <div class="subpage-hero-media">
      {heroImageMobile ? (
        <picture class="subpage-hero-picture">
          <source
            media="(max-width: 767px)"
            srcset={heroImageMobile}
            type="image/webp"
          />
          <source
            media="(min-width: 768px)"
            srcset={heroImage}
            type="image/webp"
          />
          <img
            src={heroImage}
            alt={heroImageAlt}
            class="subpage-hero-img"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="1920"
            height="1080"
          />
        </picture>
      ) : (
        <img
          src={heroImage}
          alt={heroImageAlt}
          class="subpage-hero-img"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1920"
          height="1080"
        />
      )}
      <!-- Ambient Multi-Stop Vignette Overlay -->
      <div class="subpage-hero-scrim"></div>
    </div>

    <!-- Center-Bottom Content Box -->
    <div class="subpage-hero-content">
      <div class="subpage-hero-box">
        <!-- Breadcrumb Navigation -->
        <nav class="subpage-breadcrumbs" aria-label="Breadcrumb">
          <ol class="breadcrumbs-list">
            {breadcrumbs.map((crumb, idx) => (
              <li class="breadcrumb-item">
                <a href={crumb.url} class="breadcrumb-link">{crumb.name}</a>
                <span class="breadcrumb-sep">/</span>
              </li>
            ))}
            <li class="breadcrumb-item current" aria-current="page">
              <span>{heroTitle}</span>
            </li>
          </ol>
        </nav>

        <span class="subpage-eyebrow">
          {heroEyebrow}
        </span>

        <h1 class="subpage-title">
          {heroTitle}
        </h1>

        <p class="subpage-subtitle">
          {heroSubtitle}
        </p>

        <!-- High-Conversion Actions -->
        <div class="subpage-actions">
          <a href="/contact/#quote" class="btn-subpage-primary">
            <span>REQUEST SITE SURVEY</span>
            <ArrowRight size={14} />
          </a>

          {specs && specs.length > 0 && (
            <button
              type="button"
              class="btn-subpage-secondary"
              id="trigger-subpage-specs-btn"
              aria-label={`View technical specifications for ${heroTitle}`}
            >
              <span>SPECIFICATIONS</span>
            </button>
          )}

          <a
            href={`https://wa.me/${business.whatsapp}?text=Hello%20Invisible%20Safety%2C%20I%20am%20inquiring%20about%20${encodeURIComponent(heroTitle)}.`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-subpage-whatsapp"
            aria-label="Direct WhatsApp consultation"
          >
            <MessageCircle size={16} />
            <span>WHATSAPP QUOTE</span>
          </a>

          <a
            href={`tel:${business.phoneRaw}`}
            class="btn-subpage-call"
            aria-label={`Call ${business.phone}`}
          >
            <Phone size={14} />
            <span>{business.phone}</span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- =========================================================================
       2. TRANSLUCENT BOTTOM-SHEET SPECIFICATIONS MODAL
       ========================================================================= -->
  {specs && specs.length > 0 && (
    <div class="specs-modal-backdrop" id="subpage-specs-modal" aria-hidden="true">
      <div class="specs-sheet" id="subpage-specs-sheet">
        <div class="sheet-header">
          <div>
            <span class="sheet-eyebrow">{heroEyebrow} · TECHNICAL HALLMARKS</span>
            <h3 class="sheet-title">{heroTitle}</h3>
          </div>
          <button type="button" class="sheet-close-btn" id="subpage-specs-close" aria-label="Close specifications">
            <X size={20} />
          </button>
        </div>

        <div class="sheet-body">
          <div class="specs-grid">
            {specs.map((item) => (
              <div class="spec-item">
                <span class="spec-item-label">{item.label}</span>
                <span class="spec-item-value">{item.value}</span>
              </div>
            ))}
          </div>

          <div class="sheet-footer">
            <a href="/contact/#quote" class="btn-sheet-submit">
              <span>SCHEDULE COMPLIMENTARY SITE SURVEY</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- =========================================================================
       3. SUBCATEGORIES / CONFIGURATIONS (Clean Light Cards)
       ========================================================================= -->
  {subcategories && subcategories.length > 0 && (
    <section class="subcategories-section">
      <div class="subpage-container">
        <div class="subpage-section-header">
          <span class="editorial-eyebrow">{subcategoriesTitle}</span>
          <h2 class="editorial-title">Available Architectural Formats</h2>
          <p class="editorial-subtitle">{subcategoriesSubtitle}</p>
        </div>

        <div class="subcategories-grid">
          {subcategories.map((sub) => (
            <a href={sub.href} class="subcategory-card group">
              {sub.image && (
                <div class="subcategory-media">
                  <img src={sub.image} alt={sub.title} class="subcategory-img" loading="lazy" />
                  <div class="subcategory-overlay"></div>
                </div>
              )}
              <div class="subcategory-body">
                {sub.badge && <span class="subcategory-badge">{sub.badge}</span>}
                <h3 class="subcategory-title">{sub.title}</h3>
                <p class="subcategory-desc">{sub.subtitle}</p>
                {sub.spec && <span class="subcategory-spec">{sub.spec}</span>}
                <div class="subcategory-cta">
                  <span>DISCOVER SPECIFICATIONS</span>
                  <ChevronRight size={14} />
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- =========================================================================
       4. MAIN CONTENT SLOT (Custom engineering, calculator, comparison, FAQs)
       ========================================================================= -->
  <slot />

  <!-- =========================================================================
       5. VISUAL GALLERY GRID: 2-Column Editorial Grid with Lightbox
       ========================================================================= -->
  {gallery && gallery.length > 0 && (
    <section class="editorial-gallery-section" id="gallery-showcase">
      <div class="subpage-container">
        <div class="subpage-section-header">
          <span class="editorial-eyebrow">{galleryEyebrow}</span>
          <h2 class="editorial-title">{galleryTitle}</h2>
          <p class="editorial-subtitle">{gallerySubtitle}</p>
        </div>

        <div class="editorial-gallery-grid-2col">
          {gallery.map((item, idx) => (
            <div
              class="gallery-editorial-card trigger-lightbox"
              data-img-src={item.src}
              data-img-alt={item.alt}
              data-img-title={item.title}
              data-img-caption={item.caption || ""}
              data-idx={idx}
              role="button"
              tabindex="0"
              aria-label={`View photo ${item.title}`}
            >
              <img
                src={item.src}
                alt={item.alt}
                class="gallery-card-img"
                loading="lazy"
                width="800"
                height="500"
              />
              <div class="gallery-card-overlay">
                {item.badge && <span class="gallery-card-badge">{item.badge}</span>}
                <h3 class="gallery-card-title">{item.title}</h3>
                {item.caption && <p class="gallery-card-caption">{item.caption}</p>}
                <span class="gallery-card-action">
                  <Maximize2 size={13} />
                  <span>TAP TO EXPAND VIEW</span>
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- =========================================================================
       5B. VERIFIED REGIONAL INSTALLATIONS: Hyderabad, Vizag & Vijayawada
       ========================================================================= -->
  <section class="editorial-projects-section" id="verified-projects">
    <div class="subpage-container">
      <div class="subpage-section-header">
        <span class="editorial-eyebrow">DOCUMENTED PROOF OF WORK</span>
        <h2 class="editorial-title">Live Installations Across AP &amp; Telangana</h2>
        <p class="editorial-subtitle">
          Real residential and commercial installations across luxury communities in Hyderabad, Visakhapatnam, and Vijayawada.
        </p>
      </div>

      <div class="regional-projects-grid">
        {projects.map((proj) => (
          <div class="regional-project-card">
            <div class="project-media-wrap">
              <img
                src={proj.imageAfter}
                alt={`${proj.title} - ${proj.apartmentName}, ${proj.city}`}
                class="project-img"
                loading="lazy"
                width="640"
                height="400"
              />
              <span class="project-city-badge">{proj.city}</span>
            </div>
            <div class="project-info-block">
              <div class="project-meta-line">
                <span class="project-locality">{proj.locality}</span>
                <span class="project-floor">{proj.floor}</span>
              </div>
              <h3 class="project-title">{proj.apartmentName}</h3>
              <p class="project-config">{proj.configuration}</p>
              <p class="project-quote">"{proj.clientQuote}"</p>
              <div class="project-client-name">&mdash; {proj.clientName}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================================================================
       6. CONCIERGE SURVEY INVITATION STRIP (Warm Peach/Sand)
       ========================================================================= -->
  <section class="editorial-concierge-strip">
    <div class="subpage-container">
      <div class="concierge-editorial-box">
        <span class="concierge-eyebrow">PRECISION ON-SITE ENGINEERING</span>
        <h2 class="concierge-title">Schedule On-Site Balcony Measurement</h2>
        <p class="concierge-desc">
          Our experienced surveyor will inspect your structure, measure balcony openings, present physical material samples, and provide a transparent written quotation.
        </p>
        <div class="concierge-actions">
          <a href="/contact/#quote" class="btn-concierge-primary">
            <span>REQUEST SITE SURVEY</span>
            <ArrowRight size={14} />
          </a>
          <a
            href={`https://wa.me/${business.whatsapp}?text=Hello%20Invisible%20Safety%2C%20I%20would%20like%20to%20schedule%20a%20doorstep%20accurate%20measurement.`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-concierge-whatsapp"
          >
            <MessageCircle size={15} />
            <span>WHATSAPP SURVEY</span>
          </a>
          <a href={`tel:${business.phoneRaw}`} class="btn-concierge-call">
            <Phone size={14} />
            <span>Call: {business.phone}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       7. INTERACTIVE LIGHTBOX MODAL (Built-In)
       ========================================================================= -->
  <div class="lightbox-backdrop" id="subpage-lightbox-modal" aria-hidden="true">
    <div class="lightbox-content">
      <button type="button" class="lightbox-close-btn" id="lightbox-close" aria-label="Close image preview">
        <X size={20} />
      </button>
      <div class="lightbox-img-wrapper">
        <img src="" alt="" class="lightbox-img" id="lightbox-target-img" />
      </div>
      <div class="lightbox-meta">
        <div>
          <h3 class="lightbox-title" id="lightbox-target-title">Installation Preview</h3>
          <p class="lightbox-caption" id="lightbox-target-caption"></p>
        </div>
        <div class="lightbox-counter" id="lightbox-counter">1 / 4</div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* =========================================================================
     LIGHT-FIRST ARCHITECTURAL SUBPAGE LAYOUT
     ========================================================================= */
  .subpage-hero {
    position: relative;
    width: 100%;
    min-height: clamp(540px, 72vh, 760px);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    background-color: #0F233D;
    border-bottom: 1px solid #E2E8F0;
  }

  .subpage-hero-media {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .subpage-hero-picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .subpage-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: contrast(1.05) saturate(1.04);
    transform: scale(1.0);
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .subpage-hero:hover .subpage-hero-img {
    transform: scale(1.025);
  }

  /* Architectural Multi-Stop Scrim */
  .subpage-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 35, 61, 0.5) 0%,
      rgba(15, 35, 61, 0.25) 40%,
      rgba(15, 35, 61, 0.85) 85%,
      rgba(15, 35, 61, 0.96) 100%
    );
    pointer-events: none;
    z-index: 2;
  }

  .subpage-hero-content {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(3.5rem, 8vh, 5.5rem) clamp(1.25rem, 4vw, 2.5rem) clamp(2.5rem, 5vh, 4rem);
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .subpage-hero-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 860px;
    width: 100%;
  }

  /* Breadcrumbs */
  .subpage-breadcrumbs {
    margin-bottom: 1rem;
  }

  .breadcrumbs-list {
    display: flex;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 6px;
    font-size: 12px;
  }

  .breadcrumb-link {
    color: #CBD5E1;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb-link:hover {
    color: #FFFFFF;
  }

  .breadcrumb-sep {
    color: #64748B;
    margin-left: 6px;
  }

  .breadcrumb-item.current {
    color: #D8BE8A;
    font-weight: 600;
  }

  .subpage-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #D8BE8A;
    margin-bottom: 0.75rem;
    text-shadow: 0 1px 6px rgba(15, 35, 61, 0.8);
  }

  .subpage-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: clamp(1.85rem, 4.2vw, 3.4rem);
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: 0.02em;
    color: #FFFFFF;
    text-shadow: 0 2px 14px rgba(15, 35, 61, 0.7);
    margin: 0 0 1rem 0;
    word-break: break-word;
  }

  .subpage-subtitle {
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.3vw, 1.15rem);
    color: #F1F5F9;
    line-height: 1.6;
    margin: 0 0 2rem 0;
    max-width: 720px;
    text-shadow: 0 1px 6px rgba(15, 35, 61, 0.85);
  }

  .subpage-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .btn-subpage-primary {
    min-height: 48px;
    padding: 0 1.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #0F233D;
    color: #FFFFFF !important;
    border: 1px solid #0F233D;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(15, 35, 61, 0.25);
    transition: all 0.2s ease;
  }

  .btn-subpage-primary:hover {
    background: #1A365D;
    transform: translateY(-2px);
  }

  .btn-subpage-secondary {
    min-height: 48px;
    padding: 0 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #FFFFFF !important;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-subpage-secondary:hover {
    background: #FFFFFF;
    color: #0F233D !important;
  }

  .btn-subpage-whatsapp {
    min-height: 48px;
    padding: 0 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: #25D366;
    color: #FFFFFF !important;
    border: 1px solid #25D366;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.3);
    transition: all 0.2s ease;
  }

  .btn-subpage-whatsapp:hover {
    background: #20BA5A;
    transform: translateY(-2px);
  }

  .btn-subpage-whatsapp:hover {
    background: #15803D;
    transform: translateY(-2px);
  }

  .btn-subpage-call {
    min-height: 48px;
    padding: 0 1.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.12);
    color: #FFFFFF !important;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-subpage-call:hover {
    background: #FFFFFF;
    color: #1A365D !important;
  }

  /* Specifications Bottom-Sheet Modal */
  .specs-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 35, 61, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 1050;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .specs-modal-backdrop.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .specs-sheet {
    width: 100%;
    max-width: 680px;
    background: #FFFFFF;
    border-top: 1px solid #E2E8F0;
    border-radius: 20px 20px 0 0;
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    box-shadow: 0 -12px 40px rgba(15, 35, 61, 0.15);
    transform: translateY(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    max-height: 85vh;
    overflow-y: auto;
    box-sizing: border-box;
    color: #0F233D;
  }

  .specs-modal-backdrop.is-active .specs-sheet {
    transform: translateY(0);
  }

  .sheet-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #E2E8F0;
    margin-bottom: 1.5rem;
  }

  .sheet-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #C6A66B;
    text-transform: uppercase;
