  .lightbox-counter {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    color: #94A3B8;
    font-weight: 600;
  }
</style>

<script is:inline>
  function setupSubpageModals() {
    // 1. Lightbox setup
    const lightboxBackdrop = document.getElementById('subpage-lightbox-modal');
    const lightboxCloseBtn = document.getElementById('lightbox-close');
    const targetImg = document.getElementById('lightbox-target-img');
    const targetTitle = document.getElementById('lightbox-target-title');
    const targetCaption = document.getElementById('lightbox-target-caption');
    const counter = document.getElementById('lightbox-counter');
    const cards = Array.from(document.querySelectorAll('.trigger-lightbox'));

    let currentIndex = 0;

    function openLightbox(idx) {
      currentIndex = idx;
      const card = cards[idx];
      if (!card || !targetImg || !lightboxBackdrop) return;

      const src = card.getAttribute('data-img-src') || '';
      const alt = card.getAttribute('data-img-alt') || '';
      const title = card.getAttribute('data-img-title') || '';
      const caption = card.getAttribute('data-img-caption') || '';

      targetImg.src = src;
      targetImg.alt = alt;
      if (targetTitle) targetTitle.textContent = title;
      if (targetCaption) targetCaption.textContent = caption;
      if (counter) counter.textContent = (idx + 1) + ' / ' + cards.length;

      lightboxBackdrop.classList.add('is-active');
      lightboxBackdrop.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightboxBackdrop) return;
      lightboxBackdrop.classList.remove('is-active');
      lightboxBackdrop.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    cards.forEach((card, idx) => {
      card.addEventListener('click', () => openLightbox(idx));
    });

    if (lightboxCloseBtn) lightboxCloseBtn.addEventListener('click', closeLightbox);
    if (lightboxBackdrop) {
      lightboxBackdrop.addEventListener('click', (e) => {
        if (e.target === lightboxBackdrop) closeLightbox();
      });
    }

    // 2. Specifications Bottom Sheet Modal Setup
    const specsModal = document.getElementById('subpage-specs-modal');
    const specsTrigger = document.getElementById('trigger-subpage-specs-btn');
    const specsCloseBtn = document.getElementById('subpage-specs-close');

    function openSpecsModal() {
      if (!specsModal) return;
      specsModal.classList.add('is-active');
      specsModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeSpecsModal() {
      if (!specsModal) return;
      specsModal.classList.remove('is-active');
      specsModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    if (specsTrigger) specsTrigger.addEventListener('click', openSpecsModal);
    if (specsCloseBtn) specsCloseBtn.addEventListener('click', closeSpecsModal);
    if (specsModal) {
      specsModal.addEventListener('click', (e) => {
        if (e.target === specsModal) closeSpecsModal();
      });
    }

    // Global Escape Key Listener
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (lightboxBackdrop && lightboxBackdrop.classList.contains('is-active')) {
          closeLightbox();
        }
        if (specsModal && specsModal.classList.contains('is-active')) {
          closeSpecsModal();
        }
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupSubpageModals);
  document.addEventListener('astro:page-load', setupSubpageModals);
</script>
