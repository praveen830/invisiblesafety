---
import BaseLayout from './BaseLayout.astro';
import {
  ShieldCheck,
  Award,
  Wrench,
  CheckCircle2,
  Sparkles,
  ArrowRight,
  Phone,
  MessageCircle,
  Maximize2,
  X,
  ChevronRight,
  ChevronLeft
} from 'lucide-react';
import { business } from '../data/business';
import { projects } from '../data/projects';

export interface SpecItem {
  label: string;
  value: string;
  icon?: any;
}

export interface GalleryItem {
  src: string;
  alt: string;
  title: string;
  caption?: string;
  badge?: string;
}

export interface SubCategoryItem {
  title: string;
  subtitle: string;
  href: string;
  image?: string;
  spec?: string;
  badge?: string;
}

export interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  schema?: Record<string, any> | Record<string, any>[];
  
  // Hero Props
  heroEyebrow?: string;
  heroTitle: string;
  heroSubtitle: string;
  heroImage: string;
  heroImageAlt?: string;
  
  // Specifications Ribbon (Technical Hallmarks)
  specs?: SpecItem[];
  
  // 2-Column Editorial Visual Gallery
  gallery?: GalleryItem[];
  galleryEyebrow?: string;
  galleryTitle?: string;
  gallerySubtitle?: string;
  
  // Subcategories / Solutions
  subcategories?: SubCategoryItem[];
  subcategoriesTitle?: string;
  subcategoriesSubtitle?: string;
}

const {
  title,
  description,
  canonicalUrl,
  schema,
  heroEyebrow = "ARCHITECTURAL INTEGRATION",
  heroTitle,
  heroSubtitle,
  heroImage,
  heroImageAlt = "Invisible Safety Architectural Installation",
  specs = [
    { label: "Material Metallurgy", value: "Virgin SS316 Marine Grade", icon: ShieldCheck },
    { label: "Tensile Strength", value: "400+ kgf Breaking Load", icon: Award },
    { label: "Direct Warranty", value: "10-Year Certificate", icon: Wrench },
    { label: "Compliance & Safety", value: "RWA Society Approved", icon: CheckCircle2 }
  ],
  gallery = [
    {
      src: "/images/category-invisible-grills.jpg",
      alt: "Luxury High-Rise Balcony Invisible Grills",
      title: "Skyline Panorama Balcony",
      caption: "Virgin SS316 2mm cables preserving unobstructed 180° penthouse view in crisp daylight.",
      badge: "Flagship Residential"
    },
    {
      src: "/images/category-bird-protection.jpg",
      alt: "Translucent Bird Netting and Stainless Steel Spikes",
      title: "Translucent Sanctuary Net & Spikes",
      caption: "0.7mm monofilament mesh and SS304 spikes on AC ledges for complete bird exclusion.",
      badge: "Humane Exclusion"
    },
    {
      src: "/images/category-child-safety.jpg",
      alt: "Child and Pet Balcony Safety Netting",
      title: "High-Rise Child Fall Protection",
      caption: "Impact-tested virgin polymer netting anchored with stainless steel border tension cords.",
      badge: "Safety Certified"
    },
    {
      src: "/images/category-structural-safety.jpg",
      alt: "Industrial Building Void Fall Protection Netting",
      title: "Structural Duct & Void Containment",
      caption: "Heavy-duty fall arrest netting protecting multi-floor building atrium voids and utility shafts.",
      badge: "Commercial Grade"
    }
  ],
  galleryEyebrow = "REAL VERIFIED INSTALLATIONS",
  galleryTitle = "Architectural Living Portfolio",
  gallerySubtitle = "Photographic documentation from real high-rise balconies, penthouses, and gated residences.",
  subcategories,
  subcategoriesTitle = "CONFIGURATIONS & FORMATS",
  subcategoriesSubtitle = "Explore purpose-engineered variations tailored to your specific architectural layout."
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  schema={schema}
>
  <!-- =========================================================================
       1. SUBPAGE FULL-VIEWPORT HERO (100dvh Coastal Atmosphere)
       ========================================================================= -->
  <header class="subpage-hero">
    <div class="subpage-hero-media">
      <img
        src={heroImage}
        alt={heroImageAlt}
        class="subpage-hero-img"
        loading="eager"
        width="1920"
        height="1080"
      />
      <!-- Coastal Atmospheric Scrim -->
      <div class="subpage-hero-scrim"></div>
    </div>

    <!-- Center-Bottom Content Box -->
    <div class="subpage-hero-content">
      <div class="subpage-hero-box">
        <span class="subpage-eyebrow">
          {heroEyebrow}
        </span>

        <h1 class="subpage-title">
          {heroTitle}
        </h1>

        <p class="subpage-subtitle">
          {heroSubtitle}
        </p>

        <!-- Coastal Conversion Actions -->
        <div class="subpage-actions">
          <a href="/contact/#quote" class="subpage-btn-primary">
            <span>REQUEST SITE SURVEY</span>
            <ArrowRight size={14} />
          </a>

          {specs && specs.length > 0 && (
            <button
              type="button"
              class="subpage-btn-secondary"
              id="trigger-subpage-specs-btn"
              aria-label={`View technical specifications for ${heroTitle}`}
            >
              <span>SPECIFICATIONS</span>
            </button>
          )}

          <a
            href={`https://wa.me/${business.whatsapp}?text=Hello%20Invisible%20Safety%2C%20I%20am%20inquiring%20about%20${encodeURIComponent(heroTitle)}.`}
            target="_blank"
            rel="noopener noreferrer"
            class="subpage-btn-secondary hidden sm:inline-flex"
            aria-label="Direct WhatsApp consultation"
          >
            <MessageCircle size={15} />
            <span>WHATSAPP CONSULT</span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- =========================================================================
       2. BOTTOM-SHEET SPECIFICATIONS MODAL (Coastal Frosted Theme)
       ========================================================================= -->
  {specs && specs.length > 0 && (
    <div class="specs-modal-backdrop" id="subpage-specs-modal" aria-hidden="true">
      <div class="specs-sheet" id="subpage-specs-sheet">
        <div class="sheet-header">
          <div>
            <span class="sheet-eyebrow">{heroEyebrow} · TECHNICAL HALLMARKS</span>
            <h3 class="sheet-title">{heroTitle}</h3>
          </div>
          <button type="button" class="sheet-close-btn" id="subpage-specs-close" aria-label="Close specifications">
            <X size={20} />
          </button>
        </div>

        <div class="sheet-body">
          <div class="specs-grid">
            {specs.map((item) => (
              <div class="spec-item">
                <span class="spec-item-label">{item.label}</span>
                <span class="spec-item-value">{item.value}</span>
              </div>
            ))}
          </div>

          <div class="sheet-footer">
            <a href="/contact/#quote" class="subpage-btn-primary" style="width: 100%; text-align: center; height: 50px;">
              <span>SCHEDULE COMPLIMENTARY SITE SURVEY</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- =========================================================================
       3. SUBCATEGORIES / CONFIGURATIONS (Frosted White-Blue Cards)
       ========================================================================= -->
  {subcategories && subcategories.length > 0 && (
    <section class="subcategories-section">
      <div class="subpage-container">
        <div class="subpage-section-header">
          <span class="editorial-eyebrow">{subcategoriesTitle}</span>
          <h2 class="editorial-title">Available Architectural Formats</h2>
          <p class="editorial-subtitle">{subcategoriesSubtitle}</p>
        </div>

        <div class="subcategories-grid">
          {subcategories.map((sub) => (
            <a href={sub.href} class="subcategory-card group">
              {sub.image && (
                <div class="subcategory-media">
                  <img src={sub.image} alt={sub.title} class="subcategory-img" loading="lazy" />
                  <div class="subcategory-overlay"></div>
                </div>
              )}
              <div class="subcategory-body">
                {sub.badge && <span class="subcategory-badge">{sub.badge}</span>}
                <h3 class="subcategory-title">{sub.title}</h3>
                <p class="subcategory-desc">{sub.subtitle}</p>
                {sub.spec && <span class="subcategory-spec">{sub.spec}</span>}
                <div class="subcategory-cta">
                  <span>DISCOVER SPECIFICATIONS</span>
                  <ChevronRight size={14} />
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- =========================================================================
       4. MAIN CONTENT SLOT
       ========================================================================= -->
  <slot />

  <!-- =========================================================================
       5. VISUAL GALLERY GRID: 2-Column Grid with Lightbox
       ========================================================================= -->
  {gallery && gallery.length > 0 && (
    <section class="editorial-gallery-section" id="gallery-showcase">
      <div class="subpage-container">
        <div class="subpage-section-header">
          <span class="editorial-eyebrow">{galleryEyebrow}</span>
          <h2 class="editorial-title">{galleryTitle}</h2>
          <p class="editorial-subtitle">{gallerySubtitle}</p>
        </div>

        <div class="editorial-gallery-grid-2col">
          {gallery.map((item, idx) => (
            <div
              class="gallery-editorial-card trigger-lightbox"
              data-img-src={item.src}
              data-img-alt={item.alt}
              data-img-title={item.title}
              data-img-caption={item.caption || ""}
              data-idx={idx}
              role="button"
              tabindex="0"
              aria-label={`View photo ${item.title}`}
            >
              <img src={item.src} alt={item.alt} class="gallery-card-img" loading="lazy" />
              <div class="gallery-card-overlay">
                {item.badge && <span class="gallery-card-badge">{item.badge}</span>}
                <h3 class="gallery-card-title">{item.title}</h3>
                {item.caption && <p class="gallery-card-caption">{item.caption}</p>}
                <div class="gallery-card-action">
                  <span>EXPAND HIGH-RES PHOTOGRAPH</span>
                  <Maximize2 size={13} />
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- =========================================================================
       6. CONCIERGE SURVEY INVITATION STRIP
       ========================================================================= -->
  <section class="editorial-concierge-strip">
    <div class="subpage-container">
      <div class="concierge-editorial-box">
        <span class="concierge-eyebrow">PRECISION ON-SITE ENGINEERING</span>
        <h2 class="concierge-title">Schedule Doorstep Laser Measurement</h2>
        <p class="concierge-desc">
          Our certified architectural surveyor will inspect your structure, measure cable lengths with high-precision lasers, present authentic SS316 wire samples, and deliver a zero-obligation quotation.
        </p>
        <div class="concierge-actions">
          <a href="/contact/#quote" class="subpage-btn-primary">
            <span>REQUEST SITE SURVEY</span>
            <ArrowRight size={14} />
          </a>
          <a href={`tel:${business.phoneRaw}`} class="subpage-btn-secondary">
            <Phone size={14} />
            <span>DIRECT CALL: {business.phone}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       7. INTERACTIVE LIGHTBOX MODAL
       ========================================================================= -->
  <div class="lightbox-backdrop" id="subpage-lightbox-modal" aria-hidden="true">
    <div class="lightbox-content">
      <button type="button" class="lightbox-close-btn" id="lightbox-close" aria-label="Close image preview">
        <X size={20} />
      </button>
      <div class="lightbox-img-wrapper">
        <img src="" alt="" class="lightbox-img" id="lightbox-target-img" />
      </div>
      <div class="lightbox-meta">
        <div>
          <h3 class="lightbox-title" id="lightbox-target-title">Installation Preview</h3>
          <p class="lightbox-caption" id="lightbox-target-caption"></p>
        </div>
        <div class="lightbox-counter" id="lightbox-counter">1 / 4</div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* =========================================================================
     SUBPAGE HERO (100dvh Coastal Atmosphere)
     ========================================================================= */
  .subpage-hero {
    position: relative;
    width: 100%;
    min-height: 100dvh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    background-color: #0F1E36;
    border-bottom: 1px solid #D8E6F3;
  }

  .subpage-hero-media {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .subpage-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: contrast(1.05) saturate(1.04);
    transform: scale(1.0);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .subpage-hero:hover .subpage-hero-img {
    transform: scale(1.03);
  }

  .subpage-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(15, 30, 54, 0.15) 0%,
      rgba(15, 30, 54, 0.45) 50%,
      rgba(15, 30, 54, 0.88) 100%
    );
    pointer-events: none;
    z-index: 2;
  }

  .subpage-hero-content {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2.5rem);
    padding-bottom: clamp(2.5rem, 6.5vh, 4.5rem);
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .subpage-hero-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 860px;
    width: 100%;
  }

  .subpage-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #38BDF8;
    background: rgba(15, 30, 54, 0.65);
    padding: 0.35rem 1.15rem;
    border-radius: 9999px;
    border: 1px solid rgba(56, 189, 248, 0.35);
    backdrop-filter: blur(8px);
    margin-bottom: 0.85rem;
  }

  .subpage-title {
    font-family: var(--font-brand, 'Cinzel', serif);
    font-size: clamp(1.75rem, 4.4vw, 3.4rem);
    font-weight: 800;
    letter-spacing: 0.05em;
    color: #FFFFFF;
    text-transform: uppercase;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8), 0 4px 20px rgba(0, 0, 0, 0.6);
    margin: 0 0 0.85rem 0;
    line-height: 1.15;
    max-width: 100%;
  }

  .subpage-subtitle {
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.8vw, 1.12rem);
    color: #F1F5F9;
    line-height: 1.55;
    margin: 0 0 2rem 0;
    max-width: 680px;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.85);
  }

  .subpage-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Buttons */
  .subpage-btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.85rem 2.25rem;
    background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
    color: #0F1E36 !important;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 800;
    text-decoration: none;
    border-radius: 9999px;
    border: 1px solid #F59E0B;
    box-shadow: 0 4px 20px rgba(245, 158, 11, 0.45);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .subpage-btn-primary:hover {
    background: linear-gradient(135deg, #FBBF24 0%, #EA580C 100%);
    color: #0F1E36 !important;
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(245, 158, 11, 0.6);
    border-color: #FBBF24;
  }

  .subpage-btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.85rem 2.25rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #1E3A5F !important;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    text-decoration: none;
    border-radius: 9999px;
    border: 1px solid #D8E6F3;
    box-shadow: 0 4px 18px rgba(30, 58, 95, 0.15);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .subpage-btn-secondary:hover {
    background: #EBF3FA;
    color: #0284C7 !important;
    border-color: #0284C7;
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .subpage-actions {
      flex-direction: column;
      width: 100%;
      max-width: 320px;
      gap: 0.75rem;
    }
    .subpage-actions a,
    .subpage-actions button {
      width: 100%;
    }
  }

  /* Bottom-Sheet Specs Modal */
  .specs-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 30, 54, 0.65);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 1050;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .specs-modal-backdrop.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .specs-sheet {
    width: 100%;
    max-width: 680px;
    background: #FFFFFF;
    border: 1px solid #D8E6F3;
    border-radius: 20px 20px 0 0;
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    box-shadow: 0 -20px 60px rgba(30, 58, 95, 0.2);
    transform: translateY(100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    max-height: 85vh;
    overflow-y: auto;
    box-sizing: border-box;
    color: var(--color-body);
  }

  .specs-modal-backdrop.is-active .specs-sheet {
    transform: translateY(0);
  }

  .sheet-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid #EBF3FA;
    margin-bottom: 1.5rem;
  }

  .sheet-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--color-accent);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.25rem;
  }

  .sheet-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-primary);
    margin: 0;
  }

  .sheet-close-btn {
    background: #F1F5F9;
    border: 1px solid #D8E6F3;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-secondary);
    cursor: pointer;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 480px) {
    .specs-grid {
      grid-template-columns: 1fr;
    }
  }

  .spec-item {
    background: #F8FAFC;
    border: 1px solid #D8E6F3;
    border-radius: 8px;
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .spec-item-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #64748B;
    text-transform: uppercase;
  }

  .spec-item-value {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .sheet-footer {
    margin-top: 1rem;
  }

  /* Subcategories Grid */
  .subcategories-section {
    background-color: #F4F7FB;
    color: #475569;
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    border-bottom: 1px solid #D8E6F3;
  }

  .subcategories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .subcategory-card {
    background: #FFFFFF;
    border: 1px solid #D8E6F3;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 4px 18px -2px rgba(30, 58, 95, 0.06);
    transition: all 0.28s ease;
  }

  .subcategory-card:hover {
    border-color: #0EA5E9;
    transform: translateY(-4px);
    box-shadow: 0 12px 30px -4px rgba(30, 58, 95, 0.12);
  }

  .subcategory-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #EBF3FA;
  }

  .subcategory-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  .subcategory-card:hover .subcategory-img {
    transform: scale(1.04);
  }

  .subcategory-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 30, 54, 0.05) 0%, rgba(15, 30, 54, 0.6) 100%);
  }

  .subcategory-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .subcategory-badge {
    align-self: flex-start;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #0284C7;
    background: #E0F2FE;
    border: 1px solid #BAE6FD;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }

  .subcategory-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: #1E3A5F;
    margin: 0 0 0.5rem 0;
  }

  .subcategory-desc {
    font-size: 0.88rem;
    color: #64748B;
    line-height: 1.55;
    margin: 0 0 1rem 0;
    flex-grow: 1;
  }

  .subcategory-spec {
    font-size: 0.8rem;
    font-weight: 600;
    color: #0284C7;
    border-top: 1px solid #EBF3FA;
    padding-top: 0.75rem;
    margin-bottom: 1rem;
    display: block;
  }

  .subcategory-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #0284C7;
    transition: gap 0.2s ease;
  }

  .subcategory-card:hover .subcategory-cta {
    gap: 0.65rem;
  }

  /* Containers & Headers */
  .subpage-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 3.5vw, 2.5rem);
    box-sizing: border-box;
  }

  .subpage-section-header {
    text-align: center;
    max-width: 760px;
